{#
    Carte « Disponibilités » — portée par « Informations générales » et
    « Restauration ». Seule la première propose le choix « lieu privatisable ».
#}
<section class="fiche__carte">
    <h2 class="fiche__section-titre">Disponibilités</h2>

    {% if a_privatisation %}
        <div class="fiche__privatisation">
            <span class="fiche__champ-label">Lieu privatisable*</span>
            <div class="fiche__radios">
                <label class="fiche__radio">
                    <span class="fiche__radio-puce fiche__radio-puce--active" aria-hidden="true"></span>
                    <input class="sr-only" type="radio" name="privatisable" value="oui" checked>
                    <span>Oui</span>
                </label>
                <label class="fiche__radio">
                    <span class="fiche__radio-puce" aria-hidden="true"></span>
                    <input class="sr-only" type="radio" name="privatisable" value="non">
                    <span>Non</span>
                </label>
            </div>
        </div>
    {% endif %}

    <div class="fiche__horaires">
        <span class="fiche__sous-titre">Horaires</span>
        <div class="fiche__jours">
            {% for jour in jours %}
                <div class="fiche__jour">
                    <div class="fiche__jour-entete">
                        <span class="fiche__bascule {{ jour.ouvert ? 'fiche__bascule--active' : '' }}"
                              role="switch"
                              aria-checked="{{ jour.ouvert ? 'true' : 'false' }}"
                              aria-label="{{ jour.nom }}"
                              tabindex="0">
                            <span class="fiche__bascule-bouton"></span>
                        </span>
                        <span class="fiche__jour-nom">{{ jour.nom }}</span>
                    </div>

                    {% if jour.ouvert %}
                        <div class="fiche__creneaux">
                            <div class="fiche__creneau">
                                <span class="fiche__champ-label">Ouverture</span>
                                <div class="fiche__heure">08:00</div>
                            </div>
                            <div class="fiche__creneau">
                                <span class="fiche__champ-label">Fermeture</span>
                                <div class="fiche__heure">18:00</div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="fiche__fermetures">
        <div class="fiche__fermetures-entete">
            <span class="fiche__sous-titre">Périodes de fermeture</span>
            <button class="bp-btn bp-btn--lg bp-btn--outline" type="button">
                <span class="bp-btn__icon">
                    <svg width="24" height="24" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M8 2.5v11M2.5 8h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                    </svg>
                </span>
                Ajouter une période
            </button>
        </div>

        {% for periode in periodes %}
            <div class="fiche__periode">
                <div class="fiche__periode-champ">
                    <span class="fiche__champ-label">Nom de la période</span>
                    <div class="fiche__periode-boite">{{ periode.nom }}</div>
                </div>
                <div class="fiche__periode-champ">
                    <span class="fiche__champ-label">Date(s) de fermeture</span>
                    <div class="fiche__periode-boite fiche__periode-boite--dates">
                        <span>{{ periode.dates }}</span>
                        <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <rect x="1.5" y="3" width="13" height="11.5" rx="2" stroke="var(--primary-turquoise)" stroke-width="1.3"></rect>
                            <path d="M1.5 6.5h13M5 1.5V4M11 1.5V4" stroke="var(--primary-turquoise)" stroke-width="1.3" stroke-linecap="round"></path>
                        </svg>
                    </div>
                </div>
                <button class="fiche__periode-supprimer" type="button" aria-label="Supprimer la période">
                    <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M2.5 4h11M6.5 4V2.5h3V4M4 4v9.5a1 1 0 001 1h6a1 1 0 001-1V4M6.5 7v5M9.5 7v5"
                              stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </button>
            </div>
        {% endfor %}
    </div>
</section>
