{#
    Carte « Disponibilités » — portée par « Informations générales » et
    « Restauration ». Seule la première propose le choix « lieu privatisable ».

    Les interrupteurs et les boutons radio sont ceux du portail : de vrais
    `input`, donc de vraies coutures pour un formulaire.
#}
{#
    L'écart entre les quatre blocs est à 32 px, pas aux 56 px des cartes de
    section : celles-là n'ont que deux enfants, ici il y en a quatre et la carte
    se délitait en autant d'îlots.
#}
<section class="shrink-0 box-border flex flex-col gap-8 p-14 rounded-[32px]
                bg-neutral-100 shadow-(--shadow)">
    <twig:Typography variant="heading-3" element="h2" class="font-[700]!">Disponibilités</twig:Typography>

    {% if a_privatisation %}
        <div class="flex flex-col gap-2">
            {{ _self.label('Lieu privatisable*') }}
            <div class="flex flex-row gap-10">
                <twig:Form:RadioItem id="privatisable-oui" name="privatisable" value="oui" checked>Oui</twig:Form:RadioItem>
                <twig:Form:RadioItem id="privatisable-non" name="privatisable" value="non">Non</twig:Form:RadioItem>
            </div>
        </div>
    {% endif %}

    <div class="flex flex-col gap-4">
        <twig:Typography variant="subtitle" bold>Horaires</twig:Typography>
        <div class="flex flex-row gap-6 items-start flex-wrap">
            {% for jour in jours %}
                <div class="flex flex-col gap-2 flex-1 basis-32 min-w-0">
                    <div class="flex flex-row items-center gap-2">
                        <twig:Form:SwitchButton id="jour-{{ loop.index }}" name="jour-{{ loop.index }}"
                                                checked="{{ jour.ouvert }}" class="shrink-0" />
                        <twig:Typography variant="input" element="span"
                                         class="text-[0.875rem]! leading-[1.375rem]! whitespace-nowrap">{{ jour.nom }}</twig:Typography>
                    </div>

                    {% if jour.ouvert %}
                        <div class="flex flex-row gap-2">
                            {{ _self.heure('Ouverture', '08:00') }}
                            {{ _self.heure('Fermeture', '18:00') }}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="flex flex-col gap-4">
        <div class="flex flex-row items-center gap-6">
            <twig:Typography variant="subtitle" bold class="flex-1">Périodes de fermeture</twig:Typography>
            <twig:Button variant="outline" size="lg" icon="plus">Ajouter une période</twig:Button>
        </div>

        {% for periode in periodes %}
            <div class="flex flex-row gap-6 items-end self-stretch">
                <div class="flex flex-col gap-1 flex-1 min-w-0">
                    {{ _self.label('Nom de la période') }}
                    <div class="h-10 box-border flex items-center px-3 rounded-xs
                                bg-primary-5 inset-ring-1 inset-ring-primary">
                        <twig:Typography variant="input">{{ periode.nom }}</twig:Typography>
                    </div>
                </div>
                <div class="flex flex-col gap-1 flex-1 min-w-0">
                    {{ _self.label('Date(s) de fermeture') }}
                    <div class="h-10 box-border flex items-center gap-2 px-3 rounded-xs
                                bg-primary-5 inset-ring-1 inset-ring-primary">
                        <twig:Typography variant="input" class="flex-1 min-w-0">{{ periode.dates }}</twig:Typography>
                        <twig:Icon name="calendar" class="w-5 h-5 shrink-0 text-primary" />
                    </div>
                </div>
                <button type="button" aria-label="Supprimer la période"
                        class="w-6 h-10 shrink-0 flex items-center justify-center cursor-pointer text-neutral-900">
                    <twig:Icon name="trash" class="w-[18px] h-[18px]" />
                </button>
            </div>
        {% endfor %}
    </div>
</section>

{% macro label(texte) %}
    <twig:Typography variant="input" element="span"
                     class="text-[0.875rem]! leading-[1.375rem]!">{{ texte }}</twig:Typography>
{% endmacro %}

{% macro heure(libelle, valeur) %}
    <div class="flex flex-col gap-1">
        {{ _self.label(libelle) }}
        <div class="h-10 w-[76px] box-border flex items-center px-3 rounded-xs
                    bg-primary-5 inset-ring-1 inset-ring-primary">
            <twig:Typography variant="input">{{ valeur }}</twig:Typography>
        </div>
    </div>
{% endmacro %}
