{#
    Matrice « Capacités » — maquette mdm/fiche/_capacites, sur la vraie
    collection `salles` (SalleType) : poignée, vignette, nom, superficie et
    8 configurations, 4 équipements en cases, ajout/retrait par le contrôleur
    form-collection.

    Écarts assumés : la poignée de tri et la vignette photo n'ont pas de donnée
    back par salle — elles gardent le gabarit maquette mais sont inertes
    (infobulle « En développement ») ; pas de lien « plan de salle » ; la
    matrice est toujours en édition — l'éditeur EST le mode édition. Le bandeau
    « Pré-remplir avec l'IA » ouvre le vrai flux d'extraction OCR. Elle défile
    horizontalement.

    Variables : `widget` — la collection de formulaires `salles`.
#}
{% set grille = 'grid grid-cols-[24px_81px_172px_repeat(9,70px)_repeat(4,66px)_40px] gap-[15px] items-center min-w-min' %}

{% macro ligne(item, grille) %}
    <fieldset data-form-collection-item
              class="{{ grille }} shrink-0 box-border h-[72px] px-2 py-2 rounded-sm border-0">
        {# Poignée de tri maquette : pas de réordonnancement back — inerte. #}
        <span class="w-6 h-6 flex items-center justify-center cursor-not-allowed text-neutral-300"
              title="En développement" aria-hidden="true">
            <twig:Icon name="arrows-out-cardinal" class="w-6 h-6" />
        </span>
        {# Vignette photo maquette : pas de photo par salle — emplacement au gabarit. #}
        <span class="w-[81px] h-14 box-border flex items-center justify-center rounded-xs
                     border-[1.4px] border-dashed border-neutral-300 cursor-not-allowed"
              title="En développement" aria-hidden="true">
            <twig:Icon name="image" class="w-[22px] h-[22px] text-neutral-400" />
        </span>
        {{ form_widget(item.nom, { attr: { placeholder: 'Nom de la salle' } }) }}
        {% for capacite in ['superficie', 'capaciteReunion', 'capaciteU', 'capaciteClasse',
                            'capaciteTheatre', 'capaciteCabaret', 'capaciteBanquet',
                            'capaciteCocktail', 'capaciteAuditorium'] %}
            {{ form_widget(attribute(item, capacite)) }}
        {% endfor %}
        {% for equipement in ['lumiereJour', 'accesPmr', 'espaceDansant', 'climatisee'] %}
            <span class="flex justify-center">{{ form_widget(attribute(item, equipement)) }}</span>
        {% endfor %}
        {# La position se gère par l'ordre, pas dans la grille. #}
        {% do item.position.setRendered %}
        <button type="button" data-action="form-collection#remove" aria-label="Supprimer la salle"
                class="flex items-center justify-center shrink-0 w-8 h-8 rounded-full cursor-pointer
                       text-neutral-900 hover:bg-error-pastel">
            <twig:Icon name="trash" class="w-[15px] h-4" />
        </button>
    </fieldset>
{% endmacro %}

<fieldset class="flex flex-col gap-4 border-0 p-0 m-0"
    data-controller="form-collection"
    data-form-collection-index-value="{{ widget|length }}"
    data-form-collection-prototype-value="{{ _self.ligne(widget.vars.prototype, grille)|e('html_attr') }}"
>
    <legend class="contents"><twig:Typography variant="subtitle" bold element="span">Capacités par salle</twig:Typography></legend>

    {# La matrice fait ~1550 px : elle défile horizontalement plutôt que de se tasser. #}
    <div class="flex flex-col overflow-x-auto scrollbar pb-2">
        <div class="{{ grille }} items-end! px-2 pb-3" role="row">
            <span></span>
            <span></span>
            <span role="columnheader">
                <twig:Typography variant="body-sm" bold>Nom de la salle</twig:Typography>
            </span>
            {% for colonne in [
                ['Surface', 'area'], ['Réunion', 'meeting'], ['En U', 'u-meeting'],
                ['Classe', 'classroom'], ['Théâtre', 'presentation'], ['Cabaret', 'cabaret'],
                ['Banquet', 'banquet'], ['Cocktail', 'cocktail'], ['Auditorium', 'conference'],
                ['Lumière du jour', 'sun'], ['Accès PMR', 'wheel-chair'],
                ['Espace dansant', 'dance'], ['Climatisée', 'wind'],
            ] %}
                <span class="flex flex-col items-center gap-2.5" role="columnheader">
                    <twig:Icon name="{{ colonne.1 }}" class="w-6 h-6 shrink-0 text-neutral-900" />
                    <twig:Typography variant="body-sm" bold center class="text-pretty">{{ colonne.0 }}</twig:Typography>
                </span>
            {% endfor %}
            <span></span>
        </div>

        <div class="h-px min-w-min bg-neutral-300"></div>

        <div class="flex flex-col min-w-min divide-y divide-neutral-200" data-form-collection-target="items">
            {% for item in widget %}
                {{ _self.ligne(item, grille) }}
            {% endfor %}
        </div>
    </div>

    <div class="flex justify-end">
        <twig:Button variant="outline" size="sm" icon="plus" type="button"
                     data-action="form-collection#add" data-remove-label="Retirer">Ajouter une salle</twig:Button>
    </div>

    {# Bandeau maquette « Pré-remplir avec l'IA », branché sur le vrai flux
       d'extraction OCR (la modale propose les valeurs lues, à valider). #}
    <div class="box-border flex flex-col min-[1100px]:flex-row items-start min-[1100px]:items-center
                gap-6 min-[1100px]:gap-10 p-8 rounded-sm bg-old-gold-pastel">
        <div class="flex flex-col flex-1 min-w-0 gap-2">
            <twig:Typography variant="subtitle" bold>Pré-remplir le tableau avec l'IA</twig:Typography>
            <twig:Typography variant="body" class="text-pretty">Importez la brochure commerciale ou la fiche
                technique de l'établissement : l'IA en extrait les salles, leurs surfaces et leurs capacités par
                configuration, puis vous propose chaque valeur — rien n'est écrit sans votre validation.</twig:Typography>
        </div>
        <twig:Modal:TriggerButton variant="outline" size="lg" icon="upload-simple" class="shrink-0"
                                  modalIdentifier="extraction">Importer un fichier</twig:Modal:TriggerButton>
    </div>
</fieldset>
