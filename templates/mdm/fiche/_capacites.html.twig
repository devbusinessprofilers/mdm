{#
    Matrice « Capacités » — section Réunion.

    Grille de 16 colonnes : poignée, vignette, nom, 8 chiffres (surface + 7
    configurations), 4 équipements, lien vers le plan. Deux états : lecture
    (valeurs brutes, pastilles vert/gris) et édition (champs saisissables,
    cases à cocher, ajout de salle et pré-remplissage par l'IA).
#}
{% set colonnes = constant('App\\Pim\\Maquette\\FicheLieuMaquette::COLONNES_CAPACITES') %}
{% set lecture = not capacites_en_edition %}
{% set grille = 'grid grid-cols-[24px_81px_172px_repeat(8,70px)_repeat(4,66px)_96px] gap-[15px] items-center min-w-min' %}

<section class="shrink-0 box-border flex flex-col gap-6 p-14 rounded-[32px]
                bg-neutral-100 shadow-(--shadow)">
    <div class="flex flex-row items-center gap-6">
        <twig:Typography variant="heading-3" element="h2" class="font-[700]!">Capacités</twig:Typography>
        {% if lecture %}
            <twig:Button asLink variant="outline" size="lg"
                         href="{{ path('app_mdm_fiche_lieu', { section: index, capacites: 'edition' }) }}">Modifier</twig:Button>
        {% else %}
            <twig:Button asLink variant="primary" size="lg"
                         href="{{ path('app_mdm_fiche_lieu', { section: index }) }}">Terminer</twig:Button>
        {% endif %}
    </div>

    {# La matrice fait ~1440 px : elle défile horizontalement plutôt que de se tasser. #}
    <div class="flex flex-col overflow-x-auto scrollbar">
        <div class="{{ grille }} items-end! px-2 pb-3" role="row">
            <span></span>
            <span></span>
            <span role="columnheader">
                <twig:Typography variant="body-sm" bold>Nom de la salle</twig:Typography>
            </span>
            {% for colonne in colonnes %}
                <span class="flex flex-col items-center gap-2.5" role="columnheader">
                    <twig:Icon name="{{ colonne.1 }}" class="w-6 h-6 shrink-0 text-neutral-900" />
                    <twig:Typography variant="body-sm" bold center>{{ colonne.0 }}</twig:Typography>
                </span>
            {% endfor %}
        </div>

        <div class="h-px min-w-min bg-neutral-300"></div>

        {% for salle in salles %}
            <div class="{{ grille }} shrink-0 box-border h-[72px] p-2 rounded-sm
                        {{ lecture and salle.enAvant ? 'bg-primary-5' : 'bg-neutral-100' }}" role="row">
                {% if lecture %}
                    <span class="w-6 h-6" aria-hidden="true"></span>
                {% else %}
                    <span class="w-6 h-6 flex items-center justify-center cursor-grab text-neutral-500"
                          aria-hidden="true">
                        <twig:Icon name="arrows-out-cardinal" class="w-6 h-6" />
                    </span>
                {% endif %}

                {#
                    ÉCART : la photo de salle du handoff (assets/salle.jpg) n'a pas
                    été récupérée ; on garde l'emplacement au bon gabarit, teinté.
                #}
                <span class="w-[81px] h-14 box-border flex items-center justify-center rounded-xs
                             {{ salle.photo
                                ? 'border-[1.4px] border-solid border-transparent bg-primary-4'
                                : 'border-[1.4px] border-dashed border-neutral-300' }}"
                      aria-hidden="true">
                    <twig:Icon name="image" class="w-[22px] h-[22px] text-neutral-400" />
                </span>

                {% if lecture %}
                    <span class="whitespace-nowrap">
                        <twig:Typography variant="body-lg" bold>{{ salle.nom }}</twig:Typography>
                    </span>
                    {% for chiffre in salle.chiffres %}
                        <twig:Typography variant="body-lg" bold center>{{ chiffre }}</twig:Typography>
                    {% endfor %}
                    {% for equipement in salle.equipements %}
                        <span class="flex justify-center" role="cell">
                            <span class="sr-only">{{ equipement ? 'Disponible' : 'Non disponible' }}</span>
                            {% if equipement %}
                                <span class="w-[18px] h-[18px] shrink-0 flex items-center justify-center
                                             rounded-lg bg-success" aria-hidden="true">
                                    <twig:Icon name="check" class="w-3 h-3 text-neutral-100" />
                                </span>
                            {% else %}
                                <span class="w-[18px] h-[18px] shrink-0 flex items-center justify-center
                                             rounded-lg inset-ring-[1.2px] inset-ring-neutral-400" aria-hidden="true">
                                    <twig:Icon name="cross" class="w-2.5 h-2.5 text-neutral-400" />
                                </span>
                            {% endif %}
                        </span>
                    {% endfor %}
                    <a href="#" class="whitespace-nowrap">
                        <twig:Typography variant="body" textColor="primary-3" underline
                        >{{ constant('App\\Pim\\Maquette\\FicheLieuMaquette::PLAN_SALLE') }}</twig:Typography>
                    </a>
                {% else %}
                    {{ _self.saisie(salle.nom) }}
                    {% for chiffre in salle.chiffres %}
                        {{ _self.saisie(chiffre, true) }}
                    {% endfor %}
                    {% for equipement in salle.equipements %}
                        <twig:Form:Checkbox id="capa-{{ loop.parent.loop.index }}-{{ loop.index }}"
                                            name="capa-{{ loop.parent.loop.index }}-{{ loop.index }}"
                                            checked="{{ equipement }}"
                                            class="flex justify-center" />
                    {% endfor %}
                    <span class="flex items-center gap-3.5 whitespace-nowrap">
                        <button type="button">
                            <twig:Typography variant="body" textColor="primary-3" underline
                                             class="cursor-pointer">Importer</twig:Typography>
                        </button>
                        <button type="button" aria-label="Supprimer la salle"
                                class="flex shrink-0 cursor-pointer text-neutral-900">
                            <twig:Icon name="trash" class="w-[15px] h-4" />
                        </button>
                    </span>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {% if not lecture %}
        <div class="flex justify-end">
            <twig:Button variant="outline" size="lg" icon="plus">Ajouter une salle</twig:Button>
        </div>

        {#
            Le fond doré du handoff est rgb(254, 248, 232) ; le jeton le plus
            proche du portail est `old-gold-pastel` (#FBF6E7), à trois points près.
        #}
        <div class="box-border flex flex-col min-[1100px]:flex-row items-start min-[1100px]:items-center
                    gap-6 min-[1100px]:gap-10 p-8 rounded-sm bg-old-gold-pastel">
            <div class="flex flex-col flex-1 min-w-0 gap-2">
                <twig:Typography variant="subtitle" bold>Pré remplir le fichier avec l'IA</twig:Typography>
                <twig:Typography variant="body" class="text-pretty">Importez la brochure commerciale ou la fiche
                    technique de l'établissement : l'IA en extrait les salles, leurs surfaces et leurs capacités par
                    configuration, puis pré-remplit le tableau. Chaque valeur reste à valider avant enregistrement.</twig:Typography>
            </div>
            <twig:Button variant="outline" size="lg" icon="upload-simple" class="shrink-0">Importer un fichier</twig:Button>
        </div>
    {% endif %}
</section>

{% macro saisie(valeur, nombre = false) %}
    <span class="h-10 box-border flex items-center rounded-xs bg-primary-5 inset-ring-1 inset-ring-primary
                 {{ nombre ? 'justify-center' : 'px-3' }}">
        <twig:Typography variant="input">{{ valeur }}</twig:Typography>
    </span>
{% endmacro %}
