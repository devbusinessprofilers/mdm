{#
    Matrice « Capacités » — maquette mdm/fiche/_capacites, sur la vraie
    collection `salles` (SalleType) : poignée, vignette, nom, superficie et
    8 configurations, 4 équipements en cases, ajout/retrait par le contrôleur
    form-collection.

    Écarts assumés : la poignée de tri n'a pas de donnée back par salle — elle
    garde le gabarit maquette mais reste inerte (infobulle « En
    développement ») ; la matrice est toujours en édition — l'éditeur EST le
    mode édition. Le bandeau « Pré-remplir avec l'IA » ouvre le vrai flux
    d'extraction OCR. Elle défile horizontalement.

    La vignette de chaque ligne importe un fichier pour la salle (maquette
    « Importer ») : envoi vers le flux documentaire du lieu (usage Plan de
    salle) par le contrôleur salle-plan ; les fichiers se gèrent ensuite dans
    la section Médias. Une salle pas encore enregistrée reste inerte.

    Partagé entre le Lieu (section Réunion) et le Restaurant (Salles &
    capacités) : mêmes champs de salle. La gamme choisit le flux documentaire
    de l'import par salle (endpoint et nom de formulaire) ; sans flux connu,
    la vignette reste inerte.

    Variables : `widget` — la collection de formulaires `salles` ;
    `gamme` — valeur TypeFiche de la fiche ('lieu', 'restaurant'…).
#}
{% set grille = 'grid grid-cols-[24px_81px_172px_repeat(9,70px)_repeat(4,66px)_40px] gap-[15px] items-center min-w-min' %}
{# Le parent de la collection est le formulaire de l'entité (Lieu ou
   Restaurant) : son data alimente l'URL d'upload et le décompte des fichiers
   déjà rattachés à chaque salle. #}
{% set entite = widget.parent.vars.data %}
{% set config_fichiers = {
    'lieu': { url: path('app_pim_lieu_document_upload', {id: entite.id}), formulaire: 'document_upload' },
    'restaurant': { url: path('app_pim_restaurant_document_upload', {id: entite.id}), formulaire: 'restaurant_document_upload' },
}[gamme]|default(null) %}
{% set avec_fichiers = config_fichiers is not null %}
{% set fichiers_par_salle = {} %}
{% if avec_fichiers %}
    {% for ressource in entite.ressources %}
        {# La ressource porte la salle du Lieu OU celle du Restaurant. #}
        {% set salle_ressource = ressource.salle ?? ressource.restaurantSalle %}
        {% if salle_ressource %}
            {% set cle = salle_ressource.id ~ '' %}
            {% set fichiers_par_salle = fichiers_par_salle|merge({ (cle): fichiers_par_salle[cle]|default(0) + 1 }) %}
        {% endif %}
    {% endfor %}
{% endif %}

{% macro ligne(item, grille, fichiers_par_salle, avec_fichiers) %}
    <fieldset data-form-collection-item
              class="{{ grille }} shrink-0 box-border h-[72px] px-2 py-2 rounded-sm border-0">
        {# Poignée de tri maquette : pas de réordonnancement back — inerte. #}
        <span class="w-6 h-6 flex items-center justify-center cursor-not-allowed text-neutral-300"
              title="En développement" aria-hidden="true">
            <twig:Icon name="arrows-out-cardinal" class="w-6 h-6" />
        </span>
        {# Vignette maquette « Importer » : dépose un fichier rattaché à la
           salle (plan, photo) via le contrôleur salle-plan. Une salle non
           enregistrée n'a pas encore d'identifiant : la vignette reste inerte,
           tout comme les gammes sans flux documentaire par salle. #}
        {% set salle = item.vars.data %}
        {% if avec_fichiers and salle %}
            {% set nb_fichiers = fichiers_par_salle[salle.id ~ '']|default(0) %}
            <label class="w-[81px] h-14 box-border flex items-center justify-center rounded-xs cursor-pointer
                          border-[1.4px] {{ nb_fichiers > 0
                              ? 'border-solid border-primary text-primary'
                              : 'border-dashed border-neutral-300 text-neutral-400 hover:border-primary hover:text-primary' }}"
                  title="{{ nb_fichiers > 0
                      ? nb_fichiers ~ ' fichier(s) rattaché(s) — gérés dans la section Médias'
                      : 'Importer un fichier pour cette salle (plan, photo)' }}"
                  data-salle-plan-vignette>
                <twig:Icon name="image" class="w-[22px] h-[22px]" />
                <twig:Form:FileInput accept="application/pdf,image/jpeg,image/png"
                                     data-action="change->salle-plan#importer"
                                     data-salle-plan-salle-param="{{ salle.id }}" />
            </label>
        {% else %}
            <span class="w-[81px] h-14 box-border flex items-center justify-center rounded-xs
                         border-[1.4px] border-dashed border-neutral-300 cursor-not-allowed"
                  title="{{ avec_fichiers
                      ? 'Enregistrez la salle pour lui associer un fichier'
                      : "L'import de fichier n'est pas disponible pour cette gamme" }}"
                  aria-hidden="true">
                <twig:Icon name="image" class="w-[22px] h-[22px] text-neutral-400" />
            </span>
        {% endif %}
        {{ form_widget(item.nom, { attr: { placeholder: 'Nom de la salle' } }) }}
        {% for capacite in ['superficie', 'capaciteReunion', 'capaciteU', 'capaciteClasse',
                            'capaciteTheatre', 'capaciteCabaret', 'capaciteBanquet',
                            'capaciteCocktail', 'capaciteAuditorium'] %}
            {{ form_widget(attribute(item, capacite)) }}
        {% endfor %}
        {% for equipement in ['lumiereJour', 'accesPmr', 'espaceDansant', 'climatisee'] %}
            <span class="flex justify-center">{{ form_widget(attribute(item, equipement)) }}</span>
        {% endfor %}
        {# La position se gère par l'ordre, pas dans la grille. #}
        {% do item.position.setRendered %}
        <button type="button" data-action="form-collection#remove" aria-label="Supprimer la salle"
                class="flex items-center justify-center shrink-0 w-8 h-8 rounded-full cursor-pointer
                       text-neutral-900 hover:bg-error-pastel">
            <twig:Icon name="trash" class="w-[15px] h-4" />
        </button>
    </fieldset>
{% endmacro %}

{# min-w-0 : un fieldset a min-inline-size:min-content par défaut — sans le
   neutraliser, la matrice (~1550 px) élargit la carte au lieu de défiler. #}
<fieldset class="flex flex-col gap-4 border-0 p-0 m-0 min-w-0"
    data-controller="form-collection{% if avec_fichiers %} salle-plan{% endif %}"
    data-form-collection-index-value="{{ widget|length }}"
    data-form-collection-prototype-value="{{ _self.ligne(widget.vars.prototype, grille, {}, avec_fichiers)|e('html_attr') }}"
    {% if avec_fichiers %}
    data-salle-plan-url-value="{{ config_fichiers.url }}"
    data-salle-plan-formulaire-value="{{ config_fichiers.formulaire }}"
    data-salle-plan-token-value="{{ csrf_token(config_fichiers.formulaire) }}"
    {% endif %}
>
    <legend class="contents"><twig:Typography variant="subtitle" bold element="span">Capacités par salle</twig:Typography></legend>

    {# La matrice fait ~1550 px : elle défile horizontalement plutôt que de se tasser. #}
    <div class="flex flex-col overflow-x-auto scrollbar pb-2">
        <div class="{{ grille }} items-end! px-2 pb-3" role="row">
            <span></span>
            <span></span>
            <span role="columnheader">
                <twig:Typography variant="body-sm" bold>Nom de la salle</twig:Typography>
            </span>
            {% for colonne in [
                ['Surface', 'area'], ['Réunion', 'meeting'], ['En U', 'u-meeting'],
                ['Classe', 'classroom'], ['Théâtre', 'presentation'], ['Cabaret', 'cabaret'],
                ['Banquet', 'banquet'], ['Cocktail', 'cocktail'], ['Auditorium', 'conference'],
                ['Lumière du jour', 'sun'], ['Accès PMR', 'wheel-chair'],
                ['Espace dansant', 'dance'], ['Climatisée', 'wind'],
            ] %}
                <span class="flex flex-col items-center gap-2.5" role="columnheader">
                    <twig:Icon name="{{ colonne.1 }}" class="w-6 h-6 shrink-0 text-neutral-900" />
                    <twig:Typography variant="body-sm" bold center class="text-pretty">{{ colonne.0 }}</twig:Typography>
                </span>
            {% endfor %}
            <span></span>
        </div>

        <div class="h-px min-w-min bg-neutral-300"></div>

        <div class="flex flex-col min-w-min divide-y divide-neutral-200" data-form-collection-target="items">
            {% for item in widget %}
                {{ _self.ligne(item, grille, fichiers_par_salle, avec_fichiers) }}
            {% endfor %}
        </div>
    </div>

    {% if avec_fichiers %}<p class="form-error" hidden data-salle-plan-target="erreur"></p>{% endif %}

    <div class="flex justify-end">
        <twig:Button variant="outline" size="sm" icon="plus" type="button"
                     data-action="form-collection#add" data-remove-label="Retirer">Ajouter une salle</twig:Button>
    </div>

    {# Bandeau maquette « Pré-remplir avec l'IA », branché sur le vrai flux
       d'extraction OCR (la modale propose les valeurs lues, à valider). #}
    <div class="box-border flex flex-col min-[1100px]:flex-row items-start min-[1100px]:items-center
                gap-6 min-[1100px]:gap-10 p-8 rounded-sm bg-old-gold-pastel">
        <div class="flex flex-col flex-1 min-w-0 gap-2">
            <twig:Typography variant="subtitle" bold>Pré-remplir le tableau avec l'IA</twig:Typography>
            <twig:Typography variant="body" class="text-pretty">Importez la brochure commerciale ou la fiche
                technique de l'établissement : l'IA en extrait les salles, leurs surfaces et leurs capacités par
                configuration, puis vous propose chaque valeur — rien n'est écrit sans votre validation.</twig:Typography>
        </div>
        <twig:Modal:TriggerButton variant="outline" size="lg" icon="upload-simple" class="shrink-0"
                                  modalIdentifier="extraction">Importer un fichier</twig:Modal:TriggerButton>
    </div>
</fieldset>
