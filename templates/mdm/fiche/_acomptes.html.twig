{#
    Conditions de paiement de l'acompte (maquette portail) : trois emplacements
    « Ajouter un acompte », chacun = date d'exigibilité (LOV) + pourcentage.
    La case (hors formulaire) ouvre l'emplacement ; la refermer vide ses deux
    champs (data-vider), donc l'acompte disparaît à l'enregistrement.

    Variables : `widgets` — les six champs, date puis pourcentage pour chaque
    emplacement, dans l'ordre (condPaieAccDate1, condPaieAccPourcentage1, …).
#}
{% set par_nom = widgets|reduce((acc, w) => acc|merge({ (w.vars.name): w }), {}) %}
<div class="flex flex-col gap-5">
    <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">
        Jusqu'à trois acomptes : indiquez pour chacun la date d'exigibilité par rapport à l'événement et le pourcentage du montant total.
    </twig:Typography>
    <div class="flex flex-col divide-y divide-neutral-200">
        {% for n in 1..3 %}
            {% set date = par_nom['condPaieAccDate' ~ n] %}
            {% set pourcentage = par_nom['condPaieAccPourcentage' ~ n] %}
            {% set id_case = date.vars.id ~ '_actif' %}
            {% set actif = date.vars.value is not empty or pourcentage.vars.value is not empty %}
            <div class="flex flex-col gap-4 py-4" data-acompte="{{ n }}">
                <label for="{{ id_case }}" class="flex flex-row items-center gap-3 cursor-pointer w-fit">
                    <twig:Form:Checkbox id="{{ id_case }}" name="acompte_actif[{{ n }}]" value="1" :checked="actif" />
                    <twig:Typography variant="body" bold element="span">Ajouter un acompte{{ n > 1 ? ' (' ~ n ~ ')' : '' }}</twig:Typography>
                </label>
                <div class="flex flex-row flex-wrap gap-x-6 gap-y-5 data-[masque]:hidden"
                     data-affichage-conditionnel-target="cible"
                     data-source="{{ id_case }}"
                     data-valeurs="1"
                     data-vider="1">
                    <div class="w-[calc(50%-12px)]">{{ form_row(date) }}</div>
                    <div class="w-[calc(50%-12px)]">{{ form_row(pourcentage) }}</div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
