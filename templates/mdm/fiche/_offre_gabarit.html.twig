{#
    Gabarit d'un emplacement d'offre d'Activité (forfait ou option), rendu
    UNE fois depuis le prototype de la collection `offres` — Symfony refuse
    de rendre deux fois le même champ. Placeholders remplacés par
    _offres_activite : __name__ (clé de la ligne), __type__ (forfait|option),
    __position__ (n° d'emplacement), __libelle__ (« forfait » / « option »).
    Les champs ne sont jamais désactivés (relecture 2026-09-04) : un
    emplacement décoché est vidé et sa ligne vide ignorée à la soumission.

    Variable : `proto` — le FormView prototype de la collection.
#}
{{ form_widget(proto.children.type, { value: '__type__' }) }}
{{ form_widget(proto.children.position, { value: '__position__' }) }}
<div class="w-full">{{ form_row(proto.children.nom, { label: 'Nom __libelle__' }) }}</div>
<div class="w-[calc(50%-12px)]">{{ form_row(proto.children.participantsMin, { label: 'Nombre de participants minimum' }) }}</div>
<div class="w-[calc(50%-12px)]">{{ form_row(proto.children.participantsMax, { label: 'Participants maximum' }) }}</div>
<div class="w-[calc(50%-12px)]">{{ form_row(proto.children.prix, { label: 'Montant HT à partir de (/pers)' }) }}</div>
<div class="w-[calc(50%-12px)]">{{ form_row(proto.children.modeTarification) }}</div>
