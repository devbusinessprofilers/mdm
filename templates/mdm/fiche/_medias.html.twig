{#
    Section « Médias » : onglets, galerie de vignettes et association à une salle.
    Les vignettes de la maquette sont des emplacements vides — aucune image
    n'est fournie par le handoff.
#}
{% set onglets_medias = constant('App\\Pim\\Maquette\\FicheLieuDonnees::ONGLETS_MEDIAS') %}

<div class="flex flex-col gap-6">
    <div class="flex flex-row items-center gap-2 flex-wrap">
        {% for rang, nom in onglets_medias %}
            <button type="button" aria-pressed="{{ rang == 0 ? 'true' : 'false' }}"
                    class="group/onglet shrink-0 px-4 py-2 rounded-lg cursor-pointer
                           aria-pressed:bg-primary-4">
                <twig:Typography variant="body-sm" bold class="whitespace-nowrap
                                 group-aria-pressed/onglet:text-primary-3!">{{ nom }}</twig:Typography>
            </button>
        {% endfor %}
        <span class="flex-1"></span>
        <twig:Typography variant="body-xs" textColor="neutral-400">25 Mo max · 960 × 480 px · format paysage</twig:Typography>
    </div>

    <div class="flex flex-row flex-wrap gap-4">
        {% for rang in 0..11 %}
            <div class="relative w-[152px] h-[104px] shrink-0 flex items-center justify-center rounded-xs
                        bg-primary-5 inset-ring-1
                        {{ rang == 0 ? 'inset-ring-primary' : 'inset-ring-neutral-300' }}">
                {% if rang == 0 %}
                    <span class="absolute top-2 left-2 px-2 py-0.5 rounded-full bg-primary">
                        <twig:Typography variant="body-xs" textColor="neutral-100" bold>Photo principale</twig:Typography>
                    </span>
                {% endif %}
                <twig:Icon name="images" class="w-7 h-7 text-neutral-400" />
            </div>
        {% endfor %}

        <button type="button"
                class="w-[152px] h-[104px] shrink-0 flex flex-col items-center justify-center gap-1.5
                       rounded-xs cursor-pointer bg-neutral-100 inset-ring-1 inset-ring-primary">
            <twig:Icon name="plus" class="w-[22px] h-[22px] text-primary" />
            <twig:Typography variant="body-sm" textColor="primary-3" bold>Ajouter un média</twig:Typography>
        </button>
    </div>

    <div class="flex flex-col gap-1 w-[calc(50%-12px)]">
        <div class="flex flex-row items-center gap-2">
            <span class="w-2 h-2 shrink-0 rounded-full bg-peach"></span>
            <twig:Typography variant="input" element="span"
                             class="text-[0.875rem]! leading-[1.375rem]!">Associer à une salle de réunion</twig:Typography>
        </div>
        <div class="min-h-10 box-border flex items-center gap-2 px-2.5 py-2 rounded-xs
                    bg-primary-5 inset-ring-1 inset-ring-primary">
            <twig:Typography variant="input" class="flex-1 min-w-0">Salle de réunion</twig:Typography>
            <twig:Icon name="caret-down" class="w-4 h-4 shrink-0 text-neutral-500" />
        </div>
    </div>
</div>
