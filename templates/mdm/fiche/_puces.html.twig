{#
    Groupes de puces — section « Services & équipements ».
    Le décompte et l'autorité viennent de la maquette : ces listes sont
    déclarées par le prestataire.
#}
{% for groupe in groupes_puces %}
    {% set cochees = groupe.puces|filter(puce => puce.1)|length %}
    <div class="flex flex-col gap-4">
        <div class="flex flex-row items-center gap-2 flex-wrap">
            <twig:Typography variant="input" element="span"
                             class="text-[0.875rem]! leading-[1.375rem]!">{{ groupe.nom }}</twig:Typography>
            <span class="w-2 h-2 shrink-0 rounded-full bg-peach"></span>
            <span class="shrink-0 px-2 py-0.5 rounded-full bg-error-pastel">
                <twig:Typography variant="body-xs" textColor="peach" bold>Prestataire</twig:Typography>
            </span>
            <span class="flex-1"></span>
            <twig:Typography variant="body-sm" textColor="neutral-500">{{ cochees }} sur {{ groupe.puces|length }} sélectionnés</twig:Typography>
        </div>

        <div class="flex flex-row flex-wrap gap-2.5">
            {% for puce in groupe.puces %}
                <button type="button" aria-pressed="{{ puce.1 ? 'true' : 'false' }}"
                        class="group/puce h-12 box-border shrink-0 flex items-center px-4 py-2 rounded-lg
                               cursor-pointer bg-neutral-100 inset-ring-1 inset-ring-neutral-300
                               aria-pressed:bg-primary aria-pressed:inset-ring-0">
                    <twig:Typography variant="body-sm" bold class="whitespace-nowrap
                                     group-aria-pressed/puce:text-neutral-100!">{{ puce.0 }}</twig:Typography>
                </button>
            {% endfor %}
        </div>
    </div>
{% endfor %}
