{#
    Panneau latéral de la section « Collaborateurs ».

    Deux états dans la maquette : l'invitation par email, puis le formulaire
    complet. Les deux sont rendus ici et c'est le contrôleur `collaborateurs`
    qui bascule de l'un à l'autre — depuis « Continuer » ou depuis le crayon
    d'une ligne du tableau, qui pré-remplit alors les champs.
#}
{% set droits = constant('App\\Pim\\Maquette\\FicheLieuMaquette::DROITS_COLLABORATEUR') %}
{% set email_invitation = constant('App\\Pim\\Maquette\\FicheLieuMaquette::EMAIL_INVITATION') %}
{% set email_brouillon = constant('App\\Pim\\Maquette\\FicheLieuMaquette::EMAIL_BROUILLON') %}

<aside class="w-[420px] shrink-0 box-border flex flex-col gap-5 px-8 py-10 overflow-y-auto
              bg-primary-5 scrollbar"
       aria-label="Ajouter ou modifier un collaborateur">

    {# ------------------------------------------------------ Invitation #}
    <div class="flex flex-col gap-5" data-collaborateurs-target="ajout">
        <div class="flex flex-col items-center gap-2">
            <twig:Icon name="plus" class="w-12 h-12 text-primary" />
            <twig:Typography variant="subtitle" bold class="mt-2">Ajouter un collaborateur</twig:Typography>
            <twig:Typography variant="body-sm" textColor="neutral-500" center
                             class="text-pretty">Renseignez l'adresse professionnelle du collaborateur.
                Il recevra une invitation à rejoindre la fiche et choisira son mot de passe.</twig:Typography>
        </div>

        <div class="flex flex-col gap-1 self-stretch">
            {{ _self.label('Adresse email', true) }}
            <div class="h-10 box-border flex items-center px-3 rounded-xs
                        bg-neutral-100 inset-ring-1 inset-ring-neutral-300">
                <twig:Typography variant="input" textColor="neutral-400">{{ email_brouillon }}</twig:Typography>
            </div>
        </div>

        <twig:Button variant="primary" size="lg" full
                     data-action="collaborateurs#continuer">Continuer</twig:Button>
    </div>

    {# ------------------------------------------------------- Formulaire #}
    <div class="flex flex-col gap-5" data-collaborateurs-target="formulaire" hidden>
        <div class="flex flex-col items-center gap-2">
            <twig:Badge icon="user" class="w-24" />
            <button type="button"
                    class="w-9 h-9 box-border flex items-center justify-center rounded-lg cursor-pointer
                           border-2 border-transparent bg-origin-border bg-clip-padding,border-box
                           bg-[linear-gradient(var(--color-neutral-100),var(--color-neutral-100)),var(--primary-gradient)]
                           text-neutral-900">
                <span class="sr-only">Changer la photo</span>
                <twig:Icon name="pencil" class="w-4 h-4" />
            </button>
        </div>

        {#
            L'email est en lecture seule : c'est la clé de l'invitation, elle
            ne se corrige pas depuis ce panneau.
        #}
        {{ _self.champ('Nom', 'nom') }}
        {{ _self.champ('Prénom', 'prenom') }}
        {{ _self.champ('Email', 'email', email_invitation, true) }}
        {{ _self.champ('Téléphone', 'telephone') }}

        <twig:Typography variant="body-lg" bold class="mt-1">Droits</twig:Typography>

        <div class="flex flex-col gap-1 self-stretch">
            {{ _self.label('Rôle', true) }}
            <div class="h-10 box-border flex items-center gap-2 px-3 rounded-xs cursor-pointer
                        bg-neutral-100 inset-ring-1 inset-ring-neutral-300">
                <twig:Typography variant="input" class="flex-1 min-w-0"
                                 data-collaborateurs-target="role">Manager</twig:Typography>
                <twig:Icon name="caret-down" class="w-4 h-4 shrink-0 text-neutral-900" />
            </div>
        </div>

        <div class="flex flex-row flex-wrap gap-x-4 gap-y-2.5 self-stretch">
            {% for droit in droits %}
                <button type="button" role="checkbox" aria-checked="false"
                        class="group/droit flex items-center gap-2 cursor-pointer"
                        data-action="collaborateurs#basculerDroit">
                    {#
                        Case propre à ce panneau : 18 px et coins à 4, là où la
                        molécule du système fait 20 px à angles vifs.
                    #}
                    <span class="w-[18px] h-[18px] shrink-0 box-border flex items-center justify-center
                                 rounded-[4px] bg-neutral-100 inset-ring-[1.3px] inset-ring-primary
                                 group-aria-checked/droit:bg-primary" aria-hidden="true">
                        <twig:Icon name="check" class="w-3 h-3 text-neutral-100 hidden group-aria-checked/droit:block" />
                    </span>
                    <twig:Typography variant="body-sm" class="whitespace-nowrap">{{ droit }}</twig:Typography>
                </button>
            {% endfor %}
        </div>

        <div class="flex flex-col gap-1.5 self-stretch">
            {{ _self.label('Statut') }}
            <button type="button" role="switch" aria-checked="false"
                    class="group/statut flex items-center gap-2.5 cursor-pointer"
                    data-collaborateurs-target="principal"
                    data-action="collaborateurs#basculerPrincipal">
                {#
                    Interrupteur propre à ce panneau : 38 × 20, sans anneau —
                    celui des disponibilités fait 40 × 24 et porte une bordure.
                #}
                <span class="w-[38px] h-5 shrink-0 box-border flex items-center justify-start p-0.5
                             rounded-lg bg-primary-4
                             group-aria-checked/statut:justify-end group-aria-checked/statut:bg-primary"
                      aria-hidden="true">
                    <span class="w-4 h-4 rounded-lg bg-primary
                                 group-aria-checked/statut:bg-neutral-100"></span>
                </span>
                <twig:Typography variant="body-sm">Contact principal <span class="text-peach">*</span></twig:Typography>
            </button>
        </div>

        <div class="flex flex-col gap-3 self-stretch mt-2">
            <twig:Button variant="primary" size="lg" full
                         data-action="collaborateurs#annuler">Continuer</twig:Button>
            <twig:Button variant="outline" size="lg" full
                         data-action="collaborateurs#annuler">Annuler</twig:Button>
        </div>
    </div>
</aside>

{% macro label(texte, requis = false) %}
    <twig:Typography variant="input" element="span"
                     class="text-[0.875rem]! leading-[1.375rem]!">{{ texte }}{% if requis %} <span class="text-peach">*</span>{% endif %}</twig:Typography>
{% endmacro %}

{% macro champ(libelle, cible, valeur = '', lecture_seule = false) %}
    <div class="flex flex-col gap-1 self-stretch">
        {{ _self.label(libelle, true) }}
        <div class="h-10 box-border flex items-center px-3 rounded-xs
                    {{ lecture_seule ? 'bg-neutral-200' : 'bg-neutral-100 inset-ring-1 inset-ring-neutral-300' }}">
            <twig:Typography variant="input" ellipsis class="flex-1 min-w-0"
                             textColor="{{ valeur is empty or lecture_seule ? 'neutral-400' : 'neutral-900' }}"
                             data-collaborateurs-target="{{ cible }}">{{ valeur }}</twig:Typography>
        </div>
    </div>
{% endmacro %}
