{#
    Menu déroulant — molécule « Menu dropdown ».
    `type` : 'checkboxes' (210 px) ou 'poi' (432 px).
    Le rail de droite est la barre de défilement du composant.
#}
{#
    ÉCART : la molécule fixe 210 px (checkboxes) et 432 px (poi). Le menu prend
    ici la largeur de son champ — sinon il flotte sous un champ trois fois plus
    large et tronque les libellés. Le positionnement absolu et l'ombre portée
    sont ajoutés de même : la molécule est présentée isolée dans la
    bibliothèque, il faut bien l'ancrer sous son champ.
#}
{% macro menu_deroulant(options, type = 'checkboxes') %}
    <div class="absolute top-[calc(100%+4px)] left-0 z-20 flex flex-row items-start box-border
                w-full gap-2 py-4 pl-0 pr-4 rounded-[4px] bg-primary-5 shadow-(--shadow)
                [&[hidden]]:hidden! {{ type == 'poi' ? 'text-neutral-300' : '' }}"
         role="listbox"
         data-bp-select-target="menu"
         hidden>
        {# Le rail de droite est la barre de défilement du composant : la vraie est masquée. #}
        <ul class="flex flex-col items-start self-stretch flex-1 min-w-0 max-h-60 gap-2 m-0 p-0
                   overflow-y-auto list-none [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            {% for option in options %}
                {#
                    Alignement en haut : quand un libellé s'enroule, la case reste
                    en regard de sa première ligne au lieu de se centrer sur tout
                    le bloc. Le libellé s'enroule plutôt que d'être coupé —
                    « Aéroport Inter. Amiens Henry Potez… » se perdait sinon.
                #}
                <li class="w-full shrink-0">
                    <button type="button" role="option"
                            aria-selected="{{ option.selectionnee ? 'true' : 'false' }}"
                            class="group/option flex flex-row items-start box-border w-full gap-2
                                   px-4 py-1 text-left cursor-pointer hover:bg-primary-4
                                   focus-visible:outline-2 focus-visible:outline-primary-3
                                   focus-visible:-outline-offset-2">
                        <span class="relative flex items-center justify-center shrink-0 w-5 h-5 mt-px">
                            <span class="flex items-center justify-center box-border w-5 h-5 rounded-[1px]
                                         inset-ring-1 inset-ring-primary text-neutral-100
                                         group-aria-selected/option:bg-primary">
                                <twig:Icon name="check" class="w-3 h-3 hidden group-aria-selected/option:block" />
                            </span>
                        </span>
                        <twig:Typography variant="body" element="span"
                                         class="relative flex-1 min-w-0 text-pretty">{{ option.libelle }}</twig:Typography>
                    </button>
                </li>
            {% else %}
                <li class="px-4 py-1">
                    <twig:Typography variant="body" textColor="neutral-500">Aucune option disponible</twig:Typography>
                </li>
            {% endfor %}
        </ul>

        <span class="relative self-stretch shrink-0 w-2" aria-hidden="true">
            <span class="absolute inset-0 rounded-b-lg bg-neutral-100"></span>
            <span class="absolute top-0 left-0 w-2 h-[var(--menu-curseur,54%)] rounded-lg bg-primary"></span>
        </span>
    </div>
{% endmacro %}

