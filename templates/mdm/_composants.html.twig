{#
    Composants du back-office MDM.

    Les glyphes sont ceux de `mdm-icons.js` du handoff, eux-mêmes repris des
    Fondations du design system du portail. Mêmes viewBox, mêmes tracés.
#}

{#
    Résout un glyphe par son nom.

    Le design system a livré 16 nouveaux vecteurs (navicons.js) qui prennent le
    pas sur l'ancien jeu — `info`, `bed` et `fork` sont redéfinis. Les glyphes
    non couverts par la nouvelle série restent servis par l'ancien jeu.
#}
{% macro icone(nom) %}
    {% set nouveaux = ['info', 'mappin', 'confetti', 'note', 'bed', 'userrect', 'fork', 'bike',
                       'lectern', 'plant', 'euro', 'images', 'rocket', 'money', 'users', 'layout'] %}
    {% set modale = ['caret', 'caretleft', 'caretright', 'warn', 'search', 'spinner', 'arrowright',
                     'okcircle', 'plus'] %}
    {% if nom in nouveaux %}
        {% import 'mdm/_icones_nav.html.twig' as nav %}
        {{- nav.icone_nav(nom) -}}
    {% elseif nom in modale %}
        {% import 'mdm/_icones_modale.html.twig' as md %}
        {{- md.icone_modale(nom) -}}
    {% else %}
        {{- _self.icone_heritee(nom) -}}
    {% endif %}
{% endmacro %}

