{# Étincelle : tout ce qui relève de l'enrichissement par l'IA. #}
{% macro icone_etincelle() %}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
        <path d="M8 1l1.6 4.4L14 7l-4.4 1.6L8 13l-1.6-4.4L2 7l4.4-1.6L8 1z" fill="currentColor"></path>
    </svg>
{% endmacro %}

{# Cadenas : champ maîtrisé par Salesforce, donc en lecture seule. #}
{% macro icone_verrou() %}
    <svg width="16" height="18" viewBox="0 0 12 14" fill="none" aria-hidden="true" focusable="false">
        <rect x="1" y="6" width="10" height="7" rx="1.6" stroke="currentColor" stroke-width="1.3"></rect>
        <path d="M3.5 6V4a2.5 2.5 0 015 0v2" stroke="currentColor" stroke-width="1.3"></path>
    </svg>
{% endmacro %}

{# Coche fine, utilisée dans les listes d'avantages des formules. #}
{% macro icone_coche_fine() %}
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
        <path d="M13.5 4.5L6.5 11.5L2.5 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
{% endmacro %}

{#
    Barre d'outils d'un champ de texte enrichi : annuler, rétablir, gras,
    italique, alignements, liste à puces, émoji. Reprise telle quelle de la
    maquette — décorative à ce stade, aucun éditeur n'est branché.
#}
{% macro barre_texte_enrichi() %}
    {% import 'mdm/_icones_nav.html.twig' as nav %}
    {#
        Cinq groupes, avec leurs largeurs fixes : annuler/rétablir, gras/italique,
        les quatre alignements, la liste, l'émoji.
    #}
    {% set groupes = [
        { largeur: 56, outils: ['rtundo', 'rtredo'] },
        { largeur: 56, outils: ['rtbold', 'rtital'] },
        { largeur: 120, outils: ['rtleft', 'rtcenter', 'rtright', 'rtjust'] },
        { largeur: 24, outils: ['rtlist'] },
        { largeur: 24, outils: ['rtsmiley'] }
    ] %}
    {% for groupe in groupes %}
        <span class="fiche__outils-groupe" style="width: {{ groupe.largeur }}px">
            {% for outil in groupe.outils %}
                <span class="fiche__outil">{{ nav.icone_nav(outil) }}</span>
            {% endfor %}
        </span>
    {% endfor %}
{% endmacro %}

{#
    Menu déroulant — molécule « Menu dropdown ».
    `type` : 'checkboxes' (210 px) ou 'poi' (432 px).
    Le rail de droite est la barre de défilement du composant.
#}
{% macro menu_deroulant(options, type = 'checkboxes') %}
    <div class="bp-menu {{ type == 'poi' ? 'bp-menu--poi' : '' }}"
         role="listbox"
         data-bp-select-target="menu"
         hidden>
        <ul class="bp-menu__liste">
            {% for option in options %}
                <li>
                    <button class="bp-menu-item"
                            type="button"
                            role="option"
                            aria-selected="{{ option.selectionnee ? 'true' : 'false' }}">
                        <span class="bp-menu-item__icone">
                            <span class="bp-checkbox {{ option.selectionnee ? 'bp-checkbox--cochee' : '' }}">
                                <svg width="9.714" height="6.8" viewBox="0 0 9.714 6.800" fill="none" aria-hidden="true">
                                    <path d="M 9.511 0.199 C 9.782 0.465 9.782 0.896 9.511 1.162 L 3.961 6.601 C 3.69 6.866 3.249 6.866 2.978 6.601 L 0.203 3.881 C -0.068 3.616 -0.068 3.184 0.203 2.919 C 0.474 2.653 0.914 2.653 1.185 2.919 L 3.471 5.156 L 8.531 0.199 C 8.802 -0.066 9.242 -0.066 9.513 0.199 L 9.511 0.199 Z" fill="currentColor" fill-rule="nonzero"></path>
                                </svg>
                            </span>
                        </span>
                        <span class="bp-menu-item__label">{{ option.libelle }}</span>
                    </button>
                </li>
            {% else %}
                <li class="bp-menu__vide">Aucune option disponible</li>
            {% endfor %}
        </ul>

        <span class="bp-menu__barre" aria-hidden="true">
            <span class="bp-menu__barre-piste"></span>
            <span class="bp-menu__barre-curseur"></span>
        </span>
    </div>
{% endmacro %}

{# Chevron des menus déroulants (filtres, vue enregistrée). #}
{% macro chevron() %}
    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true" focusable="false">
        <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
{% endmacro %}

{# Pastille de couleur : typologie de fiche, tonalité d'un compteur. #}
{% macro pastille(couleur, taille = 8) %}
    <span class="mdm-dot" style="--mdm-dot-color: var(--{{ couleur }}); --mdm-dot-size: {{ taille }}px" aria-hidden="true"></span>
{% endmacro %}

{#
    ------------------------------------------------------------------------
    Convention de branchement des liens
    ------------------------------------------------------------------------
    Un écran intégré reçoit son `href` : le lien est un <a> normal.
    Un écran pas encore intégré n'en reçoit pas : on rend un élément inerte
    plutôt qu'un `href="#"`, qui remonterait la page et laisserait croire que
    la destination existe.

    L'apparence au repos est identique dans les deux cas — seuls le curseur et
    l'infobulle changent — pour ne pas s'écarter de la maquette.

    Brancher un nouvel écran = ajouter `href: path('sa_route')` à son appel.
#}

{% macro lien(libelle, classe, href = null) %}
    {% if href %}
        <a class="{{ classe }}" href="{{ href }}">{{ libelle }}</a>
    {% else %}
        <span class="{{ classe }} mdm-lien--a-venir"
              role="link"
              aria-disabled="true"
              title="Écran non encore intégré">{{ libelle }}</span>
    {% endif %}
{% endmacro %}

{# Entrée du rail latéral. #}
{% macro rail_item(libelle, options = {}) %}
    {% import _self as ui %}
    {% set actif = options.actif|default(false) %}
    {% set href = options.href|default(null) %}
    <{{ href ? 'a' : 'span' }}
       class="mdm-rail__item {{ actif ? 'mdm-rail__item--actif' : '' }} {{ href ? '' : 'mdm-lien--a-venir' }}"
       {% if href %}href="{{ href }}"{% else %}role="link" aria-disabled="true" title="Écran non encore intégré"{% endif %}
       {{ actif ? 'aria-current="page"' : '' }}>
        <span class="mdm-rail__icon">{{ ui.icone(options.icone|default('info')) }}</span>
        <span class="mdm-rail__label">{{ libelle }}</span>
        {% if options.compteur is defined %}
            <span class="mdm-rail__count">{{ options.compteur }}</span>
        {% endif %}
    </{{ href ? 'a' : 'span' }}>
{% endmacro %}

{# Entrée de la navigation principale. #}
{% macro nav_item(libelle, actif = false, href = null) %}
    {% if href %}
        <a class="mdm-nav__item {{ actif ? 'mdm-nav__item--actif' : '' }}"
           href="{{ href }}"
           {{ actif ? 'aria-current="page"' : '' }}>{{ libelle }}</a>
    {% else %}
        <span class="mdm-nav__item {{ actif ? 'mdm-nav__item--actif' : '' }} mdm-lien--a-venir"
              role="link"
              aria-disabled="true"
              title="Écran non encore intégré">{{ libelle }}</span>
    {% endif %}
{% endmacro %}
