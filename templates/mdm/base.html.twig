{#
    Coquille du back-office MDM : barre supérieure (composants du portail) +
    zone de contenu défilante. Reprise du vrai front, branchée sur les routes et
    l'utilisateur réels via `EnteteExtension` (fonctions `entete_menu`,
    `entete_utilisateur`, `entete_administration`).

    Les pages remplissent `{% block contenu %}` ; une page qui a besoin d'un rail
    de navigation latéral surcharge `{% block rail %}`.

    TinyMCE (composant `Form:Wysiwyg`) n'est pas chargé ici : son injection
    (sans script inline, interdit par la policy) est traitée avec l'éditeur de
    fiche, seul écran qui l'utilise.
#}
{% extends 'base.html.twig' %}

{# Le vrai front porte son propre en-tête : on neutralise la barre provisoire de base. #}
{% block navbar %}{% endblock %}
{# Les messages flash sont rendus dans la zone de contenu, pas en tête de body. #}
{% block flashes %}{% endblock %}

{% set entete_menu = entete_menu() %}
{% set entete_utilisateur = entete_utilisateur() %}

{% block body_class %}antialiased{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&family=Ubuntu+Sans:wght@400;500;700;800&display=swap">
{% endblock %}

{% block body %}
    <div class="relative flex flex-col h-screen overflow-hidden
                bg-[linear-gradient(180deg,var(--color-primary-5)_0%,var(--color-neutral-100)_100%)]">

        <header class="shrink-0 flex gap-2 xs:gap-8 items-center justify-between px-6 py-4 sm:px-8
                       bg-neutral-100 shadow-(--shadow) z-2 max-h-(--navbar-height)">
            <div class="flex items-center gap-8 min-w-0">
                <twig:Logo class="w-[186px] shrink-0" />
                <twig:Header:Menu items="{{ entete_menu }}"
                                  class="hidden 2xl:block [&_a]:whitespace-nowrap [&_ul]:gap-6" />
            </div>

            <div class="hidden 2xl:flex items-center gap-6 shrink-0">
                {# Recherche : la loupe soumet le formulaire GET vers le
                   référentiel — champ rempli, la recherche part immédiatement
                   (`f[q]`) ; champ vide, on atterrit sur /referentiel nu. #}
                {% set recherche_entete = global_search_form() %}
                {{ form_start(recherche_entete) }}
                    {% do recherche_entete.q.setRendered %}
                    {% do recherche_entete.submit.setRendered %}
                    <div class="flex items-center w-[260px] h-[38px] rounded-full overflow-hidden
                                bg-neutral-100 inset-ring-1 inset-ring-neutral-200
                                focus-within:inset-ring-primary
                                [&>div]:h-full [&>div]:bg-transparent!">
                        <twig:Button variant="text" size="sm" type="submit" icon="magnifying-glass"
                                     title="Rechercher dans le référentiel" aria-label="Rechercher"
                                     class="h-full! px-2.5! rounded-none! hover:bg-primary-4" />
                        <twig:Form:TextInput
                            id="recherche-globale-entete"
                            name="{{ recherche_entete.q.vars.full_name }}"
                            value="{{ recherche_entete.q.vars.value }}"
                            placeholder="nom · ville · identifiant"
                            class="border-0! rounded-none! h-full! pl-0!"
                        />
                    </div>
                {{ form_end(recherche_entete) }}

                <div class="group/profil relative">
                    <twig:Header:Profil user="{{ entete_utilisateur }}"
                                        currentRoute="{{ app.request.attributes.get('_route') }}"
                                        route="app_mdm_espace_travail"
                                        class="group-hover/profil:after:w-full
                                               group-focus-within/profil:after:w-full" />

                    <div class="absolute right-0 top-full z-10 hidden pt-3
                                group-hover/profil:block group-focus-within/profil:block">
                        <div class="w-[264px] flex flex-col rounded-sm bg-neutral-100 shadow-(--shadow)
                                    inset-ring-1 inset-ring-neutral-200 overflow-hidden">

                            <div class="flex flex-col gap-0.5 px-4 py-3 bg-primary-5 border-b border-neutral-200">
                                <twig:Typography variant="body-sm" bold ellipsis>{{ entete_utilisateur.fullName }}</twig:Typography>
                                <twig:Typography variant="body-xs" textColor="neutral-500" ellipsis>{{ entete_utilisateur.job }}</twig:Typography>
                            </div>

                            {% set administration = entete_administration() %}
                            {% if administration is not empty %}
                                <div class="flex flex-col gap-1 p-2">
                                    <twig:Typography variant="body-xs" bold textColor="neutral-500"
                                                     class="px-2 pt-1 pb-0.5 tracking-[0.8px] uppercase">Administration</twig:Typography>

                                    {% for entree in administration %}
                                        <a href="{{ path(entree.2) }}"
                                           class="flex items-center gap-2 px-2 py-1.5 rounded-xs hover:bg-primary-4">
                                            <twig:Icon name="{{ entree.1 }}" aria-hidden="true"
                                                       class="shrink-0 w-4 h-4 text-primary" />
                                            <twig:Typography variant="body-sm" bold textColor="primary-3"
                                                             ellipsis class="min-w-0">{{ entree.0 }}</twig:Typography>
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            <div class="flex flex-col p-2 border-t border-neutral-200">
                                <a href="{{ path('app_mdm_espace_travail') }}"
                                   class="flex items-center gap-2 px-2 py-1.5 rounded-xs hover:bg-primary-4">
                                    <twig:Icon name="user" aria-hidden="true" class="shrink-0 w-4 h-4 text-primary" />
                                    <twig:Typography variant="body-sm" bold textColor="primary-3">Mon espace de travail</twig:Typography>
                                </a>
                                <a href="{{ path('app_signalement_bug') }}"
                                   class="flex items-center gap-2 px-2 py-1.5 rounded-xs hover:bg-primary-4">
                                    <twig:Icon name="warning" aria-hidden="true" class="shrink-0 w-4 h-4 text-error" />
                                    <twig:Typography variant="body-sm" bold textColor="error">Signaler un bug</twig:Typography>
                                </a>
                                <div class="px-2 py-1.5">{{ form(logout_form()) }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <twig:Header:Menu:BurgerMenu items="{{ entete_menu }}" class="2xl:hidden" />
        </header>

        <div class="mdm-main flex flex-1 min-h-0" {% block main_attributs %}{% endblock %}>
            {% block rail %}{% endblock %}

            <div class="flex flex-col flex-1 min-w-0 min-h-0 overflow-y-auto">
                {% block flashes_contenu %}
                    {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="mx-6 mt-4">
                                {# Le ton suit le type : rouge pour l'erreur, ocre pour l'avertissement. #}
                                <twig:Alert icon="{{ type == 'success' ? 'check-circle' : (type in ['error', 'danger'] ? 'cross-circle' : (type == 'warning' ? 'warning' : 'info-circle')) }}"
                                            role="{{ type in ['error', 'danger', 'warning'] ? 'alert' : 'status' }}"
                                            class="{{ type in ['error', 'danger'] ? 'bg-error!' : (type == 'warning' ? 'bg-old-gold!' : '') }}">
                                    {{- message -}}
                                </twig:Alert>
                            </div>
                        {% endfor %}
                    {% endfor %}
                {% endblock %}

                {% block contenu %}{% endblock %}
            </div>
        </div>

    </div>
{% endblock %}
