{#
    Maquette : « Creation fiche » — tunnel de création d'une fiche.

    Écrit avec les composants du portail prestataire et Tailwind. Les
    interrupteurs et les boutons radio sont ceux du design system : ce sont de
    vrais `input`, donc de vraies coutures pour un formulaire.
#}
{% extends 'mdm/base.html.twig' %}

{% set ecran = 'creation' %}

{% block title %}Créer une fiche{% endblock %}

{# Le contrôleur couvre le rail et le contenu : le rail y déclenche des sauts. #}
{% block main_attributs %}data-controller="creation"{% endblock %}

{#
    Le rail de cet écran ne liste pas les sections du référentiel mais les sept
    blocs de la création, avec leur état de remplissage.
#}
{% block rail %}
    <nav class="w-[284px] shrink-0 flex flex-col overflow-hidden bg-neutral-100 border-r border-neutral-200"
         aria-label="Sections de la fiche">

        <div class="shrink-0 flex flex-col gap-[3px] px-4 pt-5 pb-3">
            <span class="px-1 pb-1.5 uppercase tracking-[0.8px]">
                <twig:Typography variant="body-xs" textColor="neutral-500" bold>Sections de la fiche</twig:Typography>
            </span>

            {% for ancre in ancres %}
                <button type="button"
                        class="group/ancre flex items-center gap-2 w-full px-3.5 py-2.5 rounded-xs text-left
                               cursor-pointer aria-current:bg-linear-(--primary-gradient)"
                        data-creation-target="ancre"
                        data-action="creation#aller"
                        data-creation-bloc-param="{{ ancre.index }}"
                        {{ ancre.active ? 'aria-current="true"' : '' }}>
                    <twig:Icon name="{{ ancre.icone }}"
                               class="w-5 h-5 shrink-0 p-0.5 box-border
                                      {{ ancre.verrouillee ? 'text-neutral-400' : 'text-primary' }}
                                      group-aria-current/ancre:text-neutral-100" />
                    <span class="flex-1 min-w-0 truncate">
                        <twig:Typography variant="body-sm" bold
                                         textColor="{{ ancre.verrouillee ? 'neutral-400' : 'neutral-900' }}"
                                         class="group-aria-current/ancre:text-neutral-100!">{{ ancre.libelle }}</twig:Typography>
                    </span>
                    <span class="shrink-0 px-[7px] py-px rounded-full whitespace-nowrap
                                 {{ _self.tonBadge(ancre.ton) }}
                                 group-aria-current/ancre:bg-neutral-100/22!">
                        <twig:Typography variant="body-xs" bold
                                         class="text-[10px]! {{ _self.texteBadge(ancre.ton) }}
                                                group-aria-current/ancre:text-neutral-100!">{{ ancre.badge }}</twig:Typography>
                    </span>
                </button>
            {% endfor %}
        </div>

        <div class="shrink-0 mt-auto mx-4 mb-5 p-3.5 rounded-[12px] bg-primary-4 flex flex-col gap-1.5">
            <twig:Typography variant="body-sm" textColor="primary-3" bold>Enrichissement après création</twig:Typography>
            <twig:Typography variant="body-xs" textColor="neutral-500" class="text-pretty">{{ noteEnrichissement }}</twig:Typography>
        </div>
    </nav>
{% endblock %}

{% block contenu %}
    <div class="flex flex-col flex-1 min-h-0 {{ occupe ? 'relative' : '' }}">

        {# --------------------------------------------------------- En-tête #}
        <div class="shrink-0 flex items-end justify-between gap-6 px-10 pt-[22px] pb-4">
            <div class="flex flex-col gap-1.5 min-w-0">
                <nav class="flex items-center gap-[7px]" aria-label="Fil d'Ariane">
                    <a href="{{ path('app_mdm_referentiel_general') }}">
                        <twig:Typography variant="body-sm" textColor="primary">Référentiel</twig:Typography>
                    </a>
                    <twig:Typography variant="body-sm" textColor="neutral-400" aria-hidden="true">/</twig:Typography>
                    <a href="{{ path('app_mdm_referentiel_general') }}">
                        <twig:Typography variant="body-sm" textColor="primary">Toutes les fiches</twig:Typography>
                    </a>
                    <twig:Typography variant="body-sm" textColor="neutral-400" aria-hidden="true">/</twig:Typography>
                    <twig:Typography variant="body-sm" textColor="neutral-500" bold aria-current="page">Nouvelle fiche</twig:Typography>
                </nav>
                <twig:Typography variant="heading-2" element="h1" bold>Créer une fiche</twig:Typography>
                <twig:Typography variant="body-sm" textColor="neutral-500">{{ sousTitre }}</twig:Typography>
            </div>

            {% if etiquetteBrouillon %}
                <twig:Tag label="{{ etiquetteBrouillon }}" variant="neutral" size="lg" class="shrink-0 rounded-full!" />
            {% endif %}
        </div>

        {# ------------------------------------------------------- Les sept blocs #}
        <div class="flex-1 min-h-0 overflow-y-auto flex flex-col gap-5 px-10 pb-7 scrollbar"
             data-creation-target="defilement">

            {% if banniere.visible %}
                <div class="shrink-0 box-border flex items-start gap-3 px-5 py-4 rounded-[16px]
                            bg-error-pastel inset-ring-1 inset-ring-peach"
                     role="alert" data-creation-target="banniere">
                    <twig:Icon name="warning" class="w-5 h-5 shrink-0 text-error" />
                    <div class="flex flex-col gap-1.5 min-w-0">
                        <twig:Typography variant="body" bold data-creation-target="banniereTitre">{{ banniere.titre }}</twig:Typography>
                        <div class="flex flex-wrap gap-x-4 gap-y-2">
                            {% for champ in banniere.champs %}
                                {# `adresse` disparaît si la zone d'intervention prend sa place. #}
                                <span {% if 'Adresse postale' == champ %}data-champ="adresse"{% endif %}>
                                    <twig:Typography variant="body-sm" textColor="neutral-500">· {{ champ }}</twig:Typography>
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {% for bloc in blocs %}
                <section class="shrink-0 box-border flex flex-col gap-[22px] px-10 py-9 rounded-[32px]
                                bg-neutral-100 shadow-(--shadow) {{ bloc.verrouille ? 'opacity-72' : '' }}"
                         data-creation-target="bloc" data-bloc="{{ bloc.index }}">

                    <div class="flex items-start justify-between gap-5">
                        <div class="flex flex-col gap-1 min-w-0">
                            <div class="flex items-center gap-2.5">
                                <span class="w-[26px] h-[26px] shrink-0 flex items-center justify-center rounded-full
                                             {{ bloc.verrouille ? 'bg-neutral-200' : 'bg-linear-(--primary-gradient)' }}">
                                    <twig:Typography variant="body-sm" bold
                                                     textColor="{{ bloc.verrouille ? 'neutral-400' : 'neutral-100' }}">{{ bloc.numero }}</twig:Typography>
                                </span>
                                <twig:Typography variant="heading-3" element="h2" bold>{{ bloc.titre }}</twig:Typography>
                            </div>
                            <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">{{ bloc.description }}</twig:Typography>
                        </div>
                        {% if bloc.etiquette %}
                            <twig:Tag label="{{ bloc.etiquette }}"
                                      variant="{{ 'erreur' == bloc.etiquetteTon ? 'error' : 'neutral' }}"
                                      size="sm" class="shrink-0" />
                        {% endif %}
                    </div>

                    {% if bloc.verrouille %}
                        <div class="flex items-center gap-2.5 px-4 py-3.5 rounded-[12px] bg-neutral-200">
                            <twig:Icon name="lock" class="w-[18px] h-[18px] shrink-0 text-neutral-400" />
                            <twig:Typography variant="body-sm" textColor="neutral-500">Choisissez d'abord une gamme :
                                elle détermine les champs de ce bloc.</twig:Typography>
                        </div>
                    {% endif %}

                    {# --------------------------------------------------- Gamme #}
                    {% if 'gamme' == bloc.type %}
                        <div class="flex flex-col gap-3.5">
                            <div class="flex flex-row gap-3.5 flex-wrap">
                                {% for g in gammes %}
                                    <a href="{{ path('app_mdm_creation_fiche', { etat: etat.id, gamme: g.id }) }}"
                                       class="group/gamme flex-1 basis-60 min-w-0 box-border flex items-center gap-2.5
                                              px-[18px] py-4 rounded-[16px] text-left
                                              {{ g.active
                                                 ? 'bg-linear-(--primary-gradient) shadow-(--shadow)'
                                                 : 'bg-neutral-100 inset-ring-1 inset-ring-neutral-300' }}">
                                        <twig:Icon name="{{ g.icone }}"
                                                   class="w-6 h-6 shrink-0 p-0.5 box-border
                                                          {{ g.active ? 'text-neutral-100' : 'text-primary' }}" />
                                        <span class="flex flex-col gap-0.5 min-w-0">
                                            <twig:Typography variant="body" bold
                                                             textColor="{{ g.active ? 'neutral-100' : 'neutral-900' }}"
                                                             class="whitespace-nowrap">{{ g.label }}</twig:Typography>
                                            <twig:Typography variant="body-xs"
                                                             textColor="{{ g.active ? 'neutral-100' : 'neutral-400' }}"
                                                             ellipsis
                                                             class="{{ g.active ? 'opacity-82' : '' }}">{{ g.sous }}</twig:Typography>
                                        </span>
                                    </a>
                                {% endfor %}
                            </div>
                            {{ _self.note('info-circle', noteGamme) }}
                        </div>
                    {% endif %}

                    {# --------------------------------- Identité et localisation #}
                    {% if 'identite' == bloc.type %}
                        {#
                            Adresse fixe ou zone d'intervention : sur une gamme
                            mobile les deux blocs sont rendus et le bouton radio
                            montre celui qui vaut. L'attribut porte sur ce qui est
                            affiché, pas sur le choix brut — une gamme non mobile
                            garde son adresse même si l'état porte « zone ».
                        #}
                        <div class="group/identite flex flex-col gap-5"
                             data-creation-target="identite"
                             data-implantation="{{ implantation.affiche }}">

                            <div class="flex flex-row flex-wrap gap-6">
                                <div class="flex flex-col gap-1 w-[calc(50%-12px)]">
                                    {{ _self.label('Nom de la fiche', true) }}
                                    {{ _self.boite(nom.valeur, nom.vide, false, nom.fautif) }}
                                    {% if nom.fautif %}
                                        {{ _self.indice('Le nom est obligatoire.', 'error') }}
                                    {% endif %}
                                </div>

                                <div class="flex flex-col gap-1 w-[calc(50%-12px)]">
                                    {{ _self.label('Référence MDM') }}
                                    {{ _self.boite(reference, false, true) }}
                                    {{ _self.indice('Attribuée automatiquement à la création.') }}
                                </div>
                            </div>

                            {% if implantation.visible %}
                                <div class="flex flex-col gap-2.5">
                                    {{ _self.label("Ce prestataire a-t-il une adresse fixe ?") }}
                                    <div class="flex flex-row gap-7">
                                        <twig:Form:RadioItem id="implantation-fixe" name="implantation"
                                                             checked="{{ 'fixe' == implantation.choix }}"
                                                             data-action="creation#choisirImplantation"
                                                             data-creation-valeur-param="fixe">Implantation fixe</twig:Form:RadioItem>
                                        <twig:Form:RadioItem id="implantation-zone" name="implantation"
                                                             checked="{{ 'zone' == implantation.choix }}"
                                                             data-action="creation#choisirImplantation"
                                                             data-creation-valeur-param="zone">Zone d'intervention</twig:Form:RadioItem>
                                    </div>
                                </div>
                            {% endif %}

                            {% if adresse.rendue %}
                                <div class="flex flex-row flex-wrap gap-6 items-start
                                            group-data-[implantation=zone]/identite:hidden">
                                    <div class="relative flex flex-col gap-1 w-[calc(50%-12px)]">
                                        {{ _self.label('Adresse postale', true) }}
                                        <div class="min-h-10 box-border flex items-center gap-2 px-2.5 py-2 rounded-xs
                                                    bg-primary-5 cursor-text
                                                    {{ adresse.fautif ? 'inset-ring-1 inset-ring-peach' : 'inset-ring-1 inset-ring-primary' }}"
                                             role="button" tabindex="0"
                                             data-action="click->creation#basculerSuggestions">
                                            <twig:Icon name="pin" class="w-4 h-4 shrink-0 text-primary" />
                                            <twig:Typography variant="input"
                                                             textColor="{{ adresse.vide ? 'neutral-400' : 'neutral-900' }}"
                                                             ellipsis class="flex-1 min-w-0">{{ adresse.valeur }}</twig:Typography>
                                        </div>
                                        {{ _self.indice(adresse.indice, adresse.fautif ? 'error' : '') }}

                                        <div class="absolute left-0 right-0 top-[70px] z-5 flex flex-col gap-0.5 p-1.5
                                                    rounded-[12px] bg-neutral-100 shadow-[0_12px_28px_rgba(3,74,94,0.18)]"
                                             data-creation-target="suggestions" hidden>
                                            {% for suggestion in adresse.suggestions %}
                                                <div class="flex items-center gap-2.5 px-2.5 py-2 rounded-xs cursor-pointer
                                                            {{ suggestion.active ? 'bg-primary-4' : '' }}">
                                                    <twig:Icon name="pin"
                                                               class="w-4 h-4 shrink-0 {{ suggestion.active ? 'text-primary' : 'text-neutral-400' }}" />
                                                    <span class="flex flex-col gap-px min-w-0">
                                                        <twig:Typography variant="body-sm" bold
                                                                         textColor="{{ suggestion.active ? 'primary-3' : 'neutral-900' }}">{{ suggestion.titre }}</twig:Typography>
                                                        <twig:Typography variant="body-xs" textColor="neutral-500">{{ suggestion.detail }}</twig:Typography>
                                                    </span>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>

                                    <div class="flex flex-col gap-1 w-[calc(50%-12px)]">
                                        {{ _self.label('Adresse structurée') }}
                                        <div class="box-border flex flex-col gap-0.5 px-3 py-2.5 rounded-xs
                                                    {{ adresse.vide ? 'bg-neutral-200' : 'bg-primary-5 inset-ring-1 inset-ring-primary' }}">
                                            {% for partie in adresse.parties %}
                                                <div class="flex items-baseline gap-2.5">
                                                    <twig:Typography variant="body-xs" textColor="neutral-400"
                                                                     class="shrink-0 w-[92px]">{{ partie.cle }}</twig:Typography>
                                                    <twig:Typography variant="input"
                                                                     textColor="{{ adresse.vide ? 'neutral-400' : 'neutral-900' }}"
                                                                     class="flex-1 min-w-0">{{ partie.valeur }}</twig:Typography>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {% if zone.rendue %}
                                <div class="flex flex-col gap-2.5 group-data-[implantation=fixe]/identite:hidden">
                                    <div class="flex items-baseline justify-between gap-5">
                                        {{ _self.label("Zone d'intervention", true) }}
                                        <twig:Typography variant="body-sm" textColor="primary-3" bold
                                                         data-creation-target="zoneCompte">{{ zone.compte }}</twig:Typography>
                                    </div>
                                    <div class="flex flex-row flex-wrap gap-2.5">
                                        {% for departement in zone.departements %}
                                            <button type="button" role="checkbox"
                                                    aria-checked="{{ departement.active ? 'true' : 'false' }}"
                                                    class="group/dept h-10 box-border shrink-0 flex items-center gap-2
                                                           pl-2.5 pr-4 rounded-full cursor-pointer
                                                           bg-neutral-100 inset-ring-1 inset-ring-neutral-300
                                                           aria-checked:bg-primary aria-checked:inset-ring-0"
                                                    data-action="creation#basculerDepartement">
                                                <span class="shrink-0 px-[7px] py-0.5 rounded-full
                                                             bg-neutral-200 group-aria-checked/dept:bg-neutral-100">
                                                    <twig:Typography variant="body-xs" bold textColor="neutral-500"
                                                                     class="group-aria-checked/dept:text-primary!">{{ departement.numero }}</twig:Typography>
                                                </span>
                                                <twig:Typography variant="body-sm" class="whitespace-nowrap
                                                                 group-aria-checked/dept:font-black
                                                                 group-aria-checked/dept:text-neutral-100!">{{ departement.libelle }}</twig:Typography>
                                            </button>
                                        {% endfor %}
                                    </div>
                                    {{ _self.indice("Un prestataire mobile n'a pas d'adresse publiée : la zone remplace l'adresse sur les canaux.") }}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                    {# ------------------------------------------- Classification #}
                    {% if 'classif' == bloc.type %}
                        <div class="flex flex-col gap-[22px]">
                            {% for groupe in classification %}
                                <div class="flex flex-col gap-2.5">
                                    <div class="flex items-baseline justify-between gap-5">
                                        {{ _self.label(groupe.label) }}
                                        <twig:Typography variant="body-sm" bold
                                                         textColor="{{ groupe.fautif ? 'error' : 'neutral-400' }}"
                                                         data-creation-target="compteClasse">{{ groupe.compte }}</twig:Typography>
                                    </div>
                                    <div class="flex flex-row flex-wrap gap-2.5 {{ groupe.fautif ? 'is-fautif' : '' }}">
                                        {% for puce in groupe.puces %}
                                            <button type="button" role="checkbox"
                                                    aria-checked="{{ puce.active ? 'true' : 'false' }}"
                                                    class="group/puce h-12 box-border shrink-0 flex items-center gap-1
                                                           px-4 py-2 rounded-full cursor-pointer
                                                           bg-neutral-100 inset-ring-1
                                                           {{ groupe.fautif ? 'inset-ring-peach' : 'inset-ring-neutral-300' }}
                                                           aria-checked:bg-primary aria-checked:inset-ring-0"
                                                    data-action="creation#basculerPuce">
                                                <twig:Icon name="check" class="w-4 h-4 shrink-0 text-neutral-100 hidden group-aria-checked/puce:block" />
                                                <twig:Icon name="plus" class="w-4 h-4 shrink-0 text-primary group-aria-checked/puce:hidden" />
                                                <twig:Typography variant="body-sm" bold class="whitespace-nowrap
                                                                 group-aria-checked/puce:text-neutral-100!">{{ puce.libelle }}</twig:Typography>
                                            </button>
                                        {% endfor %}
                                    </div>
                                    {% if groupe.fautif %}
                                        {{ _self.indice('Au moins une valeur est requise.', 'error') }}
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {# ------------------------------------------------- Statut #}
                    {% if 'statut' == bloc.type %}
                        <div class="flex flex-col gap-[18px]">
                            {% for interrupteur in interrupteurs %}
                                <div class="flex items-start gap-3.5">
                                    <twig:Form:SwitchButton id="interrupteur-{{ loop.index }}"
                                                            name="interrupteur-{{ loop.index }}"
                                                            checked="{{ interrupteur.actif }}"
                                                            class="shrink-0" />
                                    <div class="flex flex-col gap-[3px] min-w-0">
                                        <div class="flex items-center gap-2.5">
                                            <twig:Typography variant="body" bold>{{ interrupteur.label }}</twig:Typography>
                                            {% if interrupteur.etiquette %}
                                                <twig:Tag label="{{ interrupteur.etiquette }}" variant="old-gold" size="sm" />
                                            {% endif %}
                                        </div>
                                        <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">{{ interrupteur.aide }}</twig:Typography>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {# --------------------------------------------- Visibilité #}
                    {% if 'visibilite' == bloc.type %}
                        <div class="flex flex-col gap-3.5">
                            <div class="flex items-center gap-4">
                                <div class="flex-1 min-w-0 max-w-[420px] min-h-10 box-border flex items-center gap-2
                                            px-2.5 py-2 rounded-xs bg-primary-5 inset-ring-1 inset-ring-primary">
                                    <twig:Icon name="magnifying-glass" class="w-4 h-4 shrink-0 text-neutral-400" />
                                    <twig:Typography variant="input" textColor="neutral-400">Rechercher un site de diffusion</twig:Typography>
                                </div>
                                <twig:Typography variant="body" textColor="primary-3" bold class="shrink-0"
                                                 data-creation-target="sitesCompte">{{ sites.compte }}</twig:Typography>
                            </div>

                            <div class="flex flex-row flex-wrap gap-2.5" data-creation-target="sitesPuces">
                                {% for puce in sites.puces %}
                                    <twig:Tag label="{{ puce.libelle }}"
                                              variant="{{ puce.active ? 'primary-3' : 'neutral' }}" size="sm" />
                                {% endfor %}
                            </div>

                            <div class="max-h-[226px] overflow-y-auto p-1.5 rounded-[12px]
                                        inset-ring-1 inset-ring-neutral-200 scrollbar">
                                {% for groupe in sites.groupes %}
                                    <div class="flex flex-col gap-0.5 px-1.5 pt-2 pb-2.5">
                                        <div class="flex items-center gap-2.5 px-1.5 pb-1.5">
                                            <span class="uppercase tracking-[0.8px]">
                                                <twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ groupe.nom }}</twig:Typography>
                                            </span>
                                            <span class="flex-1 h-px bg-neutral-200"></span>
                                            <twig:Typography variant="body-xs" textColor="neutral-400" bold
                                                             data-creation-target="compteGroupe">{{ groupe.compte }}</twig:Typography>
                                        </div>
                                        <div class="flex flex-row flex-wrap">
                                            {% for site in groupe.sites %}
                                                <button type="button" role="checkbox"
                                                        aria-checked="{{ site.retenu ? 'true' : 'false' }}"
                                                        {{ site.verrouille ? 'data-verrouille="1" aria-disabled="true"' : '' }}
                                                        class="group/site w-1/4 box-border flex items-center gap-2
                                                               px-2 py-[7px] rounded-xs text-left
                                                               {{ site.verrouille ? 'cursor-default' : 'cursor-pointer' }}"
                                                        data-libelle="{{ site.libelle }}"
                                                        data-action="creation#basculerSite">
                                                    <span class="w-5 h-5 shrink-0 box-border flex items-center justify-center rounded-xs
                                                                 bg-neutral-100 inset-ring-1 inset-ring-neutral-400
                                                                 group-aria-checked/site:bg-primary group-aria-checked/site:inset-ring-0
                                                                 {{ site.verrouille ? 'bg-neutral-400! inset-ring-0!' : '' }}">
                                                        <twig:Icon name="check" class="w-3.5 h-3.5 text-neutral-100 hidden group-aria-checked/site:block" />
                                                    </span>
                                                    <twig:Typography variant="body-sm" textColor="neutral-500" ellipsis
                                                                     class="flex-1 min-w-0 group-aria-checked/site:font-black
                                                                            group-aria-checked/site:text-neutral-900!">{{ site.libelle }}</twig:Typography>
                                                    {% if site.mention %}
                                                        <twig:Tag label="{{ site.mention }}"
                                                                  variant="{{ 'payant' == site.mention ? 'old-gold' : 'primary-3' }}"
                                                                  size="sm" class="shrink-0" />
                                                    {% endif %}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {# ----------------------------------- Contact prestataire #}
                    {% if 'contact' == bloc.type %}
                        <div class="group/contact flex flex-col gap-[18px]"
                             data-creation-target="contact"
                             data-repli="{{ contact.repli ? '1' : '0' }}">
                            <button type="button" role="checkbox"
                                    aria-checked="{{ contact.repli ? 'true' : 'false' }}"
                                    class="group/repli flex items-start gap-3 px-4 py-3.5 rounded-[12px] text-left
                                           cursor-pointer bg-neutral-200 aria-checked:bg-primary-4"
                                    data-action="creation#basculerRepli">
                                <span class="w-5 h-5 shrink-0 box-border flex items-center justify-center rounded-xs
                                             bg-neutral-100 inset-ring-1 inset-ring-neutral-400
                                             group-aria-checked/repli:bg-primary group-aria-checked/repli:inset-ring-0">
                                    <twig:Icon name="check" class="w-3.5 h-3.5 text-neutral-100 hidden group-aria-checked/repli:block" />
                                </span>
                                <span class="flex flex-col gap-[3px] min-w-0 text-left">
                                    <twig:Typography variant="body" bold>Utiliser le contact de repli Business Profilers</twig:Typography>
                                    <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">{{ contact.aide }}</twig:Typography>
                                </span>
                            </button>

                            <div class="flex flex-row flex-wrap gap-6">
                                {% for champ in contact.champs %}
                                    <div class="flex flex-col gap-1 w-[calc(50%-12px)]">
                                        {{ _self.label(champ.label, false, contact.repli) }}
                                        {{ _self.boite(champ.valeur, champ.vide, contact.repli, champ.fautif, contact.repli) }}
                                        {% if champ.indice %}
                                            {{ _self.indice(champ.indice, champ.indiceTon) }}
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>

                            {{ _self.note('users', contact.note) }}
                        </div>
                    {% endif %}

                    {# ---------------------------------------- Accès extranet #}
                    {% if 'acces' == bloc.type %}
                        <div class="flex flex-col gap-[18px]">
                            <div class="flex flex-col gap-3">
                                {% for option in acces.options %}
                                    <button type="button" role="radio"
                                            aria-checked="{{ option.active ? 'true' : 'false' }}"
                                            {{ option.inerte ? 'aria-disabled="true"' : '' }}
                                            class="group/acces flex items-start gap-2.5 text-left
                                                   {{ option.inerte ? 'cursor-default' : 'cursor-pointer' }}"
                                            data-action="creation#choisirAcces">
                                        <span class="w-5 h-5 shrink-0 box-border flex items-center justify-center rounded-full
                                                     {{ option.inerte ? 'bg-neutral-200 inset-ring-1 inset-ring-neutral-300'
                                                                      : 'bg-neutral-100 inset-ring-1 inset-ring-primary' }}">
                                            <span class="block w-2.5 h-2.5 rounded-full
                                                         {{ option.inerte ? 'bg-neutral-400' : 'bg-primary' }}
                                                         group-aria-checked/acces:opacity-100 opacity-0"></span>
                                        </span>
                                        <span class="flex flex-col gap-0.5 min-w-0 text-left">
                                            <twig:Typography variant="body" bold
                                                             textColor="{{ option.inerte ? 'neutral-400' : 'neutral-900' }}">{{ option.label }}</twig:Typography>
                                            <twig:Typography variant="body-sm" textColor="neutral-400" data-aide>{{ option.aide }}</twig:Typography>
                                        </span>
                                    </button>
                                {% endfor %}
                            </div>

                            <div class="flex flex-col gap-1 w-[calc(50%-12px)]">
                                {{ _self.label("Trame d'email", false, not acces.trame.actif) }}
                                <div class="min-h-10 box-border flex items-center gap-2 px-2.5 py-2 rounded-xs
                                            {{ acces.trame.actif ? 'bg-primary-5 inset-ring-1 inset-ring-primary' : 'bg-neutral-200' }}">
                                    <twig:Typography variant="input"
                                                     textColor="{{ acces.trame.actif ? 'neutral-900' : 'neutral-500' }}"
                                                     ellipsis class="flex-1 min-w-0"
                                                     data-creation-target="trame">{{ acces.trame.valeur }}</twig:Typography>
                                    <twig:Icon name="caret-down" class="w-4 h-4 shrink-0 text-neutral-500" />
                                </div>
                                {{ _self.indice(acces.trame.indice, '', 'trameIndice') }}
                            </div>
                        </div>
                    {% endif %}

                </section>
            {% endfor %}
        </div>

        {# ------------------------------------------------ Barre d'actions #}
        <div class="shrink-0 min-h-[76px] box-border flex items-center justify-between gap-6 px-10
                    bg-neutral-100 border-t border-neutral-200 shadow-[0_-6px_18px_rgba(51,38,174,0.06)]">
            <div class="flex items-center flex-1 min-w-0 gap-2.5">
                <twig:Icon name="{{ barre.icone }}"
                           class="w-[18px] h-[18px] shrink-0 {{ _self.tonBarre(barre.ton) }}" />
                <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">{{ barre.note }}</twig:Typography>
            </div>
            <div class="flex items-center shrink-0 gap-3">
                <twig:Button variant="text" size="md" disabled="{{ occupe }}" textColor="neutral-500">Annuler</twig:Button>
                <twig:Button variant="text" size="md" disabled="{{ occupe or not choisie }}" textColor="neutral-500">Enregistrer comme brouillon</twig:Button>
                <twig:Button variant="outline" size="md" disabled="{{ occupe or not choisie }}">Créer et enchaîner</twig:Button>
                <twig:Button variant="primary" size="md" disabled="{{ occupe or not choisie }}"
                             icon="{{ occupe ? 'spinner' : 'arrow-right' }}">{{ barre.libellePrincipal }}</twig:Button>
            </div>
        </div>

        {# ------------------------------------------- Voile de création #}
        {% if occupe %}
            <div class="absolute inset-0 z-6 grid place-items-center bg-neutral-200/55"
                 role="status" aria-live="polite">
                <div class="w-[min(420px,calc(100vw-48px))] box-border flex flex-col items-center gap-3.5
                            px-[34px] py-7 rounded-[20px] bg-neutral-100 shadow-[0_8px_24px_rgba(51,38,174,0.16)]">
                    <twig:Icon name="spinner" class="w-[34px] h-[34px] text-primary animate-spin" />
                    <twig:Typography variant="heading-3" bold>Création de la fiche</twig:Typography>
                    <div class="flex flex-col gap-2 w-full">
                        {% for etape in etapesCreation %}
                            <div class="flex items-center gap-2.5">
                                <twig:Icon name="{{ _self.icôneEtape(etape.etat) }}"
                                           class="w-4 h-4 shrink-0 {{ _self.tonEtape(etape.etat) }}" />
                                <twig:Typography variant="body-sm"
                                                 bold="{{ 'attente' != etape.etat }}"
                                                 textColor="{{ 'attente' == etape.etat ? 'neutral-400' : 'neutral-900' }}">{{ etape.libelle }}</twig:Typography>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="w-full h-1.5 rounded-full bg-neutral-200 overflow-hidden">
                        <div class="w-[62%] h-full rounded-full bg-linear-(--primary-gradient)"></div>
                    </div>
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}

{# ------------------------------------------------------------- Macros #}

{% macro label(texte, requis = false, grise = false) %}
    <twig:Typography variant="input" element="span"
                     textColor="{{ grise ? 'neutral-400' : 'neutral-900' }}"
                     class="text-[0.875rem]! leading-[1.375rem]!">{{ texte }}{% if requis %} <span class="text-peach">*</span>{% endif %}</twig:Typography>
{% endmacro %}

{#
    La boîte de champ du portail : 40 de haut, fond bleuté, anneau turquoise.
    Les champs de cet écran sont des libellés, pas des `input` : le composant
    `Form:TextInput` attend une valeur saisissable, la forme est donc reprise.
#}
{% macro boite(valeur, vide = false, lecture = false, fautif = false, cadenas = false) %}
    <div class="min-h-10 box-border flex items-center gap-2 px-2.5 py-2 rounded-xs
                {{ lecture ? 'bg-neutral-200' : 'bg-primary-5' }}
                {{ lecture ? '' : (fautif ? 'inset-ring-1 inset-ring-peach' : 'inset-ring-1 inset-ring-primary') }}">
        <twig:Typography variant="input" ellipsis class="flex-1 min-w-0"
                         textColor="{{ vide ? 'neutral-400' : (lecture ? 'neutral-500' : 'neutral-900') }}">{{ valeur }}</twig:Typography>
        {% if cadenas %}
            <twig:Icon name="lock" class="w-3.5 h-3.5 shrink-0 text-neutral-400" />
        {% endif %}
    </div>
{% endmacro %}

{% macro indice(texte, ton = '', cible = null) %}
    <twig:Typography variant="body-xs"
                     textColor="{{ 'error' == ton ? 'error' : ('attention' == ton ? 'neutral-500' : 'neutral-400') }}"
                     data-creation-target="{{ cible }}">{{ texte }}</twig:Typography>
{% endmacro %}

{% macro note(icone, texte) %}
    <div class="flex items-start gap-2.5">
        <twig:Icon name="{{ icone }}" class="w-4 h-4 shrink-0 text-neutral-400" />
        <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">{{ texte }}</twig:Typography>
    </div>
{% endmacro %}

{% macro tonBadge(ton) %}
    {%- if 'ok' == ton -%}bg-success-pastel
    {%- elseif 'erreur' == ton -%}bg-error-pastel
    {%- else -%}bg-neutral-200
    {%- endif -%}
{% endmacro %}

{% macro texteBadge(ton) %}
    {%- if 'ok' == ton -%}text-success!
    {%- elseif 'erreur' == ton -%}text-error!
    {%- else -%}text-neutral-400!
    {%- endif -%}
{% endmacro %}

{% macro tonBarre(ton) %}
    {%- if 'pret' == ton -%}text-success
    {%- elseif 'erreur' == ton -%}text-error
    {%- elseif 'occupe' == ton -%}text-primary animate-spin
    {%- else -%}text-neutral-400
    {%- endif -%}
{% endmacro %}

{% macro icôneEtape(etat) %}
    {%- if 'faite' == etat -%}check-circle
    {%- elseif 'encours' == etat -%}spinner
    {%- else -%}caret-right
    {%- endif -%}
{% endmacro %}

{% macro tonEtape(etat) %}
    {%- if 'faite' == etat -%}text-success
    {%- elseif 'encours' == etat -%}text-primary animate-spin
    {%- else -%}text-neutral-300
    {%- endif -%}
{% endmacro %}
