{% extends 'mdm/base.html.twig' %}

{# Éditeur de fiche par sections, toutes gammes — c'est LA vue de fiche (les
   anciennes vues « voir » et « modifier » de /admin ont été fusionnées ici).
   Gabarit sobre : structure et fonctionnement de la maquette, le style
   viendra du front. #}

{% macro collection(field, title) %}
    <fieldset
        data-controller="form-collection"
        data-form-collection-index-value="{{ field|length }}"
        data-form-collection-prototype-value="{{ form_widget(field.vars.prototype)|e('html_attr') }}"
    >
        <legend>{{ title }}</legend>
        <div data-form-collection-target="items">
            {% for item in field %}
                <fieldset data-form-collection-item>
                    {{ form_widget(item) }}
                    <button type="button" data-action="form-collection#remove">Retirer</button>
                </fieldset>
            {% endfor %}
        </div>
        <button type="button" data-action="form-collection#add" data-remove-label="Retirer">Ajouter</button>
    </fieldset>
{% endmacro %}

{% block title %}{{ fiche.label ?? 'Fiche' }} · {{ section.titre }}{% endblock %}

{% set statut_libelles = {
    'en_cours': 'En cours',
    'en_attente_validation': 'En attente',
    'validee': 'Validée',
    'publiee': 'Publiée',
    'archivee': 'Archivée',
} %}

{% block body %}
<main class="page">
    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-kicker">Fiche</p>
            <h1>{{ fiche.label ?? 'Sans libellé' }}</h1>
            <p class="page-description">
                {{ entete.reference }} · v{{ entete.version }}
                · <span class="badge {{ entete.statut == 'publiee' ? 'badge-success' : (entete.statut == 'archivee' ? 'badge-neutral' : 'badge-info') }}">{{ statut_libelles[entete.statut] ?? entete.statut }}</span>
                · Complétude {{ entete.completude }} %
            </p>
            {% include 'dam/_fiche_alerts.html.twig' %}
        </div>
        <div class="table-actions">
            <a class="btn btn-secondary btn-small" href="{{ liens.ocr }}">Extraire d'un document</a>
            <a class="btn btn-secondary btn-small" href="{{ liens.traductions }}">Traductions</a>
            <a class="btn btn-secondary btn-small" href="{{ liens.historique }}">Historique complet</a>
        </div>
    </header>

    <div class="table-actions">
        {% for nom, action in actions %}
            {% set attribut = {'submit': 'FICHE_SUBMIT', 'validate': 'FICHE_VALIDATE', 'reject': 'FICHE_VALIDATE', 'publish': 'FICHE_PUBLISH', 'archive': 'FICHE_ARCHIVE'}[nom] %}
            {% if is_granted(attribut, fiche) %}{{ form(action) }}{% endif %}
        {% endfor %}
        {% if is_granted('FICHE_DELETE', fiche) %}<div class="danger-form">{{ form(action_suppression) }}</div>{% endif %}
    </div>

    <div class="admin-grid">
        <aside>
            <nav class="card" aria-label="Sections de la fiche">
                <h2>Ma fiche</h2>
                <ul>
                    {% for onglet in onglets %}
                        <li>
                            <a class="text-link" href="{{ onglet.url }}"
                               {% if onglet.actif %}aria-current="page"{% endif %}>
                                {{ onglet.actif ? '▸ ' : '' }}{{ onglet.titre }}
                            </a>
                            {% if onglet.completude is not null %}<small>{{ onglet.completude }} %</small>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        </aside>

        <section class="card">
            <h2>{{ section.titre }}{% if onglets[section_index].completude is not null %} <small>{{ onglets[section_index].completude }} % complété</small>{% endif %}</h2>

            {% if section.champs is not empty %}
                {{ form_start(form) }}
                    {% for champ in section.champs %}
                        {% set widget = attribute(form, champ) %}
                        {% if widget.vars.prototype is defined %}
                            {{ _self.collection(widget, widget.vars.label ?? champ) }}
                        {% else %}
                            {{ form_row(widget) }}
                        {% endif %}
                    {% endfor %}
                    {# Le jeton CSRF doit voyager avec la soumission partielle. #}
                    {{ form_widget(form._token) }}
                    {{ form_row(form.submit, {label: 'Enregistrer la section'}) }}
                {{ form_end(form, {render_rest: false}) }}
            {% endif %}

            {% if 'suggestions_attente' in section.blocs and suggestions_attente is not null %}
                <h3>Suggestions en attente</h3>
                <p class="page-description">
                    Corrections et enrichissements proposés par les vérifications automatiques, à arbitrer — Accepter les applique immédiatement à la fiche.
                </p>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Source</th>
                            <th>Champ</th>
                            <th>Valeur actuelle</th>
                            <th>Proposition</th>
                            <th>Confiance</th>
                            {% if is_granted('ROLE_BP_VALIDATOR') %}<th></th><th></th>{% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for ligne in suggestions_attente.lignes %}
                            <tr>
                                <td>{{ ligne.source }}</td>
                                <th scope="row">{{ ligne.label }}</th>
                                <td>{{ ligne.actuel != '' ? ligne.actuel : '—' }}</td>
                                <td>{{ ligne.valeur }}</td>
                                <td>{% if ligne.confiance is not null %}{{ ligne.confiance }} %{% else %}—{% endif %}</td>
                                {% if is_granted('ROLE_BP_VALIDATOR') %}
                                    <td>{% if ligne.accepter is not null %}{{ form(ligne.accepter) }}{% endif %}</td>
                                    <td>{{ form(ligne.ignorer) }}</td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr><td class="empty-state" colspan="{{ is_granted('ROLE_BP_VALIDATOR') ? 7 : 5 }}">Aucune suggestion en attente sur cette fiche.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% if suggestions_attente.lignes is not empty and not is_granted('ROLE_BP_VALIDATOR') %}
                    <p class="page-description">L'arbitrage des suggestions est réservé aux validateurs.</p>
                {% endif %}
                {% if suggestions_attente.lignes|filter(l => l.source == 'Geoapify')|length > 0 %}
                    <p class="page-description"><small>Adresse vérifiée par Geoapify — données © OpenStreetMap contributors.</small></p>
                {% endif %}
            {% endif %}

            {% if 'medias' in section.blocs and medias %}
                {% if medias.gamme == 'lieu' %}
                    {% include 'pim/lieu/_medias.html.twig' with medias.vars %}
                {% else %}
                    {% include 'pim/_documents_gamme.html.twig' with medias.vars %}
                {% endif %}
            {% endif %}

            {% if 'collaborateurs' in section.blocs %}
                {% set peut_gerer = is_granted('FICHE_MANAGE_AFFILIATIONS', fiche) %}
                <div class="table-shell"><div class="table-scroll"><table class="data-table">
                    <thead><tr><th>Nom</th><th>Email</th><th>Téléphone</th><th>Rôle · drapeaux</th>{% if peut_gerer %}<th></th>{% endif %}</tr></thead>
                    <tbody>
                    {% for ligne in affiliations %}
                        {% set affiliation = ligne.affiliation %}
                        <tr>
                            <td>{{ affiliation.collaborateur.firstName }} {{ affiliation.collaborateur.lastName }}</td>
                            <td>{{ affiliation.collaborateur.email }}</td>
                            <td>{{ affiliation.collaborateur.phone ?? '—' }}</td>
                            <td>
                                {% if peut_gerer %}
                                    {{ form(ligne.edition) }}
                                {% else %}
                                    <span class="badge badge-neutral">{{ affiliation.role.value }}</span>
                                    {% if affiliation.receivesRequests %}<span class="badge badge-info">contact principal</span>{% endif %}
                                    {% if affiliation.repli %}<span class="badge badge-warning">repli</span>{% endif %}
                                {% endif %}
                            </td>
                            {% if peut_gerer %}<td>{{ form(ligne.suppression) }}</td>{% endif %}
                        </tr>
                    {% else %}
                        <tr><td class="empty-state" colspan="{{ peut_gerer ? 5 : 4 }}">Aucun collaborateur affilié.</td></tr>
                    {% endfor %}
                    </tbody>
                </table></div></div>
                {% if peut_gerer and form_invitation %}
                    <h3>Inviter un collaborateur</h3>
                    <p class="page-description">L'email est la clé : une adresse déjà connue rattache le collaborateur existant. La marketplace crée le compte et envoie le mail d'accès.</p>
                    {{ form(form_invitation) }}
                {% else %}
                    <p class="page-description">La gestion des collaborateurs est réservée aux validateurs.</p>
                {% endif %}
            {% endif %}

            {% if 'sites' in section.blocs %}
                <h3>Sites de diffusion</h3>
                <p class="page-description">Les sites obligatoires restent cochés ; les sites payants sont signalés.</p>
                {{ form(form_sites) }}
            {% endif %}

            {% if 'salesforce' in section.blocs %}
                <h3>Données Salesforce</h3>
                {% if salesforce %}
                    <p class="page-description">
                        Lecture seule — rafraîchies chaque nuit depuis Salesforce et diffusées sur la marketplace.
                        Dernier rafraîchissement : {{ salesforce.refreshedAt|date('d/m/Y H:i') }}.
                    </p>
                    <table class="data-table">
                        <tbody>
                            <tr><th scope="row">Note RSE globale</th><td>{{ salesforce.noteGlobale ?? '—' }}</td></tr>
                            <tr><th scope="row">RSE — Achats responsables</th><td>{{ salesforce.noteAchatsResponsables ?? '—' }}</td></tr>
                            <tr><th scope="row">RSE — Impact environnemental</th><td>{{ salesforce.noteImpactEnvironnemental ?? '—' }}</td></tr>
                            <tr><th scope="row">RSE — Impact social</th><td>{{ salesforce.noteImpactSocial ?? '—' }}</td></tr>
                            <tr><th scope="row">RSE — Mobilité</th><td>{{ salesforce.noteMobilite ?? '—' }}</td></tr>
                            <tr><th scope="row">RSE — Labels et démarche qualité</th><td>{{ salesforce.noteLabelsEtDemarcheQualite ?? '—' }}</td></tr>
                            <tr><th scope="row">Évaluation client</th><td>{{ salesforce.evaluationClient ?? '—' }}</td></tr>
                            <tr><th scope="row">Procédure judiciaire</th><td>{{ salesforce.procedureJudiciaire ?? '—' }}</td></tr>
                            <tr><th scope="row">Contrats avec comptes</th><td>{{ salesforce.contratsComptes is not empty ? salesforce.contratsComptes|join(', ') : '—' }}</td></tr>
                        </tbody>
                    </table>
                    <p class="page-description">Le statut « Partenaire BP » de cette fiche est également piloté par Salesforce.</p>
                {% else %}
                    <p class="page-description">Fiche inconnue de Salesforce : aucune donnée RSE, évaluation ou statut partenaire n'en est reçue.</p>
                {% endif %}
            {% endif %}

            {% if 'suggestions' in section.blocs %}
                {% set extraction_statuts = {
                    'queued': 'En file',
                    'processing': 'Lecture en cours',
                    'ready': 'À valider',
                    'partially_reviewed': 'Partiellement validée',
                    'reviewed': 'Validée',
                    'failed': 'En échec',
                } %}
                <h3>Extraire d'un document</h3>
                {% if not extraction.active %}
                    <p class="page-description">L'extraction de documents n'est pas activée sur cet environnement.</p>
                {% elseif extraction.en_cours %}
                    {# Temps 2 — la lecture court en tâche de fond : on suit, on ne redépose pas. #}
                    {% set en_cours = extraction.en_cours %}
                    <div class="card">
                        <p>
                            <strong>{{ en_cours.document.originalFilename }}</strong>
                            · <span class="badge badge-info">{{ extraction_statuts[en_cours.status.value] ?? en_cours.status.value }}</span>
                            {% if en_cours.pageCount %} · {{ en_cours.pageCount }} page{{ en_cours.pageCount > 1 ? 's' : '' }}{% endif %}
                        </p>
                        <p class="page-description">
                            Déposé par {{ en_cours.createdBy }} le {{ en_cours.createdAt|date('d/m/Y à H:i') }}.
                            La lecture peut prendre plusieurs minutes — vous pouvez continuer à travailler,
                            les valeurs lues vous attendront ici.
                        </p>
                    </div>
                    <p class="page-description">Vous pourrez déposer un autre document quand cette lecture sera terminée.</p>
                    <a class="btn btn-secondary btn-small" href="{{ onglets[section_index].url }}">Actualiser</a>
                {% elseif extraction.form_depot and is_granted('FICHE_EDIT', fiche) %}
                    {# Temps 1 — le dépôt. #}
                    <p class="page-description">
                        Déposez une plaquette, un devis ou un plan (PDF). L'IA en lit les valeurs et vous
                        les propose — rien n'est écrit dans la fiche sans votre accord, champ par champ.
                    </p>
                    {{ form(extraction.form_depot) }}
                {% endif %}

                {% if extraction.active and extraction.a_revoir %}
                    {# Temps 3 — l'humain valide champ par champ ; la provenance est la page du document. #}
                    <h3>Valider les valeurs lues</h3>
                    <p class="page-description">
                        {{ extraction.a_revoir.document.originalFilename }} ·
                        {{ extraction.a_revoir.suggestions|filter(s => s.isPending)|length }} valeur(s) à arbitrer.
                        Le document reste attaché à la fiche comme pièce justificative.
                    </p>
                    {% if is_granted('ROLE_BP_VALIDATOR') %}
                        {% set form_revue = extraction.form_revue %}
                        {{ form_start(form_revue) }}
                            {{ form_widget(form_revue.fiche_version) }}
                            {{ form_widget(form_revue._token) }}
                            <div class="table-shell"><div class="table-scroll"><table class="data-table">
                                <thead><tr><th>Champ</th><th>Valeur actuelle</th><th>Valeur lue (corrigible)</th><th>Confiance</th><th>Pages</th><th>Décision</th></tr></thead>
                                <tbody>
                                {% for suggestion in extraction.a_revoir.suggestions|filter(s => s.isPending) %}
                                    {% set ligne = attribute(form_revue, suggestion.id) %}
                                    <tr>
                                        <td><strong>{{ suggestion.label }}</strong><br><small>{{ suggestion.fieldPath }}</small></td>
                                        <td>{{ suggestion.observedValue is iterable ? suggestion.observedValue|json_encode : (suggestion.observedValue ?? 'Champ vide') }}</td>
                                        <td>{{ form_widget(ligne.value) }}</td>
                                        <td>{{ suggestion.confidence is null ? '—' : (suggestion.confidence * 100)|number_format(0) ~ ' %' }}</td>
                                        <td>{{ suggestion.pageReferences|map(p => 'p. ' ~ p)|join(', ') ?: '—' }}</td>
                                        <td>{{ form_row(ligne.accept) }}{{ form_row(ligne.reject) }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table></div></div>
                            {{ form_row(form_revue.save, {label: 'Appliquer les décisions'}) }}
                        {{ form_end(form_revue, {render_rest: false}) }}
                    {% else %}
                        <p class="page-description">La validation des valeurs lues est réservée aux validateurs.</p>
                    {% endif %}
                {% endif %}

                <h3>Extractions de la fiche</h3>
                {% if extractions is not empty %}
                    <ul>
                        {% for ligne_extraction in extractions %}
                            <li>
                                <a class="text-link" href="{{ path('app_ocr_show', {id: fiche.idString, extractionId: ligne_extraction.id}) }}">{{ ligne_extraction.document.originalFilename }}</a>
                                · {{ extraction_statuts[ligne_extraction.status.value] ?? ligne_extraction.status.value }}
                                · {{ ligne_extraction.suggestionCount|default('—') }} valeur(s)
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="page-description">Aucune extraction pour cette fiche.</p>
                {% endif %}
                <a class="text-link" href="{{ liens.ocr_admin }}">Écran complet des extractions</a>
            {% endif %}

            {% if 'historique' in section.blocs %}
                <h3>Dernières modifications</h3>
                {% if historique is not empty %}
                    <ul>
                        {% for revision in historique %}
                            <li>{{ revision.createdAt|date('d/m/Y H:i') }} · {{ revision.action }} · {{ revision.actor }} <small>({{ revision.source }})</small></li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="page-description">Aucune modification enregistrée.</p>
                {% endif %}
                <a class="btn btn-secondary btn-small" href="{{ liens.historique }}">Historique complet et restauration</a>
            {% endif %}
        </section>
    </div>
</main>
{% endblock %}
