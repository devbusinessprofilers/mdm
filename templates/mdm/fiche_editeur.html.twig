{% extends 'mdm/base.html.twig' %}

{#
    Éditeur de fiche, toutes gammes — toutes les sections sont rendues dans la
    page, dans UN SEUL formulaire : les onglets du rail basculent les volets
    côté client (contrôleur `fiche-onglets`) sans recharger, les saisies des
    autres onglets sont conservées, et la barre épinglée « Enregistrer »
    (FloatSubmit, comme la maquette) soumet le tout. Les blocs à formulaires
    propres (suggestions, médias, collaborateurs, sites, Salesforce, OCR,
    historique) vivent dans des volets séparés, HORS du formulaire principal.

    Sans JavaScript, les entrées du rail restent des liens `?section=N`.
#}

{% set statut_libelles = {
    'en_cours': 'En cours', 'en_attente_validation': 'En attente',
    'validee': 'Validée', 'publiee': 'Publiée', 'archivee': 'Archivée',
} %}
{% set statut_variante = {
    'publiee': 'success', 'validee': 'primary-3',
    'en_attente_validation': 'old-gold', 'archivee': 'neutral', 'en_cours': 'neutral',
} %}
{% set extraction_statuts = {
    'queued': 'En file', 'processing': 'Lecture en cours', 'ready': 'À valider',
    'partially_reviewed': 'Partiellement validée', 'reviewed': 'Validée', 'failed': 'En échec',
} %}
{% set actions_audit = {
    'create': 'Création', 'update': 'Modification', 'submission': 'Soumission',
    'validation': 'Validation', 'publication': 'Publication', 'rejection': 'Refus',
    'archive': 'Archivage', 'restore': 'Restauration',
} %}
{# Cases « porte d'entrée » (l'établissement dispose de…) : elles ouvrent leur
   bloc en pleine largeur au lieu de rejoindre la pile de cases en pied. #}
{% set cases_en_tete = ['chambreHebergement', 'salleReunionExist'] %}
{# Cases rendues à leur position dans l'ordre des champs de la section, au lieu
   de la pile de pied : l'accessibilité PMR précède la collection Accès. #}
{% set cases_en_ligne = ['pmrAcces', 'accesPmr', 'toilettesPmr'] %}

{% block title %}{{ fiche.label ?? 'Fiche' }} · {{ section.titre }}{% endblock %}

{#
    Collections de formulaire — le contrôleur Stimulus form-collection ajoute et
    retire les lignes. Ces attributs sont exigés par la policy des templates.
#}
{# Titre en `subtitle` gras + bouton d'ajout sur la même rangée, sans encadré :
   c'est la hiérarchie de la maquette (« Périodes de fermeture », « Accès »…). #}
{% macro collection(field, title) %}
    {# Le bloc Accès embarque en plus le bouton « Suggérer les accès »
       (contrôleur acces-suggestion, porté par la rangée d'en-tête : la policy
       fige `data-controller="form-collection"` sur le fieldset) : les entrées
       trouvées autour du GPS de la fiche arrivent comme lignes pré-remplies
       de la collection. #}
    {% set avec_suggestion = field.vars.name == 'acces' %}
    <fieldset class="flex flex-col gap-4 border-0 p-0 m-0"
        data-controller="form-collection"
        data-form-collection-index-value="{{ field|length }}"
        data-form-collection-prototype-value="{{ form_widget(field.vars.prototype)|e('html_attr') }}"
    >
        <div class="flex flex-row items-center gap-6"{% if avec_suggestion %} data-controller="acces-suggestion"{% endif %}>
            <legend class="contents"><twig:Typography variant="subtitle" bold element="span">{{ title }}{% if field.vars.obligatoire|default(false) %} *{% endif %}</twig:Typography></legend>
            <span class="flex-1"></span>
            {% if avec_suggestion %}
                <span data-acces-suggestion-target="statut" class="hidden antialiased text-[0.625rem] leading-[1rem] font-sans text-red-600"></span>
                <twig:Button variant="outline" size="sm" type="button"
                    data-acces-suggestion-target="bouton"
                    data-action="acces-suggestion#suggerer"
                    data-remove-label="Retirer">Suggérer les accès</twig:Button>
            {% endif %}
            <twig:Button variant="outline" size="sm" icon="plus" type="button" data-action="form-collection#add" data-remove-label="Retirer">Ajouter</twig:Button>
        </div>
        {% if field.vars.help|default(null) %}
            <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty -mt-2">{{ field.vars.help }}</twig:Typography>
        {% endif %}
        <div class="flex flex-col gap-3" data-form-collection-target="items">
            {% for item in field %}
                <fieldset data-form-collection-item class="flex items-start gap-2 border-0 p-0 m-0">
                    <div class="flex-1">{{ form_widget(item) }}</div>
                    <twig:Button variant="outline" size="sm" type="button" data-action="form-collection#remove">Retirer</twig:Button>
                </fieldset>
            {% endfor %}
        </div>
    </fieldset>
{% endmacro %}

{#
    Carte déclarative (FicheSectionsCatalogue, clé `cartes`) : la grille
    maquette à 2 ou 3 colonnes. Les groupes sont aplatis (noms de soumission
    inchangés), un champ riche / dropzone / zone de texte / groupe ou listé
    dans `pleins` prend toute la largeur, les cases à cocher passent en fin de
    carte sauf celles de `cases_en_ligne`. `conditions` (nom => {source,
    valeurs, vider}) enveloppe un champ dans une cible du contrôleur
    affichage-conditionnel, pilotée par le widget `source` (chemin pointé).
#}
{% macro carte_champs(form, widgets, colonnes, pleins, cases_en_ligne, conditions) %}
    {% set largeur = colonnes == 3 ? 'w-[calc(33.333%-16px)]' : 'w-[calc(50%-12px)]' %}
    {% set aplatis = widgets|reduce(
        (acc, w) => w.vars.compound|default(false)
            and w.vars.prototype is not defined
            and not w.vars.expanded|default(false)
            ? w.children|reduce((a, e) => a|merge([e]), acc)
            : acc|merge([w]),
        []) %}
    <div class="flex flex-row flex-wrap gap-x-6 gap-y-5">
        {% for widget in aplatis|filter(w => 'checkbox' not in w.vars.block_prefixes or w.vars.name in cases_en_ligne) %}
            {% set champ = widget.vars.name %}
            {# `pleins` liste des chemins pointés : seule la feuille compte. #}
            {% set pleine = widget.vars.prototype is defined
                or widget.vars.attr['data-wysiwyg']|default(false)
                or widget.vars.attr['data-dropzone']|default(false)
                or 'textarea' in widget.vars.block_prefixes
                or champ in pleins|map(p => p|split('.')|last) %}
            {% set classe = pleine ? 'w-full' : largeur %}
            {% set condition = conditions[champ]|default(null) %}
            {% if condition %}
                {% set source = condition.source|split('.')|reduce((f, p) => attribute(f, p), form) %}
                <div class="{{ classe }} data-[masque]:hidden"
                     data-affichage-conditionnel-target="cible"
                     data-source="{{ source.vars.id }}"
                     data-valeurs="{{ condition.valeurs }}"
                     {% if condition.vider|default(false) %}data-vider="1"{% endif %}>
                    {% if widget.vars.prototype is defined %}
                        {{ _self.collection(widget, widget.vars.label ?? champ) }}
                    {% else %}
                        {{ form_row(widget) }}
                    {% endif %}
                </div>
            {% elseif widget.vars.prototype is defined %}
                <div class="w-full">{{ _self.collection(widget, widget.vars.label ?? champ) }}</div>
            {% else %}
                {{ form_row(widget, { row_attr: { class: classe } }) }}
            {% endif %}
        {% endfor %}
        {% for widget in aplatis|filter(w => 'checkbox' in w.vars.block_prefixes and w.vars.name not in cases_en_ligne) %}
            {{ form_row(widget, { row_attr: { class: largeur } }) }}
        {% endfor %}
    </div>
{% endmacro %}

{# Carte « Disponibilités » d'une gamme à champs plats : les champs simples
   (privatisations…) en grille, puis les horaires par jour et les périodes de
   fermeture (partials partagés avec le Lieu). #}
{% macro carte_horaires(form, widgets, colonnes, cases_en_ligne) %}
    {% set w_jours = widgets|reduce((acc, w) => w.vars.name == 'joursOuverture' ? w : acc, null) %}
    {% set w_horaires = widgets|reduce((acc, w) => w.vars.name == 'horairesJours' ? w : acc, null) %}
    {% set w_periodes = widgets|reduce((acc, w) => w.vars.name == 'periodesFermeture' ? w : acc, null) %}
    {% set simples = widgets|filter(w => w.vars.name not in ['joursOuverture', 'horairesJours', 'periodesFermeture']) %}
    {% if simples|length > 0 %}
        {{ _self.carte_champs(form, simples, colonnes, [], cases_en_ligne, {}) }}
    {% endif %}
    {% if w_jours is not null and w_horaires is not null %}
        {% include 'mdm/fiche/_horaires_jours.html.twig' with { jours: w_jours, horaires: w_horaires } only %}
    {% endif %}
    {% if w_periodes is not null %}
        {% include 'mdm/fiche/_periodes_fermeture.html.twig' with { periodes: w_periodes } only %}
    {% endif %}
{% endmacro %}

{# Une entrée du rail : l'état actif est porté par aria-current (piloté par le
   contrôleur `fiche-onglets` — les styles suivent via les variantes de groupe). #}
{% macro rail_entree(onglet) %}
    <li>
        <a href="{{ onglet.url }}" {% if onglet.actif %}aria-current="page"{% endif %}
           data-fiche-onglets-target="entree" data-action="fiche-onglets#activer"
           data-fiche-onglets-volet-param="{{ onglet.index }}"
           class="group/entree flex items-center gap-2 mx-3 px-4 rounded-xs overflow-hidden
                  py-[clamp(2px,calc(2px+(100vh-640px)*0.0227),12px)]
                  hover:bg-primary-4
                  aria-[current=page]:bg-linear-(--primary-gradient) aria-[current=page]:hover:bg-none">
            <twig:Icon name="{{ onglet.icone }}" aria-hidden="true"
                       class="shrink-0 w-5 h-5 text-primary group-aria-[current=page]/entree:text-neutral-100" />
            <twig:Typography variant="body" bold ellipsis textColor="primary-3"
                             class="flex-1 min-w-0 group-aria-[current=page]/entree:text-neutral-100!">{{ onglet.titre }}</twig:Typography>
            {% if onglet.completude is not null %}
                <twig:Typography variant="body-xs" bold textColor="neutral-500"
                                 class="shrink-0 px-2 py-0.5 rounded-full bg-neutral-200
                                        group-aria-[current=page]/entree:bg-neutral-100/22 group-aria-[current=page]/entree:text-neutral-100!">{{ onglet.completude }} %</twig:Typography>
            {% endif %}
        </a>
    </li>
{% endmacro %}

{# Volet d'une section : visible seulement quand son onglet est actif. #}
{# `condition` (optionnel) : la carte entière devient une cible du contrôleur
   affichage-conditionnel (data-masque, indépendant du `hidden` des onglets). #}
{% macro volet_ouvre(i, actif, condition = null) %}
    <section data-fiche-onglets-target="volet" data-volet="{{ i }}" {{ actif ? '' : 'hidden' }}
             {% if condition %}data-affichage-conditionnel-target="cible" data-source="{{ condition.source }}" data-valeurs="{{ condition.valeurs }}"{% if condition.vider %} data-vider="1"{% endif %}{% endif %}
             class="shrink-0 box-border flex flex-col gap-6 p-14 rounded-[32px] bg-neutral-100 shadow-(--shadow) data-[masque]:hidden">
{% endmacro %}

{# En-tête de carte maquette : titre, compteur de champs, légende des autorités —
   la légende explique la pastille et le badge que le thème pose sur chaque champ. #}
{% macro volet_titre(titre, completude, nb = null, avec_legende = false) %}
    <div class="flex flex-row items-center gap-6 flex-wrap">
        <twig:Typography variant="heading-3" element="h2" class="grow font-[700]!">{{ titre }}</twig:Typography>
        {% if nb %}
            <twig:Typography variant="heading-3" textColor="neutral-400">{{ nb }}</twig:Typography>
        {% endif %}
        {% if avec_legende %}
            <div class="flex flex-row items-center gap-5 flex-wrap">
                {{ _self.legende('bg-primary', 'Maîtrisé par le MDM') }}
                {{ _self.legende('bg-primary-3', 'Lecture seule · Salesforce') }}
                {{ _self.legende('bg-peach', 'Déclaré par le prestataire') }}
            </div>
        {% elseif completude is not null %}
            <twig:Typography variant="body-sm" textColor="neutral-500">{{ completude }} % complété</twig:Typography>
        {% endif %}
    </div>
{% endmacro %}

{% macro legende(fond, texte) %}
    <span class="flex items-center gap-2">
        <span class="w-[9px] h-[9px] shrink-0 rounded-full {{ fond }}"></span>
        <twig:Typography variant="body-sm" textColor="neutral-500">{{ texte }}</twig:Typography>
    </span>
{% endmacro %}

{# Pastille de droit du tableau des collaborateurs : partagée avec l'admin. #}
{% import 'shared/_macros_collaborateurs.html.twig' as collab %}

{# Le contrôleur des onglets couvre le rail et les volets. #}
{% block main_attributs %}data-controller="fiche-onglets"{% endblock %}

{# ------------------------------------------------------------------ Rail des sections #}
{# Le rail ne défile jamais : les espacements se resserrent quand la fenêtre
   raccourcit (clamp sur les gaps et le py des entrées, comme la maquette). #}
{% block rail %}
{% set groupes_rail = {
    'Ma fiche': onglets|filter(o => o.groupe == 'ma_fiche'),
    'Paramètres': onglets|filter(o => o.groupe == 'parametres'),
} %}
<nav class="w-[328px] shrink-0 flex flex-col overflow-hidden bg-neutral-100 border-r border-neutral-200
            py-[clamp(6px,calc(6px+(100vh-640px)*0.05),28px)]
            gap-[clamp(6px,calc(6px+(100vh-640px)*0.0455),26px)]"
     aria-label="Sections de la fiche">
    {% for titre, groupe in groupes_rail %}
        {% if groupe is not empty %}
            <div class="flex flex-col shrink-0 gap-[clamp(2px,calc(2px+(100vh-640px)*0.0136),8px)]">
                <span class="pl-4 pr-4">
                    <twig:Typography variant="body-sm" textColor="neutral-900" bold>{{ titre }}</twig:Typography>
                </span>
                <ul class="flex flex-col">
                    {% for onglet in groupe %}{{ _self.rail_entree(onglet) }}{% endfor %}
                </ul>
            </div>
        {% endif %}
    {% endfor %}
</nav>
{% endblock %}

{# ------------------------------------------------------------------ Contenu #}
{% block contenu %}
<main class="flex flex-col h-full min-h-0">
  <div class="flex-1 min-h-0 overflow-y-auto scrollbar flex flex-col gap-6 pl-7 pr-8 pt-8">

    {# En-tête de fiche : identité et jauge à gauche, actions de barre à droite. #}
    <div class="shrink-0 flex flex-col gap-3">
        <div class="flex flex-row items-center gap-8">
            <div class="flex flex-col gap-1 grow min-w-0">
                <div class="flex flex-row items-center gap-3 flex-wrap">
                    {# 26 px / 34 en Ubuntu 700, comme la maquette (le palier sm
                       de heading-2 pousse à 32/40 et bold donne 900). #}
                    <twig:Typography variant="heading-2" element="h1"
                                     class="sm:text-[1.625rem]! sm:leading-[2.125rem]! font-[700]!">{{ fiche.label ?? 'Sans libellé' }}</twig:Typography>
                    <twig:Tag label="{{ entete.fusion ? 'Fusionnée' : (statut_libelles[entete.statut] ?? entete.statut) }}" variant="{{ statut_variante[entete.statut] ?? 'neutral' }}" size="sm" />
                    <twig:Tag label="{{ entete.reference }} · v{{ entete.version }}" variant="neutral" size="sm" />
                </div>
                <div class="flex flex-row items-center gap-4">
                    <twig:Typography variant="body" bold class="shrink-0">Complété à : {{ entete.completude }} %</twig:Typography>
                    <twig:ProgressBar :value="entete.completude" large class="grow min-w-0" />
                </div>
                {# Motif de refus : visible tant que la fiche n'est pas re-soumise ni validée. #}
                {% if entete.message_refus %}
                    <twig:Typography variant="body-sm" textColor="error" bold class="mt-1">Fiche refusée : {{ entete.message_refus }}</twig:Typography>
                {% endif %}
                {# Fiche absorbée par une fusion : archivée, avec le pourquoi et la survivante. #}
                {% if entete.fusion %}
                    <twig:Typography variant="body-sm" bold class="mt-1">
                        Fiche fusionnée dans
                        {% if entete.fusion.url %}
                            <a href="{{ entete.fusion.url }}" class="underline text-primary-3">{{ entete.fusion.label }}</a>.
                        {% else %}
                            «&nbsp;{{ entete.fusion.label }}&nbsp;».
                        {% endif %}
                        Désarchiver cette fiche efface cette mention.
                    </twig:Typography>
                {% endif %}
                {# Référence en clair : point d'ancrage des tests, hors mise en page maquette. #}
                <p class="page-description sr-only">{{ entete.reference }} · v{{ entete.version }} · {{ statut_libelles[entete.statut] ?? entete.statut }} · Complété à {{ entete.completude }} %</p>
            </div>
            {# Le bloc d'actions se replie en deux rangées plutôt que de passer sous le titre. #}
            <div class="flex flex-row items-center justify-end gap-2 shrink-0 flex-wrap max-w-[620px] [&_form]:contents">
                {# Enrichissement à la demande : toutes les sources actives sur cette fiche (asynchrone). #}
                {{ form(action_enrichir) }}
                {# Ouvre la modale d'extraction (le flux OCR réel), comme la maquette. #}
                <twig:Modal:TriggerButton variant="outline" size="md" icon="upload-simple"
                                          class="[&>:first-child]:size-5"
                                          modalIdentifier="extraction">Extraire d'un document</twig:Modal:TriggerButton>
                <twig:Button variant="outline" size="md" asLink href="{{ liens.traductions }}">Traductions</twig:Button>
                {# Actions secondaires regroupées : l'en-tête reste lisible. Le
                   déclencheur reprend le gabarit outline md des boutons voisins
                   (le composant Dropdown rend son propre <button>). #}
                <twig:Dropdown
                    wrapperClass="shrink-0"
                    class="flex items-center focus:outline-none cursor-pointer w-fit rounded-lg justify-center gap-1 border-2 bg-border-primary-gradient bg-border-hover-primary-gradient bg-border-focus-primary-gradient hover:text-neutral-100 focus:text-neutral-100 px-3.5 py-2 h-fit xs:h-[40px]"
                    containerClass="z-50 min-w-56 rounded-xs py-2 flex flex-col items-stretch text-left [&_form]:contents [&_button]:w-full [&_button]:justify-start! [&_button:hover]:bg-neutral-200 [&_a:hover]:bg-neutral-200"
                >
                    <twig:block name="trigger">
                        <twig:Typography variant="button" element="span" bold>Autres actions</twig:Typography>
                    </twig:block>
                    <a href="{{ liens.historique }}" class="px-3.5 py-2"><twig:Typography variant="button" element="span" bold>Historique</twig:Typography></a>
                    {# Envoi immédiat de la fiche vers Salesforce (visible si la synchro CSV est configurée). #}
                    {% if salesforce_envoi %}{{ form(salesforce_envoi) }}{% endif %}
                    {% if is_granted('FICHE_DELETE', fiche) %}
                        {# Suppression définitive de la fiche (confirmation demandée) : item en rouge. #}
                        <span class="danger-form contents [&_button_span]:text-error!">{{ form(action_suppression) }}</span>
                    {% endif %}
                </twig:Dropdown>
            </div>
        </div>

        {% include 'dam/_fiche_alerts.html.twig' %}

        {# Refus avec motif : réservé aux validateurs quand la fiche est en attente. #}
        {% if actions.reject is defined and is_granted('FICHE_VALIDATE', fiche) %}
            <details class="rounded-md bg-neutral-100 shadow-(--shadow) px-4 py-3">
                <summary class="cursor-pointer"><twig:Typography variant="body-sm" bold element="span">Refuser la fiche (motif obligatoire)</twig:Typography></summary>
                <div class="pt-3 max-w-[560px]">{{ form(actions.reject) }}</div>
            </details>
        {% endif %}
    </div>

    <span data-fiche-onglets-haut></span>

    {# ---------------- Volets de champs : un seul formulaire pour toutes les sections #}
    {# Chrome « autorité » par champ : ce thème ne s'applique qu'ici. #}
    {% form_theme form 'pim/form/_form-theme-fiche.html.twig' %}
    {# affichage-conditionnel : cibles (cartes ou champs) montrées selon la
       valeur d'un champ source, dans toutes les sections du formulaire. #}
    {{ form_start(form, { attr: {
        id: 'form-fiche',
        class: 'contents',
        'data-controller': 'affichage-conditionnel',
        'data-action': 'change->affichage-conditionnel#maj',
        'data-fiche-gamme': gamme_slug,
        'data-fiche-id': fiche.idString,
        'data-fiche-suggerer-url': path('app_pim_fiche_suggerer'),
        'data-fiche-suggerer-csrf': suggestion_csrf,
        'data-fiche-suggerer-acces-url': path('app_pim_fiche_suggerer_acces'),
        'data-fiche-suggerer-acces-csrf': acces_suggestion_csrf,
        'data-ia-suggestion-active': ia_suggestion_active ? '1' : '0',
    } }) }}
        {% for i, s in sections %}
            {% if s.champs is not empty and s.cartes is defined %}
                {# ---- Cartes déclaratives (gammes alignées sur la maquette portail) ---- #}
                {% for carte in s.cartes %}
                    {% set widgets = carte.champs|map(c => c|split('.')|reduce((f, p) => attribute(f, p), form)) %}
                    {% set bloc = carte.bloc|default(null) %}
                    {% set condition = carte.condition|default(null) %}
                    {{ _self.volet_ouvre(i, i == section_index, condition ? {
                        source: condition.source|split('.')|reduce((f, p) => attribute(f, p), form).vars.id,
                        valeurs: condition.valeurs,
                        vider: condition.vider|default(false),
                    } : null) }}
                        {{ _self.volet_titre(carte.titre ?? s.titre, loop.first ? onglets[i].completude : null, loop.first ? s.nb_champs|default(null) : null, loop.first) }}
                        {% if carte.intro|default(null) %}
                            <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty -mt-3">{{ carte.intro }}</twig:Typography>
                        {% endif %}
                        {% if bloc == 'horaires' %}
                            {{ _self.carte_horaires(form, widgets, carte.colonnes|default(2), cases_en_ligne) }}
                        {% elseif bloc == 'salles' %}
                            {# min-w-0 : la matrice défile au lieu d'élargir la carte. #}
                            <div class="w-full min-w-0">{% include 'mdm/fiche/_capacites.html.twig' with { widget: widgets|first, gamme: fiche.type.value } only %}</div>
                        {% elseif bloc == 'collection' %}
                            {% for widget in widgets %}
                                {{ _self.collection(widget, widget.vars.label ?? widget.vars.name) }}
                            {% endfor %}
                        {% elseif bloc == 'tarifs_restaurant' %}
                            {% include 'mdm/fiche/_tarifs_restaurant.html.twig' with { widgets: widgets } only %}
                        {% elseif bloc == 'offres_activite' %}
                            {% include 'mdm/fiche/_offres_activite.html.twig' with { widget: widgets|first } only %}
                        {% else %}
                            {{ _self.carte_champs(form, widgets, carte.colonnes|default(2), carte.pleins|default([]), cases_en_ligne, carte.conditions|default({})) }}
                        {% endif %}
                    </section>
                {% endfor %}
            {% elseif s.champs is not empty %}
                {{ _self.volet_ouvre(i, i == section_index) }}
                    {{ _self.volet_titre(s.titre, onglets[i].completude, s.nb_champs|default(null), true) }}
                    {# Grille maquette : champ simple en demi-largeur, riche/groupe/collection en
                       pleine largeur ; les cases à cocher passent toutes SOUS les autres champs,
                       deux par rangée en demi-largeur (même règle dans le form_rows de
                       _form-theme-fiche). Le libellé d'un groupe de premier niveau est tu :
                       la carte porte déjà le titre. #}
                    <div class="flex flex-row flex-wrap gap-x-6 gap-y-5">
                        {# Les groupes de premier niveau sont aplatis dans la grille de la
                           section (les noms de soumission ne changent pas) : leurs cases à
                           cocher rejoignent ainsi la pile de fin de section — ERP sous
                           Téléphone. Les sections à bloc spécialisé gardent leurs groupes
                           entiers, leurs partials attendent le widget complet. #}
                        {# Un champ peut être une feuille pointée (`groupe.champ`) : la
                           résolution traverse le formulaire, les noms de soumission ne
                           changent pas. Les widgets visés par un partial spécialisé
                           (puces, disponibilités) restent entiers. #}
                        {% set widgets_section = s.champs|map(c => c|split('.')|reduce((f, p) => attribute(f, p), form))|reduce(
                            (acc, w) => w.vars.compound|default(false)
                                and w.vars.prototype is not defined
                                and not w.vars.expanded|default(false)
                                and 'puces' not in s.blocs
                                and w.vars.name != 'disponibilites'
                                ? w.children|reduce((a, e) => a|merge([e]), acc)
                                : acc|merge([w]),
                            []) %}
                        {# Disponibilités et périodes de fermeture : sous la grille, comme
                           la carte annexe de la maquette. Les noms couvrent le compound
                           du Lieu et les champs à plat du Restaurant. #}
                        {% set noms_annexes = ['disponibilites', 'periodesFermeture', 'privatisationTotale', 'privatisationPartielle', 'horairesJours', 'joursOuverture'] %}
                        {% set widgets_annexes = 'disponibilites' in s.blocs
                            ? widgets_section|filter(w => w.vars.name in noms_annexes)
                            : [] %}
                        {% set widgets_section = 'disponibilites' in s.blocs
                            ? widgets_section|filter(w => w.vars.name not in noms_annexes)
                            : widgets_section %}
                        {% for widget in widgets_section|filter(w => 'checkbox' in w.vars.block_prefixes and w.vars.name in cases_en_tete) %}
                            <div class="w-full">{{ form_row(widget) }}</div>
                        {% endfor %}
                        {% for widget in widgets_section|filter(w => 'checkbox' not in w.vars.block_prefixes or w.vars.name in cases_en_ligne) %}
                            {% set champ = widget.vars.name %}
                            {# Les blocs spécialisés passent AVANT la branche collection
                               générique : `salles` est aussi une collection et serait
                               sinon avalée par elle (matrice jamais rendue). #}
                            {% if 'capacites' in s.blocs and champ == 'salles' %}
                                {# min-w-0 : autorise l'item flex à rétrécir pour que la
                                   matrice défile au lieu d'élargir la carte. La gamme
                                   choisit le flux documentaire de l'import par salle. #}
                                <div class="w-full min-w-0">{% include 'mdm/fiche/_capacites.html.twig' with { widget: widget, gamme: fiche.type.value } only %}</div>
                            {% elseif 'puces' in s.blocs %}
                                <div class="w-full">{% include 'mdm/fiche/_puces.html.twig' with { widget: widget } only %}</div>
                            {% elseif widget.vars.prototype is defined %}
                                <div class="w-full">{{ _self.collection(widget, widget.vars.label ?? champ) }}</div>
                            {% else %}
                                {% set est_groupe = widget.vars.compound|default(false) and not widget.vars.expanded|default(false) %}
                                {% set pleine = est_groupe
                                    or widget.vars.attr['data-wysiwyg']|default(false)
                                    or widget.vars.attr['data-dropzone']|default(false)
                                    or 'textarea' in widget.vars.block_prefixes %}
                                {% set rangee = { class: pleine ? 'w-full' : 'w-[calc(50%-12px)]' } %}
                                {# label: false seulement pour les groupes — un label: null
                                   écraserait le libellé configuré du champ. #}
                                {% if est_groupe %}
                                    {{ form_row(widget, { row_attr: rangee, label: false }) }}
                                {% else %}
                                    {{ form_row(widget, { row_attr: rangee }) }}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                        {# Cases en demi-largeur dans le flux : deux par rangée, alignées
                           sur la grille des champs — la dernière reste seule sur sa
                           ligne quand le compte est impair. #}
                        {% for widget in widgets_section|filter(w => 'checkbox' in w.vars.block_prefixes and w.vars.name not in cases_en_tete and w.vars.name not in cases_en_ligne) %}
                            {{ form_row(widget, { row_attr: { class: 'w-[calc(50%-12px)]' } }) }}
                        {% endfor %}
                    </div>
                </section>

                {# Carte annexe maquette : les disponibilités et fermetures ont
                   leur propre carte blanche sous celle des champs. Le Lieu passe
                   par son partial (compound + horaires par jour) ; les autres
                   gammes rendent leurs champs à plat, périodes comprises. #}
                {% if widgets_annexes|length > 0 %}
                    {{ _self.volet_ouvre(i, i == section_index) }}
                        {{ _self.volet_titre('Disponibilités', null) }}
                        {# reduce, pas first|default : une collection VIDE est un
                           FormView Countable à zéro, que default() remplacerait. #}
                        {% set w_dispo = widgets_annexes|reduce((acc, w) => w.vars.name == 'disponibilites' ? w : acc, null) %}
                        {% set w_periodes = widgets_annexes|reduce((acc, w) => w.vars.name == 'periodesFermeture' ? w : acc, null) %}
                        {% if w_dispo is not null %}
                            {% include 'mdm/fiche/_disponibilites.html.twig' with { widget: w_dispo, periodes: w_periodes } only %}
                        {% else %}
                            {# Jours + horaires par jour (champs à plat du Restaurant) :
                               même partial que la carte du Lieu. #}
                            {% set w_jours = widgets_annexes|reduce((acc, w) => w.vars.name == 'joursOuverture' ? w : acc, null) %}
                            {% set w_horaires = widgets_annexes|reduce((acc, w) => w.vars.name == 'horairesJours' ? w : acc, null) %}
                            {% set horaires_partages = w_jours is not null and w_horaires is not null %}
                            {% set annexes_simples = widgets_annexes|filter(w => w.vars.name != 'periodesFermeture'
                                and (not horaires_partages or w.vars.name not in ['joursOuverture', 'horairesJours'])) %}
                            <div class="flex flex-row flex-wrap gap-x-6 gap-y-5">
                                {% for widget in annexes_simples|filter(w => 'checkbox' not in w.vars.block_prefixes) %}
                                    {% if widget.vars.expanded|default(false) %}
                                        {# Choix multiples : interrupteurs en rangée, comme la
                                           carte Disponibilités du Lieu. #}
                                        <div class="w-full flex flex-col gap-2">
                                            {{ form_label(widget) }}
                                            <div class="flex flex-row gap-x-6 gap-y-3 items-center flex-wrap">
                                                {% for choix in widget %}
                                                    <label class="flex flex-row items-center gap-2 shrink-0 cursor-pointer" for="{{ choix.vars.id }}">
                                                        <twig:Form:SwitchButton id="{{ choix.vars.id }}" name="{{ choix.vars.full_name }}"
                                                                                value="{{ choix.vars.value }}" :checked="choix.vars.checked" class="shrink-0" />
                                                        <twig:Typography variant="input" element="span"
                                                                         class="text-[0.875rem]! leading-[1.375rem]! whitespace-nowrap">{{ choix.vars.label }}</twig:Typography>
                                                    </label>
                                                {% endfor %}
                                            </div>
                                            {% do widget.setRendered %}
                                        </div>
                                    {% else %}
                                        {{ form_row(widget, { row_attr: { class: 'w-[calc(50%-12px)]' } }) }}
                                    {% endif %}
                                {% endfor %}
                                {% for widget in annexes_simples|filter(w => 'checkbox' in w.vars.block_prefixes) %}
                                    {{ form_row(widget, { row_attr: { class: 'w-[calc(50%-12px)]' } }) }}
                                {% endfor %}
                            </div>
                            {% if horaires_partages %}
                                {% include 'mdm/fiche/_horaires_jours.html.twig' with { jours: w_jours, horaires: w_horaires } only %}
                            {% endif %}
                            {% if w_periodes is not null %}
                                {% include 'mdm/fiche/_periodes_fermeture.html.twig' with { periodes: w_periodes } only %}
                            {% endif %}
                        {% endif %}
                    </section>
                {% endif %}
            {% endif %}
        {% endfor %}
        {{ form_widget(form._token) }}
        {% do form.submit.setRendered %}
    {{ form_end(form, {render_rest: false}) }}

    {# ---------------- Volets des blocs (formulaires propres, hors formulaire principal) #}
    {# Suggestions en attente et historique ne font plus volet : ils vivent dans
       le pied maquette, toujours visible sous les sections. #}
    {% for i, s in sections %}
        {% if s.blocs|filter(b => b not in ['puces', 'disponibilites', 'capacites', 'suggestions_attente', 'suggestions', 'historique'])|length > 0 %}
            {{ _self.volet_ouvre(i, i == section_index) }}
                {% if s.champs is empty %}{{ _self.volet_titre(s.titre, onglets[i].completude) }}{% endif %}

                {# ---- Formules de visibilité (maquette pure, désactivé) ---- #}
                {% if 'formules' in s.blocs %}
                    {% include 'mdm/fiche/_formules.html.twig' %}
                {% endif %}

                {# ---- Templates de message (maquette pure, désactivé) ---- #}
                {% if 'templates' in s.blocs %}
                    <div class="flex flex-col gap-4" title="Fonction à venir — en développement">
                        <twig:Typography variant="body-sm" textColor="neutral-500">
                            Modèles de réponse envoyés aux demandes de la marketplace — à venir, sans back aujourd'hui.
                        </twig:Typography>
                        <div class="flex flex-col gap-3 opacity-60">
                            {% for numero in 1..5 %}
                                <div class="flex flex-col gap-1">
                                    <twig:Typography variant="body-sm" bold>Template {{ numero }}</twig:Typography>
                                    <div class="min-h-16 box-border flex items-center px-3 py-2 rounded-xs bg-neutral-200 cursor-not-allowed">
                                        <twig:Typography variant="body-sm" textColor="neutral-500" class="italic">En développement</twig:Typography>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {# ---- Médias ---- #}
                {# Onglets internes maquette (Photos / Plans / Supports /
                   Vidéo / Documents). Le wrapper medias-bloc rafraîchit son
                   contenu par fetch après chaque action média : plus aucun
                   rechargement de page, la saisie du formulaire principal est
                   préservée. Les formulaires natifs des modales soumettent en
                   AJAX via l'intercepteur du wrapper. #}
                {% if 'medias' in s.blocs and medias %}
                    {% include 'mdm/fiche/_medias_onglets.html.twig' %}
                {% endif %}

                {# ---- Collaborateurs : grille maquette (pastilles de droits, crayon,
                       corbeille) + panneau latéral à deux états. Le crayon recharge la
                       page avec ?collaborateur=<id> : le panneau passe alors en mode
                       édition avec le vrai formulaire — pas de bascule JS factice. ---- #}
                {% if 'collaborateurs' in s.blocs %}
                    {% set peut_gerer = is_granted('FICHE_MANAGE_AFFILIATIONS', fiche) %}
                    {% set collaborateur_edite = peut_gerer ? app.request.query.get('collaborateur') : null %}
                    {% set ligne_editee = collaborateur_edite
                        ? (affiliations|filter(l => l.affiliation.idString == collaborateur_edite)|first)
                        : null %}
                    {# Classes écrites en toutes lettres : Tailwind ne compile pas
                       une classe construite par concaténation. #}
                    {% set grille_collab = peut_gerer
                        ? 'grid-cols-[96px_84px_minmax(0,1fr)_116px_104px_84px_84px_84px_78px_62px]'
                        : 'grid-cols-[96px_84px_minmax(0,1fr)_116px_104px_84px_84px_84px_78px]' %}
                    <div class="flex flex-col min-[1100px]:flex-row gap-6 items-start">
                    <div class="flex-1 min-w-0 flex flex-col gap-3">
                        <div class="flex flex-col self-stretch overflow-x-auto">
                            <div class="grid {{ grille_collab }} gap-1.5 box-border px-3 py-2.5 rounded-xs bg-primary-4 min-w-[900px]" role="row">
                                {% for colonne in ['Nom', 'Prénom', 'Email', 'Téléphone', 'Rôle', 'Traite les demandes', 'Traite les contenus', 'Traite les paiements'] %}
                                    <span role="columnheader"><twig:Typography variant="body-xs" textColor="primary-3" bold>{{ colonne }}</twig:Typography></span>
                                {% endfor %}
                                {{ collab.entete_repli() }}
                                {% if peut_gerer %}<span></span>{% endif %}
                            </div>
                            {% for ligne in affiliations %}
                                {% set affiliation = ligne.affiliation %}
                                <div class="grid {{ grille_collab }} gap-1.5 items-center box-border px-3 py-3.5 min-w-[900px]
                                            border-b border-neutral-200 {{ affiliation.idString == collaborateur_edite ? 'bg-primary-5' : '' }}" role="row">
                                    <span class="min-w-0 truncate"><twig:Typography variant="body-sm" bold>{{ affiliation.collaborateur.lastName }}</twig:Typography></span>
                                    <span class="min-w-0 truncate"><twig:Typography variant="body-sm">{{ affiliation.collaborateur.firstName }}</twig:Typography></span>
                                    <span class="min-w-0 truncate"><twig:Typography variant="body-sm">{{ affiliation.collaborateur.email }}</twig:Typography></span>
                                    <span class="whitespace-nowrap"><twig:Typography variant="body-sm">{{ affiliation.collaborateur.phone ?? '—' }}</twig:Typography></span>
                                    <span class="min-w-0 truncate"><twig:Typography variant="body-sm">{{ affiliation.role.label }}</twig:Typography></span>
                                    {{ collab.droit_collab(affiliation.receivesRequests, 'Traite les demandes') }}
                                    {{ collab.droit_collab(affiliation.traiteContenus, 'Traite les contenus') }}
                                    {{ collab.droit_collab(affiliation.traitePaiements, 'Traite les paiements') }}
                                    {{ collab.cellule_repli(affiliation) }}
                                    {% if peut_gerer %}
                                        <div class="flex items-center gap-2.5">
                                            <a href="{{ onglets[i].url }}&collaborateur={{ affiliation.idString }}"
                                               class="flex shrink-0 cursor-pointer text-neutral-900">
                                                <span class="sr-only">Modifier {{ affiliation.collaborateur.firstName }} {{ affiliation.collaborateur.lastName }}</span>
                                                <twig:Icon name="pencil" class="w-[17px] h-[17px]" />
                                            </a>
                                            {{ form_start(ligne.suppression, { attr: { class: 'contents' } }) }}
                                                {# Corbeille maquette : le composant Button porte le submit
                                                   (policy des templates), réduit à l'icône seule. #}
                                                <twig:Button variant="text" size="sm" type="submit" icon="trash"
                                                             class="p-0! px-0! h-fit! shrink-0 text-neutral-900 hover:text-error [&>:first-child]:w-[17px] [&>:first-child]:h-[17px]">
                                                    <span class="sr-only">Retirer {{ affiliation.collaborateur.firstName }} {{ affiliation.collaborateur.lastName }}</span>
                                                </twig:Button>
                                                {% do ligne.suppression.submit.setRendered %}
                                            {{ form_end(ligne.suppression) }}
                                        </div>
                                    {% endif %}
                                </div>
                            {% else %}
                                <div class="px-3 py-6"><twig:Typography variant="body-sm" textColor="neutral-500">Aucun utilisateur affilié.</twig:Typography></div>
                            {% endfor %}
                        </div>
                        {% if not peut_gerer %}
                            <twig:Typography variant="body-sm" textColor="neutral-500">La gestion des utilisateurs est réservée aux validateurs.</twig:Typography>
                        {% endif %}
                    </div>

                    {# Panneau latéral maquette : invitation par défaut, édition du
                       collaborateur pointé par le crayon (vrais formulaires). #}
                    {% if peut_gerer and form_invitation %}
                        <aside class="w-full min-[1100px]:w-[420px] shrink-0 box-border flex flex-col gap-5 px-8 py-10
                                      rounded-[24px] bg-primary-5"
                               aria-label="Ajouter ou modifier un utilisateur">
                            {% if ligne_editee %}
                                <div class="flex flex-col items-center gap-2">
                                    <twig:Badge icon="user" class="w-24" />
                                    <twig:Typography variant="subtitle" bold class="mt-2">Modifier {{ ligne_editee.affiliation.collaborateur.firstName }} {{ ligne_editee.affiliation.collaborateur.lastName }}</twig:Typography>
                                    {# L'email est la clé du rattachement, il ne se corrige pas ici. #}
                                    <twig:Typography variant="body-sm" textColor="neutral-500" center>{{ ligne_editee.affiliation.collaborateur.email }}</twig:Typography>
                                </div>
                                {{ form(ligne_editee.edition) }}
                                <twig:Button variant="outline" size="sm" full asLink href="{{ onglets[i].url }}">Annuler</twig:Button>
                            {% else %}
                                <div class="flex flex-col items-center gap-2">
                                    <twig:Icon name="plus" class="w-12 h-12 text-primary" />
                                    <twig:Typography variant="subtitle" bold class="mt-2">Ajouter un utilisateur</twig:Typography>
                                    <twig:Typography variant="body-sm" textColor="neutral-500" center class="text-pretty">
                                        Renseignez l'adresse professionnelle de l'utilisateur.
                                        Une adresse déjà connue rattache l'utilisateur existant ;
                                        la marketplace crée le compte et envoie le mail d'accès.
                                    </twig:Typography>
                                </div>
                                {{ form(form_invitation) }}
                            {% endif %}
                        </aside>
                    {% endif %}
                    </div>
                {% endif %}

                {# ---- Sites de diffusion ---- #}
                {% if 'sites' in s.blocs %}
                    <div class="flex flex-col gap-3">
                        <twig:Typography variant="subtitle" element="h3" bold>Sites de diffusion</twig:Typography>
                        <twig:Typography variant="body-sm" textColor="neutral-500">Les sites obligatoires restent cochés ; les sites payants sont signalés.</twig:Typography>
                        {{ form(form_sites) }}
                        {# Attribution géographique à la demande : ajout seul, selon les critères de l'admin des sites. #}
                        <twig:Typography variant="body-sm" textColor="neutral-500">« Appliquer les sites automatiques » ajoute les sites dont la zone géographique couvre l'adresse de la fiche, sans rien retirer.</twig:Typography>
                        {{ form(form_sites_geo) }}
                    </div>
                {% endif %}

                {# ---- Salesforce (lecture seule) ---- #}
                {% if 'salesforce' in s.blocs %}
                    <div class="flex flex-col gap-3 pt-4 border-t border-neutral-200 first:pt-0 first:border-t-0">
                        <twig:Typography variant="subtitle" element="h3" bold>Données Salesforce</twig:Typography>
                        {% if salesforce %}
                            <twig:Typography variant="body-sm" textColor="neutral-500">
                                Lecture seule — rafraîchies chaque nuit depuis Salesforce et diffusées sur la marketplace.
                                Dernier rafraîchissement : {{ salesforce.refreshedAt|date('d/m/Y H:i') }}.
                            </twig:Typography>
                            <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
                                <table class="w-full border-collapse">
                                    <tbody>
                                        {% for libelle, valeur in {
                                            'Note RSE globale': salesforce.noteGlobale,
                                            'RSE — Achats responsables': salesforce.noteAchatsResponsables,
                                            'RSE — Impact environnemental': salesforce.noteImpactEnvironnemental,
                                            'RSE — Impact social': salesforce.noteImpactSocial,
                                            'RSE — Mobilité': salesforce.noteMobilite,
                                            'RSE — Labels et démarche qualité': salesforce.noteLabelsEtDemarcheQualite,
                                            'Évaluation client': salesforce.evaluationClient,
                                            'Procédure judiciaire': salesforce.procedureJudiciaire,
                                        } %}
                                            <tr class="h-10 border-t border-neutral-200 first:border-t-0">
                                                <th scope="row" class="px-3 text-left w-1/2"><twig:Typography variant="body-sm" bold>{{ libelle }}</twig:Typography></th>
                                                <td class="px-3"><twig:Typography variant="body-sm">{{ valeur ?? '—' }}</twig:Typography></td>
                                            </tr>
                                        {% endfor %}
                                        <tr class="h-10 border-t border-neutral-200">
                                            <th scope="row" class="px-3 text-left"><twig:Typography variant="body-sm" bold>Contrats avec comptes</twig:Typography></th>
                                            <td class="px-3"><twig:Typography variant="body-sm">{{ salesforce.contratsComptes is not empty ? salesforce.contratsComptes|join(', ') : '—' }}</twig:Typography></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <twig:Typography variant="body-sm" textColor="neutral-500">Le statut « Partenaire BP » de cette fiche est également piloté par Salesforce.</twig:Typography>
                        {% else %}
                            <twig:Typography variant="body-sm" textColor="neutral-500">Fiche inconnue de Salesforce : aucune donnée RSE, évaluation ou statut partenaire n'en est reçue.</twig:Typography>
                        {% endif %}
                    </div>
                {% endif %}


            </section>
        {% endif %}
    {% endfor %}

    {# ---------------- Pied maquette : suggestions, complétude par canal, historique #}
    <section class="shrink-0 box-border flex flex-col gap-14 p-14 rounded-[32px] bg-neutral-100 shadow-(--shadow)">
        {# Suggestions en attente (BAN, Geoapify, OCR…) — un clic pour les lignes
           d'adresse ; les valeurs lues par l'OCR s'arbitrent par le formulaire
           de revue, rendu dans le même bloc (le dépôt vit dans la modale). #}
        {% set ocr_pendantes = extraction.active and extraction.a_revoir
            ? extraction.a_revoir.suggestions|filter(s => s.isPending)
            : [] %}
        <div class="flex flex-col gap-4" data-suggestions-attente>
            {# « Suggestions IA en attente » sur la maquette — le bloc réel est
               générique (BAN, Geoapify, OCR), le libellé reste neutre. #}
            <twig:Typography variant="heading-3" element="h2" class="font-[700]!">Suggestions en attente</twig:Typography>
            {% for ligne in suggestions_attente.lignes|default([]) %}
                <div class="flex flex-row items-center gap-5 flex-wrap px-5 py-4 rounded-xs bg-primary-5 [&_form]:contents">
                    <span class="inline-flex"><twig:Tag label="{{ ligne.source }}" variant="neutral" size="sm" /></span>
                    <twig:Typography variant="body" bold class="min-w-[200px]">{{ ligne.label }}</twig:Typography>
                    <div class="flex-1 min-w-0 flex flex-col">
                        <twig:Typography variant="body">{{ ligne.valeur }}</twig:Typography>
                        {% if ligne.actuel != '' %}
                            <twig:Typography variant="body-xs" textColor="neutral-500">Actuel : {{ ligne.actuel }}</twig:Typography>
                        {% endif %}
                        {% if ligne.note|default(null) %}
                            <twig:Typography variant="body-xs" textColor="neutral-500" class="italic">{{ ligne.note }}</twig:Typography>
                        {% endif %}
                    </div>
                    <twig:Typography variant="body-sm" textColor="neutral-400">{% if ligne.confiance is not null %}{{ ligne.confiance }} %{% else %}—{% endif %}</twig:Typography>
                    {% if is_granted('ROLE_BP_VALIDATOR') %}
                        {% if ligne.accepter is not null %}{{ form(ligne.accepter) }}{% endif %}
                        {{ form(ligne.ignorer) }}
                    {% endif %}
                </div>
            {% endfor %}

            {# ---- Valeurs lues par l'OCR : mêmes lignes, décision par le formulaire de revue. ---- #}
            {% if ocr_pendantes is not empty %}
                <twig:Typography variant="subtitle" element="h3" bold>Valider les valeurs lues</twig:Typography>
                <twig:Typography variant="body-sm" textColor="neutral-500">
                    {{ extraction.a_revoir.document.originalFilename }} ·
                    {{ ocr_pendantes|length }} valeur lue (corrigible avant application) par l'extraction — le document reste attaché à la fiche.
                </twig:Typography>
                {% if is_granted('ROLE_BP_VALIDATOR') %}
                    {% set form_revue = extraction.form_revue %}
                    {{ form_start(form_revue, { attr: { class: 'flex flex-col gap-4' } }) }}
                        {{ form_widget(form_revue.fiche_version) }}
                        {{ form_widget(form_revue._token) }}
                        {% for suggestion in ocr_pendantes %}
                            {% set ligne = attribute(form_revue, suggestion.id) %}
                            <div class="flex flex-row items-start gap-5 flex-wrap px-5 py-4 rounded-xs bg-primary-5">
                                <span class="inline-flex"><twig:Tag label="OCR" variant="neutral" size="sm" /></span>
                                <div class="min-w-[200px] flex flex-col">
                                    <twig:Typography variant="body" bold>{{ suggestion.label }}</twig:Typography>
                                    <twig:Typography variant="body-xs" textColor="neutral-500">{{ suggestion.pageReferences|map(p => 'p. ' ~ p)|join(', ') ?: '—' }}</twig:Typography>
                                </div>
                                <div class="flex-1 min-w-[240px] flex flex-col gap-1">
                                    {{ form_widget(ligne.value) }}
                                    <twig:Typography variant="body-xs" textColor="neutral-500">Actuel : {{ suggestion.observedValue is iterable ? suggestion.observedValue|json_encode : (suggestion.observedValue ?? 'Champ vide') }}</twig:Typography>
                                </div>
                                <twig:Typography variant="body-sm" textColor="neutral-400">{{ suggestion.confidence is null ? '—' : (suggestion.confidence * 100)|number_format(0) ~ ' %' }}</twig:Typography>
                                <div class="flex items-center gap-3">{{ form_row(ligne.accept) }}{{ form_row(ligne.reject) }}</div>
                            </div>
                        {% endfor %}
                        <div class="flex">{{ form_row(form_revue.save, {label: 'Appliquer les décisions'}) }}</div>
                    {{ form_end(form_revue, {render_rest: false}) }}
                {% else %}
                    <twig:Typography variant="body-sm" textColor="neutral-500">La validation des valeurs lues est réservée aux validateurs.</twig:Typography>
                {% endif %}
            {% endif %}

            {% if suggestions_attente.lignes|default([]) is empty and ocr_pendantes is empty %}
                <twig:Typography variant="body-sm" textColor="neutral-500">Aucune suggestion en attente sur cette fiche.</twig:Typography>
            {% endif %}
            {% if suggestions_attente.lignes|default([]) is not empty and not is_granted('ROLE_BP_VALIDATOR') %}
                <twig:Typography variant="body-sm" textColor="neutral-500">L'arbitrage des suggestions est réservé aux validateurs.</twig:Typography>
            {% endif %}
            {% if suggestions_attente.lignes|default([])|filter(l => l.source == 'Geoapify')|length > 0 %}
                <twig:Typography variant="body-xs" textColor="neutral-500">Adresse vérifiée par Geoapify — données © OpenStreetMap contributors.</twig:Typography>
            {% endif %}
        </div>

        <div class="flex flex-row gap-14 flex-wrap">
            {# Complétude par canal — scores réels par canal (pas de déclinaison FR/EN au back). #}
            <div class="flex flex-col gap-4 w-[calc(50%-28px)] min-w-[320px]">
                <twig:Typography variant="heading-3" element="h2" class="font-[700]!">Complétude par canal</twig:Typography>
                <div class="flex flex-col">
                    <div class="flex flex-row items-center gap-4 px-3 py-2">
                        <span class="flex-1"></span>
                        <span class="w-16 text-center"><twig:Typography variant="body-xs" textColor="neutral-500" bold>Score</twig:Typography></span>
                    </div>
                    {% for libelle, valeur in {
                        'Marketplace': entete.completude_canaux.marketplace,
                        'Sites thématiques': entete.completude_canaux.thematicSites,
                        'Salesforce': entete.completude_canaux.salesforce,
                        'Portail prestataire': entete.completude_canaux.providerPortal,
                    } %}
                        <div class="flex flex-row items-center gap-4 px-3 py-2 border-t border-neutral-200">
                            <twig:Typography variant="body" class="flex-1 min-w-0">{{ libelle }}</twig:Typography>
                            <span class="w-16 text-center py-1 rounded-full
                                         {{ valeur >= 80 ? 'bg-success-pastel' : (valeur >= 40 ? 'bg-old-gold-pastel' : 'bg-error-pastel') }}">
                                <twig:Typography variant="body-sm" bold>{{ valeur }} %</twig:Typography>
                            </span>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# Historique — frise des dernières révisions. #}
            <div class="flex flex-col gap-4 flex-1 min-w-[320px]">
                <div class="flex items-baseline justify-between gap-4">
                    <twig:Typography variant="heading-3" element="h2" class="font-[700]!">Dernières modifications</twig:Typography>
                    <twig:Typography variant="body-sm" textColor="neutral-500">Les {{ historique|length }} plus récentes</twig:Typography>
                </div>
                {% for revision in historique %}
                    <div class="flex flex-row gap-3">
                        <span class="w-0.5 shrink-0 rounded-full bg-primary-4" aria-hidden="true"></span>
                        <div class="flex flex-col min-w-0">
                            <twig:Typography variant="body" bold>{{ revision.actor }}</twig:Typography>
                            <twig:Typography variant="body-xs" textColor="neutral-400">{{ revision.createdAt|date('d/m/Y H:i') }} · {{ revision.source }}</twig:Typography>
                            <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">{{ actions_audit[revision.action]|default(revision.action|replace({'_': ' '})|capitalize) }}</twig:Typography>
                        </div>
                    </div>
                {% else %}
                    <twig:Typography variant="body-sm" textColor="neutral-500">Aucune modification enregistrée.</twig:Typography>
                {% endfor %}
                <div class="flex"><twig:Button variant="outline" size="sm" asLink href="{{ liens.historique }}">Historique complet et restauration</twig:Button></div>
            </div>
        </div>
    </section>

    {# ------------------------------------------ Modale d'extraction OCR #}
    <twig:Modal identifier="extraction">
        <div class="flex flex-col gap-4 w-[min(680px,80vw)]">
            <twig:Typography variant="heading-3" element="h3" bold>Extraire d'un document</twig:Typography>

            {# Fil d'étapes maquette, branché sur l'état réel du flux : dépôt,
               lecture en file/en cours, valeurs à valider (dans l'onglet). #}
            {% if extraction.active %}
                {% set etape_extraction = extraction.en_cours ? 2 : (extraction.a_revoir ? 3 : 1) %}
                <div class="flex flex-row items-center gap-3 flex-wrap">
                    {% for etiquette in ["Dépôt du document", "Lecture par l'IA", "Validation des valeurs"] %}
                        {% set actif = loop.index == etape_extraction %}
                        <span class="flex items-center gap-2">
                            <span class="w-6 h-6 shrink-0 flex items-center justify-center rounded-full
                                         {{ actif ? 'bg-linear-(--primary-gradient)' : (loop.index < etape_extraction ? 'bg-primary-4' : 'bg-neutral-200') }}">
                                <twig:Typography variant="body-xs" bold textColor="{{ actif ? 'neutral-100' : 'neutral-500' }}">{{ loop.index }}</twig:Typography>
                            </span>
                            <twig:Typography variant="body-sm" :bold="actif" textColor="{{ actif ? 'neutral-900' : 'neutral-500' }}">{{ etiquette }}</twig:Typography>
                        </span>
                        {% if not loop.last %}<span class="w-6 h-px bg-neutral-300" aria-hidden="true"></span>{% endif %}
                    {% endfor %}
                </div>
            {% endif %}

            {% if not extraction.active %}
                <twig:Typography variant="body-sm" textColor="neutral-500">L'extraction de documents n'est pas activée sur cet environnement.</twig:Typography>
            {% elseif extraction.en_cours %}
                {% set en_cours = extraction.en_cours %}
                <div class="flex flex-row items-center gap-4 p-4 rounded-md bg-primary-5">
                    <twig:Icon name="spinner" class="w-6 h-6 shrink-0 animate-spin text-primary" />
                    <div class="flex flex-col gap-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <twig:Typography variant="body" bold element="span">{{ en_cours.document.originalFilename }}</twig:Typography>
                            <twig:Tag label="{{ extraction_statuts[en_cours.status.value] ?? en_cours.status.value }}" variant="primary-3" size="sm" />
                            {% if en_cours.pageCount %}<twig:Typography variant="body-sm" textColor="neutral-500">{{ en_cours.pageCount }} page{{ en_cours.pageCount > 1 ? 's' : '' }}</twig:Typography>{% endif %}
                        </div>
                        <twig:Typography variant="body-sm" textColor="neutral-500">
                            Déposé par {{ en_cours.createdBy }} le {{ en_cours.createdAt|date('d/m/Y à H:i') }}.
                            La lecture peut prendre plusieurs minutes — vous pouvez continuer à travailler.
                        </twig:Typography>
                    </div>
                </div>
                <twig:Typography variant="body-sm" textColor="neutral-500">Vous pourrez déposer un autre document quand cette lecture sera terminée.</twig:Typography>
                <div class="flex"><twig:Button variant="outline" size="sm" asLink href="{{ liens.ocr }}">Actualiser</twig:Button></div>
            {% elseif extraction.form_depot and is_granted('FICHE_EDIT', fiche) %}
                {% if extraction.a_revoir %}
                    <twig:Typography variant="body-sm" textColor="neutral-500">
                        Des valeurs lues attendent votre arbitrage dans le bloc « Suggestions en attente »,
                        en bas de la fiche. Vous pouvez aussi déposer un nouveau document.
                    </twig:Typography>
                {% endif %}
                {# Zone de dépôt maquette autour du vrai formulaire (catégorie, PDF, envoi). #}
                <div class="box-border flex flex-col items-center gap-3 px-6 py-8 rounded-sm bg-primary-5
                            border-[1.4px] border-dashed border-primary">
                    <twig:Icon name="upload-simple" class="w-8 h-8 text-primary" />
                    <twig:Typography variant="body" bold>Déposez votre document</twig:Typography>
                    <twig:Typography variant="body-sm" textColor="neutral-500" center class="text-pretty">
                        Plaquette, devis ou plan — l'IA en lit les valeurs et vous les propose, rien n'est écrit sans votre accord champ par champ.
                    </twig:Typography>
                    <span class="inline-flex px-2 py-0.5 rounded-full bg-primary-4">
                        <twig:Typography variant="body-xs" bold textColor="primary-3">PDF</twig:Typography>
                    </span>
                    <div class="w-full [&_form]:flex [&_form]:flex-col [&_form]:gap-3">{{ form(extraction.form_depot) }}</div>
                </div>
            {% endif %}
            {# Historique des extractions de la fiche — le flux complet vit ici. #}
            {% if extraction.active %}
                <div class="flex flex-col gap-1">
                    <twig:Typography variant="body-sm" bold>Extractions de la fiche</twig:Typography>
                    {% if extractions is not empty %}
                        <ul class="flex flex-col gap-1">
                            {% for ligne_extraction in extractions %}
                                <li class="flex items-center gap-2">
                                    <a href="{{ path('app_ocr_show', {id: fiche.idString, extractionId: ligne_extraction.id}) }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">{{ ligne_extraction.document.originalFilename }}</twig:Typography></a>
                                    <twig:Typography variant="body-sm" textColor="neutral-500">· {{ extraction_statuts[ligne_extraction.status.value] ?? ligne_extraction.status.value }} · {{ ligne_extraction.suggestionCount|default('—') }} valeur(s)</twig:Typography>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <twig:Typography variant="body-sm" textColor="neutral-500">Aucune extraction pour cette fiche.</twig:Typography>
                    {% endif %}
                    <a href="{{ liens.ocr_admin }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">Écran complet des extractions</twig:Typography></a>
                </div>
            {% endif %}
            <div class="flex justify-end">
                <twig:Modal:TriggerButton variant="text" size="sm" modalIdentifier="extraction"
                                          data-action="modal-trigger-button#close">Fermer</twig:Modal:TriggerButton>
            </div>
        </div>
    </twig:Modal>
    {# Confirmation avant dépublication : la fiche est publiée et un champ
       obligatoire de la bible vient d'être vidé. Rien n'a été enregistré :
       « Non » ferme la modale et laisse la saisie dans le formulaire, « Oui »
       renvoie le même formulaire avec le submitter nommé (SubmitType
       confirmerDepublication du LieuType), qui déclenche l'enregistrement
       et la dépublication côté serveur. #}
    {% if confirmation_depublication|default(null) and form.confirmerDepublication is defined %}
        <twig:Modal identifier="depublication" :display="true">
            <div class="flex flex-col gap-4 w-[min(560px,80vw)]">
                <twig:Typography variant="heading-3" element="h3" bold>Voulez-vous vraiment continuer ?</twig:Typography>
                <twig:Typography variant="body">Cette fiche sera dépubliée : elle repassera « En cours », sera retirée de la marketplace et devra être soumise à nouveau à validation. Les champs obligatoires suivants sont désormais vides :</twig:Typography>
                <ul class="list-disc pl-6 flex flex-col gap-1">
                    {% for champ in confirmation_depublication %}
                        <li><twig:Typography variant="body-sm" bold element="span">{{ champ }}</twig:Typography></li>
                    {% endfor %}
                </ul>
                <div class="flex flex-row gap-2 justify-end mt-2">
                    <twig:Button variant="outline" size="md" type="button" data-action="click->modal#close">Non</twig:Button>
                    <twig:Button variant="primary" size="md" type="submit" form="form-fiche"
                                 name="{{ form.confirmerDepublication.vars.full_name }}" value="1">Oui, dépublier</twig:Button>
                </div>
            </div>
        </twig:Modal>
    {% endif %}

    <div class="shrink-0 h-2"></div>
  </div>

  {# Barre d'actions fixe maquette : Annuler, l'enregistrement de TOUTES les
     sections (formulaire principal), puis le workflow d'états. Le refus
     (motif obligatoire) reste sous l'en-tête. #}
  {% set actions_workflow = actions|filter((a, n) => n != 'reject') %}
  {% if is_granted('FICHE_EDIT', fiche) or actions_workflow is not empty %}
      {# Barre compacte : trois boutons à la même taille (md, 40 px). #}
      <div class="shrink-0 h-16 flex items-center justify-center gap-4 bg-primary-4 [&_form]:contents">
          <twig:Button variant="outline" size="md" asLink href="{{ onglets[section_index].url }}">Annuler</twig:Button>
          {% if is_granted('FICHE_EDIT', fiche) %}
              <twig:Button variant="primary" size="md" type="submit" form="form-fiche">Enregistrer les modifications</twig:Button>
          {% endif %}
          {% for nom, action in actions_workflow %}
              {# « Valider et publier » exige le niveau publieur (le voter donne les deux aux validateurs). #}
              {% set attribut = {'submit': 'FICHE_SUBMIT', 'validate': 'FICHE_VALIDATE', 'validate_and_publish': 'FICHE_PUBLISH', 'publish': 'FICHE_PUBLISH', 'archive': 'FICHE_ARCHIVE', 'unarchive': 'FICHE_ARCHIVE', 'republish': 'FICHE_PUBLISH'}[nom] %}
              {% if is_granted(attribut, fiche) %}
                  {# Même neutralisation du chrome outline que pour la suppression ;
                     hauteur alignée sur les deux autres boutons (md). #}
                  <span class="contents [&_button]:bg-none! [&_button]:before:hidden! [&_button]:bg-primary-3! [&_button]:border-primary-3! [&_button]:h-[40px]! [&_button]:px-3.5! [&_button_span]:text-neutral-100!">{{ form(action) }}</span>
              {% endif %}
          {% endfor %}
      </div>
  {% endif %}
</main>
{% endblock %}
