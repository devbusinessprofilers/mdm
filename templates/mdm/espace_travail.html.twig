{% extends 'mdm/base.html.twig' %}

{# Mon espace de travail — vue personnelle (fiches assignées, priorités,
   activité), habillée au langage front. Version volontairement resserrée ; la
   version riche viendra plus tard. #}

{% block title %}Mon espace de travail{% endblock %}

{% set statut_libelles = {
    'en_cours': 'En cours', 'en_attente_validation': 'En attente',
    'validee': 'Validée', 'publiee': 'Publiée', 'archivee': 'Archivée',
} %}
{% set gamme_libelles = {
    'lieu': 'Lieu', 'restaurant': 'Restaurant', 'activite': 'Activité', 'service_evenementiel': 'Service',
} %}

{% block contenu %}
<main class="flex flex-col h-full min-h-0 overflow-y-auto scrollbar px-6 py-5 gap-5">

    <div class="shrink-0 flex items-start justify-between gap-4">
        <div class="flex flex-col gap-1">
            <twig:Typography variant="body-xs" textColor="neutral-500" bold class="uppercase tracking-[0.8px]">Espace de travail</twig:Typography>
            <twig:Typography variant="heading-2" element="h1" bold>Mon espace de travail</twig:Typography>
            <twig:Typography variant="body-sm" textColor="neutral-500">Vos fiches assignées, vos priorités et votre activité.</twig:Typography>
        </div>
        <twig:Button variant="primary" size="md" icon="plus-circle" asLink href="{{ path('app_mdm_creation_fiche') }}">Nouvelle fiche</twig:Button>
    </div>

    {# Classes card-grid/card/stat-value conservées : hooks des tests de compteurs. #}
    <section class="card-grid shrink-0 grid grid-cols-1 md:grid-cols-3 gap-3">
        <article class="card flex flex-col gap-1 p-5 rounded-[16px] bg-neutral-100 shadow-(--shadow)">
            <twig:Typography variant="body-sm" bold>Mes fiches assignées</twig:Typography>
            <twig:Typography variant="heading-1" bold class="stat-value">{{ compteurs.assignees }}</twig:Typography>
            <twig:Typography variant="body-xs" textColor="neutral-500">dont {{ compteurs.assignees_faibles }} sous 50 % de complétude</twig:Typography>
            <a href="{{ url_mes_fiches }}" class="hover:underline w-fit mt-1"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">Voir mes fiches</twig:Typography></a>
        </article>
        <article class="card flex flex-col gap-1 p-5 rounded-[16px] bg-neutral-100 shadow-(--shadow)">
            <twig:Typography variant="body-sm" bold>En attente de validation</twig:Typography>
            <twig:Typography variant="heading-1" bold class="stat-value">{{ compteurs.en_attente }}</twig:Typography>
            <twig:Typography variant="body-xs" textColor="neutral-500">parmi mes fiches assignées</twig:Typography>
        </article>
        <article class="card flex flex-col gap-1 p-5 rounded-[16px] bg-neutral-100 shadow-(--shadow)">
            <twig:Typography variant="body-sm" bold>Suggestions IA à arbitrer</twig:Typography>
            <twig:Typography variant="heading-1" bold class="stat-value">{{ compteurs.ia }}</twig:Typography>
            <twig:Typography variant="body-xs" textColor="neutral-500">fiches assignées portant des valeurs en attente</twig:Typography>
        </article>
    </section>

    <div class="flex flex-col xl:flex-row gap-5">
        <section class="flex-1 min-w-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)">
            <twig:Typography variant="heading-3" element="h2" bold>Mes priorités</twig:Typography>
            <twig:Typography variant="body-sm" textColor="neutral-500">Les fiches assignées les moins complètes en premier.</twig:Typography>
            {% if priorites is not empty %}
                <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
                    <table class="w-full border-collapse">
                        <thead class="bg-primary-5"><tr class="text-left h-10 border-b border-neutral-200">
                            {% for col in ['Code', 'Nom', 'Gamme', 'Statut', 'Complétude', ''] %}<th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ col }}</twig:Typography></th>{% endfor %}
                        </tr></thead>
                        <tbody>
                        {% for priorite in priorites %}
                            <tr class="h-11 border-t border-neutral-200 first:border-t-0">
                                <td class="px-3"><twig:Typography variant="body-sm">{{ priorite.code }}</twig:Typography></td>
                                <td class="px-3"><twig:Typography variant="body-sm" bold>{{ priorite.label ?? 'Sans libellé' }}</twig:Typography></td>
                                <td class="px-3"><twig:Tag label="{{ gamme_libelles[priorite.type] ?? priorite.type }}" variant="neutral" size="sm" /></td>
                                <td class="px-3"><twig:Tag label="{{ statut_libelles[priorite.status] ?? priorite.status }}" variant="primary-3" size="sm" /></td>
                                <td class="px-3"><twig:Typography variant="body-sm">{{ priorite.completeness is null ? '—' : priorite.completeness ~ ' %' }}</twig:Typography></td>
                                <td class="px-3">{% if priorite.url %}<a href="{{ priorite.url }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">Ouvrir</twig:Typography></a>{% endif %}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <twig:Typography variant="body-sm" textColor="neutral-500">Aucune fiche ne vous est assignée pour l'instant.</twig:Typography>
            {% endif %}
        </section>

        <aside class="w-full xl:w-[320px] shrink-0 flex flex-col gap-5">
            <section class="flex flex-col gap-2 p-5 rounded-[16px] bg-neutral-100 shadow-(--shadow)">
                <twig:Typography variant="heading-3" element="h2" bold>Raccourcis</twig:Typography>
                <ul class="flex flex-col gap-1">
                    <li><a href="{{ path('app_mdm_creation_fiche') }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">Créer une fiche</twig:Typography></a></li>
                    <li><a href="{{ url_mes_fiches }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">Mes fiches dans le référentiel</twig:Typography></a></li>
                    {% if is_granted('ROLE_ADMIN') %}
                        <li><a href="{{ path('app_etl_import_index') }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">Importer des fiches</twig:Typography></a></li>
                    {% endif %}
                </ul>
            </section>

            <section class="flex flex-col gap-2 p-5 rounded-[16px] bg-neutral-100 shadow-(--shadow)">
                <twig:Typography variant="heading-3" element="h2" bold>Mes vues enregistrées</twig:Typography>
                {% if vues_enregistrees is not empty %}
                    <ul class="flex flex-col gap-1">
                        {% for entree in vues_enregistrees %}
                            <li class="flex items-center gap-2 flex-wrap">
                                <a href="{{ entree.url }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">{{ entree.vue.name }}</twig:Typography></a>
                                <twig:Typography variant="body-xs" textColor="neutral-500">{{ entree.vue.shared ? 'Partagée · ' ~ entree.vue.ownerLabel : 'Personnelle' }}</twig:Typography>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <twig:Typography variant="body-sm" textColor="neutral-500">Aucune vue enregistrée.</twig:Typography>
                {% endif %}
            </section>

            <section class="flex flex-col gap-2 p-5 rounded-[16px] bg-neutral-100 shadow-(--shadow)">
                <twig:Typography variant="heading-3" element="h2" bold>Mon activité (7 jours)</twig:Typography>
                <ul class="flex flex-col gap-1">
                    <li><twig:Typography variant="body-sm">{{ activite.creees }} fiche{{ activite.creees == 1 ? '' : 's' }} créée{{ activite.creees == 1 ? '' : 's' }}</twig:Typography></li>
                    <li><twig:Typography variant="body-sm">{{ activite.modifiees }} modification{{ activite.modifiees == 1 ? '' : 's' }}</twig:Typography></li>
                    <li><twig:Typography variant="body-sm">{{ activite.validees }} validation{{ activite.validees == 1 ? '' : 's' }}</twig:Typography></li>
                    <li><twig:Typography variant="body-sm">{{ activite.publiees }} publication{{ activite.publiees == 1 ? '' : 's' }}</twig:Typography></li>
                </ul>
            </section>
        </aside>
    </div>
</main>
{% endblock %}
