{% extends 'base.html.twig' %}

{% block title %}Activités{% endblock %}

{% block body %}
<main class="page">
    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-kicker">Catalogue</p>
            <h1>Activités</h1>
            <p class="page-description">Consultez et maintenez les fiches Activité du PIM — {{ total_count }} fiche{{ total_count == 1 ? '' : 's' }} au total.</p>
        </div>

        <a class="btn" href="{{ path('app_pim_activite_new') }}">Créer une activité</a>
    </header>

    <div class="toolbar">
        {{ form(search_form) }}

        <a
            class="btn btn-secondary btn-small"
            href="{{ path('app_pim_activite_index', {status: 'en_attente_validation'}) }}"
        >
            À valider ({{ pending_count }})
        </a>

        {% if query or status %}
            <a class="text-link" href="{{ path('app_pim_activite_index') }}">Effacer les critères</a>
        {% endif %}
    </div>

    {% if result_count is not null %}
        <p class="page-description">{{ result_count }} résultat{{ result_count == 1 ? '' : 's' }}</p>
    {% endif %}

    <div class="table-shell">
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Nom</th>
                        <th>Ville fixe</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for activite in activites %}
                        <tr>
                            <td>{{ activite.code ?? '—' }}</td>
                            <td>{{ activite.label ?? 'Sans libellé' }}</td>
                            <td>{{ activite.ville ?? '—' }}</td>
                            <td><span class="badge badge-info">{{ activite.status.value }}</span></td>
                            <td>
                                <div class="table-actions">
                                    <a class="text-link" href="{{ path('app_pim_activite_show', {id: activite.id}) }}">Voir</a>
                                    <a class="text-link" href="{{ path('app_pim_activite_edit', {id: activite.id}) }}">Modifier</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="empty-state">Aucune activité.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <nav class="pagination" aria-label="Pagination">
        {% if app.request.query.has('cursor') %}
            <a class="btn btn-secondary btn-small" href="{{ path('app_pim_activite_index') }}">
                Retour au début
            </a>
        {% endif %}

        {% if next_cursor %}
            <a
                class="btn btn-secondary btn-small"
                href="{{ path('app_pim_activite_index', {
                    q: query ?: null,
                    status: status ? status.value : null,
                    cursor: next_cursor
                }) }}"
            >
                Page suivante
            </a>
        {% endif %}
    </nav>
</main>
{% endblock %}
