{% extends 'base.html.twig' %}

{% macro collection(field, title) %}
    <fieldset
        data-controller="form-collection"
        data-form-collection-index-value="{{ field|length }}"
        data-form-collection-prototype-value="{{ form_widget(field.vars.prototype)|e('html_attr') }}"
    >
        <legend>{{ title }}</legend>

        <div data-form-collection-target="items">
            {% for item in field %}
                <fieldset data-form-collection-item>
                    {{ form_widget(item) }}
                    <button type="button" data-action="form-collection#remove">Retirer</button>
                </fieldset>
            {% endfor %}
        </div>

        <button type="button" data-action="form-collection#add" data-remove-label="Retirer">
            Ajouter
        </button>
    </fieldset>
{% endmacro %}

{% block title %}{{ creation ? 'Nouvelle activité' : 'Modifier l’activité' }}{% endblock %}

{% block body %}
<main class="page">
    <a class="back-link" href="{{ path('app_pim_activite_index') }}">← Retour aux activités</a>

    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-kicker">Fiche Activité</p>
            <h1>{{ creation ? 'Nouvelle activité' : 'Modifier l’activité' }}</h1>
        </div>
    </header>
    {% if not creation %}{% include 'dam/_fiche_alerts.html.twig' with {fiche: activite.fiche} only %}{% endif %}

    {{ form_start(form) }}
        {{ form_errors(form) }}

        <section class="card">
            <h2>Informations générales</h2>
            {{ form_row(form.label) }}
            {{ form_row(form.prestataire) }}
            {{ form_row(form.types) }}
            <div data-controller="sous-thematiques">
                {{ form_row(form.thematiques) }}
                {{ form_row(form.sousThematiques) }}
            </div>
            {{ form_row(form.langues) }}
            {{ form_row(form.engagementsRse) }}
        </section>

        <section class="card">
            <h2>Rayon d’action</h2>
            {{ form_row(form.modeIntervention) }}

            <details open>
                <summary>Localisation fixe</summary>
                {{ form_widget(form.localisation) }}
            </details>

            <details>
                <summary>Localisation mobile</summary>
                {{ form_row(form.touteFrance) }}
                {{ form_row(form.paysMobiles) }}
                {{ form_row(form.regionsMobiles) }}
                {{ form_row(form.departementsMobiles) }}
            </details>
        </section>

        <section class="card">
            <h2>Description</h2>
            {{ form_row(form.descriptionGenerale) }}
            {{ form_row(form.comprendPrestation) }}
            {{ form_row(form.objectifs) }}
            {{ form_row(form.plus) }}
        </section>

        <section class="card">
            <h2>Capacité et durée</h2>
            {{ form_row(form.participantsMin) }}
            {{ form_row(form.participantsMax) }}
            {{ form_row(form.dureeMinMinutes) }}
            {{ form_row(form.dureeMaxMinutes) }}
        </section>

        <section class="card">
            <h2>Tarification</h2>
            {{ form_row(form.tarifParPersonne) }}
            {{ _self.collection(form.offres, 'Forfaits et options') }}
        </section>

        <section class="card">
            <h2>Médias et documents</h2>
            {{ form_row(form.youtubeUrl) }}
            {{ _self.collection(form.ressources, 'Photos — dix maximum') }}

            <h3>Nouveaux supports commerciaux</h3>
            {{ form_row(form.supportsCommerciaux) }}
            {{ form_row(form.supportTitle) }}
            {{ form_row(form.supportSource) }}
        </section>

        {{ form_row(form.submit) }}
    {{ form_end(form) }}

    {% if not creation %}
        <section class="card">
            <div class="section-heading">
                <h2>Supports commerciaux existants</h2>
                <span class="badge">{{ documents|length }}</span>
            </div>

            {% for document in documents %}
                <article class="lieu-photo-card">
                    <p>
                        <strong>{{ document.resource.legende ?: 'Support commercial' }}</strong>
                        ·
                        <span class="badge">
                            {{ document.resource.publicationStatus ? document.resource.publicationStatus.value : 'privé' }}
                        </span>
                    </p>

                    {{ form(document.metadata_form) }}
                    {{ form(document.replace_form) }}

                    <p>
                        <a href="{{ path('app_pim_activite_document_download', {
                            id: activite.id,
                            resourceId: document.resource.id
                        }) }}">Télécharger l’original</a>
                    </p>

                    {% if is_granted('ROLE_BP_VALIDATOR') %}
                        {{ form(document.publication_form) }}
                    {% endif %}

                    {{ form(document.delete_form) }}
                </article>
            {% else %}
                <p class="empty-state">Aucun support commercial.</p>
            {% endfor %}
        </section>
    {% endif %}
</main>
{% endblock %}
