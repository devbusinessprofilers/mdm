{% extends 'base.html.twig' %}

{% block title %}{{ lieu.label ?? 'Lieu' }}{% endblock %}

{% block body %}
<main class="page page-narrow">
    <a class="back-link" href="{{ path('app_pim_lieu_index') }}">← Retour aux lieux</a>
    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-kicker">Fiche Lieu</p>
            <h1>{{ lieu.label ?? 'Sans libellé' }}</h1>
        </div>
        {% if is_granted('FICHE_EDIT', lieu.fiche) %}<a class="btn" href="{{ path('app_pim_lieu_edit', {id: lieu.id}) }}">Modifier</a>{% endif %}
    </header>
    <section class="card">
    <dl class="definition-list">
        <dt>Code</dt><dd>{{ lieu.code ?? '—' }}</dd>
        <dt>Typologies</dt><dd>{{ lieu.generaleTypologie|join(', ') ?: '—' }}</dd>
        <dt>Adresse</dt><dd>{% if lieu.localisation %}{{ lieu.localisation.ruePostale }} {{ lieu.localisation.codePostal }} {{ lieu.localisation.ville }}{% else %}—{% endif %}</dd>
        <dt>Statut</dt><dd><span class="badge badge-info">{{ lieu.fiche.status.value|replace({'_': ' '})|capitalize }}</span></dd>
        {% if lieu.fiche.validationFeedback %}<dt>Dernier motif de refus</dt><dd>{{ lieu.fiche.validationFeedback }}</dd>{% endif %}
        <dt>Salles</dt><dd>{{ lieu.salles|length }}</dd>
        <dt>Périodes de fermeture</dt><dd>{{ lieu.periodesFermeture|length }}</dd>
        <dt>Accès</dt><dd>{{ lieu.acces|length }}</dd>
        <dt>Ressources DAM</dt><dd>{{ lieu.ressources|length }}</dd>
    </dl>
    </section>
    <section class="card">
        <div class="section-heading">
            <div>
                <p class="page-kicker">DAM privé</p>
                <h2>Photos du lieu</h2>
            </div>
            <span class="badge badge-info">{{ photos|length }} photo{{ photos|length > 1 ? 's' : '' }}</span>
        </div>
        {% if photos is empty %}
            <p class="empty-state">Aucune photo n’a encore été ajoutée.</p>
        {% else %}
            <div class="lieu-photo-list">
                {% for photo in photos %}
                    <article class="lieu-photo-detail">
                        <header class="lieu-photo-caption">
                            <strong>
                                {% if photo.resource.legende %}
                                    {{ photo.resource.legende }}
                                {% elseif photo.asset %}
                                    {{ photo.asset.originalFilename }}
                                {% else %}
                                    Photo sans légende
                                {% endif %}
                            </strong>
                            <span>{{ photo.resource.usage|replace({'_': ' '})|lower|capitalize }}</span>
                            {% if photo.resource.salle %}<span>Salle : {{ photo.resource.salle.nom }}</span>{% endif %}
                            {% if not photo.asset %}
                                <span class="badge badge-error">Média introuvable</span>
                            {% elseif photo.asset.status.value == 'failed' %}
                                <span class="badge badge-error">Traitement en échec</span>
                                {% if photo.asset.errorMessage %}<span>{{ photo.asset.errorMessage }}</span>{% endif %}
                            {% elseif photo.asset.status.value == 'processed' %}
                                <span class="badge badge-success">Traitement terminé</span>
                            {% else %}
                                <span class="badge badge-info">Traitement en cours</span>
                            {% endif %}
                        </header>
                        <div class="lieu-variant-grid">
                            {% for variant in photo.variants %}
                                <figure class="lieu-variant-card">
                                    {% if variant.url %}
                                        <a href="{{ variant.url }}" target="_blank" rel="noopener noreferrer" class="lieu-variant-link">
                                            <img src="{{ variant.url }}" alt="{{ photo.resource.legende ?: (photo.asset ? photo.asset.originalFilename : 'Photo du lieu') }} — variante {{ variant.name }}" loading="lazy">
                                        </a>
                                    {% else %}
                                        <div class="lieu-variant-pending">
                                            {{ photo.asset and photo.asset.status.value == 'failed' ? 'Non générée' : 'En attente de traitement' }}
                                        </div>
                                    {% endif %}
                                    <figcaption><strong>{{ variant.name }}</strong><span>{{ variant.width }} × {{ variant.height }} px</span></figcaption>
                                </figure>
                            {% endfor %}
                        </div>
                    </article>
                {% endfor %}
            </div>
            <p class="media-security-note">Les variantes optimisées sont servies depuis le DAM public. Pendant leur génération, un aperçu privé temporaire peut être utilisé.</p>
        {% endif %}
    </section>
    <section class="card">
        <h2>Cycle de validation</h2>
        <div class="table-actions">
            {% if lieu.fiche.status.value == 'en_cours' and is_granted('FICHE_SUBMIT', lieu.fiche) %}{{ form(submit_form) }}{% endif %}
            {% if lieu.fiche.status.value == 'en_attente_validation' and is_granted('FICHE_VALIDATE', lieu.fiche) %}
                {{ form(validate_form) }}
                {{ form(reject_form) }}
            {% endif %}
            {% if lieu.fiche.status.value == 'publiee' and is_granted('FICHE_ARCHIVE', lieu.fiche) %}{{ form(archive_form) }}{% endif %}
        </div>
    </section>
    {% if is_granted('FICHE_DELETE', lieu.fiche) %}<div class="danger-form">{{ form(delete_form) }}</div>{% endif %}
</main>
{% endblock %}
