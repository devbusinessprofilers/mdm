{# Gestion des photos et documents d'un lieu (DAM), répartie dans les onglets
   internes du volet Médias (shell mdm/fiche/_medias_onglets) : Photos, Plans,
   Supports commerciaux, Documents. Chaque panneau porte
   data-media-tabs-target="panel" — le shell (hors de la zone AJAX) ré-applique
   l'onglet actif après chaque re-rendu du bloc.
   Variables : lieu, creation, photos, documents (avec `onglet`),
   media_upload_form, media_csrf_token, document_upload_forms, photo_usages. #}

{% macro tuile_document(document) %}
    <button type="button" title="Modifier les paramètres du document"
            data-controller="modal-trigger-button"
            data-modal-trigger-button-modal-identifier-value="document-{{ document.view.id }}"
            data-action="modal-trigger-button#open"
            class="relative w-[250px] h-[170px] shrink-0 box-border flex flex-col items-center justify-center gap-1.5
                   px-2 rounded-xs overflow-hidden cursor-pointer bg-primary-5 inset-ring-1 inset-ring-neutral-300
                   hover:inset-ring-primary">
        <twig:Icon name="file-pdf" class="w-7 h-7 shrink-0 text-primary-3" />
        <twig:Typography variant="body-xs" bold center class="w-full truncate">{{ document.view.title ?: document.view.filename }}</twig:Typography>
        <twig:Typography variant="body-xs" textColor="neutral-500" center class="w-full truncate">
            {{ document.view.sizeBytes
                ? (document.view.sizeBytes / 1024 / 1024)|number_format(2, ',', ' ') ~ ' Mo'
                : 'fichier introuvable'
            }}
        </twig:Typography>
    </button>
{% endmacro %}

{% macro panneau_documents(onglet, titre, description, documents, upload_form) %}
    <section class="card" data-media-tabs-target="panel" data-onglet="{{ onglet }}" hidden>
        <div class="flex items-center gap-3 pb-3">
            <div class="flex flex-col">
                <twig:Typography variant="body-xs" textColor="neutral-500" bold class="uppercase tracking-[0.8px]">DAM</twig:Typography>
                <twig:Typography variant="heading-3" element="h2" bold>{{ titre }}</twig:Typography>
            </div>
            <span class="inline-flex"><twig:Tag label="{{ documents|length }}" variant="neutral" size="sm" /></span>
        </div>
        <twig:Typography variant="body-sm" textColor="neutral-500">{{ description }}</twig:Typography>

        {# Le dépôt vit dans sa modale, ouverte par la tuile « Ajouter ». #}
        <twig:Modal identifier="document-ajout-{{ onglet }}">
            <div class="flex flex-col gap-4 w-[min(560px,80vw)]">
                <twig:Typography variant="heading-3" bold>Ajouter — {{ titre }}</twig:Typography>
                <twig:Typography variant="body-sm" textColor="neutral-500">
                    PDF, JPEG ou PNG. Les originaux restent privés tant que les droits ne sont pas validés.
                </twig:Typography>
                {{ form_start(upload_form, {attr: {class: 'flex flex-col gap-3'}}) }}
                    {{ form_widget(upload_form) }}
                {{ form_end(upload_form) }}
                <div class="flex justify-end">
                    <twig:Modal:TriggerButton variant="text" size="sm" modalIdentifier="document-ajout-{{ onglet }}"
                                              data-action="modal-trigger-button#close">Fermer</twig:Modal:TriggerButton>
                </div>
            </div>
        </twig:Modal>
        {# Même système que les photos : une tuile par document, le clic
           ouvre ses paramètres en modale (préchargée avec celles des photos). #}
        <div class="flex flex-row flex-wrap gap-4 py-4">
            {% for document in documents %}
                {{ _self.tuile_document(document) }}
            {% endfor %}
            <button type="button"
                    data-controller="modal-trigger-button"
                    data-modal-trigger-button-modal-identifier-value="document-ajout-{{ onglet }}"
                    data-action="modal-trigger-button#open"
                    class="w-[250px] h-[170px] shrink-0 flex flex-col items-center justify-center gap-1.5
                           rounded-xs cursor-pointer bg-neutral-100 inset-ring-1 inset-ring-primary">
                <twig:Icon name="plus" class="w-[22px] h-[22px] text-primary" />
                <twig:Typography variant="body-sm" textColor="primary-3" bold>Ajouter un document</twig:Typography>
            </button>
        </div>
    </section>
{% endmacro %}

{% if not creation %}
    <div data-controller="lieu-media"
         data-lieu-media-upload-url-value="{{ path('app_pim_lieu_photo_upload', {id: lieu.id}) }}"
         data-lieu-media-order-url-value="{{ path('app_pim_lieu_photo_order', {id: lieu.id}) }}"
         data-lieu-media-modales-url-value="{{ path('app_pim_lieu_media_modales', {id: lieu.id}) }}"
         data-lieu-media-token-value="{{ media_csrf_token }}">

        {# ---- Photos : toute la carte est la zone de dépôt (maquette). ---- #}
        <section class="card lieu-media-manager"
                 data-media-tabs-target="panel" data-onglet="photos"
                 data-lieu-media-target="dropzone"
                 data-action="dragover->lieu-media#dragover dragleave->lieu-media#dragleave drop->lieu-media#drop">
            <div class="flex items-center gap-3 pb-3">
                <div class="flex flex-col">
                    <twig:Typography variant="body-xs" textColor="neutral-500" bold class="uppercase tracking-[0.8px]">DAM</twig:Typography>
                    <twig:Typography variant="heading-3" element="h2" bold>Photos du lieu</twig:Typography>
                </div>
                <span class="inline-flex"><twig:Tag label="{{ photos|length }}/25" variant="primary-3" size="sm" /></span>
                <span class="flex-1"></span>
                <twig:Typography variant="body-xs" textColor="neutral-400">25 Mo max · 960 × 480 px · format paysage</twig:Typography>
            </div>
            <twig:Typography variant="body-sm" textColor="neutral-500" element="p" class="pb-3">
                Déposez une ou plusieurs images n'importe où sur cette carte, glissez les vignettes pour les
                réordonner — la première est la photo principale — et choisissez la catégorie de chaque photo
                sous sa vignette. Au survol d'une vignette : recadrer, informations, supprimer.
            </twig:Typography>
            {# L'input (sr-only) reste dans la page : la tuile « Ajouter un
               média » l'ouvre par son libellé, le dépôt se fait sur la carte. #}
            {{ form_start(media_upload_form) }}
                {{ form_widget(media_upload_form.photos) }}
            {{ form_end(media_upload_form) }}
            <div class="lieu-media-progress" hidden data-lieu-media-target="progress"><span data-lieu-media-target="progressBar"></span></div>
            <p class="form-error" hidden data-lieu-media-target="error"></p>

            {% include 'pim/_medias_galerie_photos.html.twig' with {
                photos: photos,
                media_upload_form: media_upload_form,
                photo_usages: photo_usages,
                salles: salles,
                routes: { categorie: 'app_pim_lieu_photo_categorie', delete: 'app_pim_lieu_photo_delete' },
                route_params: { id: lieu.id },
            } only %}

            {# Paramètres de chaque photo : une modale par vignette, dans
               _medias_modales.html.twig — préchargée en arrière-plan après
               le chargement de la page (lieu-media#connect). #}
        </section>

        {# ---- Documents, répartis par onglet maquette. ---- #}
        {{ _self.panneau_documents('plans', 'Plans',
            'Plans de salle et plan général du lieu. Les originaux restent privés, une copie publique n’est créée qu’après validation des droits.',
            documents|filter(d => d.onglet == 'plans'), document_upload_forms.plans) }}
        {{ _self.panneau_documents('supports', 'Supports commerciaux',
            'Plaquettes et supports de présentation du lieu. Les originaux restent privés, une copie publique n’est créée qu’après validation des droits.',
            documents|filter(d => d.onglet == 'supports'), document_upload_forms.supports) }}
        {{ _self.panneau_documents('documents', 'Documents administratifs',
            'Pièces administratives et légales (RIB, attestations, conditions générales…) — toujours privées.',
            documents|filter(d => d.onglet == 'documents'), document_upload_forms.documents) }}
    </div>
{% else %}
    <section class="card"><h2>Photos du lieu</h2><p>Enregistrez d’abord le lieu, puis vous pourrez ajouter plusieurs images, leurs métadonnées et les documents de la fiche.</p></section>
{% endif %}
