{# Documents et supports commerciaux existants d'une fiche (gammes Restaurant,
   Activité, Service). Extrait des anciennes vues « modifier » ; inclus par
   l'éditeur MDM, section Médias.
   Variables : documents (du ViewBuilder de la gamme), entite_id, download_route. #}
<section class="card">
    <div class="section-heading">
        <h2>Documents existants</h2>
        <span class="badge">{{ documents|length }}</span>
    </div>
    {% for document in documents %}
        <article class="lieu-photo-card">
            <p>
                <strong>{{ document.resource.legende ?: 'Support commercial' }}</strong>
                <span class="badge badge-info">{{ document.resource.publicationStatus ? document.resource.publicationStatus.value : 'privé' }}</span>
            </p>
            {{ form(document.metadata_form) }}
            {{ form(document.replace_form) }}
            <p><a href="{{ path(download_route, {id: entite_id, resourceId: document.resource.id}) }}">Télécharger l’original</a></p>
            {% if is_granted('ROLE_BP_VALIDATOR') %}
                {{ form(document.publication_form) }}
            {% endif %}
            {{ form(document.delete_form) }}
        </article>
    {% else %}
        <p class="empty-state">Aucun document.</p>
    {% endfor %}
</section>
