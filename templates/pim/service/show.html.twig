{% extends 'base.html.twig' %}

{% block title %}{{ service.label ?? 'Service' }}{% endblock %}

{% block body %}
<main class="page page-narrow">
    <a class="back-link" href="{{ path('app_pim_service_index') }}">← Retour aux services</a>
    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-kicker">Fiche Service</p>
            <h1>{{ service.label ?? 'Sans libellé' }}</h1>
        </div>
        <div class="table-actions">
            <a class="btn btn-secondary" href="{{ path('app_enrichment_fiche_translation_show', {id: service.id}) }}">Traductions</a>
            <a class="btn" href="{{ path('app_pim_service_edit', {id: service.id}) }}">Modifier</a>
            {% if is_granted('ROLE_BP_VALIDATOR') %}
                <a class="btn btn-secondary" href="{{ path('app_pim_service_history', {id: service.id}) }}">Historique</a>
            {% endif %}
        </div>
    </header>
    {% include 'pim/_completeness.html.twig' with {entity: service} only %}
    <section class="card">
        <dl class="definition-list">
            <dt>Code</dt>
            <dd>{{ service.code ?? '—' }}</dd>

            <dt>Prestations</dt>
            <dd>{{ service.prestations|join(', ') ?: '—' }}</dd>

            <dt>Rayon</dt>
            <dd>{{ service.modeIntervention ? service.modeIntervention.value : '—' }}</dd>

            <dt>Statut</dt>
            <dd>
                <span class="badge badge-info">{{ service.fiche.status.value }}</span>
            </dd>
        </dl>
    </section>

    <section class="card">
        <h2>Description</h2>
        <p>{{ service.descriptionGenerale ?? '—' }}</p>
    </section>

    <section class="card">
        <h2>Cycle de validation</h2>

        {% if service.fiche.status.value == 'en_cours' and is_granted('FICHE_SUBMIT', service.fiche) %}
            {{ form(submit_form) }}
        {% endif %}

        {% if service.fiche.status.value == 'en_attente_validation' and is_granted('FICHE_VALIDATE', service.fiche) %}
            {{ form(validate_form) }}
            {{ form(reject_form) }}
        {% endif %}

        {% if service.fiche.status.value == 'publiee' and is_granted('FICHE_ARCHIVE', service.fiche) %}
            {{ form(archive_form) }}
        {% endif %}
    </section>

    {% if is_granted('FICHE_DELETE', service.fiche) %}
        <div class="danger-form">
            {{ form(delete_form) }}
        </div>
    {% endif %}
</main>
{% endblock %}
