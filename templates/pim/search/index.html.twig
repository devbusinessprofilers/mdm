{% extends 'base.html.twig' %}

{% block title %}Recherche globale du PIM{% endblock %}

{% block body %}
<main class="page">
    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-kicker">PIM</p>
            <h1>Recherche globale</h1>
            <p class="page-description">Recherchez simultanément dans les lieux, activités, restaurants et services.</p>
        </div>
    </header>

    <section class="toolbar global-search-toolbar" aria-label="Critères de recherche">
        {{ form(search_form) }}
    </section>

    {% if query == '' %}
        <section class="card empty-state">
            Saisissez un code, un libellé, une ville ou un autre terme indexé pour lancer la recherche.
        </section>
    {% else %}
        <div class="section-heading global-search-summary">
            <h2>{{ page.totalCount }} résultat{{ page.totalCount > 1 ? 's' : '' }} pour « {{ query }} »</h2>
        </div>
        <div class="table-shell">
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr><th>Type</th><th>Code et libellé</th><th>Ville</th><th>Statut</th><th>Complétude</th><th>Modification</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                    {% for result in page.results %}
                        {% set item = result.item %}
                        {% set type_label = item.type.value == 'lieu' ? 'Lieu' : (item.type.value == 'activite' ? 'Activité' : (item.type.value == 'restaurant' ? 'Restaurant' : 'Service')) %}
                        {% set status_label = item.status.value == 'en_cours' ? 'En cours' : (item.status.value == 'en_attente_validation' ? 'En attente' : (item.status.value == 'validee' ? 'Validée' : (item.status.value == 'publiee' ? 'Publiée' : 'Archivée'))) %}
                        <tr>
                            <td><span class="badge badge-neutral">{{ type_label }}</span></td>
                            <td><strong>{{ item.code }}</strong><br>{{ item.label|default('—') }}</td>
                            <td>{{ item.ville|default('—') }}</td>
                            <td><span class="badge {{ item.status.value == 'publiee' ? 'badge-success' : (item.status.value == 'archivee' ? 'badge-neutral' : 'badge-info') }}">{{ status_label }}</span></td>
                            <td>{{ item.completeness }} %</td>
                            <td><time datetime="{{ item.updatedAt|date('c') }}">{{ item.updatedAt|date('d/m/Y H:i') }}</time></td>
                            <td><div class="table-actions"><a class="text-link" href="{{ result.showUrl }}">Voir</a><a class="text-link" href="{{ result.editUrl }}">Modifier</a></div></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="empty-state">Aucun résultat ne correspond à ces critères.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if page.nextCursor %}
            <nav class="pagination" aria-label="Pagination des résultats">
                <span>Les résultats sont classés par pertinence.</span>
                <a class="btn btn-secondary" href="{{ path('app_pim_global_search', {q: query, type: type ? type.value : null, status: status ? status.value : null, country: country, completeness_min: completeness_min, completeness_max: completeness_max, limit: limit, cursor: page.nextCursor}) }}">Résultats suivants</a>
            </nav>
        {% endif %}
    {% endif %}
</main>
{% endblock %}
