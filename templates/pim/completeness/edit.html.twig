{% extends 'mdm/simple.html.twig' %}
{% block title %}Modifier {{ configuration.fieldCode }}{% endblock %}
{% block corps %}<main class="page page-narrow">
    <a class="back-link" href="{{ path('app_pim_completeness_index', {type: configuration.ficheType.value}) }}">← Retour à la complétude</a>
    <header class="page-header"><div><p class="page-kicker">{{ configuration.ficheType.value|replace({'_': ' '}) }}</p><h1>{{ configuration.label }}</h1><code>{{ configuration.fieldCode }}</code></div></header>
    <section class="card"><dl class="definition-list"><dt>Chemin métier</dt><dd>{{ definition.path }}</dd><dt>Condition</dt><dd>{{ definition.conditionLabel ?? 'Toujours applicable' }}</dd><dt>Cible de l’entité</dt><dd>{{ definition.defaultTargetLength ?? 'Non définie' }}</dd></dl></section>
    {{ form_start(form, {attr: {class: 'card form-stack'}}) }}{{ form_widget(form) }}{{ form_end(form) }}
    <section class="card table-wrapper">
        <div class="section-heading"><div><p class="page-kicker">Gouvernance</p><h2>Historique de configuration</h2></div></div>
        <table><thead><tr><th>Date</th><th>Révision</th><th>Auteur</th><th>Source</th><th>Avant</th><th>Après</th></tr></thead><tbody>
        {% for audit in audits %}<tr>
            <td>{{ audit.changedAt|date('d/m/Y H:i:s') }}</td><td>{{ audit.revision }}</td><td>{{ audit.actor }}</td><td>{{ audit.source }}</td>
            <td><code>{{ audit.before ? audit.before|json_encode : 'Création' }}</code></td><td><code>{{ audit.after ? audit.after|json_encode : 'Suppression' }}</code></td>
        </tr>{% else %}<tr><td colspan="6">Aucune modification historisée.</td></tr>{% endfor %}
        </tbody></table>
    </section>
</main>{% endblock %}
