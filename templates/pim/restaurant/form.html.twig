{% extends 'base.html.twig' %}

{% macro collection(field, title) %}
    <fieldset
        data-controller="form-collection"
        data-form-collection-index-value="{{ field|length }}"
        data-form-collection-prototype-value="{{ form_widget(field.vars.prototype)|e('html_attr') }}"
    >
        <legend>{{ title }}</legend>
        <div data-form-collection-target="items">
            {% for item in field %}
                <fieldset data-form-collection-item>
                    {{ form_widget(item) }}
                    <button type="button" data-action="form-collection#remove">Retirer</button>
                </fieldset>
            {% endfor %}
        </div>
        <button type="button" data-action="form-collection#add" data-remove-label="Retirer">Ajouter</button>
    </fieldset>
{% endmacro %}

{% block title %}{{ creation ? 'Nouveau restaurant' : 'Modifier le restaurant' }}{% endblock %}

{% block body %}
<main class="page">
    <a class="back-link" href="{{ path('app_pim_restaurant_index') }}">← Retour aux restaurants</a>
    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-kicker">Fiche Restaurant</p>
            <h1>{{ creation ? 'Nouveau restaurant' : 'Modifier le restaurant' }}</h1>
        </div>
    </header>

    {{ form_start(form) }}
        {{ form_errors(form) }}

        <section class="card">
            <h2>Informations générales</h2>
            {{ form_row(form.label) }}
            {{ form_row(form.typesRestaurant) }}
            {{ form_row(form.typesCuisine) }}
            {{ form_row(form.specificitesAlimentaires) }}
            {{ form_row(form.typesEvenement) }}
            {{ form_row(form.siteOfficiel) }}
        </section>

        <section class="card">
            <h2>Disponibilités</h2>
            {{ form_row(form.privatisationTotale) }}
            {{ form_row(form.privatisationPartielle) }}
            {{ form_row(form.joursOuverture) }}
            {{ form_row(form.heureOuverture) }}
            {{ form_row(form.heureFermeture) }}
            {{ _self.collection(form.periodesFermeture, 'Périodes de fermeture') }}
        </section>

        <section class="card">
            <h2>Localisation et accessibilité</h2>
            <p class="page-description">Champs texte pour la V1. L’autocomplétion et la minicarte seront ajoutées lors du passage au front.</p>
            {% if duplicate_address_count > 0 %}
                <p class="flash-warning" role="status">
                    Cette adresse est déjà utilisée par {{ duplicate_address_count }} autre{{ duplicate_address_count == 1 ? '' : 's' }} fiche{{ duplicate_address_count == 1 ? '' : 's' }} Lieu ou Restaurant. La sauvegarde reste autorisée.
                </p>
            {% endif %}
            {{ form_widget(form.localisation) }}
            {{ _self.collection(form.acces, 'Accès à proximité') }}
            {{ form_row(form.accesPmr) }}
            {{ form_row(form.toilettesPmr) }}
        </section>

        <section class="card">
            <h2>Description</h2>
            {{ form_row(form.descriptionGenerale) }}
            {{ form_row(form.atouts) }}
        </section>

        <section class="card">
            <h2>Capacités et salles</h2>
            {{ form_row(form.capaciteAssiseMax) }}
            {{ form_row(form.capaciteEspacePrivatisable) }}
            {{ form_row(form.capaciteBanquet) }}
            {{ form_row(form.capaciteCocktail) }}
            {{ _self.collection(form.salles, 'Salles et espaces privatisables') }}
        </section>

        <section class="card">
            <h2>Services, équipements et RSE</h2>
            {{ form_row(form.services) }}
            {{ form_row(form.equipements) }}
            {{ form_row(form.engagementsRse) }}
        </section>

        <section class="card">
            <h2>Médias et documents</h2>
            {{ form_row(form.youtubeUrl) }}
            {{ _self.collection(form.ressources, 'Photos — dix maximum') }}

            <h3>Nouveaux menus</h3>
            {{ form_row(form.menus) }}

            <h3>Nouveaux supports commerciaux</h3>
            {{ form_row(form.supportsCommerciaux) }}
            {{ form_row(form.documentTitle) }}
            {{ form_row(form.documentSource) }}
            {{ form_row(form.documentRightsGranted) }}
        </section>

        {{ form_row(form.submit) }}
    {{ form_end(form) }}

    {% if not creation %}
        <section class="card">
            <h2>Documents existants</h2>
            {% for document in documents %}
                <article class="lieu-photo-card">
                    <strong>{{ document.resource.legende ?: document.resource.usage }}</strong>
                    <span class="badge badge-info">{{ document.resource.publicationStatus ? document.resource.publicationStatus.value : 'privé' }}</span>
                    {{ form(document.metadata_form) }}
                    {{ form(document.replace_form) }}
                    <a href="{{ path('app_pim_restaurant_document_download', {
                        id: restaurant.id,
                        resourceId: document.resource.id
                    }) }}">Télécharger</a>
                    {% if is_granted('ROLE_BP_VALIDATOR') %}
                        {{ form(document.publication_form) }}
                    {% endif %}
                    {{ form(document.delete_form) }}
                </article>
            {% else %}
                <p class="empty-state">Aucun document.</p>
            {% endfor %}
        </section>
    {% endif %}
</main>
{% endblock %}
