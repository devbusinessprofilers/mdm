{#
    Surcouche du thème de formulaire réservée à l'éditeur de fiche. Appliquée par
    {% form_theme %} sur le seul formulaire de la fiche : le thème global fournit
    tous les autres blocs, celui-ci ne redéfinit que le libellé pour y greffer le
    chrome « autorité » — une pastille de couleur à gauche du libellé et un badge
    nommant l'autorité à droite (qui fait foi sur le champ).

    Défaut MDM ; un champ réellement piloté par Salesforce porte
    label_attr['data-autorite'] = 'Salesforce' (cf. App\Pim\Enum\Autorite). Les
    groupes (sous-formulaires composés) gardent un libellé nu — la pastille n'a
    de sens que sur un champ terminal.

    Les classes de couleur sont écrites en toutes lettres : Tailwind ne scanne
    pas le PHP et n'émettrait pas des classes construites dynamiquement.
#}
{#- Case « puce » (opt-in `attr['data-puce']`) : l'input nu, masqué —
    le libellé-pilule qui l'enveloppe porte tout le rendu (mdm/fiche/_puces). -#}
{%- block checkbox_widget -%}
    {%- if attr['data-puce']|default(false) -%}
        <input
            type="checkbox"
            id="{{ id }}"
            name="{{ full_name }}"
            value="{{ value|default('1') }}"
            {% if checked %}checked{% endif %}
            {% if disabled %}disabled{% endif %}
            class="sr-only"
        >
    {%- else -%}
        <twig:Form:Checkbox
            id="{{ id }}"
            name="{{ full_name }}"
            value="{{ value|default('1') }}"
            :checked="checked"
            :disabled="disabled"
            :inputAttributes="attr"
        />
    {%- endif -%}
{%- endblock -%}

{#- Sous-formulaires : la grille 2 colonnes de la maquette s'applique à chaque
    niveau — champ simple en demi-largeur ; riche, collection ou groupe en
    pleine largeur. Les cases à cocher passent toutes SOUS les autres champs,
    deux par rangée en demi-largeur (même règle dans la boucle des volets
    de mdm/fiche_editeur). Les champs cachés ne prennent pas de place dans le
    flux. -#}
{%- block form_rows -%}
    <div class="flex flex-row flex-wrap gap-x-6 gap-y-5">
        {%- set enfants = form.children|filter(c => not c.rendered) -%}
        {%- for enfant in enfants|filter(c => 'checkbox' not in c.vars.block_prefixes) -%}
            {%- set pleine = enfant.vars.compound|default(false)
                or enfant.vars.prototype is defined
                or enfant.vars.attr['data-wysiwyg']|default(false)
                or 'textarea' in enfant.vars.block_prefixes -%}
            {{- form_row(enfant, { row_attr: { class: pleine ? 'w-full' : 'w-[calc(50%-12px)]' } }) -}}
        {%- endfor -%}
        {%- for enfant in enfants|filter(c => 'checkbox' in c.vars.block_prefixes) -%}
            {{- form_row(enfant, { row_attr: { class: 'w-[calc(50%-12px)]' } }) -}}
        {%- endfor -%}
    </div>
{%- endblock -%}

{#- Champ riche de l'éditeur de fiche : le Wysiwyg du thème global, plus la
    pilule « Suggérer » de la maquette. La pilule appelle l'IA (contrôleur
    Stimulus champ-suggestion) sur les champs Wysiwyg et sur les zones de texte
    portant `data-suggerer` ; gamme/id/URL/jeton/état actif sont lus sur le
    formulaire de la fiche (mdm/fiche_editeur). Branche wysiwyg synchronisée
    avec textarea_widget du thème global. -#}
{%- block textarea_widget -%}
    {#- Pilule partagée par les deux branches : le contenu courant est lu côté
        client (TinyMCE si Wysiwyg, sinon la zone de texte) puis remplacé. -#}
    {%- set pilule_suggerer -%}
        <div class="flex flex-col items-end gap-1">
            <button type="button" data-action="click->champ-suggestion#suggerer"
                    data-champ-suggestion-target="bouton"
                    class="shrink-0 flex items-center gap-1 px-2 py-1 rounded-full bg-primary-4 hover:bg-primary-4/80 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
                <twig:Icon name="ai" class="w-3.5 h-3.5 text-primary-3" />
                <span data-champ-suggestion-target="libelle" class="antialiased text-[0.625rem] leading-[1rem] font-sans font-[900] text-primary-3">Suggérer</span>
            </button>
            <span data-champ-suggestion-target="statut" class="hidden antialiased text-[0.625rem] leading-[1rem] font-sans text-red-600"></span>
        </div>
    {%- endset -%}
    {%- if attr['data-wysiwyg']|default(false) -%}
        <div class="flex flex-col gap-2"
             data-controller="champ-suggestion"
             data-champ-suggestion-champ-value="{{ label|default(name|humanize) }}"
             data-champ-suggestion-field-id-value="{{ id }}">
            <twig:Form:Wysiwyg
                id="{{ id }}"
                name="{{ full_name }}"
                value="{{ value }}"
                :disabled="disabled"
                :maxLength="attr.maxlength|default(0)"
                :compteur="attr['data-compteur']|default(0)"
                class="[&_.tox-tinymce]:h-[200px]!"
            />
            <div class="flex flex-row justify-end">{{ pilule_suggerer }}</div>
        </div>
    {%- elseif attr['data-compteur']|default(0) > 0 -%}
        {#- Zone de texte simple avec compteur « x / N » (opt-in `data-compteur`,
            bible row 53) : le contrôleur compteur-caracteres lit le champ à
            chaque saisie. -#}
        <div class="flex flex-col gap-1"
             data-controller="compteur-caracteres"
             data-compteur-caracteres-max-value="{{ attr['data-compteur'] }}">
            <twig:Form:Textarea
                id="{{ id }}"
                name="{{ full_name }}"
                value="{{ value }}"
                :disabled="disabled"
                data-compteur-caracteres-target="champ"
                data-action="input->compteur-caracteres#actualiser"
            />
            <div class="flex justify-end">
                <span data-compteur-caracteres-target="affichage" class="antialiased text-[0.75rem] leading-[1.25rem] font-sans text-neutral-500">0 / {{ attr['data-compteur'] }}</span>
            </div>
        </div>
    {%- elseif attr['data-suggerer']|default(false) -%}
        <div class="flex flex-col gap-2"
             data-controller="champ-suggestion"
             data-champ-suggestion-champ-value="{{ label|default(name|humanize) }}"
             data-champ-suggestion-field-id-value="{{ id }}">
            <twig:Form:Textarea
                id="{{ id }}"
                name="{{ full_name }}"
                value="{{ value }}"
                :disabled="disabled"
            />
            <div class="flex flex-row justify-end">{{ pilule_suggerer }}</div>
        </div>
    {%- else -%}
        <twig:Form:Textarea
            id="{{ id }}"
            name="{{ full_name }}"
            value="{{ value }}"
            :disabled="disabled"
        />
    {%- endif -%}
{%- endblock -%}

{#- Rangée d'une case : la case et son libellé (pastille + badge d'autorité)
    sur la même ligne — l'empilement libellé-au-dessus laissait la moitié de
    la cellule vide. -#}
{%- block checkbox_row -%}
    <div class="flex flex-col gap-1{% if row_attr.class is defined %} {{ row_attr.class }}{% endif %}">
        <div class="flex flex-row items-center gap-2">
            {{- form_widget(form) -}}
            <div class="grow min-w-0">{{ form_label(form) }}</div>
        </div>
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock -%}

{%- block form_label -%}
    {%- if label is not same as(false) -%}
        {%- if label is empty -%}
            {%- set label = name|humanize -%}
        {%- endif -%}
        {#- Classes Typography inlinées (rendu par champ, ~60 fois par fiche) :
            synchroniser avec Typography.html.twig / _typography_markup.html.twig.
            Graisse normale, comme la maquette (variant input, jamais bold). -#}
        {%- set libelle -%}
            <span class="antialiased text-[0.875rem] leading-[1.375rem] font-sans text-base-text">
                {{- translation_domain is same as(false) ? label : label|trans({}, translation_domain) -}}
                {%- if required %} *{% endif -%}
            </span>
        {%- endset -%}
        <label for="{{ id }}"{% if disabled %} class="cursor-not-allowed"{% endif %}>
            {%- if compound|default(false) -%}
                {{- libelle -}}
            {%- else -%}
                {#- La pastille suffit, la légende de carte la décode — le badge
                    nommant l'autorité sur chaque champ a été retiré (bruit).
                    Un champ piloté par Salesforce porte en plus le cadenas
                    maquette. -#}
                {%- set autorite = label_attr['data-autorite']|default('MDM') -%}
                {%- set pastille = { 'MDM': 'bg-primary', 'Salesforce': 'bg-primary-3', 'Prestataire': 'bg-peach' }[autorite]|default('bg-primary') -%}
                <span class="flex items-center gap-2" title="{{ { 'MDM': 'Maîtrisé par le MDM', 'Salesforce': 'Lecture seule · Salesforce', 'Prestataire': 'Déclaré par le prestataire' }[autorite]|default(autorite) }}">
                    <span class="w-2 h-2 shrink-0 rounded-full {{ pastille }}"></span>
                    {{- libelle -}}
                    {%- if 'Salesforce' == autorite -%}
                        <twig:Icon name="lock" class="w-3.5 h-3.5 shrink-0 text-neutral-400"
                                   title="Champ maîtrisé par Salesforce" />
                    {%- endif -%}
                </span>
            {%- endif -%}
        </label>
    {%- endif -%}
{%- endblock -%}
