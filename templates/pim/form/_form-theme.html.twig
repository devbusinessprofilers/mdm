{#
    Thème de formulaire Tailwind du back-office.

    Il adapte le rendu Symfony aux composants du design-system : les pages
    gardent {{ form_row() }} / {{ form_widget() }} / {{ form() }} (donc le CSRF
    et la validation natifs), et l'apparence vient d'ici. Chaque widget délègue
    au composant Twig correspondant — source unique de vérité pour le markup et
    les classes, plutôt qu'une copie du HTML.

    Enregistré globalement dans config/packages/twig.yaml.
#}
{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    <div class="flex flex-col gap-2{% if row_attr.class is defined %} {{ row_attr.class }}{% endif %}">
        {#- L'erreur se pose sur la ligne du libellé : rendue entre le libellé
            et le champ, elle décalait le champ par rapport à ses voisins dans
            les grilles à deux colonnes. -#}
        {%- if label is not same as(false) and errors|length > 0 -%}
            <div class="flex items-baseline justify-between gap-x-3">
                {{- form_label(form) -}}
                <div class="min-w-0 text-right">{{- form_errors(form) -}}</div>
            </div>
        {%- else -%}
            {{- form_label(form) -}}
            {{- form_errors(form) -}}
        {%- endif -%}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock -%}

{%- block form_label -%}
    {%- if label is not same as(false) -%}
        {%- if label is empty -%}
            {%- set label = name|humanize -%}
        {%- endif -%}
        {#- Classes Typography inlinées (rendu par champ, ~60 fois par fiche) :
            synchroniser avec Typography.html.twig / _typography_markup.html.twig. -#}
        <label for="{{ id }}"{% if disabled %} class="cursor-not-allowed"{% endif %}>
            <span class="antialiased text-[0.875rem] leading-[1.375rem] font-sans text-base-text font-[900]">
                {{- label is same as(false) ? '' : (translation_domain is same as(false) ? label : label|trans({}, translation_domain)) -}}
                {%- if required %} *{% endif -%}
            </span>
        </label>
    {%- endif -%}
{%- endblock -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <span class="antialiased text-[0.75rem] leading-[1.25rem] font-sans text-neutral-500">
            {{- translation_domain is same as(false) ? help : help|trans({}, translation_domain) -}}
        </span>
    {%- endif -%}
{%- endblock -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="flex flex-col gap-1">
            {%- for error in errors -%}
                <li><span class="antialiased text-[0.75rem] leading-[1.25rem] font-sans text-error">{{ error.message }}</span></li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock -%}

{%- block form_widget_simple -%}
    {#- Un champ peut forcer son type HTML natif (time, date…) via attr.type. -#}
    {%- set type = attr.type|default(type|default('text')) -%}
    {%- if 'file' == type and attr['data-dropzone']|default(false) -%}
        {#- Zone de dépôt du design-system (opt-in `attr: { 'data-dropzone': true }`) :
            l'input natif est soumis avec le formulaire, le contrôleur dropzone
            gère cartes et retraits. -#}
        <twig:Form:Dropzone
            id="{{ id }}"
            name="{{ full_name }}"
            accept="{{ attr.accept|default('') }}"
            :maxFileCount="attr['data-max-files']|default(5)"
            fileMaxSize="{{ attr['data-max-size']|default('5M') }}"
            :disabled="disabled"
            form="{{ attr.form|default('') }}"
        />
    {%- elseif type in ['hidden', 'file'] -%}
        {#- champs sans composant dédié : rendu Symfony standard -#}
        {{- parent() -}}
    {%- else -%}
        {%- set attrs_entree = { 'type': type == 'text' ? 'text' : type } -%}
        {#- Un champ rendu hors du <form> (volet Médias) s'y rattache par
            l'attribut HTML natif `form` (attr: { form: 'form-fiche' }). -#}
        {%- if attr.form is defined -%}{%- set attrs_entree = attrs_entree|merge({ 'form': attr.form }) -%}{%- endif -%}
        {%- if attr.autocomplete is defined -%}{%- set attrs_entree = attrs_entree|merge({ 'autocomplete': attr.autocomplete }) -%}{%- endif -%}
        {%- if attr.autofocus is defined and attr.autofocus -%}{%- set attrs_entree = attrs_entree|merge({ 'autofocus': 'autofocus' }) -%}{%- endif -%}
        <twig:Form:TextInput
            id="{{ id }}"
            name="{{ full_name }}"
            value="{{ value }}"
            :disabled="disabled"
            :readonly="attr.readonly is defined and attr.readonly"
            placeholder="{{ attr.placeholder|default('') }}"
            :inputAttributes="attrs_entree"
        />
    {%- endif -%}
{%- endblock -%}

{%- block money_widget -%}
    {#- Le composant MoneyInput porte l'icône € dans le champ (masque fr) —
        pas de motif « {{ widget }} € » Symfony posé en texte nu autour. -#}
    <twig:Form:MoneyInput
        id="{{ id }}"
        name="{{ full_name }}"
        placeholder="{{ attr.placeholder|default('') }}"
        :scale="2"
        :disabled="disabled"
        :inputAttributes="value != '' ? { value: value } : {}"
    />
{%- endblock -%}

{%- block password_widget -%}
    {#- `data-with-control` (opt-in via l'attr du champ) affiche la jauge et
        les règles de robustesse du composant Password du portail. -#}
    <twig:Form:Password
        id="{{ id }}"
        name="{{ full_name }}"
        :disabled="disabled"
        :withControl="attr['data-with-control'] is defined"
        placeholder="{{ attr.placeholder|default('') }}"
        autocomplete="{{ attr.autocomplete|default('') }}"
    />
{%- endblock -%}

{%- block textarea_widget -%}
    {%- if attr['data-wysiwyg']|default(false) -%}
        {#- Zone de texte enrichie (opt-in via `attr: { 'data-wysiwyg': true }`
            dans la définition du champ) : montée sur TinyMCE par le composant
            Wysiwyg. `[&_.tox-tinymce]:h-[200px]!` cale la hauteur compacte de la
            maquette — `maxHeight` ne borne que l'auto-croissance, pas le socle. -#}
        <twig:Form:Wysiwyg
            id="{{ id }}"
            name="{{ full_name }}"
            value="{{ value }}"
            :disabled="disabled"
            :maxLength="attr.maxlength|default(0)"
            class="[&_.tox-tinymce]:h-[200px]!"
        />
    {%- else -%}
        <twig:Form:Textarea
            id="{{ id }}"
            name="{{ full_name }}"
            value="{{ value }}"
            :disabled="disabled"
        />
    {%- endif -%}
{%- endblock -%}

{%- block choice_widget_collapsed -%}
    {%- set est_autocomplete = attr['data-controller'] is defined and 'autocomplete' in attr['data-controller'] -%}
    {%- if est_autocomplete -%}
        {#- Champ ux-autocomplete : garder le <select> natif porteur du contrôleur
            Stimulus et de l'URL, que tom-select transforme côté JS. -#}
        {{- parent() -}}
    {%- else -%}
        {#- Un select multiple soumet un tableau : son `name` doit porter `[]` —
            que Symfony fournit déjà sur un ChoiceType multiple replié, d'où le
            garde contre le doublon `[][]`. -#}
        <twig:Form:Select
            id="{{ id }}"
            name="{{ full_name }}{{ multiple and not (full_name ends with '[]') ? '[]' : '' }}"
            :choices="choices"
            :value="value"
            :multiple="multiple"
            :disabled="disabled"
            :required="required"
            :limit="attr['data-max']|default(null)"
            placeholder="{{ attr.placeholder|default('') }}"
        />
    {%- endif -%}
{%- endblock -%}

{%- block checkbox_widget -%}
    {#- `value` porte « 1 » pour une case booléenne, ou la valeur du choix pour
        une case issue d'un ChoiceType « expanded » — indispensable pour que la
        bonne valeur soit soumise. `attr` est relayé sur l'input (cibles et
        actions Stimulus des cases de sélection, notamment). -#}
    <twig:Form:Checkbox
        id="{{ id }}"
        name="{{ full_name }}"
        value="{{ value|default('1') }}"
        :checked="checked"
        :disabled="disabled"
        :inputAttributes="attr"
    />
{%- endblock -%}

{%- block button_widget -%}
    {%- set button_label = label is not same as(false)
        ? (label is empty ? name|humanize : (translation_domain is same as(false) ? label : label|trans(label_translation_parameters, translation_domain)))
        : '' -%}
    {#- `name` et `id` sont indispensables : Symfony détecte un bouton d'action
        cliqué (SubmitButton::isClicked) par la présence de son `name` dans la
        requête. Sans lui, les boutons nommés (« Créer quand même », etc.) ne
        déclenchent plus rien.
        Apparence pilotable par le champ : attr `data-variant`, `data-size`,
        `data-full`, `data-icon` (défauts inchangés : primary, pleine largeur,
        sans icône). -#}
    <twig:Button
        variant="{{ attr['data-variant']|default('primary') }}"
        size="{{ attr['data-size']|default('lg') }}"
        type="{{ type|default('button') }}"
        name="{{ full_name }}"
        id="{{ id }}"
        icon="{{ attr['data-icon']|default('') }}"
        :disabled="disabled"
        :full="attr['data-full']|default(true) == true"
    >{{ button_label }}</twig:Button>
{%- endblock -%}

{%- block submit_widget -%}
    {%- set type = type|default('submit') -%}
    {{- block('button_widget') -}}
{%- endblock -%}
