{%- block provider_portal_password_widget -%}
    <twig:Form:Password
        id="{{ id }}"
        name="{{ full_name }}"
        value="{{ value }}"
        placeholder="{{ (attr.placeholder ?? '')|trans }}"
        class="{{ attr.widgetClass ?? '' }}"
        disabled="{{ disabled }}"
        withControl="{{ with_control }}"
    />
{%- endblock -%}
