{%- block avatar_widget -%}
    <twig:Form:Avatar
        id="{{ id }}"
        name="{{ full_name }}"
        initials="{{ initials }}"
        pictureUrl="{{ picture_url }}"
        inverted="{{ inverted }}"
        accept="{{ attr.accept ?? '' }}"
        disabled="{{ attr.disabled ?? false }}"
    />
{%- endblock -%}

{%- block avatar_row -%}
    <div class="flex flex-col gap-1">
        {{ form_widget(form) }}
        {{ form_label(form) }}
    </div>
{%- endblock -%}
