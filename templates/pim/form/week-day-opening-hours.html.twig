{% block week_day_opening_hours_row %}
    {% set dependencyIdentifier = 'range-wrapper-'~form.vars.id %}
    <div class="flex flex-col gap-2">
        {{ form_row(form.isOpen, {'input_attributes': getFormDependencyTriggerAttributes(dependencyIdentifier)}) }}
        <div
            class="grid grid-cols-2 gap-2 overflow-hidden transition-opacity"
            {{ getFormDependencyWrapperAttributes(dependencyIdentifier)|renderHtmlAttributes }}
        >
            {% if form.from is defined %}
                {{ form_row(form.from) }}
            {% endif %}
            {% if form.to is defined %}
                {{ form_row(form.to) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
