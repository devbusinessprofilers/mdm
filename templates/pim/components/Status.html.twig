{% set iconCva = cva({
    variants: {
        state: {
            true: 'w-4 h-4 bg-success text-neutral-100 rounded-full',
            false: 'w-6 h-6 text-neutral-400',
        },
    },
}) %}
<div class="flex justify-center items-center w-6 h-6">
    <twig:Icon name="{{ state ? 'check' : 'cross-circle' }}" class="{{ iconCva.apply({ 'state': state }) }}"/>
</div>
