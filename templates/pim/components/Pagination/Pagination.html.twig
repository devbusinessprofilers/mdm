{% set arrowCva = cva({
    base: '!p-0 !px-2 text-neutral-500',
    variants: {
        disabled: {
            true: 'opacity-0',
        }
    }
}) %}

<ul {{ attributes.without('class') }} class="flex flex-wrap items-center gap-2 justify-center {{ attributes.render('class') }}">
    {% for item in scope.items %}
        <li>
            {{ component('Pagination:PaginationItem', {
                'label': item.label,
                'disabled': item.isSpacer,
                'isActive': item.isCurrent,
                'page': item.page,
                ...this.getTargetAttributes(item.page),
            }) }}
        </li>
    {% endfor %}
    {# Fake element to force "wrap" in mobile => allows to display both pagination arrows previous/next on separated line #}
    <li class="lg:hidden basis-full"></li>
    <li class="lg:order-first">
        {{ component('Button', {
            'variant': 'text',
            'icon': 'caret-left',
            'class': arrowCva.apply({disabled: scope.disableLeftArrow}),
            ...previousAttributes,
        }) }}
    </li>
    <li class="lg:order-last">
        {{ component('Button', {
            'variant': 'text',
            'icon': 'caret-right',
            'class': arrowCva.apply({disabled: scope.disableRightArrow}),
            ...nextAttributes,
        }) }}
    </li>
</ul>
