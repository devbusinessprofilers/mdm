{% set cva = cva({
    base: '
        flex items-center justify-center rounded-full border p-2 border-neutral-500 w-9 h-9
        focus:outline-none
    ',
    variants: {
        disabled: {
            true: 'text-neutral-500',
            false: 'cursor-pointer',
        },
    },
    compoundVariants: [
        { disabled: false, isActive: false, class: '
            transition-[border-color,background-color] text-neutral-500
            hover:bg-primary-3 hover:text-neutral-100 hover:border-primary-3
            focus:bg-primary-3 focus:text-neutral-100 focus:border-primary-3
        ' },
        { disabled: false,  isActive: true, class: 'bg-primary-3 text-neutral-100 font-bold border-primary-3' },
    ],
}) %}

<button {{ attributes.without('class', 'page') }} class="{{ cva.apply({ disabled, isActive }, attributes.render('class')) }}" id="{{ page }}">
    <twig:Typography variant="text-sm" textColor="controlled" class="transition-[color]">{{- label -}}</twig:Typography>
</button>
