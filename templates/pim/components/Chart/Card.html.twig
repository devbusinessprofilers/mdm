<section
    {{ attributes.without('class') }}
    class="flex flex-col gap-4 bg-neutral-100 rounded-md shadow-(--shadow) p-10 {{ attributes.render('class') }}"
>
    <twig:Typography textColor="neutral-500" bold>{{ label }}</twig:Typography>
    <div class="flex gap-2 items-center">
        <twig:Typography variant="heading-2" bold>{{ value }}</twig:Typography>
        {% if critical %}
            <twig:Tag label="{{ variation }}" icon="trend-down" variant="error" size="lg"/>
        {% else %}
            <twig:Tag label="{{ variation }}" icon="trend-up" variant="success" size="lg"/>
        {% endif %}
    </div>
</section>
