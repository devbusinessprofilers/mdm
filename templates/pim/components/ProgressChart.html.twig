<div class="relative w-fit {{ attributes.render('class') }}">

    {% set data = {
        'datasets': [{
            'data': [value, 100 - value],
            'borderColor': ['#33A0BE'],
            'borderWidth': 1,
            'backgroundColor': [
                '#33A0BE',
                '#FFFFFF',
            ],
            'circumference': 180,
            'rotation': -90,
        }],
    } %}

    {% set options = {
        'aspectRatio': 2,
        'cutout': '75%',
        'hover': { 'mode': null },
        'plugins': {
            'legend': { 'display': false },
            'tooltip': { 'enabled': false },
            'datalabels': { 'display': false },
        },
    } %}

    <twig:Chart
        type="doughnut"
        data="{{ data }}"
        options="{{ options }}"
    />

    <twig:Typography variant="subtitle" bold class="absolute w-full text-center bottom-0">{{ value }}%</twig:Typography>

</div>
