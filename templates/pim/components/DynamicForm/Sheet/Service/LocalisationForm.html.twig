{% include 'pim/form/_form-theme.html.twig' %}

{% set cva = cva({
    base: 'flex flex-col gap-6 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 2xl:p-14',
    variants: {
        isPositionSet: {
            true: 'opacity-100',
            false: 'opacity-0',
        },
    },
}) %}

{{ form_start(form, { 'attr': {
    'id': form.vars.id,
    'class': 'flex flex-col gap-6 lg:gap-8',
    'data-controller': ('live' ~ ' ' ~ (attributes.render('data-controller')|default('')))|trim,
    ...attributes.without('class', 'data-controller'),
} }) }}
<section class="flex flex-col gap-6 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 2xl:p-14">
    <h2><twig:Typography variant="heading-3" bold>{{ 'page.sheet.service.localisation.main.title'|trans }}</twig:Typography></h2>
    {{ form_row(form.address) }}
</section>

<section class="flex flex-col gap-6 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 2xl:p-14">
    <h2><twig:Typography variant="heading-3" bold>{{ 'page.sheet.service.localisation.geographic_range.title'|trans }}</twig:Typography></h2>
    {{ form_row(form.geographicRange) }}
</section>

{% set isPositionSet = form.nearCities is defined %}

{% if isPositionSet %}
    <section class="{{ cva.apply({ isPositionSet }) }}">
        <div class="flex flex-col gap-2">
            <h2><twig:Typography variant="heading-3" bold>{{ 'page.sheet.service.localisation.accessibility.title'|trans }}</twig:Typography></h2>
            <p><twig:Typography>{{ 'page.sheet.service.localisation.accessibility.description'|trans }}</twig:Typography></p>
        </div>
        <div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-x-6 gap-y-4 lg:gap-y-6">
            {{ form_row(form.nearCities) }}
            {{ form_row(form.nearParkings) }}
            {{ form_row(form.nearTrainStations) }}
            {{ form_row(form.nearAirports) }}
        </div>
    </section>
{% endif %}

<section class="flex flex-col gap-6 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 2xl:p-14">
    <h2><twig:Typography variant="heading-3" bold>{{ 'page.sheet.service.localisation.reduced_mobility.title'|trans }}</twig:Typography></h2>
    {{ form_row(form.hasReducedMobilityAccess) }}

    {% if form.isReducedMobilityFriendly is defined %}
        {{ form_row(form.isReducedMobilityFriendly) }}
    {% endif %}
</section>

{{ form_end(form) }}
