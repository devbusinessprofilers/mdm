{#- Les classes des variants body/button + dark sont recopiées en dur dans
    Form/Select.html.twig et Form/_checkbox_markup.html.twig (inlining de
    performance) : les synchroniser si elles changent ici. -#}
{% set cva = cva({
    base: 'antialiased',
    variants: {
        variant: {
            'body': 'text-[0.875rem] leading-[1.375rem] font-sans',
            'body-lg': 'text-[1rem] leading-[1.5rem] font-sans',
            'body-sm': 'text-[0.75rem] leading-[1.25rem] font-sans',
            'body-xs': 'text-[0.625rem] leading-[1rem] font-sans',
            'heading-1': 'text-[2rem] leading-[2.5rem] sm:text-[2.5rem] sm:leading-[3rem] font-title',
            'heading-2': 'text-[1.625rem] leading-[2.125rem] sm:text-[2rem] sm:leading-[2.5rem] font-title',
            'heading-3': 'text-[1.25rem] leading-[1.875rem] sm:text-[1.375rem] font-title',
            'subtitle': 'text-[1.25rem] leading-[1.75rem] font-title',
            'input': 'text-[0.75rem] leading-[1.25rem] font-sans',
            'button': 'text-[0.875rem] leading-[1.375rem] font-sans',
        },
        textColor: {
            'controlled': 'text-inherit',
            'dark': 'text-base-text',
            'error': 'text-error',
            'light': 'text-light-text',
            'neutral-100': 'text-neutral-100',
            'neutral-400': 'text-neutral-400',
            'neutral-500': 'text-neutral-500',
            'neutral-900': 'text-neutral-900',
            'primary': 'text-primary',
            'primary-3': 'text-primary-3',
            'success': 'text-success',
            'old-gold': 'text-old-gold',
        },
        medium: { true: 'font-[600]' },
        bold: { true: 'font-[900]' },
        center: { true: 'block text-center' },
        underline: { true: 'underline' },
        ellipsis: { true: 'truncate' },
    },
    compoundVariants: [
        { variant: ['heading-1'], bold: true, class: 'font-[950]' },
    ],
}) %}

<{{ element }} {{ attributes.without('class') }} class="{{ cva.apply({ variant: variant.value, textColor: textColor.value, bold, medium, center, underline, ellipsis }, attributes.render('class')) }}">
    {%- block content -%}{%- endblock -%}
</{{ element }}>
