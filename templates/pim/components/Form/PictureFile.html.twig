<div
    class="relative w-20 h-14 {{ class }}"
    {{ attributes }}
    {# @todo: remove asset to resolve URL #}
    {{ stimulus_controller('picture-file', { 'pictureUrl': pictureUrl ? asset(pictureUrl) : null }) }}
>
    {# Contain prototype for picture preview #}
    <div class="hidden">
        <div data-picture-file-target="prototype">
            <img
                data-prototype-image=""
                src=""
                class="absolute z-1 top-0 left-0 w-full h-full object-cover object-center rounded-xs flex items-center justify-center text-[2.5rem] text-error-transparency"
                alt="X"
            />
            <twig:Button
                data-prototype-delete=""
                icon="trash"
                size="sm"
                class="z-2 cursor-pointer opacity-0 group-hover:opacity-100"
            />
        </div>
    </div>
    <div class="box-border w-full h-full border border-dashed border-neutral-400 rounded-xs flex items-center justify-center">
        <twig:Icon name="image" class="w-4 h-4" />
    </div>
    <div
        class="absolute top-0 left-0 w-full h-full flex items-center justify-center group"
        data-picture-file-target="preview"
    >
    </div>
    <input
        id="{{ id }}"
        name="{{ name }}"
        accept="{{ accept }}"
        type="file"
        {% if disabled %}
            disabled
        {% else %}
            data-picture-file-target="inputFile"
            data-action="change->picture-file#onFileChange"
        {% endif %}
        class="absolute top-0 left-0 w-full h-full opacity-0 cursor-pointer"
    >
</div>
