<div
    class="{{ attributes.render('class') }}"
    {{ stimulus_controller('provider-portal--wysiwyg', { 'maxHeight': maxHeight, 'maxLength': maxLength }) }}
>
    <textarea
        id="{{ id }}"
        name="{{ name }}"
        {{ stimulus_target('provider-portal--wysiwyg', 'wysiwyg') }}
        {% if disabled %}disabled{% endif %}
        {% if readonly %}readonly{% endif %}
        {{ attributes.without('class', 'value') }}
    >
        {{ value|default('') }}
    </textarea>
</div>
