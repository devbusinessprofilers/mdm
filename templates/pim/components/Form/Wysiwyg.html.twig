<div
    class="{{ attributes.render('class') }}"
    {{ stimulus_controller('wysiwyg', { 'maxHeight': maxHeight, 'maxLength': maxLength, 'compteur': compteur }) }}
>
    <textarea
        id="{{ id }}"
        name="{{ name }}"
        {{ stimulus_target('wysiwyg', 'wysiwyg') }}
        {% if disabled %}disabled{% endif %}
        {% if readonly %}readonly{% endif %}
        {{ attributes.without('class', 'value') }}
    >{{ value|default('') }}</textarea>
    {% if compteur > 0 %}
        <div class="flex justify-end">
            <span {{ stimulus_target('wysiwyg', 'compteur') }} class="antialiased text-[0.75rem] leading-[1.25rem] font-sans text-neutral-500">0 / {{ compteur }}</span>
        </div>
    {% endif %}
</div>
