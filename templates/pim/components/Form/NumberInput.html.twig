{% set cva = cva({
    base: 'border rounded-xs p-2 focus:outline-none text-[0.75rem] leading-[1.25rem] w-full bg-transparent relative no-spin pr-10',
    variants: {
        disabled: {
            true: 'cursor-not-allowed text-neutral-500 border-neutral-300',
            false: 'border-primary',
        },
    },
    compoundVariants: [
        { disabled: false, readonly: false, class: 'cursor-text' },
        { disabled: false, readonly: true, class: 'cursor-pointer' },
    ],
}) %}

{% set wrapperCva = cva({
    base: 'w-full relative',
    variants: {
        disabled: {
            true: 'cursor-not-allowed text-neutral-500 bg-neutral-200 focus-within:outline focus-within:outline-neutral-500',
            false: 'bg-primary-5 focus-within:bg-neutral-100',
        },
    },
}) %}

<div
    class="{{ wrapperCva.apply({ disabled }) }}"
    {{ stimulus_controller('provider-portal--number-input', {
        'step': step,
        'scale': scale,
        'radix': radix,
        'thousandsSeparator': thousandsSeparator,
        'padFractionalZeros': padFractionalZeros,
        'min': minValue,
        'max': maxValue,
    }) }}
>
    {# IMPORTANT: use input type text (not number) to avoid conflict with IMask #}
    <input
        id="{{ id }}"
        name="{{ name }}"
        type="text"
        {% if disabled %}disabled{% endif %}
        {% if readonly %}readonly{% endif %}
        {% if placeholder is defined and placeholder is not empty %}placeholder="{{ placeholder }}"{% endif %}
        class="{{ cva.apply({ disabled, readonly }, attributes.render('class')) }}"
        {{ stimulus_target('provider-portal--number-input', 'input') }}
        data-action="
            keydown.up->provider-portal--number-input#increase
            keydown.down->provider-portal--number-input#decrease
        "
        {{ attributes.without('class') }}
    >
    <twig:Icon
        name="caret-up"
        class="absolute top-[5px] right-2 w-4 h-4 text-neutral-900 cursor-pointer"
        data-action="click->provider-portal--number-input#increase"
    />
    <twig:Icon
        name="caret-down"
        class="absolute bottom-[5px] right-2 w-4 h-4 text-neutral-900 cursor-pointer"
        data-action="click->provider-portal--number-input#decrease"
    />
</div>
