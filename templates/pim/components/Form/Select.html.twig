{% import 'pim/components/Form/_checkbox_markup.html.twig' as form_parts %}

{% set wrapperCva = cva({
    base: 'flex gap-2 items-center justify-between border rounded-xs pr-2 w-full',
    variants: {
        disabled: {
            true: 'cursor-not-allowed text-neutral-500 border-neutral-300 bg-neutral-200 focus-within:outline focus:outline-neutral-500',
            false: 'border-primary bg-primary-5 focus-within:bg-neutral-100',
        },
    }
}) %}

{% set inputCva = cva({
    base: 'focus:outline-none text-[0.75rem] leading-[1.25rem] w-full pl-2 py-2',
    variants: {
        disabled: { true: 'cursor-not-allowed' },
    },
}) %}

{% set optionCva = cva({
    base: 'pl-2 py-1 hover:bg-primary-4 cursor-pointer',
    variants: {
        selected: { true: 'bg-primary-4' },
    },
}) %}

{% set noOptionsCva = cva({
    base: 'px-2',
    variants: {
        hidden: { true: 'hidden' },
    },
}) %}

{% set selectedValues = this.getSelectedValues() %}

{# Les choix ne voyagent plus en JSON : le <select> caché ci-dessous les
   porte déjà, le contrôleur `select` les dérive de ses <option> au
   branchement (le doublon pesait ~90 Ko sur une fiche Lieu). #}
<div
    {{ stimulus_controller('select', {
        'defaultSelection': selectedValues,
        'multiple': multiple,
        'limit': limit,
    }) }}
    data-bindable
    class="{{ attributes.render('class') }}"
>
    {% if prototype %}
        <option
            {{ stimulus_target('select', 'optionPrototype') }}
            value=""
            class="hidden"
        >
            Select Option Prototype
        </option>
    {% endif %}

    {# Prototype de ligne d'option : la liste visible est construite par le
       contrôleur `select` à partir de ce clone et du JSON des choices — le
       serveur ne rend plus un <li> (avec ses spans/checkbox) par option,
       ce qui coûtait cher sur les fiches (20 selects × 20-80 options). #}
    <li
        {{ stimulus_target('select', 'elementPrototype') }}
        {{ stimulus_action('select', 'toggleChoice', 'click', {
            value: '',
            label: '',
        }) }}
        class="{{ optionCva.apply({ selected: false }, 'hidden') }}"
    >
        {% if multiple %}
            {{ form_parts.checkbox('', '', '1', false, false, [], null, 'Select Checkbox Choice Prototype') }}
        {% else %}
            <span class="antialiased text-[0.875rem] leading-[1.375rem] font-sans text-base-text">Select Choice Prototype</span>
        {% endif %}
    </li>

    <select
        id="{{ id }}"
        name="{{ name }}"
        {{ stimulus_target('select', 'select') }}
        {% if disabled %}disabled{% endif %}
        {% if multiple %}multiple{% endif %}
        hidden
        {% for attrKey, attrValue in selectAttributes %}
            {{ attrKey }}="{{ attrValue }}"
        {% endfor %}
    >
        {# Sans option vide, un select simple soumet sa première option par
           défaut — « rien de choisi » doit rester possible s'il n'est pas requis. #}
        {% if not multiple and not required %}
            <option value="" {% if selectedValues is empty %}selected{% endif %}></option>
        {% endif %}
        {% for choice in choices %}
            <option
                value="{{ choice.value }}"
                {% if choice.value in selectedValues %}selected{% endif %}
            >
                {{ choice.label }}
            </option>
        {% endfor %}
    </select>

    <twig:Dropdown
        class="{{ wrapperCva.apply({ disabled }) }}"
        wrapperClass="{{ wrapperClass }}"
        containerClass="w-full z-128 rounded-xxs py-4 px-2 overflow-x-visible bg-primary-5"
        disabled="{{ disabled }}"
    >
        <twig:block name="trigger">
            <input
                {{ stimulus_target('select', 'input') }}
                {{ stimulus_action('select', 'onSearch', 'input')|stimulus_action('select', 'prevent', 'keyup') }}
                id="trigger-{{ id }}"
                autocomplete="off"
                {% if placeholder is not empty %}placeholder="{{ placeholder }}"{% endif %}
                {% if disabled %}disabled{% endif %}
                class="{{ inputCva.apply({ disabled }) }}"
            />
        </twig:block>

        {# Ré-import nécessaire : le contenu de <twig:Dropdown> est compilé comme
           un template embarqué, les macros du template parent n'y sont pas visibles. #}
        {% import 'pim/components/Form/_checkbox_markup.html.twig' as form_parts %}

        {% if tip is not null %}
            <div class="flex items-center gap-2 mx-2 pb-2 mb-2 border-b border-neutral-300">
                {% if tipIcon is not null %}
                    <twig:Icon name="{{ tipIcon }}" class='w-5 h-5 text-primary' />
                {% endif %}
                <twig:Typography>
                    {{ tip|trans }}
                </twig:Typography>
            </div>
        {% endif %}

        {# Liste vide côté serveur : remplie au connect() du contrôleur `select`
           en clonant le prototype de ligne (voir plus haut). #}
        <ul
            {{ stimulus_target('select', 'list') }}
            class="w-full flex flex-col gap-2 max-h-[214px] overflow-x-visible overflow-y-auto scrollbar"
        ></ul>

        <twig:Typography
            data-select-target="noOptions"
            class="block w-full {{ noOptionsCva.apply({ hidden: choices|length > 0 }) }}"
        >
            {{- 'select.no_options'|trans -}}
        </twig:Typography>
    </twig:Dropdown>
</div>
