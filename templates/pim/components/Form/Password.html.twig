{% set inputCva = cva({
    base: 'transition-[box-shadow] border rounded-xs p-2 focus:outline-none text-[0.75rem] leading-[1.25rem] pr-10 w-full',
    variants: {
        disabled: {
            true: '
                cursor-not-allowed text-neutral-500 border-neutral-300 bg-neutral-200
                focus:outline focus:outline-neutral-500
            ',
            false: '
                cursor-text border-primary bg-primary-5
                focus:bg-neutral-100
            ',
        },
    }
}) %}

<div
    class="flex flex-col gap-3 {{ attributes.render('class') }}"
    {{ stimulus_controller('provider-portal--password', { 'withControl': withControl }) }}
>
    <div class="w-full relative">
        <input
            id="{{ id }}"
            name="{{ name }}"
            type="password"
            class="{{ inputCva.apply({ disabled }, attributes.render('class')) }}"
            {% if disabled %}
                disabled
            {% else %}
                {{ stimulus_target('provider-portal--password', 'input') }}
                {{ stimulus_action('provider-portal--password', 'handle', 'input') }}
            {% endif %}
            {{ attributes.without('class') }}
        >
        {% if not disabled %}
            <twig:Icon name="eye" class="absolute right-2 top-1/2 -translate-y-1/2 w-6 aspect-square" data-action="click->provider-portal--password#toggle" />
        {% endif %}
    </div>
    {% if withControl and not disabled %}
        <div class="flex flex-col gap-2">
            <twig:ProgressBar max="5" data-provider-portal--password-target="progress" noGradient />
            <div class="flex flex-wrap gap-2">
                <twig:StateTag label="{{ 'password.requirement.length'|trans }}" icon="check" data-provider-portal--password-target="lengthTag" />
                <twig:StateTag label="{{ 'password.requirement.upper'|trans }}" icon="check" data-provider-portal--password-target="upperTag" />
                <twig:StateTag label="{{ 'password.requirement.lower'|trans }}" icon="check" data-provider-portal--password-target="lowerTag" />
                <twig:StateTag label="{{ 'password.requirement.special'|trans }}" icon="check" data-provider-portal--password-target="specialTag" />
                <twig:StateTag label="{{ 'password.requirement.number'|trans }}" icon="check" data-provider-portal--password-target="numberTag" />
            </div>
        </div>
    {% endif %}
</div>
