{% set isDynamicTarget = (form is not defined or form is null) and dynamicFormId is defined and dynamicFormId is not null %}
<div
    {% if isDynamicTarget %}
        {{ stimulus_controller('float-submit', { formDatasetId: dynamicFormId }) }}
    {% endif %}
    class="sticky bottom-0 left-0 right-0 bg-primary-4 flex justify-center items-center px-4 py-2 lg:py:4 z-10"
>
    {% if isDynamicTarget %}
        <twig:Button
            type="submit"
            disabled="{{ disabled }}"
            class="{{ attributes.render('class') }}"
            data-float-submit-target="button"
        >
            {{ label }}
        </twig:Button>
    {% else %}
        <twig:Button
            type="submit"
            disabled="{{ disabled }}"
            form="{{ formId }}"
            class="{{ attributes.render('class') }}"
            data-float-submit-target="button"
        >
            {{ label }}
        </twig:Button>
    {% endif %}
</div>
