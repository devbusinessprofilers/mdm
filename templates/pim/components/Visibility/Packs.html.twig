{% set cva = cva({
    'base': 'grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 lg:gap-8',
}) %}

<ul {{ attributes.without('class') }} class="{{ cva.apply({}, attributes.render('class')) }}">
    {% for pack in this.getPacks() %}
        <li>
            <twig:Visibility:PackCard
                label="{{ 'visibility.pack.' ~ pack.type.value ~ '.label'|trans }}"
                value="{{ pack.value }}"
                options="{{ pack.options }}"
                isSelected="{{ pack.isSelected }}"
                class="h-full"
            />
        </li>
    {% endfor %}
</ul>
