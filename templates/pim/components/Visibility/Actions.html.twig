{% set cva = cva({
    'base': 'grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 lg:gap-8',
}) %}

<ul {{ attributes.without('class') }} class="{{ cva.apply({}, attributes.render('class')) }}">
    {% for action in this.getActions() %}
        <li>
            <twig:Visibility:ActionCard
                label="{{ action.type|trans }}"
                icon="{{ action.icon }}"
                tip="{{ action.tip }}"
                class="h-full"
            />
        </li>
    {% endfor %}
</ul>
