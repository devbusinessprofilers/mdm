{% set cva = cva({
    'base': 'flex flex-col gap-4 px-4 py-6 rounded-sm justify-between bg-primary-4',
}) %}

<div {{ attributes.without('class') }} class="{{ cva.apply({}, attributes.render('class')) }}">
    <div class="flex flex-col gap-2 items-center">
        <twig:Icon name="{{ icon }}" class="w-12 h-12" />
        <twig:Typography variant="heading-3" bold center>
            {{ label|trans }}
            {% if tip %}
                <twig:Typography textColor="neutral-500">({{ tip|trans }})</twig:Typography>
            {% endif %}
        </twig:Typography>
    </div>
    <twig:Button asLink variant="outline" href="{{ buttonLink }}" full>{{ 'visibility.action.cta'|trans }}</twig:Button>
</div>
