{% set styledIcon = [
    'styled-linkedin',
    'styled-analytic',
    'styled-mail',
] %}

{% set flagIcon = [
    'flag-en',
    'flag-fr',
] %}

{% set mapIcon = [
    'bg-pin',
    'bg-home-pin',
] %}

{% set strokeIcon = [
    'amphitheatre',
    'balcony',
    'beach',
    'terrace',
    'trad',
] %}

{% if name in strokeIcon %}
    {% set prefix = 'provider-portal-stroke' %}
{% elseif name in mapIcon %}
    {% set prefix = 'provider-portal-pin' %}
{% elseif name in flagIcon %}
    {% set prefix = 'provider-portal-flags' %}
{% elseif name in styledIcon %}
    {% set prefix = 'provider-portal-styled' %}
{% else %}
    {% set prefix = 'provider-portal' %}
{% endif %}

{{ ux_icon(prefix ~ ':' ~ name, attributes.all()) }}
