<nav{{ attributes.without('class') }} class="flex flex-col gap-4 {{ attributes.render('class') }}">
    {% if items is defined and items|length > 0 %}
        <ul class="flex flex-col gap-1">
            {% for item in items %}
                <li>
                    <twig:SideBar:Menu:NavLink
                        route="{{ item.route }}"
                        routeParameters="{{ item.routeParameters }}"
                        currentRoute="{{ app.request.attributes.get('_route') }}"
                        label="{{ item.label|trans }}"
                        icon="{{ item.icon }}"
                        iconColor="{{ item.iconColor }}"
                        size="lg"
                    />
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if sections is defined and sections|length > 0 %}
        {% for section in sections %}
            <div class="flex flex-col gap-1">
                <twig:Typography bold>{{ section.title|trans }}</twig:Typography>
                <ul class="flex flex-col gap-1">
                    {% for item in section.items %}
                        <li>
                            <twig:SideBar:Menu:NavLink
                                route="{{ item.route }}"
                                routeParameters="{{ item.routeParameters }}"
                                currentRoute="{{ app.request.attributes.get('_route') }}"
                                label="{{ item.label|trans }}"
                                icon="{{ item.icon }}"
                                iconColor="{{ item.iconColor }}"
                                size="lg"
                            />
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    {% endif %}
</nav>
