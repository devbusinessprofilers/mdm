<div
    {{ attributes.without('class') }}
    class="{{ attributes.render('class') }}"
    {{ stimulus_controller('mobile-menu') }}
>
    <div
        class="flex items-center gap-1 cursor-pointer"
        data-action="click->mobile-menu#toggle"
    >
        <twig:Icon name="gear" class="w-6 h-6" />
        <twig:Typography variant="body" underline bold>{{ 'menu.mobile.sheet'|trans }}</twig:Typography>
    </div>

    <div
        {{ stimulus_target('mobile-menu', 'menuWrapper') }}
        class="z-256 bg-background-transparency fixed left-0 top-0 bottom-0 w-screen h-screen hidden overflow-y-auto"
    >
        <div {{ stimulus_target('mobile-menu', 'menu') }} class="
            flex flex-col gap-4 py-6 w-full min-h-screen xs:w-[75vw] sm:max-w-[280px] bg-neutral-100 xs:rounded-r-4xl
            transition-[translate] shadow-(--shadow) -translate-x-full hidden
        ">
            <twig:Button
                variant="text"
                icon="cross"
                iconSize="lg"
                textColor="primary-3"
                data-action="click->mobile-menu#toggle"
                class="self-end"
            />

            <nav{{ attributes.without('class') }} class="flex flex-col px-4 gap-2 overflow-y-auto overflow-x-hidden scrollbar {{ attributes.render('class') }}">
                {% if items is defined and items|length > 0 %}
                    <ul class="flex flex-col gap-1">
                        {% for item in items %}
                            <li>
                                <twig:SideBar:Menu:NavLink
                                    route="{{ item.route }}"
                                    routeParameters="{{ item.routeParameters }}"
                                    currentRoute="{{ app.request.attributes.get('_route') }}"
                                    label="{{ item.label|trans }}"
                                    icon="{{ item.icon }}"
                                    iconColor="{{ item.iconColor }}"
                                />
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if sections is defined and sections|length > 0 %}
                    {% for section in sections %}
                        <div class="flex flex-col gap-1">
                            <twig:Typography bold>{{ section.title|trans }}</twig:Typography>
                            <ul class="flex flex-col gap-1">
                                {% for item in section.items %}
                                    <li>
                                        <twig:SideBar:Menu:NavLink
                                            route="{{ item.route }}"
                                            routeParameters="{{ item.routeParameters }}"
                                            currentRoute="{{ app.request.attributes.get('_route') }}"
                                            label="{{ item.label|trans }}"
                                            icon="{{ item.icon }}"
                                            iconColor="{{ item.iconColor }}"
                                        />
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                {% endif %}
            </nav>
        </div>
    </div>
</div>
