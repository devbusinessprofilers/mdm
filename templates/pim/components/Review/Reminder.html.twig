{% set cva = cva({
    base: 'flex flex-col justify-between gap-6 border-b border-neutral-300 pb-4 sm:flex-row sm:items-center',
}) %}

<article {{ attributes.without('class') }} class="{{ cva.apply({}, attributes.render('class')) }}">
    <div class="flex flex-col sm:gap-4 sm:flex-row">
        {% if reminder.logoUrl %}
            <img src="{{ asset(reminder.logoUrl) }}" alt="{{ reminder.companyName }}" class="h-12 w-12 rounded-full shrink-0" />
        {% else %}
            <div class="flex justify-center items-center h-12 w-12 rounded-full border-2 border-primary-3 bg-primary-4 shrink-0">
                <twig:Typography variant="subtitle" textColor="primary-3" center>{{ reminder.companyName|first|upper }}</twig:Typography>
            </div>
        {% endif %}
        <div class="flex flex-col">
            <h1><twig:Typography variant="subtitle" bold>{{ reminder.companyName }}</twig:Typography></h1>
            <div class="flex flex-col gap-y-2 gap-x-4 sm:items-center sm:flex-row sm:flex-wrap">
                <twig:Typography>{{ reminder.eventName }}</twig:Typography>
                <twig:Typography>{{ reminder.eventReference }}</twig:Typography>
                <twig:Typography>{{ reminder.placeName }}</twig:Typography>
                <twig:Typography>{{ reminder.date|date('d/m/Y') }}</twig:Typography>
            </div>
        </div>
    </div>
    {% if reminder.remindDate %}
        <twig:Button size="sm" icon="check" disabled class="w-full sm:w-fit">
            {{ 'review.reminder.already_reminded'|trans({'%date%': reminder.remindDate|date('d/m/Y')}) }}
        </twig:Button>
    {% else %}
        {# TODO: Change path to route #}
        <twig:Button asLink size="sm" variant="outline" class="w-full sm:w-fit" href="{{ path('provider_portal_review_reminder') }}">
            {{ 'review.reminder.remind'|trans }}
        </twig:Button>
    {% endif %}
</article>
