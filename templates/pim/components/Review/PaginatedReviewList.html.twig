{% set cva = cva({
    base: 'flex-1 flex flex-col gap-6',
}) %}

<div {{ attributes.without('class') }} class="{{ cva.apply({}, attributes.render('class')) }}">
    <div class="flex flex-col gap-2 lg:flex-row lg:justify-between">
        <twig:Typography variant="subtitle" bold>{{ 'paginated_review_list.number'|trans({'count': totalItems}) }}</twig:Typography>
        <form>
            <twig:Form:Select
                id="type"
                name="type"
                placeholder="{{ 'paginated_review_list.type.placeholder'|trans }}"
                choices="{{ typeChoices }}"
                data-model="currentType"
                data-action="custom:change->live#action"
                data-live-action-param="changeSheetType"
                selected="{{ currentType }}"
            />
        </form>
    </div>

    <ul class="flex flex-col gap-4 lg:gap-6">
        {% for review in items %}
            <li><twig:Review review="{{ review }}" /></li>
        {% endfor %}
    </ul>

    <twig:Pagination
        total="{{ totalPages }}"
        current="{{ currentPage }}"
        targetAttributes="{{ {
            'data-action': 'click->live#action',
            'data-live-action-param': 'changePage',
            'data-live-page-param': 'page',
        } }}"
        previousAttributes="{{ {
            'data-action': 'click->live#action',
            'data-live-action-param': 'previousPage',
        } }}"
        nextAttributes="{{ {
            'data-action': 'click->live#action',
            'data-live-action-param': 'nextPage',
        } }}"
    />
</div>
