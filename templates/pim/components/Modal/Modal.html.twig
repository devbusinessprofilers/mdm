<div
    class="fixed top-0 left-0 w-screen h-screen bg-background-transparency flex justify-center items-center z-256 hidden"
    data-modal="{{ identifier|default('') }}"
    {{ stimulus_controller('modal', { 'display': display }) }}
    {{ stimulus_target('modal', 'modal') }}
    data-action="click->modal#backdrop keydown.esc@window->modal#escape"
>
    {# Défilement vertical seul, à la barre fine du système — pas d'ascenseur horizontal. #}
    <div class="relative max-w-80/100 max-h-80/100 overflow-y-auto overflow-x-hidden scrollbar bg-neutral-100 p-14 rounded-md">
        <button type="button" aria-label="Fermer" data-action="modal#close"
                class="absolute top-4 right-4 p-1 cursor-pointer text-neutral-500 hover:text-neutral-900">
            <twig:Icon name="cross" class="w-5 h-5" />
        </button>
        {%- block content -%}{% endblock -%}
    </div>
</div>
