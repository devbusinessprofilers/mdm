{% set linkCva = cva({
    base: '
        flex items-center gap-2 relative
        after:max-w-0 after:transition-[max-width] after:content-[""] after:absolute after:bottom-0 after:h-1 after:bg-primary
        hover:after:max-w-full
    ',
    variants: {
        'isActive': {
            true: 'after:max-w-full',
        },
        'level': {
            0: 'pt-1.5 pb-2.5 px-4 after:left-4 after:right-4',
            1: 'p-0 h-8 after:left-0 after:right-0',
            2: 'p-2 after:left-2 after:right-2',
        }
    },
}) %}

<a
    href="{{ path(route, routeParameters) }}"
    class="{{ linkCva.apply({ isActive, level }, attributes.render('class')) }}"
    {{ attributes.without('class', 'href') }}
>
    {#- Typography/Icon inlinés via les macros partagées : le menu est rendu sur
        chaque page, un composant par libellé/icône coûtait cher. -#}
    {% import 'pim/components/_typography_markup.html.twig' as typo %}
    {% import 'pim/components/_icon_markup.html.twig' as icon_parts %}
    {% if icon %}
        {# Icône centrée et calibrée : à 1em elle flottait en haut de sa boîte. #}
        <span class="{{ typo.classes('body', iconColor.value, false, false, false, false, false, 'w-6 h-6 flex items-center justify-center shrink-0') }}">{{ icon_parts.icon(icon, {name: icon, class: 'w-5 h-5'}) }}</span>
    {% endif %}
    <span class="{{ typo.classes(labelVariant.value, 'dark', isLabelBold) }}">{{ label }}</span>
    {% if notification is defined and notification and notification > 0 %} 
        <twig:Sticker value="{{ notification }}" />
    {% endif %}
</a>
