{# Galerie de photos du volet Médias (maquette) — partagée entre la fiche
   Lieu et les gammes. Cartes 250 × 170 : vignette numérotée (la première est
   la photo principale), select de catégorie sous chaque vignette (enregistré
   en AJAX au changement), et au survol un voile avec trois actions :
   recadrer, infos (modale de paramètres), supprimer. Une photo « Salle de
   réunion » porte en pied la barre de choix de la salle rattachée. Le
   drag-drop réordonne — déplacer une photo en première position la désigne
   principale.
   Variables : photos, media_upload_form, photo_usages, salles (id => nom,
   fiches Lieu seulement), routes { categorie, delete } (noms de routes),
   route_params (paramètres communs, complétés de resourceId par photo). #}
<div class="flex flex-row flex-wrap gap-x-4 gap-y-5 py-4" data-lieu-media-target="list">
    {% for photo in photos %}
        {% set url_categorie = path(routes.categorie, route_params|merge({resourceId: photo.resource.id})) %}
        <div class="w-[250px] flex flex-col gap-2"
             data-lieu-media-target="item" data-id="{{ photo.resource.id }}" draggable="true"
             data-action="dragstart->lieu-media#dragstart dragover->lieu-media#dragoverItem drop->lieu-media#dropItem">
            <div class="group relative w-[250px] h-[170px] rounded-xs overflow-hidden bg-primary-5 inset-ring-1
                        {{ loop.first ? 'inset-ring-primary' : 'inset-ring-neutral-300' }}">
                {# Variante CDN adaptée à la carte (320 × 190), pas la miniature. #}
                {% set variante = photo.variants|filter(v => v.name == 'medium_2' and v.url)|first %}
                {% if variante or photo.thumbnail_url %}
                    <img src="{{ variante ? variante.url : photo.thumbnail_url }}"
                         alt="{{ photo.resource.legende ?: (photo.asset ? photo.asset.originalFilename : 'Photo') }}"
                         class="w-full h-full object-cover pointer-events-none" loading="lazy">
                {% else %}
                    <span class="w-full h-full flex items-center justify-center">
                        <twig:Icon name="images" class="w-7 h-7 text-neutral-400" />
                    </span>
                {% endif %}
                {# Pastille de position — la première est la photo principale. #}
                <span class="absolute top-2 right-2 z-1 flex items-center px-2.5 py-1 rounded-full bg-peach">
                    <span class="antialiased text-[0.6875rem] leading-none font-sans font-[700] text-neutral-100">
                        {{- loop.first ? '1 - Photo principale' : loop.index -}}
                    </span>
                </span>
                {% if photo.asset and photo.asset.errorMessage %}
                    <span class="absolute bottom-2 right-2 z-1 w-[18px] h-[18px] flex items-center justify-center rounded-full bg-error"
                          title="{{ photo.asset.errorMessage }}">
                        <twig:Icon name="warning" class="w-3 h-3 text-neutral-100" />
                    </span>
                {% endif %}
                {# Voile + actions au survol : recadrer, infos, supprimer. #}
                <div class="hidden absolute inset-0 z-2 bg-neutral-900/35 items-center justify-center gap-2 group-hover:flex group-focus-within:flex">
                    <button type="button" title="Recadrer et pivoter"
                            data-controller="modal-trigger-button"
                            data-modal-trigger-button-modal-identifier-value="crop-photo-{{ photo.resource.id }}"
                            data-action="modal-trigger-button#open"
                            class="w-9 h-9 flex items-center justify-center rounded-full bg-neutral-100 cursor-pointer hover:bg-primary-4">
                        <span class="sr-only">Recadrer et pivoter la photo</span>
                        <twig:Icon name="gear" class="w-[18px] h-[18px] text-primary-3" />
                    </button>
                    <button type="button" title="Informations de la photo"
                            data-controller="modal-trigger-button"
                            data-modal-trigger-button-modal-identifier-value="photo-{{ photo.resource.id }}"
                            data-action="modal-trigger-button#open"
                            class="w-9 h-9 flex items-center justify-center rounded-full bg-neutral-100 cursor-pointer hover:bg-primary-4">
                        <span class="sr-only">Voir les informations de la photo</span>
                        <twig:Icon name="info-circle" class="w-[18px] h-[18px] text-primary-3" />
                    </button>
                    <button type="button" title="Supprimer la photo"
                            data-action="lieu-media#remove"
                            data-url="{{ path(routes.delete, route_params|merge({resourceId: photo.resource.id})) }}"
                            class="w-9 h-9 flex items-center justify-center rounded-full bg-neutral-100 cursor-pointer hover:bg-error [&:hover_svg]:text-neutral-100">
                        <span class="sr-only">Supprimer la photo</span>
                        <twig:Icon name="trash" class="w-[18px] h-[18px] text-error" />
                    </button>
                </div>
                {# Photo de salle de réunion : la salle rattachée se choisit
                   directement sur la photo (barre sombre en pied). #}
                {% if photo.resource.usage == 'CONFIG_PHOTO_SALLE' and salles|default({}) is not empty %}
                    <twig:Form:NativeSelect
                        dark
                        :choices="salles"
                        selected="{{ photo.resource.salle ? photo.resource.salle.id : (photo.resource.restaurantSalle ? photo.resource.restaurantSalle.id : '') }}"
                        data-action="change->lieu-media#changerSalle"
                        data-url="{{ url_categorie }}"
                        aria-label="Salle de réunion rattachée"
                        class="absolute bottom-2 left-2 right-2 z-1"
                    />
                {% endif %}
            </div>
            {# Catégorie de la photo — enregistrée à la volée au changement.
               « Salle de réunion » n'est proposée que si la fiche a des salles
               (elle ferait un rejet serveur sinon) ; une catégorie hors liste
               inline (plan de salle) reste visible comme option, sa gestion
               fine passant par la modale d'infos. #}
            {% set usages_proposables = salles|default({}) is not empty
                ? photo_usages
                : photo_usages|filter((libelle, code) => code != 'CONFIG_PHOTO_SALLE') %}
            {% set choix_categories = photo.resource.usage in usages_proposables|keys
                ? usages_proposables
                : usages_proposables|merge({ (photo.resource.usage): photo.usage_label }) %}
            <twig:Form:NativeSelect
                :choices="choix_categories"
                selected="{{ photo.resource.usage }}"
                data-action="change->lieu-media#changerCategorie"
                data-url="{{ url_categorie }}"
                aria-label="Catégorie de la photo"
            />
        </div>
    {% endfor %}
    <label for="{{ media_upload_form.photos.vars.id }}"
           class="w-[250px] h-[170px] flex flex-col items-center justify-center gap-1.5
                  rounded-xs cursor-pointer bg-neutral-100 inset-ring-1 inset-ring-primary">
        <twig:Icon name="plus" class="w-[22px] h-[22px] text-primary" />
        <twig:Typography variant="body-sm" textColor="primary-3" bold>Ajouter un média</twig:Typography>
    </label>
</div>
