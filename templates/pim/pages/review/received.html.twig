{% extends 'pim/pages/review/_layout.html.twig' %}

{% block title %}
    {{ 'page.review.received.title'|trans }}
{% endblock %}

{% block main %}
    <div class="flex flex-col gap-2 mb-6 lg:mb-8">
        <h1><twig:Typography variant="heading-3" bold>{{ 'page.review.received.title'|trans }}</twig:Typography></h1>
        <p><twig:Typography variant="body-lg">{{ 'page.review.received.description'|trans }}</twig:Typography></p>
    </div>
    <div class="flex flex-col gap-y-6 lg:flex-row lg:gap-x-20 lg:justify-between">
        <div class="flex flex-col w-full gap-6 sm:gap-14 lg:flex-1/3">
            <div class="flex flex-col gap-2">
                <twig:Score value="{{ globalScore }}" />
                <p><twig:Typography variant="body-lg" center>{{ 'page.review.received.scores.global.description'|trans }}</twig:Typography></p>
            </div>
            <div class="flex flex-col gap-2">
                <twig:Typography variant="subtitle" bold>{{ 'page.review.received.scores.title'|trans }}</twig:Typography>
                <ul>
                    {% for score, percentage in scores %}
                        <li class="flex gap-2 items-center">
                            <twig:Typography variant="body-lg">{{- score -}}</twig:Typography>
                            <twig:ProgressBar value="{{ percentage }}" large />
                        </li>
                    {% endfor %}
                </ul>
            </div>
            <ul class="flex flex-col gap-4 sm:gap-8">
                {% for section in sections %}
                    <li class="flex gap-4 items-center justify-between border-b border-neutral-300 pb-2">
                        <div class="flex gap-2 items-center">
                            <twig:Icon name="{{ section.icon }}" class="w-6 h-6" />
                            <twig:Typography bold>{{- section.label|trans -}}</twig:Typography>
                        </div>
                        <twig:Typography bold>{{- section.score|format_number({ min_fraction_digit: 1, max_fraction_digit: 1 }) -}}</twig:Typography>
                    </li>
                {% endfor %}
            </ul>
        </div>
        <div class="w-full lg:flex-2/3">
            <twig:Review:PaginatedReviewList totalItems="{{ reviewsTotal }}" itemsPerPage="{{ 5 }}" />
        </div>
    </div>
{% endblock %}
