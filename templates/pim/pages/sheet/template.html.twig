{% extends 'pim/pages/sheet/_layout.html.twig' %}

{% block title %}
    {{ 'page.template.title'|trans }}
{% endblock %}

{% block form_themes %}
    {% include 'pim/form/_form-theme.html.twig' with {
        'additionalFormThemes': ['pim/form/subform/_message-templates.html.twig'],
    } %}
{% endblock %}

{% block main %}
    {{ form_start(form, { 'attr': {'id': form.vars.id, 'class': 'flex flex-col gap-6 lg:gap-8'} }) }}
    <section class="flex flex-col gap-6 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 2xl:p-14">
        {{ form_row(form.messageTemplates) }}
    </section>
    {{ form_end(form) }}
{% endblock %}

{% block float_submit %}
    <twig:Form:FloatSubmit label="{{ 'global.save'|trans }}" formId="{{ form.vars.id }}" />
{% endblock %}
