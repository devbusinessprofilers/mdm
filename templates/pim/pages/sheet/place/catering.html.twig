{% extends 'pim/pages/sheet/_layout.html.twig' %}

{% block title %}
    {{ 'page.sheet.place.catering.title'|trans }}
{% endblock %}

{% block main %}
    {{ form_start(form, { 'attr': { 'id': form.vars.id, 'class': 'flex flex-col gap-6 lg:gap-8'} }) }}
    <section class="flex flex-col gap-6 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 2xl:p-14">
        <h2><twig:Typography variant="heading-3" bold>{{ 'page.sheet.place.catering.title'|trans }}</twig:Typography></h2>
        <div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-x-6 gap-y-4">
            {{ form_row(form.restaurantCount) }}
            {{ form_row(form.diningRoomCount) }}
            {{ form_row(form.overallDiningCount) }}
            {{ form_row(form.sittingDiningCount) }}
            {{ form_row(form.withDanceEvening, {'attr': {'class': 'lg:col-start-1 lg:col-end-2'}}) }}
            {{ form_row(form.withCocktailParty) }}
            {{ form_row(form.withLocalCaterer) }}
            {{ form_row(form.withExternalCaterer) }}
            {{ form_row(form.selfCatererAuthorized) }}
            {{ form_row(form.exclusivityAuthorized) }}
            {{ form_row(form.musicEndTime) }}
        </div>
        <div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-x-6 gap-y-4">
            {{ form_row(form.cuisines) }}
            {{ form_row(form.mealServices) }}
        </div>
    </section>
    {{ form_end(form) }}
{% endblock %}

{% block float_submit %}
    <twig:Form:FloatSubmit label="{{ 'global.save'|trans }}" formId="{{ form.vars.id }}" />
{% endblock %}
