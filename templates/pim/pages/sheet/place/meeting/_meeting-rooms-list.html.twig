{#
@var array<\App\Pim\Model\ProviderPortal\DTO\Sheet\Place\Meeting\MeetingRoomDTO> meetingRooms
#}

<div class="overflow-x-scroll scrollbar pb-10">
    {% include 'pim/pages/sheet/place/meeting/_meeting-rooms-header.html.twig' with { 'editable': false } %}
    <ul class="w-full flex flex-col gap-2 mt-10">
        {% for meetingRoom in meetingRooms %}
            <li class="w-fit py-2 hover:bg-primary-5">
                <div class="grid grid-cols-[400px_repeat(12,70px)_100px] gap-x-4 items-center">
                    <div class="flex gap-2 items-center">
                        <span class="w-6"></span>
                        {% if meetingRoom.pictureUrl is not null %}
                            {# @todo: use protected route to display picture? #}
                            <img class="w-20 h-14 rounded-xs" src="{{ asset(meetingRoom.pictureUrl) }}" alt="{{ meetingRoom.name ?? '-' }}" />
                        {% else %}
                            <div class="w-20 h-14 border border-dashed border-neutral-300 rounded-xs"></div>
                        {% endif %}
                        <twig:Typography variant="body-sm" bold>{{ meetingRoom.name ?? '-' }}</twig:Typography>
                    </div>
                    <twig:Typography variant="body-sm" bold center>{{ meetingRoom.area ?? '-' }}</twig:Typography>
                    <twig:Typography variant="body-sm" bold center>{{ meetingRoom.theatreArea ?? '-' }}</twig:Typography>
                    <twig:Typography variant="body-sm" bold center>{{ meetingRoom.meetingArea ?? '-' }}</twig:Typography>
                    <twig:Typography variant="body-sm" bold center>{{ meetingRoom.uShapedArea ?? '-' }}</twig:Typography>
                    <twig:Typography variant="body-sm" bold center>{{ meetingRoom.classArea ?? '-' }}</twig:Typography>
                    <twig:Typography variant="body-sm" bold center>{{ meetingRoom.cabaretArea ?? '-' }}</twig:Typography>
                    <twig:Typography variant="body-sm" bold center>{{ meetingRoom.banquetArea ?? '-' }}</twig:Typography>
                    <twig:Typography variant="body-sm" bold center>{{ meetingRoom.cocktailArea ?? '-' }}</twig:Typography>
                    <twig:BinaryStatus status="{{ meetingRoom and meetingRoom.hasNaturalLight }}" class="w-full h-6" />
                    <twig:BinaryStatus status="{{ meetingRoom and meetingRoom.hasAirConditioned }}" class="w-full h-6" />
                    <twig:BinaryStatus status="{{ meetingRoom and meetingRoom.hasReducedMobilityAccess }}" class="w-full h-6" />
                    <twig:BinaryStatus status="{{ meetingRoom and meetingRoom.hasDanceFloor }}" class="w-full h-6" />
                    {% if meetingRoom.planUrl is not null %}
                        <twig:Typography variant="body-sm" underline center ellipsis>
                            {# @todo: remove asset to resolve URL #}
                            <a href="{{ asset(meetingRoom.planUrl) }}" download>
                                {{ meetingRoom.getPlanFileName() }}
                            </a>
                        </twig:Typography>
                    {% else %}
                        <twig:Typography variant="body-sm" center>-</twig:Typography>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ul>
</div>
