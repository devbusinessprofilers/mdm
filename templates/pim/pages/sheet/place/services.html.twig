{% extends 'pim/pages/sheet/_layout.html.twig' %}

{% block title %}
    {{ 'page.sheet.place.services.title'|trans }}
{% endblock %}

{% block main %}
    {{ form_start(form, { 'attr': { 'id': form.vars.id, 'class': 'flex flex-col gap-6 lg:gap-8'} }) }}
    <section class="flex flex-col gap-6 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 2xl:p-14">
        <div class="w-full flex flex-col gap-14">
            {{ form_row(form.amenities, {'label_attr': {'typography': 'heading-3', 'bold': true, 'class': 'mb-4'}}) }}
            {{ form_row(form.meetingEquipments, {'label_attr': {'typography': 'heading-3', 'bold': true, 'class': 'mb-4'}}) }}
            {{ form_row(form.facilities, {'label_attr': {'typography': 'heading-3', 'bold': true, 'class': 'mb-4'}}) }}
            {{ form_row(form.wellnessList, {'label_attr': {'typography': 'heading-3', 'bold': true, 'class': 'mb-4'}}) }}
        </div>
    </section>
    {{ form_end(form) }}
{% endblock %}

{% block float_submit %}
    <twig:Form:FloatSubmit label="{{ 'global.save'|trans }}" formId="{{ form.vars.id }}" />
{% endblock %}
