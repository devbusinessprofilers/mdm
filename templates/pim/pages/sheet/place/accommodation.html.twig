{% extends 'pim/pages/sheet/_layout.html.twig' %}

{% block title %}
    {{ 'page.sheet.place.accommodation.title'|trans }}
{% endblock %}

{% block main %}
    {% set dependencyIdentifier = 'accommodation-wrapper' %}
    {% set withAccommodation = form.vars.value.withAccommodation %}

    {{ form_start(form, { 'attr': getFormDependencyAttributes()|merge({'id': form.vars.id, 'class': 'flex flex-col gap-6 lg:gap-8'}) }) }}
        <section class="flex flex-col gap-6 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 2xl:p-14">
            <h2><twig:Typography variant="heading-3" bold>{{ 'page.sheet.place.accommodation.title'|trans }}</twig:Typography></h2>
            {{ form_row(form.withAccommodation, {'input_attributes': getFormDependencyTriggerAttributes(dependencyIdentifier)}) }}
            <div {{ getFormDependencyWrapperAttributes(dependencyIdentifier)|renderHtmlAttributes }}>
                {% if withAccommodation %}
                    <div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-x-6 gap-y-4 mb-4">
                            {{ form_row(form.roomCount, {'attr': {'class': 'lg:col-start-1 lg:col-end-2'}}) }}
                            {{ form_row(form.singleRoomCount, {'attr': {'class': 'lg:col-start-1 lg:col-end-2'}}) }}
                            {{ form_row(form.twinRoomCount) }}
                            {{ form_row(form.doubleRoomCount) }}
                            {{ form_row(form.totalCapacity) }}
                            {{ form_row(form.description, {'attr': {'class': 'lg:col-start-1 lg:col-end-4'}}) }}
                    </div>
                    <h2><twig:Typography variant="heading-3" bold>{{ 'page.sheet.place.accommodation.equipment'|trans }}</twig:Typography></h2>
                    <div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-x-6 gap-y-4">
                        {{ form_row(form.equipments) }}
                    </div>
                {% endif %}
            </div>
        </section>
    {{ form_end(form) }}
{% endblock %}

{% block float_submit %}
    <twig:Form:FloatSubmit label="{{ 'global.save'|trans }}" formId="{{ form.vars.id }}" />
{% endblock %}
