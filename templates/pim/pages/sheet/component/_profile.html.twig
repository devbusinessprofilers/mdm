{#
@var \App\Pim\Model\ProviderPortal\DTO\SheetDTO sheet
#}

<div class="flex flex-col gap-1">
    <div class="flex flex-col-reverse items-start flex-wrap gap-4 lg:flex-row lg:items-center">
        <h1><twig:Typography variant="heading-2" bold>{{ sheet.name }}</twig:Typography></h1>
        <ul class="flex gap-2">
            {% for tag in sheet.tags %}
                <li><twig:Tag variant="{{ tag.variant.value }}" label="{{ tag.label|trans }}" size="sm" /></li>
            {% endfor %}
            {% if sheet.isOnline %}
                <li><twig:Tag variant="success" label="{{ 'page.sheet.tag.online'|trans }}" size="sm" /></li>
            {% else %}
                <li><twig:Tag variant="neutral" label="{{ 'page.sheet.tag.offline'|trans }}" size="sm" /></li>
            {% endif %}
        </ul>
    </div>
    <div class="flex flex-col items-center gap-4 mb-6 lg:gap-30 lg:flex-row lg:mb-8">
        <div class="flex flex-col items-start gap-2 w-full lg:items-center lg:w-auto lg:flex-grow lg:flex-row lg:gap-4">
            <twig:Typography variant="body-lg" bold class="flex flex-1 max-w-fit items-center gap-2">
                {{ 'page.sheet.completion'|trans({ '{percentage}': sheet.progress }) }}
                <twig:Icon name="eye" class="w-8 h-8" />
            </twig:Typography>
            <twig:ProgressBar large value="{{ sheet.progress }}" class="lg:w-auto lg:flex-grow" />
        </div>
        <twig:Button disabled="{{ sheet.progress < 100 }}" class="w-full lg:w-fit">
            {{ 'page.sheet.publish'|trans }}
        </twig:Button>
    </div>
</div>
