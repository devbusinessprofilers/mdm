{% extends 'pim/pages/sheet/_layout.html.twig' %}

{% block title %}
    {{ 'page.sheet.service.detail.title'|trans }}
{% endblock %}

{% block main %}
    {{ form_start(form, { 'attr': { 'id': form.vars.id, 'class': 'flex flex-col gap-6 lg:gap-8'} }) }}
    <section class="flex flex-col gap-6 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 2xl:p-14">
        <h2><twig:Typography variant="heading-3" bold>{{ 'page.sheet.service.detail.title'|trans }}</twig:Typography></h2>
        <div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-x-6 gap-y-4">
            {{ form_row(form.receptionList) }}
            {{ form_row(form.giftList) }}
            {{ form_row(form.communicationList) }}
            {{ form_row(form.facilityList) }}
            {{ form_row(form.digitalList) }}
            {{ form_row(form.activityList) }}
            {{ form_row(form.translationList) }}
            {{ form_row(form.transportList) }}
            {{ form_row(form.foodList) }}
            {{ form_row(form.miscellaneousList) }}
            {{ form_row(form.marketingList) }}
        </div>
    </section>
    {{ form_end(form) }}
{% endblock %}

{% block float_submit %}
    <twig:Form:FloatSubmit label="{{ 'global.save'|trans }}" formId="{{ form.vars.id }}" />
{% endblock %}
