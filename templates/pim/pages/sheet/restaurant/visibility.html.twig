{% extends 'pim/pages/sheet/_layout.html.twig' %}

{% block title %}
    {{ 'page.sheet.restaurant.visibility.main.title'|trans }}
{% endblock %}

{% block main %}
    <div class="flex flex-col gap-6 lg:gap-8">
        <section class="flex flex-col gap-6 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 2xl:p-14">
            <div class="flex flex-col gap-2">
                <h2><twig:Typography variant="heading-3" bold>{{ 'page.sheet.restaurant.visibility.main.title'|trans }}</twig:Typography></h2>
                <p><twig:Typography variant="body-lg">{{ 'page.sheet.restaurant.visibility.main.description'|trans }}</twig:Typography></p>
            </div>
            <twig:Visibility:Packs sheet="{{ sheet }}" />
        </section>
    </div>
{% endblock %}
