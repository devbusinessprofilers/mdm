{% extends 'pim/pages/sheet/_layout.html.twig' %}

{% block title %}
    {{ 'page.sheet.restaurant.prices.title'|trans }}
{% endblock %}

{% block form_themes %}
    {% include 'pim/form/_form-theme.html.twig' with {
        'additionalFormThemes': ['provider_portal/form/subform/_optional_price.html.twig'],
    } %}
{% endblock %}

{% block main %}
    {{ form_start(form, { 'attr': getFormDependencyAttributes()|merge({'id': form.vars.id, 'class': 'flex flex-col gap-6 lg:gap-8'}) }) }}
    <section class="flex flex-col gap-8 bg-neutral-100 rounded-md shadow-(--shadow) w-full p-6 lg:gap-8 2xl:p-14">
        <div class="flex flex-col gap-2">
            <h2><twig:Typography variant="heading-3" bold>{{ 'page.sheet.restaurant.prices.title'|trans }}</twig:Typography></h2>
            <p><twig:Typography>{{ 'page.sheet.restaurant.prices.description'|trans }}</twig:Typography></p>
        </div>
        <div class="flex flex-col gap-6">
            {{ form_row(form.seatedLunch) }}
            {{ form_row(form.cocktailLunchParty) }}
            {{ form_row(form.seatedDinner) }}
            {{ form_row(form.cocktailDinnerParty) }}
            {{ form_row(form.wineOption) }}
            {{ form_row(form.alcoholOption) }}
        </div>
    </section>
    {{ form_end(form) }}
{% endblock %}

{% block float_submit %}
    <twig:Form:FloatSubmit label="{{ 'global.save'|trans }}" formId="{{ form.vars.id }}" />
{% endblock %}
