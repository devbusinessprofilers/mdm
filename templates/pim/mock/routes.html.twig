{% block body %}
    <main class="p-8">
        <h1><twig:Typography variant="heading-1" bold center class="block">Pages</twig:Typography></h1>
        <h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">UI</twig:Typography></h2>
        <div class="flex flex-wrap gap-6">
            {% for route in routes['ui'] %}
                <twig:Button asLink href="{{ path(route.path) }}" variant="outline">{{ route.name }}</twig:Button>
            {% endfor %}
        </div>
        <h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Connexion</twig:Typography></h2>
        <div class="flex flex-wrap gap-6">
            {% for route in routes['connection'] %}
                <twig:Button asLink href="{{ path(route.path) }}" variant="outline">{{ route.name }}</twig:Button>
            {% endfor %}
        </div>
        <h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Mon compte</twig:Typography></h2>
        <div class="flex flex-wrap gap-6">
            {% for route in routes['account'] %}
                <twig:Button asLink href="{{ path(route.path) }}" variant="outline">{{ route.name }}</twig:Button>
            {% endfor %}
        </div>
        <h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Graphiques</twig:Typography></h2>
        <div class="flex flex-wrap gap-6">
            {% for route in routes['chart'] %}
                <twig:Button asLink href="{{ path(route.path) }}" variant="outline">{{ route.name }}</twig:Button>
            {% endfor %}
        </div>
        <h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Ma fiche lieu</twig:Typography></h2>
        <div class="flex flex-wrap gap-6">
            {% for route in routes['sheet-place'] %}
                <twig:Button asLink href="{{ path(route.path, route.parameters|default({})) }}" variant="outline">{{ route.name }}</twig:Button>
            {% endfor %}
        </div>
        <h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Ma fiche restaurant</twig:Typography></h2>
        <div class="flex flex-wrap gap-6">
            {% for route in routes['sheet-restaurant'] %}
                <twig:Button asLink href="{{ path(route.path, route.parameters|default({})) }}" variant="outline">{{ route.name }}</twig:Button>
            {% endfor %}
        </div>
        <h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Ma fiche activités</twig:Typography></h2>
        <div class="flex flex-wrap gap-6">
            {% for route in routes['sheet-activity'] %}
                <twig:Button asLink href="{{ path(route.path, route.parameters|default({})) }}" variant="outline">{{ route.name }}</twig:Button>
            {% endfor %}
        </div>
        <h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Ma fiche service</twig:Typography></h2>
        <div class="flex flex-wrap gap-6">
            {% for route in routes['sheet-service'] %}
                <twig:Button asLink href="{{ path(route.path, route.parameters|default({})) }}" variant="outline">{{ route.name }}</twig:Button>
            {% endfor %}
        </div>
        <h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Ma fiche plateau-repas</twig:Typography></h2>
        <div class="flex flex-wrap gap-6">
            {% for route in routes['sheet-meal-tray'] %}
                <twig:Button asLink href="{{ path(route.path, route.parameters|default({})) }}" variant="outline">{{ route.name }}</twig:Button>
            {% endfor %}
        </div>
        <h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Avis</twig:Typography></h2>
        <div class="flex flex-wrap gap-6">
            {% for route in routes['review'] %}
                <twig:Button asLink href="{{ path(route.path) }}" variant="outline">{{ route.name }}</twig:Button>
            {% endfor %}
        </div>
    </main>
{% endblock %}
