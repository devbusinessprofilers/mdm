<h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Champs Text</twig:Typography></h2>
<div class="flex gap-4 flex-wrap">
    <ul class="bg-neutral-100 rounded-sm p-8 flex flex-col gap-4 shadow-(--shadow)">
        <li><twig:Form:TextInput id="text" name="text" /></li>
        <li><twig:Form:TextInput leftIcon="flag-fr" id="text-input-left-icon" name="text-input-left-icon" /></li>
        <li><twig:Form:TextInput rightIcon="lock" id="text-input-right-icon" name="text-input-right-icon" /></li>
        <li><twig:Form:TextInput iconColor="primary-3" rightIcon="lock" id="text-input-right-colored-icon" name="text-input-right-colored-icon" /></li>
        <li><twig:Form:TextInput value="value" iconColor="primary-3" rightIcon="lock" disabled id="text-input-right-colored-icon-disabled" name="text-input-right-colored-icon-disabled" /></li>
    </ul>
    <ul class="bg-neutral-100 rounded-sm p-8 flex flex-col gap-4 shadow-(--shadow) flex-grow-1">
        <twig:Typography variant="heading-3" bold>Textarea</twig:Typography>
        <li><twig:Form:Textarea id="textarea" name="textarea" /></li>
        <twig:Typography variant="heading-3" bold>Wysiwyg</twig:Typography>
        <li><twig:Form:Wysiwyg id="wysiwyg" name="wysiwyg" maxHeight="150" /></li>
    </ul>
</div>
