<h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Stars</twig:Typography></h2>
<div class="flex gap-8 flex-col bg-neutral-100 rounded-sm p-8  shadow-(--shadow)">
    <ul class="flex max-w-full gap-4">
        <li>
            <twig:Stars value="{{ 0 }}" />
        </li>
        <li>
            <twig:Stars value="{{ 3 }}" max="{{ 10 }}" />
        </li>
        <li>
            <twig:Stars value="{{ 6 }}" max="{{ 10 }}" />
        </li>
        <li>
            <twig:Stars value="{{ 7 }}" max="{{ 10 }}" />
        </li>
        <li>
            <twig:Stars value="{{ 100 }}" />
        </li>
    </ul>
</div>
