<h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Select</twig:Typography></h2>
<div class="flex gap-4 flex-wrap">
    <ul class="bg-neutral-100 rounded-sm p-8 flex flex-col gap-4 shadow-(--shadow)">
        <li><twig:Form:Select id="select" name="select" /></li>
        <li><twig:Form:Select id="select-multiple" name="select-multiple" multiple /></li>
        <li><twig:Form:Select id="select-tip" name="select-tip" tip="test" tipIcon="eye" /></li>
        <li><twig:Form:Select id="select-disabled" name="select-disabled" disabled /></li>
    </ul>
</div>
