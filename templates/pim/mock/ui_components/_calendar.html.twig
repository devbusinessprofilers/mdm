<h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Calendrier</twig:Typography></h2>
<div class="flex gap-4 flex-wrap">
    {% set inputFormat = 'd/m/Y' %}
    {% set separator = ' - ' %}
    <ul class="bg-neutral-100 rounded-sm p-8 flex flex-col gap-4 shadow-(--shadow)">
        <li><twig:Form:Calendar id="calendar" name="calendar" value="{{ 'now'|date(inputFormat) }}" inputFormat="{{ inputFormat }}" /></li>
        <li>
            <twig:Form:CalendarRange
                id="calendar-range"
                name="calendar-range"
                value="{{ 'now'|date(inputFormat) ~ separator ~ date('+ 5days')|date(inputFormat) }}"
                inputFormat="{{ inputFormat }}"
                separator="{{ separator }}"
            />
        </li>
        <li><twig:Form:Calendar id="calendar-disabled" name="calendar-disabled" disabled /></li>
    </ul>
</div>
