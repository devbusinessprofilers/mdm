<h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Tags</twig:Typography></h2>
<div class="flex gap-8 flex-col bg-neutral-100 rounded-sm p-8  shadow-(--shadow)">
    <ul class="flex flex-wrap max-w-full gap-4">
        <li><twig:Tag label="Tag neutral" variant="neutral" size="sm"/></li>
        <li><twig:Tag label="Tag old-gold" variant="old-gold" size="sm"/></li>
        <li><twig:Tag label="Tag primary" variant="primary" size="sm"/></li>
        <li><twig:Tag label="Tag primary-3" variant="primary-3" size="sm"/></li>
        <li><twig:Tag label="Tag peach" variant="peach" size="sm"/></li>
        <li><twig:Tag label="Tag success" variant="success" size="sm"/></li>
        <li><twig:Tag label="Tag success-pastel" variant="success-pastel" size="sm"/></li>
        <li><twig:Tag label="Tag error" variant="error" size="sm"/></li>
    </ul>
    <ul class="flex flex-wrap max-w-full gap-4">
        <li><twig:Tag label="Large tag neutral" icon="eye" variant="neutral" size="lg"/></li>
        <li><twig:Tag label="Large tag old-gold" icon="eye" variant="old-gold" size="lg"/></li>
        <li><twig:Tag label="Large tag primary" icon="eye" variant="primary" size="lg"/></li>
        <li><twig:Tag label="Large tag primary-3" icon="eye" variant="primary-3" size="lg"/></li>
        <li><twig:Tag label="Large tag peach" icon="eye" variant="peach" size="lg"/></li>
        <li><twig:Tag label="Large tag success" icon="eye" variant="success" size="lg"/></li>
        <li><twig:Tag label="Large tag success-pastel" icon="eye" variant="success-pastel" size="lg"/></li>
        <li><twig:Tag label="Large tag error" icon="eye" variant="error" size="lg"/></li>
    </ul>
    <ul class="flex flex-wrap max-w-full gap-4">
        <li><twig:Tag label="Small tag with long text neutral" icon="check" variant="neutral" size="sm"/></li>
        <li><twig:Tag label="Small tag with long text old-gold" icon="check" variant="old-gold" size="sm"/></li>
        <li><twig:Tag label="Small tag with long text primary" icon="check" variant="primary" size="sm"/></li>
        <li><twig:Tag label="Small tag with long text primary-3" icon="check" variant="primary-3" size="sm"/></li>
        <li><twig:Tag label="Small tag with long text peach" icon="check" variant="peach" size="sm"/></li>
        <li><twig:Tag label="Small tag with long text success" icon="check" variant="success" size="sm"/></li>
        <li><twig:Tag label="Small tag with long text success-pastel" icon="check" variant="success-pastel" size="sm"/></li>
        <li><twig:Tag label="Small tag with long text error" icon="check" variant="error" size="sm"/></li>
    </ul>
</div>
