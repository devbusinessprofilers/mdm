<h2><twig:Typography variant="heading-2" bold class="mt-8 mb-4 block">Radio button</twig:Typography></h2>
<div class="flex gap-8 flex-col bg-neutral-100 rounded-sm p-8  shadow-(--shadow)">
    <ul class="flex flex-wrap max-w-full gap-8">
        <li><twig:Form:RadioItem id="radio-1" name="radio" checked>Checked</twig:Form:RadioItem></li>
        <li><twig:Form:RadioItem id="radio-2" name="radio">Unchecked</twig:Form:RadioItem></li>
        <li><twig:Form:RadioItem id="radio-3" name="radio-disabled" checked disabled>Checked disabled</twig:Form:RadioItem></li>
        <li><twig:Form:RadioItem id="radio-4" name="radio-disabled" disabled>Unchecked disabled</twig:Form:RadioItem></li>
    </ul>
</div>
