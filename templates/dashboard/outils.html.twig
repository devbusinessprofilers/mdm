{% extends 'mdm/base.html.twig' %}

{#
    Écran « Outils » — châssis maquette : le rail porte le journal et ses
    familles (les vraies destinations sont les filtres du journal, le détail
    de chaque ligne renvoyant vers l'écran concerné), le contenu reste le
    journal unifié des traitements.
#}

{% macro indicateur(libelle, valeur, note, icone, fond) %}
    <div class="flex flex-col flex-1 basis-48 min-w-0 box-border gap-1.5 px-5 py-4
                rounded-sm bg-neutral-100 shadow-(--shadow)">
        <div class="flex items-center gap-2">
            {# Le fond de la pastille dit la nature du compteur, pas sa valeur. #}
            <span class="flex items-center justify-center shrink-0 w-7 h-7 rounded-lg {{ fond }}">
                <twig:Icon name="{{ icone }}" aria-hidden="true" class="w-4 h-4 text-primary-3" />
            </span>
            <twig:Typography variant="body-xs" bold textColor="neutral-500" ellipsis
                             class="min-w-0 tracking-[0.3px] uppercase">{{ libelle }}</twig:Typography>
        </div>
        <twig:Typography variant="subtitle" class="font-[700]!">{{ valeur }}</twig:Typography>
        <twig:Typography variant="body-sm" textColor="neutral-500">{{ note }}</twig:Typography>
    </div>
{% endmacro %}

{% block title %}Outils · Journal des traitements{% endblock %}

{% set famille_libelles = familles %}
{% set statuts_erreur = ['echoue', 'termine_avec_erreurs', 'failed', 'en_erreur'] %}
{% set famille_icones = { 'import': 'upload-simple', 'ocr': 'ai', 'traduction': 'list', 'media': 'images' } %}

{% set a_venir = 'Fonction à venir — en développement' %}

{# ------------------------------------------------- Rail : les outils, puis les familles du journal #}
{% block rail %}
    <nav class="flex flex-col shrink-0 box-border w-[328px] pl-5 pr-3 py-4 gap-4 overflow-hidden"
         aria-label="Outils et familles du journal">
        <div class="flex flex-col gap-1">
            <twig:Typography variant="body" bold class="pl-2 pr-4">Outils</twig:Typography>
            <div class="flex flex-col">
                {# Mise à jour massive : pas de back → grisée. #}
                <span title="{{ a_venir }}" aria-disabled="true"
                      class="flex items-center gap-2 box-border px-4 py-2 rounded-xs overflow-hidden opacity-60 cursor-not-allowed">
                    <twig:Icon name="pencil" aria-hidden="true" class="shrink-0 self-center w-4 h-4 mx-1 text-neutral-400" />
                    <twig:Typography variant="body" bold ellipsis textColor="neutral-500" class="flex-1 min-w-0">Mise à jour massive</twig:Typography>
                    <twig:Typography variant="body-xs" bold textColor="neutral-500"
                                     class="shrink-0 px-[7px] py-0.5 rounded-lg bg-neutral-200">À venir</twig:Typography>
                </span>

                <a href="{{ path('app_mdm_outils') }}"
                   class="group/onglet flex items-center gap-2 box-border px-4 py-2 rounded-xs overflow-hidden cursor-pointer
                          hover:bg-primary-4 aria-[current=page]:bg-linear-(--primary-gradient) aria-[current=page]:hover:bg-none"
                   {{ famille is null ? 'aria-current="page"' : '' }}>
                    <twig:Icon name="spinner" aria-hidden="true"
                               class="shrink-0 self-center w-4 h-4 mx-1 text-primary group-aria-[current=page]/onglet:text-neutral-100" />
                    <twig:Typography variant="body" bold ellipsis textColor="primary-3"
                                     class="flex-1 min-w-0 group-aria-[current=page]/onglet:text-neutral-100!">Journal des traitements</twig:Typography>
                    <twig:Typography variant="body-xs" bold textColor="neutral-500"
                                     class="shrink-0 px-[7px] py-0.5 rounded-lg bg-neutral-200
                                            group-aria-[current=page]/onglet:bg-neutral-100
                                            group-aria-[current=page]/onglet:text-primary-3!">{{ lignes|length }}</twig:Typography>
                </a>

                {# Campagnes IA : pas de back → grisée. #}
                <span title="{{ a_venir }}" aria-disabled="true"
                      class="flex items-center gap-2 box-border px-4 py-2 rounded-xs overflow-hidden opacity-60 cursor-not-allowed">
                    <twig:Icon name="rocket" aria-hidden="true" class="shrink-0 self-center w-4 h-4 mx-1 text-neutral-400" />
                    <twig:Typography variant="body" bold ellipsis textColor="neutral-500" class="flex-1 min-w-0">Campagnes IA</twig:Typography>
                    <twig:Typography variant="body-xs" bold textColor="neutral-500"
                                     class="shrink-0 px-[7px] py-0.5 rounded-lg bg-neutral-200">À venir</twig:Typography>
                </span>

                {# Imports & exports : écran dédié à venir. #}
                <span title="{{ a_venir }}" aria-disabled="true"
                      class="flex items-center gap-2 box-border px-4 py-2 rounded-xs overflow-hidden opacity-60 cursor-not-allowed">
                    <twig:Icon name="upload-simple" aria-hidden="true" class="shrink-0 self-center w-4 h-4 mx-1 text-neutral-400" />
                    <twig:Typography variant="body" bold ellipsis textColor="neutral-500" class="flex-1 min-w-0">Imports & exports</twig:Typography>
                    <twig:Typography variant="body-xs" bold textColor="neutral-500"
                                     class="shrink-0 px-[7px] py-0.5 rounded-lg bg-neutral-200">À venir</twig:Typography>
                </span>
            </div>
        </div>

        <div class="flex flex-col gap-1">
            <twig:Typography variant="body" bold class="pl-2 pr-4">Familles du journal</twig:Typography>
            <div class="flex flex-col">
                {% for cle, libelle in familles %}
                    <a href="{{ path('app_mdm_outils', { famille: cle }) }}"
                       class="group/onglet flex items-center gap-2 box-border px-4 py-2 rounded-xs overflow-hidden cursor-pointer
                              hover:bg-primary-4 aria-[current=page]:bg-linear-(--primary-gradient) aria-[current=page]:hover:bg-none"
                       {{ famille == cle ? 'aria-current="page"' : '' }}>
                        <twig:Icon name="{{ famille_icones[cle]|default('clipboard') }}" aria-hidden="true"
                                   class="shrink-0 self-center w-4 h-4 mx-1 text-primary group-aria-[current=page]/onglet:text-neutral-100" />
                        <twig:Typography variant="body" bold ellipsis textColor="primary-3"
                                         class="flex-1 min-w-0 group-aria-[current=page]/onglet:text-neutral-100!">{{ libelle }}</twig:Typography>
                    </a>
                {% endfor %}
            </div>
        </div>

        <span class="flex-1"></span>

        {% if outbox_en_attente > 0 %}
            <div class="shrink-0 flex flex-col gap-1.5 mr-1 p-3.5 rounded-[12px] bg-primary-4">
                <twig:Typography variant="body-sm" bold textColor="primary-3">Outbox</twig:Typography>
                <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">
                    {{- outbox_en_attente }} message{{ outbox_en_attente > 1 ? 's' : '' }} en attente de départ vers la marketplace.
                </twig:Typography>
            </div>
        {% endif %}
    </nav>
{% endblock %}

{% block contenu %}
<main class="flex flex-col h-full min-h-0 overflow-y-auto scrollbar">

    <div class="shrink-0 flex items-end justify-between gap-6 px-10 pt-[22px] pb-4">
        <div class="flex flex-col gap-1 min-w-0 max-w-[720px]">
            <twig:Typography variant="heading-2" element="h1"
                             class="sm:text-[1.625rem]! sm:leading-[2.125rem]! font-[700]!">
                {{- famille ? famille_libelles[famille] : 'Journal des traitements' -}}
            </twig:Typography>
            <twig:Typography variant="body" element="p" textColor="neutral-500">Imports, extractions, traductions et médias, du plus récent au plus ancien.</twig:Typography>
        </div>
        <div class="flex items-center gap-2.5 shrink-0">
            <twig:Button variant="{{ erreurs ? 'primary' : 'outline' }}" size="sm" asLink
                         href="{{ path('app_mdm_outils', { erreurs: erreurs ? null : 1, famille: famille }) }}">En échec seulement</twig:Button>
            {% if is_granted('ROLE_ADMIN') %}
                <twig:Button variant="primary" size="md" icon="upload-simple" asLink href="{{ path('app_etl_import_index') }}">Importer un fichier</twig:Button>
            {% endif %}
        </div>
    </div>

    <div class="flex-1 min-h-0 flex flex-col gap-4 px-10 pb-8">

        {# ---- Indicateurs maquette, calculés sur le journal courant. ---- #}
        {% set en_erreur = lignes|filter(l => l.statut in statuts_erreur)|length %}
        {% set en_cours = lignes|filter(l => l.statut in ['en_cours', 'processing', 'running', 'en_attente', 'pending'])|length %}
        <div class="shrink-0 flex flex-row gap-3.5 flex-wrap">
            {{ _self.indicateur('Traitements', lignes|length, 'journal courant', 'info-circle', 'bg-neutral-200') }}
            {{ _self.indicateur('En cours ou en file', en_cours, 'suivis en direct', 'spinner', 'bg-primary-4') }}
            {{ _self.indicateur('Terminés', lignes|length - en_erreur - en_cours, 'sans erreur bloquante', 'ok-circle', 'bg-success-pastel') }}
            {{ _self.indicateur('Avec erreurs', en_erreur, 'détail ligne à ligne', 'warning', 'bg-error-pastel') }}
            {{ _self.indicateur('Outbox', outbox_en_attente, 'messages en attente', 'paper-plane', 'bg-peach-pastel') }}
        </div>

        {# ---- Tableau maquette : Origine / Traitement / État / Erreur / Quand / lien. ---- #}
        {% set grille = 'grid gap-4 items-center px-4 grid-cols-[repeat(auto-fit,minmax(0,1fr))]' %}
        {% set etat_jetons = {
            'echoue': ['Échoué', 'bg-error-pastel'],
            'failed': ['Échoué', 'bg-error-pastel'],
            'en_erreur': ['En erreur', 'bg-error-pastel'],
            'termine_avec_erreurs': ['Terminé avec erreurs', 'bg-peach-pastel'],
            'en_cours': ['En cours', 'bg-primary-4'],
            'processing': ['En cours', 'bg-primary-4'],
            'running': ['En cours', 'bg-primary-4'],
            'en_attente': ['En file', 'bg-neutral-200'],
            'pending': ['En file', 'bg-neutral-200'],
        } %}
        <div class="shrink-0 flex flex-col rounded-sm overflow-hidden bg-neutral-100 shadow-(--shadow)">
            <div class="{{ grille }} h-9 shrink-0 bg-primary-5 border-b border-neutral-200" role="row">
                {% for colonne in [['Origine'], ['Traitement'], ['État'], ['Erreur'], ['Quand'], ['', 'text-right']] %}
                    <span class="min-w-0 truncate {{ colonne.1|default('text-left') }}" role="columnheader">
                        <twig:Typography variant="body-xs" bold textColor="neutral-500"
                                         class="tracking-[0.3px] uppercase">{{ colonne.0 }}</twig:Typography>
                    </span>
                {% endfor %}
            </div>

            <div class="flex flex-col">
                {% for ligne in lignes %}
                    {% set jeton = etat_jetons[ligne.statut]|default([ligne.statut|replace({'_': ' '})|capitalize, 'bg-success-pastel']) %}
                    <div role="row" class="{{ grille }} w-full min-h-[56px] py-2 box-border hover:bg-primary-5
                                           {{ loop.first ? '' : 'border-t border-neutral-200' }}">
                        <span class="min-w-0">
                            <twig:Typography variant="body-sm" ellipsis textColor="neutral-500">{{ famille_libelles[ligne.famille] ?? ligne.famille }}</twig:Typography>
                        </span>
                        <span class="flex flex-col min-w-0">
                            <twig:Typography variant="body-sm" bold ellipsis>{{ ligne.sujet }}</twig:Typography>
                        </span>
                        <span class="min-w-0">
                            <span class="inline-flex w-fit max-w-full px-[9px] py-[3px] rounded-lg {{ jeton.1 }}">
                                <twig:Typography variant="body-xs" bold ellipsis
                                                 textColor="{{ jeton.1 == 'bg-neutral-200' ? 'neutral-500' : 'primary-3' }}">{{ jeton.0 }}</twig:Typography>
                            </span>
                        </span>
                        <span class="min-w-0">
                            <twig:Typography variant="body-sm" textColor="{{ ligne.erreur ? 'error' : 'neutral-500' }}" class="text-pretty">{{ ligne.erreur ?? '—' }}</twig:Typography>
                        </span>
                        <span class="min-w-0">
                            <twig:Typography variant="body-sm" ellipsis textColor="neutral-500">{{ ligne.quand|date('d/m/Y H:i') }}</twig:Typography>
                        </span>
                        <span class="flex items-center justify-end min-w-0">
                            {% if ligne.lien and (is_granted('ROLE_ADMIN') or ligne.famille in ['ocr', 'traduction']) %}
                                <a href="{{ path(ligne.lien.route, ligne.lien.params) }}"
                                   class="flex items-center gap-1.5 rounded-xs hover:underline decoration-primary-3">
                                    <twig:Typography variant="body-sm" bold textColor="primary-3">Détail</twig:Typography>
                                    <twig:Icon name="arrow-right" aria-hidden="true" class="shrink-0 w-3 h-3 text-primary" />
                                </a>
                            {% else %}
                                <twig:Typography variant="body-sm" textColor="neutral-400">—</twig:Typography>
                            {% endif %}
                        </span>
                    </div>
                {% else %}
                    <div class="flex items-center gap-3 px-4 min-h-[56px]">
                        <twig:Icon name="ok-circle" aria-hidden="true" class="shrink-0 w-5 h-5 text-success" />
                        <twig:Typography variant="body-sm" textColor="neutral-500">
                            {{- erreurs ? 'Aucun traitement en échec — tout roule.' : 'Aucun traitement enregistré.' -}}
                        </twig:Typography>
                    </div>
                {% endfor %}
            </div>

            <div class="shrink-0 flex items-center h-[50px] px-4 border-t border-neutral-200">
                <twig:Typography variant="body-sm" textColor="neutral-500">
                    {{- lignes|length }} traitement{{ lignes|length > 1 ? 's' : '' }} affiché{{ lignes|length > 1 ? 's' : '' }} · {{ en_erreur }} en échec
                </twig:Typography>
            </div>
        </div>
    </div>
</main>
{% endblock %}
