{% extends 'mdm/base.html.twig' %}

{#
    Écran « Qualité » — châssis maquette (rail d'onglets badgés),
    contenus réels par onglet : santé par
    gamme/canal, conflits IA + adresses BAN/Geoapify, écarts de forme,
    notifications, décisions d'arbitrage.

    Écart assumé : pas de bloc « santé » à score global pondéré (aucun agrégat
    back) — la complétude par gamme et canal, réelle, tient ce rôle.
#}

{% block title %}Qualité · {{ onglets[onglet_actif] }}{% endblock %}

{% set gamme_libelles = {
    'lieu': 'Lieux', 'restaurant': 'Restaurants',
    'activite': 'Activités', 'service_evenementiel': 'Services',
} %}
{% set onglet_actions = {
    'miroir': [],
    'conflits': [['Arbitrer en masse', 'ok-circle']],
    'doublons_textes': [],
    'formes': [['Normaliser en masse', 'list']],
    'notifs': [['Renvoyer les relances', 'paper-plane']],
    'decisions': [['Exporter', 'clipboard']],
} %}
{% set onglet_meta = {
    'miroir': { icone: 'shield-check', sousTitre: 'La complétude mesurée par gamme et par canal de diffusion.' },
    'conflits': { icone: 'warning', sousTitre: 'Valeurs IA et écarts d\'adresse à arbitrer — Accepter applique, Ignorer garde la saisie.' },
    'doublons_textes': { icone: 'cube', sousTitre: 'Textes identiques ou proches entre fiches — Confirmer acte le doublon, Ignorer garde la saisie.' },
    'formes': { icone: 'list', sousTitre: 'Les écarts de forme à normaliser : pays, GPS, libellés.' },
    'notifs': { icone: 'paper-plane', sousTitre: 'Les relances de complétude envoyées aux contributeurs.' },
    'decisions': { icone: 'check-circle', sousTitre: 'La trace des arbitrages : qui a tranché, quoi, quand.' },
} %}

{# ------------------------------------------------- Rail des onglets #}
{% block rail %}
    <nav class="flex flex-col shrink-0 box-border w-[328px] pl-5 pr-3 py-4 gap-4 overflow-hidden"
         aria-label="Onglets de la gouvernance des données">
        <div class="flex flex-col gap-1">
            <twig:Typography variant="body" bold class="pl-2 pr-4">Gouvernance des données</twig:Typography>
            <div class="flex flex-col">
                {% for cle, libelle in onglets %}
                    <a href="{{ path('app_mdm_qualite', { onglet: cle }) }}"
                       class="group/onglet flex items-center gap-2 box-border px-4 py-2
                              rounded-xs overflow-hidden cursor-pointer
                              hover:bg-primary-4 aria-[current=page]:bg-linear-(--primary-gradient) aria-[current=page]:hover:bg-none"
                       {{ onglet_actif == cle ? 'aria-current="page"' : '' }}>
                        <twig:Icon name="{{ onglet_meta[cle].icone }}" aria-hidden="true"
                                   class="shrink-0 self-center w-4 h-4 mx-1 text-primary
                                          group-aria-[current=page]/onglet:text-neutral-100" />
                        <twig:Typography variant="body" bold ellipsis textColor="primary-3"
                                         class="flex-1 min-w-0
                                                group-aria-[current=page]/onglet:text-neutral-100!">{{ libelle }}</twig:Typography>
                        {% if badges[cle] is defined %}
                            <twig:Typography variant="body-xs" bold textColor="neutral-500"
                                             class="shrink-0 px-[7px] py-0.5 rounded-lg bg-neutral-200
                                                    group-aria-[current=page]/onglet:bg-neutral-100
                                                    group-aria-[current=page]/onglet:text-primary-3!">{{ badges[cle] }}</twig:Typography>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        </div>

    </nav>
{% endblock %}

{% block contenu %}
<main class="flex flex-col h-full min-h-0 overflow-y-auto scrollbar">

    <div class="shrink-0 flex items-end justify-between gap-6 px-10 pt-[22px] pb-4">
        <div class="flex flex-col gap-1 min-w-0 max-w-[720px]">
            <twig:Typography variant="heading-2" element="h1"
                             class="sm:text-[1.625rem]! sm:leading-[2.125rem]! font-[700]!">{{ onglets[onglet_actif] }}</twig:Typography>
            <twig:Typography variant="body" element="p" textColor="neutral-500"
                             class="text-pretty">{{ onglet_meta[onglet_actif].sousTitre }}</twig:Typography>
        </div>
        <div class="flex items-center gap-2.5 shrink-0">
            {# Recalcul réel des snapshots (mêmes messages que les passages planifiés). #}
            {% if form_recalcul %}
                {{ form(form_recalcul) }}
                <twig:Button variant="outline" size="sm" icon="ok-circle" asLink
                             href="{{ path('app_mdm_qualite', { onglet: 'conflits' }) }}">Arbitrer les conflits</twig:Button>
            {% endif %}
            {# Actions de la maquette sans back : visibles mais désactivées. #}
            {% for action in onglet_actions[onglet_actif]|default([]) %}
                <span title="Fonction à venir — en développement" class="inline-flex">
                    <twig:Button variant="outline" size="sm" icon="{{ action.1 }}" disabled>{{ action.0 }}</twig:Button>
                </span>
            {% endfor %}
            {% if is_granted('ROLE_SUPER_ADMIN') %}
                <twig:Button variant="outline" size="sm" asLink href="{{ path('app_pim_completeness_index') }}">Configuration de la complétude</twig:Button>
            {% endif %}
        </div>
    </div>

    {# `grow` sans basis-0 : le bloc s'étire sur l'écran quand le contenu est
       court, mais grandit AVEC le contenu quand il déborde — sinon la boîte
       reste à la hauteur de l'écran et le pb-8 se perd au milieu du contenu
       au lieu d'espacer le bas de la page. #}
    <div class="grow flex flex-col gap-4 px-10 pb-8">
    {% if onglet_actif == 'miroir' %}
        {# ---- Bloc santé maquette, sur données réelles : score pondéré par
             les volumes de fiches, un axe par canal de diffusion. ---- #}
        {% set total_fiches = sante|reduce((s, l) => s + l.fiches, 0) %}
        {% if total_fiches > 0 %}
            {% set score = (sante|reduce((s, l) => s + l.fiches * (l.global ?? 0), 0) / total_fiches)|round %}
            {% set palier = score >= 75 ? 'complet' : (score >= 60 ? 'publiable' : 'insuffisant') %}
            <div class="shrink-0 flex flex-col min-[1200px]:flex-row gap-4 items-stretch">
                <div class="flex flex-col box-border gap-4 px-[26px] py-6 rounded-md bg-neutral-100 shadow-(--shadow) w-full min-[1200px]:w-[400px] shrink-0">
                    <twig:Typography variant="body" bold>Santé du référentiel</twig:Typography>
                    <div class="flex items-end gap-3.5">
                        <twig:Typography variant="heading-1" element="p"
                                         class="shrink-0 whitespace-nowrap sm:text-[3.25rem]! sm:leading-[3.625rem]! font-[700]!">{{ score }} %</twig:Typography>
                        <div class="flex flex-col gap-[3px] pb-1.5">
                            <span class="w-fit px-[9px] py-[3px] rounded-lg {{ palier == 'complet' ? 'bg-success-pastel' : (palier == 'publiable' ? 'bg-peach-pastel' : 'bg-error-pastel') }}">
                                <twig:Typography variant="body-xs" bold textColor="primary-3">{{ palier == 'complet' ? 'Complet' : (palier == 'publiable' ? 'Publiable' : 'Insuffisant') }}</twig:Typography>
                            </span>
                            <twig:Typography variant="body-sm" textColor="neutral-500">complétude moyenne pondérée sur {{ total_fiches }} fiches</twig:Typography>
                        </div>
                    </div>
                    <div class="w-full h-2 rounded-lg bg-neutral-200 overflow-hidden">
                        <div class="h-full rounded-lg {{ score >= 60 ? 'bg-linear-(--primary-gradient)' : 'bg-peach' }}"
                             style="width: {{ score }}%"></div>
                    </div>
                    <div class="flex flex-col gap-2.5">
                        {% for canal, libelle in { 'global': 'Global', 'marketplace': 'Marketplace', 'thematic': 'Sites thématiques', 'salesforce': 'Salesforce', 'portal': 'Portail' } %}
                            {% set part = (sante|reduce((s, l) => s + l.fiches * (attribute(l, canal) ?? 0), 0) / total_fiches)|round %}
                            {% set palier_axe = part >= 75 ? 'complet' : (part >= 60 ? 'publiable' : 'insuffisant') %}
                            <div class="flex flex-col gap-1">
                                <div class="flex items-baseline justify-between gap-3">
                                    <twig:Typography variant="body-sm" bold class="min-w-0">{{ libelle }}</twig:Typography>
                                    <twig:Typography variant="body" bold
                                                     textColor="{{ palier_axe == 'complet' ? 'success' : (palier_axe == 'publiable' ? 'primary-3' : 'error') }}">{{ part }} %</twig:Typography>
                                </div>
                                <div class="w-full h-1 rounded-lg bg-neutral-200 overflow-hidden">
                                    <div class="h-full rounded-lg {{ palier_axe == 'complet' ? 'bg-success' : (palier_axe == 'publiable' ? 'bg-peach' : 'bg-error') }}"
                                         style="width: {{ part }}%"></div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="flex flex-col box-border gap-4 px-[26px] py-6 rounded-md bg-neutral-100 shadow-(--shadow) flex-1 min-w-0">
                    <twig:Typography variant="body" bold>Champs les moins renseignés</twig:Typography>
                    <div class="flex flex-col gap-0.5">
                        {% for faible in champs_faibles %}
                            <div class="flex items-center gap-2.5 px-2.5 py-2 rounded-xs">
                                <span class="shrink-0 w-1.5 h-1.5 rounded-lg bg-peach" aria-hidden="true"></span>
                                <twig:Typography variant="body-sm" ellipsis class="flex-1 min-w-0">{{ faible.libelle }}</twig:Typography>
                                <twig:Typography variant="body-sm" bold textColor="error"
                                                 class="w-[46px] shrink-0 text-right">{{ faible.part }} %</twig:Typography>
                                <twig:Typography variant="body-xs" textColor="neutral-400"
                                                 class="w-24 shrink-0 text-right">{{ faible.poids }}</twig:Typography>
                            </div>
                        {% else %}
                            <twig:Typography variant="body-sm" textColor="neutral-500">Le relevé des champs arrivera au prochain calcul des statistiques.</twig:Typography>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}

        {# Comparaison inter-sources de la maquette : pas de back → grisée. #}
        <div title="Fonction à venir — en développement"
             class="shrink-0 flex items-center gap-3 px-[26px] py-5 rounded-md bg-neutral-100 shadow-(--shadow) opacity-60">
            <twig:Icon name="warning" aria-hidden="true" class="shrink-0 w-6 h-6 text-neutral-400" />
            <div class="flex flex-col gap-0.5 flex-1 min-w-0">
                <twig:Typography variant="subtitle" class="text-[1.125rem]! leading-[1.625rem]! font-[700]!">Comparaison Salesforce / MDM / portail</twig:Typography>
                <twig:Typography variant="body" textColor="neutral-500">Le miroir champ à champ entre les trois sources arrivera avec l'intégration Salesforce.</twig:Typography>
            </div>
            <twig:Tag label="À venir" variant="neutral" size="sm" class="shrink-0" />
        </div>

        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="Santé des données">
            <twig:Typography variant="heading-3" element="h2" bold>Complétude par gamme et par canal</twig:Typography>
            <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
                <table class="w-full border-collapse">
                    <thead class="bg-primary-5"><tr class="text-left h-10 border-b border-neutral-200">
                        {% for col in ['Gamme', 'Fiches', 'Global', 'Marketplace', 'Sites thématiques', 'Salesforce', 'Portail', 'Insuffisantes (< 60 %)'] %}
                            <th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ col }}</twig:Typography></th>
                        {% endfor %}
                    </tr></thead>
                    <tbody>
                    {% for ligne in sante %}
                        <tr class="h-11 border-t border-neutral-200 first:border-t-0">
                            <td class="px-3"><twig:Typography variant="body-sm" bold>{{ gamme_libelles[ligne.type] ?? ligne.type }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ ligne.fiches }}</twig:Typography></td>
                            {% for canal in ['global', 'marketplace', 'thematic', 'salesforce', 'portal'] %}
                                <td class="px-3"><twig:Typography variant="body-sm">{{ attribute(ligne, canal) is null ? '—' : attribute(ligne, canal) ~ ' %' }}</twig:Typography></td>
                            {% endfor %}
                            <td class="px-3">
                                {% if ligne.insuffisantes > 0 %}
                                    <a href="{{ path('app_mdm_referentiel_general', {f: {gammes: [ligne.type], completudes: ['insuffisant']}}) }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">{{ ligne.insuffisantes }}</twig:Typography></a>
                                {% else %}<twig:Typography variant="body-sm">0</twig:Typography>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% elseif onglet_actif == 'conflits' %}
        {# ---- Cartes maquette, comptes réels. ---- #}
        <div class="shrink-0 flex flex-row gap-4 flex-wrap">
            {% for c in [
                { icone: 'ai', titre: 'Valeurs IA en attente', valeur: suggestions|length, alerte: suggestions|length > 0, texte: 'Suggestions issues de l\'extraction de documents, à arbitrer champ par champ.' },
                { icone: 'warning', titre: 'Écarts d\'adresse', valeur: adresses_comptes.avec, alerte: adresses_comptes.avec > 0, texte: 'La BAN ou Geoapify propose une autre adresse — Accepter applique en un clic.' },
                { icone: 'magnifying-glass', titre: 'Sans résultat fiable', valeur: adresses_comptes.sans, alerte: false, texte: 'Aucune correspondance sûre : à corriger à la main dans la fiche.' },
                { icone: 'cube', titre: 'Adresses partagées', valeur: doublons_adresse|length, alerte: false, texte: 'Plusieurs fiches déclarent la même adresse — doublons possibles.' },
            ] %}
                <div class="flex flex-col box-border gap-3 px-[26px] py-6 rounded-md bg-neutral-100 shadow-(--shadow) flex-1 basis-72 min-w-0">
                    <div class="flex items-center gap-3">
                        <twig:Icon name="{{ c.icone }}" aria-hidden="true"
                                   class="shrink-0 w-6 h-6 {{ c.alerte ? 'text-error' : 'text-primary' }}" />
                        <twig:Typography variant="subtitle" ellipsis
                                         class="flex-1 min-w-0 text-[1.125rem]! leading-[1.625rem]! font-[700]!">{{ c.titre }}</twig:Typography>
                        <span class="inline-flex shrink-0"><twig:Tag label="{{ c.valeur }}" size="sm"
                                  variant="{{ c.alerte ? 'error' : 'success-pastel' }}" class="whitespace-nowrap" /></span>
                    </div>
                    <twig:Typography variant="body" textColor="neutral-500" class="text-pretty">{{ c.texte }}</twig:Typography>
                </div>
            {% endfor %}
        </div>

        {# La modale « sources » est déclenchée depuis l'en-tête du bloc « Suggestions à arbitrer » ci-dessous. #}
        <twig:Modal identifier="sources-enrichissement">
            <div class="flex flex-col gap-6 w-[min(720px,80vw)]">
                <div class="flex flex-col gap-1">
                    <twig:Typography variant="heading-3" element="h2" bold>D'où viennent les suggestions</twig:Typography>
                    <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">Les corrections et enrichissements proposés ici sont produits automatiquement par des sources externes gratuites. Rien n'est écrit sans votre décision : Accepter applique, Ignorer conserve la saisie.</twig:Typography>
                </div>
                {% for s in [
                    {
                        nom: 'Sirene / Recherche-entreprises', etat: 'Actif',
                        declenchement: 'Batch mensuel automatique (1er du mois, si le paramètre est activé) ; lancement manuel possible.',
                        porte: 'Statut d\'activité des lieux, SIRET et TVA manquants.',
                        apport: 'Détecte les établissements cessés (proposition d\'archivage) et complète les identifiants légaux.',
                        couverture: 'France uniquement.',
                        prerequis: 'Fiche Lieu avec SIRET (contrôle exact) ou rapprochement par nom + code postal.',
                        contrainte: 'Hors de France : non couvert. Le rapprochement sans SIRET peut être incertain (arbitrage requis).',
                        licence: 'Service public gratuit, sans clé.'
                    },
                    {
                        nom: 'BAN / Geoapify (adresses)', etat: 'Actif',
                        declenchement: 'Automatique à chaque modification d\'adresse d\'une fiche ; vérification de masse manuelle possible.',
                        porte: 'Adresse postale et coordonnées GPS.',
                        apport: 'Vérifie l\'adresse, corrige code postal / ville et géolocalise.',
                        couverture: 'BAN en France, Geoapify à l\'étranger (mondial).',
                        prerequis: 'Une adresse saisie sur la fiche. Geoapify nécessite une clé API.',
                        contrainte: 'Sans clé Geoapify, l\'étranger n\'est pas vérifié.',
                        licence: 'BAN : gratuit, sans clé. Geoapify : gratuit, données © OpenStreetMap.'
                    },
                    {
                        nom: 'Geoapify Places', etat: 'Actif',
                        declenchement: 'Lancement manuel (commande d\'enrichissement des restaurants) — pas de tâche planifiée (volume d\'appels).',
                        porte: 'Attributs des restaurants : type de cuisine, spécificités alimentaires, équipements (wifi, terrasse, climatisation), accessibilité PMR, site officiel.',
                        apport: 'Complète les champs vides depuis OpenStreetMap (n\'écrase jamais une saisie).',
                        couverture: 'Tous pays, dès qu\'un GPS est présent sur la fiche.',
                        prerequis: 'Restaurant géolocalisé, clé GEOAPIFY_API_KEY et paramètre activé.',
                        contrainte: 'Couverture OpenStreetMap inégale selon les zones. Horaires non repris (format trop complexe). Plan gratuit : 3 000 requêtes/jour.',
                        licence: 'Gratuit, données © OpenStreetMap.'
                    },
                    {
                        nom: 'DATAtourisme', etat: 'Actif',
                        declenchement: 'Import manuel du flux synchronisé — pas de tâche planifiée.',
                        porte: 'Lieux et activités : description générale ; équipements bien-être / installations des lieux.',
                        apport: 'Complète les champs vides depuis les données des offices de tourisme (les photos réutilisables arriveront ensuite).',
                        couverture: 'France (métropole et outre-mer).',
                        prerequis: 'Flux JSON-LD configuré sur datatourisme.fr et synchronisé localement ; paramètre activé. Rapprochement par nom + code postal.',
                        contrainte: 'Couvre uniquement les établissements référencés par les offices de tourisme. Photos non encore reprises.',
                        licence: 'Open data officiel, Licence Ouverte 2.0 (réutilisation commerciale autorisée).'
                    },
                    {
                        nom: 'Wikidata', etat: 'Actif',
                        declenchement: 'Lancement manuel (commande de détection de chaînes) — pas de tâche planifiée.',
                        porte: 'Affiliation d\'un lieu à un groupe / une chaîne / une marque hôtelière.',
                        apport: 'Détecte l\'enseigne depuis le nom (référentiel interne des grands groupes, enrichi de Wikidata).',
                        couverture: 'Mondial (enseignes notables). Lieux uniquement.',
                        prerequis: 'Paramètre activé. Le référentiel interne fonctionne seul ; Wikidata (SPARQL) l\'enrichit s\'il est joignable.',
                        contrainte: 'Détection sur le nom : un établissement hors enseigne connue n\'est pas rattaché.',
                        licence: 'Gratuit (SPARQL, données Wikidata sous CC0).'
                    },
                ] %}
                    <div class="flex flex-col gap-1.5 p-4 rounded-md bg-primary-5">
                        <div class="flex items-center gap-3">
                            <twig:Typography variant="subtitle" bold class="flex-1 min-w-0">{{ s.nom }}</twig:Typography>
                            <span class="inline-flex shrink-0"><twig:Tag label="{{ s.etat }}" size="sm"
                                      variant="{{ s.etat == 'Actif' ? 'success-pastel' : 'neutral' }}" /></span>
                        </div>
                        <twig:Typography variant="body-sm"><span class="font-[700]">Porte sur :</span> {{ s.porte }}</twig:Typography>
                        <twig:Typography variant="body-sm" textColor="neutral-500">{{ s.apport }}</twig:Typography>
                        <div class="flex flex-col gap-0.5 pt-1">
                            <twig:Typography variant="body-xs" textColor="neutral-500"><span class="font-[700]">Déclenchement :</span> {{ s.declenchement }}</twig:Typography>
                            <twig:Typography variant="body-xs" textColor="neutral-500"><span class="font-[700]">Couverture :</span> {{ s.couverture }}</twig:Typography>
                            <twig:Typography variant="body-xs" textColor="neutral-500"><span class="font-[700]">Prérequis :</span> {{ s.prerequis }}</twig:Typography>
                            <twig:Typography variant="body-xs" textColor="neutral-500"><span class="font-[700]">Contraintes :</span> {{ s.contrainte }}</twig:Typography>
                            <twig:Typography variant="body-xs" textColor="neutral-400"><span class="font-[700]">Licence :</span> {{ s.licence }}</twig:Typography>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </twig:Modal>

        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="Suggestions IA à arbitrer">
            <twig:Typography variant="heading-3" element="h2" bold>Valeurs suggérées par l'IA en attente</twig:Typography>
            <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
                <table class="w-full border-collapse">
                    <thead class="bg-primary-5"><tr class="text-left h-10 border-b border-neutral-200">
                        {% for col in ['Fiche', 'Champ', 'Valeur lue', 'Confiance', 'Quand', ''] %}<th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ col }}</twig:Typography></th>{% endfor %}
                    </tr></thead>
                    <tbody>
                    {% for suggestion in suggestions %}
                        <tr class="h-11 border-t border-neutral-200 first:border-t-0">
                            <td class="px-3"><twig:Typography variant="body-sm" bold>{{ suggestion.label ?? 'Sans libellé' }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500">{{ suggestion.field }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ suggestion.valeur ?? '—' }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ suggestion.confiance is null ? '—' : (suggestion.confiance * 100)|round ~ ' %' }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ suggestion.quand|date('d/m/Y H:i') }}</twig:Typography></td>
                            <td class="px-3"><a href="{{ path('app_ocr_index', {id: suggestion.fiche_id}) }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">Arbitrer</twig:Typography></a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="p-6 text-center"><twig:Typography variant="body-sm" textColor="neutral-500">Aucune suggestion en attente.</twig:Typography></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        {# ---- Suggestions à arbitrer : 5 onglets, bascule client (sans reload). ---- #}
        {% form_theme sug_form 'pim/form/_form-theme-referentiel.html.twig' %}
        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)"
                 aria-label="Suggestions à arbitrer" data-controller="suggestions">
            <div class="flex items-start justify-between gap-3">
                <twig:Typography variant="heading-3" element="h2" bold>Suggestions à arbitrer</twig:Typography>
                <twig:Modal:TriggerButton variant="outline" size="sm" icon="info-circle" class="shrink-0"
                                          modalIdentifier="sources-enrichissement">En savoir plus sur les suggestions</twig:Modal:TriggerButton>
            </div>
            <twig:Typography variant="body-sm" textColor="neutral-500">Corrections et enrichissements proposés automatiquement, par source. Cochez les lignes puis appliquez ou ignorez la sélection ; la fiche reste modifiable via « Ouvrir ».</twig:Typography>

            {{ form_start(sug_form, { action: path('app_mdm_qualite_suggestions', {decision: 'accepter', src: sug_actif}), attr: { class: 'flex flex-col gap-3' } }) }}
                {% set cases = sug_form.ids.children %}

                {# Onglets à gauche (bascule client, sans reload), actions à droite sur la même ligne.
                   Les boutons Accepter/Ignorer sont partagés : leur formaction suit l'onglet actif (contrôleur). #}
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <nav class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Source des suggestions">
                        {% for o in sug_onglets %}
                            {# Deux variantes du composant Button (outline / primary) : la bascule client montre l'une, cache l'autre — design identique aux autres boutons. #}
                            <span data-suggestions-target="tab" data-suggestions-cle-param="{{ o.cle }}" class="contents"
                                  data-accepter="{{ path('app_mdm_qualite_suggestions', {decision: 'accepter', src: o.cle, page: o.page}) }}"
                                  data-ignorer="{{ path('app_mdm_qualite_suggestions', {decision: 'ignorer', src: o.cle, page: o.page}) }}">
                                {# aria-selected est porté statiquement par chaque variante : la
                                   variante masquée (display:none) sort de l'arbre d'accessibilité. #}
                                <twig:Button variant="outline" size="sm" type="button" data-role="tab-outline"
                                             role="tab" aria-selected="false"
                                             data-action="suggestions#activer" data-suggestions-cle-param="{{ o.cle }}"
                                             class="{{ o.cle == sug_actif ? 'hidden' : '' }}">{{ o.label }} ({{ o.compte }})</twig:Button>
                                <twig:Button variant="primary" size="sm" type="button" data-role="tab-primary"
                                             role="tab" aria-selected="true"
                                             data-action="suggestions#activer" data-suggestions-cle-param="{{ o.cle }}"
                                             class="{{ o.cle == sug_actif ? '' : 'hidden' }}">{{ o.label }} ({{ o.compte }})</twig:Button>
                            </span>
                        {% endfor %}
                    </nav>
                    {% if is_granted('ROLE_BP_VALIDATOR') %}
                        <div class="flex items-center gap-2 shrink-0">
                            <twig:Button variant="primary" size="sm" icon="check-circle" type="submit"
                                         data-suggestions-target="accepter"
                                         formaction="{{ path('app_mdm_qualite_suggestions', {decision: 'accepter', src: sug_actif}) }}">Accepter la sélection</twig:Button>
                            <twig:Button variant="outline" size="sm" type="submit"
                                         data-suggestions-target="ignorer"
                                         formaction="{{ path('app_mdm_qualite_suggestions', {decision: 'ignorer', src: sug_actif}) }}">Ignorer la sélection</twig:Button>
                        </div>
                    {% endif %}
                </div>

                {% for o in sug_onglets %}
                    <div data-suggestions-target="panel" data-cle="{{ o.cle }}" class="flex flex-col gap-3 {{ o.cle == sug_actif ? '' : 'hidden' }}">
                        <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
                            <table class="w-full border-collapse">
                                <thead class="bg-primary-5"><tr class="text-left h-10 border-b border-neutral-200">
                                    <th class="pl-4 pr-3 w-0">
                                        {% if is_granted('ROLE_BP_VALIDATOR') %}
                                            <button type="button" role="checkbox" aria-checked="false" class="group/tete block cursor-pointer"
                                                    data-role="caseTete" data-action="suggestions#basculerTout">
                                                <span class="sr-only">Tout sélectionner</span>
                                                <span class="w-[18px] h-[18px] box-border flex items-center justify-center rounded-xs bg-neutral-100 inset-ring-1 inset-ring-neutral-400
                                                             group-aria-checked/tete:bg-primary group-aria-checked/tete:inset-ring-0 group-aria-[checked=mixed]/tete:bg-primary group-aria-[checked=mixed]/tete:inset-ring-0">
                                                    <twig:Icon name="check" class="w-[13px] h-[13px] text-neutral-100 hidden group-aria-checked/tete:block" />
                                                    <span class="w-[9px] h-0.5 rounded-[1px] bg-neutral-100 hidden group-aria-[checked=mixed]/tete:block"></span>
                                                </span>
                                            </button>
                                        {% endif %}
                                    </th>
                                    {% set p_fiche = {onglet: 'conflits', src: o.cle, tri: 'code', ordre: (o.tri == 'code' and o.ordre == 'asc') ? 'desc' : 'asc'} %}
                                    {% set p_conf = {onglet: 'conflits', src: o.cle, tri: 'score', ordre: (o.tri == 'score' and o.ordre == 'asc') ? 'desc' : 'asc'} %}
                                    <th class="px-3">
                                        <a href="{{ path('app_mdm_qualite', p_fiche) }}" class="inline-flex items-center gap-1 group/tri" data-action="suggestions#naviguer">
                                            <twig:Typography variant="body-xs" textColor="{{ o.tri == 'code' ? 'primary-3' : 'neutral-500' }}" bold>Fiche</twig:Typography>
                                            {% if o.tri == 'code' %}<twig:Icon name="caret-down-solid" class="w-2 h-2 text-primary-3 {{ o.ordre == 'asc' ? 'rotate-180' : '' }}" />{% endif %}
                                        </a>
                                    </th>
                                    {% for col in ['Objet', 'Actuel', 'Proposition'] %}<th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ col }}</twig:Typography></th>{% endfor %}
                                    <th class="px-3">
                                        <a href="{{ path('app_mdm_qualite', p_conf) }}" class="inline-flex items-center gap-1 group/tri" data-action="suggestions#naviguer">
                                            <twig:Typography variant="body-xs" textColor="{{ o.tri == 'score' ? 'primary-3' : 'neutral-500' }}" bold>Confiance</twig:Typography>
                                            {% if o.tri == 'score' %}<twig:Icon name="caret-down-solid" class="w-2 h-2 text-primary-3 {{ o.ordre == 'asc' ? 'rotate-180' : '' }}" />{% endif %}
                                        </a>
                                    </th>
                                    <th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>Le</twig:Typography></th>
                                    <th class="px-3"></th>
                                </tr></thead>
                                <tbody>
                                {% for ligne in o.lignes %}
                                    <tr class="h-11 border-t border-neutral-200 first:border-t-0 align-middle">
                                        <td class="pl-4 pr-3 w-0">
                                            {% if is_granted('ROLE_BP_VALIDATOR') and ligne.case_index is not null and cases[ligne.case_index] is defined %}
                                                <label class="inline-flex cursor-pointer">
                                                    {{ form_widget(cases[ligne.case_index], { label: false, attr: { 'data-role': 'case', 'data-action': 'change->suggestions#surCase' } }) }}
                                                </label>
                                            {% endif %}
                                        </td>
                                        <td class="px-3">
                                            <div class="flex flex-col leading-tight">
                                                <span>
                                                    <twig:Typography variant="body-sm" bold element="span">{{ ligne.label ?? 'Sans libellé' }}</twig:Typography>
                                                    <twig:Typography variant="body-xs" textColor="neutral-500" element="span">({{ ligne.code }})</twig:Typography>
                                                </span>
                                                <twig:Typography variant="body-xs" textColor="neutral-400">{{ o.cle == 'adresses' ? ligne.source : o.provenance }}</twig:Typography>
                                            </div>
                                        </td>
                                        <td class="px-3"><twig:Typography variant="body-sm">{{ ligne.objet }}</twig:Typography></td>
                                        <td class="px-3"><twig:Typography variant="body-sm" textColor="neutral-500">{{ ligne.actuel != '' ? ligne.actuel : '—' }}</twig:Typography></td>
                                        <td class="px-3"><twig:Typography variant="body-sm">{{ ligne.proposition }}</twig:Typography></td>
                                        <td class="px-3"><twig:Typography variant="body-sm" textColor="neutral-400">{{ ligne.score is null ? '—' : ligne.score ~ ' %' }}</twig:Typography></td>
                                        <td class="px-3"><twig:Typography variant="body-sm" textColor="neutral-500">{{ ligne.quand ? ligne.quand|date('d/m/Y') : '—' }}</twig:Typography></td>
                                        <td class="px-3">
                                            {% if ligne.type == 'lieu' %}
                                                <a href="{{ path('app_mdm_fiche_lieu', {id: ligne.fiche_id, section: 1}) }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">Ouvrir</twig:Typography></a>
                                            {% else %}
                                                <a href="{{ path('app_mdm_fiche_gamme', {gamme: ligne.type == 'restaurant' ? 'restaurants' : (ligne.type == 'activite' ? 'activites' : 'services'), id: ligne.fiche_id, section: 1}) }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">Ouvrir</twig:Typography></a>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="8" class="p-6 text-center"><twig:Typography variant="body-sm" textColor="neutral-500">Aucune suggestion en attente pour cette source.</twig:Typography></td></tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% if o.pages > 1 %}
                            <div class="flex items-center justify-between gap-3">
                                <twig:Typography variant="body-xs" textColor="neutral-500">Page {{ o.page }} / {{ o.pages }} · {{ o.total }} résultat(s)</twig:Typography>
                                <div class="flex items-center gap-2">
                                    {% if o.page > 1 %}<twig:Button variant="outline" size="sm" asLink data-action="suggestions#naviguer" href="{{ path('app_mdm_qualite', {onglet: 'conflits', src: o.cle, tri: o.tri, ordre: o.ordre, page: o.page - 1}) }}">Précédente</twig:Button>{% endif %}
                                    {% if o.page < o.pages %}<twig:Button variant="outline" size="sm" asLink data-action="suggestions#naviguer" href="{{ path('app_mdm_qualite', {onglet: 'conflits', src: o.cle, tri: o.tri, ordre: o.ordre, page: o.page + 1}) }}">Suivante</twig:Button>{% endif %}
                                </div>
                            </div>
                        {% endif %}
                        {% if o.cle == 'adresses' %}<twig:Typography variant="body-xs" textColor="neutral-500">Adresses étrangères vérifiées par Geoapify — données © OpenStreetMap contributors.</twig:Typography>{% endif %}
                    </div>
                {% endfor %}
            {{ form_end(sug_form) }}

            {# Avertissement avant de quitter un onglet avec des cases cochées. #}
            <div data-suggestions-target="avert" class="hidden fixed top-0 left-0 w-screen h-screen z-256 bg-background-transparency flex items-center justify-center">
                <div class="bg-neutral-100 p-8 rounded-md w-[min(440px,90vw)] flex flex-col gap-4 shadow-(--shadow)">
                    <twig:Typography variant="heading-3" element="h2" bold>Sélection non enregistrée</twig:Typography>
                    <twig:Typography variant="body-sm" textColor="neutral-500">Vous avez coché des lignes sans les enregistrer. En changeant d'onglet, la sélection sera décochée.</twig:Typography>
                    <div class="flex justify-end gap-2">
                        <twig:Button variant="outline" size="sm" type="button" data-action="suggestions#annuler">Annuler</twig:Button>
                        <twig:Button variant="primary" size="sm" type="button" data-action="suggestions#continuer">Continuer</twig:Button>
                    </div>
                </div>
            </div>
        </section>

        <section class="shrink-0 flex flex-col gap-2 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="Doublons d'adresse">
            <twig:Typography variant="heading-3" element="h2" bold>Fiches partageant la même adresse</twig:Typography>
            {% for groupe in doublons_adresse %}
                <div class="flex flex-wrap items-center gap-2">
                    <twig:Typography variant="body-sm" bold element="span">{{ groupe.ville ?? 'Ville inconnue' }} :</twig:Typography>
                    {% for fiche in groupe.fiches %}
                        <a href="{{ path('app_mdm_edition_rapide', {id: fiche.id}) }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" element="span">{{ fiche.label ?? 'Sans libellé' }}</twig:Typography></a>{{ not loop.last ? '·' : '' }}
                    {% endfor %}
                </div>
            {% else %}
                <twig:Typography variant="body-sm" textColor="neutral-500">Aucune adresse partagée par plusieurs fiches.</twig:Typography>
            {% endfor %}
        </section>
    {% elseif onglet_actif == 'doublons_textes' %}
        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="Doublons de textes">
            <twig:Typography variant="heading-3" element="h2" bold>Champs de texte en doublon</twig:Typography>
            <twig:Typography variant="body-sm" textColor="neutral-500">Descriptions identiques (copier-coller) ou proches d'une fiche à l'autre. Confirmer acte un doublon légitime, Ignorer écarte un faux positif ; les deux le sortent de la file.</twig:Typography>
            <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
                <table class="w-full border-collapse">
                    <thead class="bg-primary-5"><tr class="text-left h-10 border-b border-neutral-200">
                        {% for col in ['Champ', 'Fiche signalée', 'Fiche de référence', 'Similarité'] %}<th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ col }}</twig:Typography></th>{% endfor %}
                        {% if is_granted('ROLE_BP_VALIDATOR') %}<th class="px-3"></th><th class="px-3"></th>{% endif %}
                    </tr></thead>
                    <tbody>
                    {% for ligne in doublons_textes %}
                        <tr class="border-t border-neutral-200 first:border-t-0 align-top [&_form]:contents">
                            <td class="px-3 py-2.5"><twig:Typography variant="body-sm" bold>{{ ligne.field_label }}</twig:Typography></td>
                            {% for cote in [ligne.signalee, ligne.reference] %}
                                <td class="px-3 py-2.5 max-w-[320px]">
                                    <a href="{{ cote.type == 'lieu'
                                        ? path('app_mdm_fiche_lieu', {id: cote.fiche_id, section: 1})
                                        : path('app_mdm_fiche_gamme', {gamme: cote.type == 'restaurant' ? 'restaurants' : (cote.type == 'activite' ? 'activites' : 'services'), id: cote.fiche_id, section: 1}) }}" class="hover:underline">
                                        <twig:Typography variant="body-sm" textColor="primary-3" bold element="span">{{ cote.label ?? 'Sans libellé' }}</twig:Typography>
                                    </a>
                                    {% if cote.snippet %}<twig:Typography variant="body-xs" textColor="neutral-500" class="text-pretty">{{ cote.snippet }}</twig:Typography>{% endif %}
                                </td>
                            {% endfor %}
                            <td class="px-3 py-2.5 whitespace-nowrap">
                                <twig:Tag label="{{ ligne.kind == 'exact' ? 'Identique' : 'Proche' }}" size="sm" variant="{{ ligne.kind == 'exact' ? 'error' : 'neutral' }}" />
                                {% if ligne.kind == 'near' and ligne.distance is not null %}<twig:Typography variant="body-xs" textColor="neutral-500" element="span"> · distance {{ ligne.distance }}</twig:Typography>{% endif %}
                            </td>
                            {% if is_granted('ROLE_BP_VALIDATOR') %}
                                <td class="px-3 py-2.5">{{ form(ligne.confirmer) }}</td>
                                <td class="px-3 py-2.5">{{ form(ligne.ignorer) }}</td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ is_granted('ROLE_BP_VALIDATOR') ? 6 : 4 }}" class="p-6 text-center"><twig:Typography variant="body-sm" textColor="neutral-500">Aucun doublon de texte en attente d'arbitrage.</twig:Typography></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% elseif onglet_actif == 'formes' %}
        <div class="dam-stats shrink-0 flex flex-row gap-4 flex-wrap" aria-label="Écarts de forme">
            {% for carte in [
                { libelle: 'Localisations sans code pays', valeur: formes.sans_pays, icone: 'pin', texte: 'Le pays manque : la fiche ne sort dans aucun filtre géographique.', filtre: 'sans_pays' },
                { libelle: 'Localisations sans GPS', valeur: formes.sans_gps, icone: 'area', texte: 'Sans coordonnées, pas de carte ni de recherche par proximité.', filtre: 'sans_gps' },
                { libelle: 'Fiches sans libellé', valeur: formes.sans_libelle, icone: 'warning', texte: 'Une fiche sans nom est invisible partout — à compléter en priorité.', filtre: 'sans_libelle' },
            ] %}
                <a class="dam-stat flex flex-col box-border gap-3 px-[26px] py-6 rounded-md bg-neutral-100 shadow-(--shadow) flex-1 basis-72 min-w-0 hover:bg-primary-5"
                   href="{{ path('app_mdm_referentiel_general', {f: {formes: [carte.filtre]}}) }}">
                    <div class="flex items-center gap-3">
                        <twig:Icon name="{{ carte.icone }}" aria-hidden="true"
                                   class="shrink-0 w-6 h-6 {{ carte.valeur > 0 ? 'text-error' : 'text-primary' }}" />
                        <twig:Typography variant="subtitle" ellipsis
                                         class="flex-1 min-w-0 text-[1.125rem]! leading-[1.625rem]! font-[700]!">{{ carte.libelle }}</twig:Typography>
                        <span class="inline-flex shrink-0"><twig:Tag label="{{ carte.valeur }}" size="sm"
                                  variant="{{ carte.valeur > 0 ? 'error' : 'success-pastel' }}" class="whitespace-nowrap" /></span>
                    </div>
                    <twig:Typography variant="body" textColor="neutral-500" class="text-pretty">{{ carte.texte }}</twig:Typography>
                </a>
            {% endfor %}
        </div>
        {# Normalisations automatiques de la maquette : pas de back → grisées. #}
        <div title="Fonction à venir — en développement"
             class="shrink-0 flex items-center gap-3 px-[26px] py-5 rounded-md bg-neutral-100 shadow-(--shadow) opacity-60">
            <twig:Icon name="list" aria-hidden="true" class="shrink-0 w-6 h-6 text-neutral-400" />
            <div class="flex flex-col gap-0.5 flex-1 min-w-0">
                <twig:Typography variant="subtitle" class="text-[1.125rem]! leading-[1.625rem]! font-[700]!">Normalisations automatiques</twig:Typography>
                <twig:Typography variant="body" textColor="neutral-500">Casse, formats et unités appliqués en masse — la liste des règles est à définir avec le métier.</twig:Typography>
            </div>
            <twig:Tag label="À venir" variant="neutral" size="sm" class="shrink-0" />
        </div>
    {% elseif onglet_actif == 'notifs' %}
        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="Relances de complétude">
            <twig:Typography variant="heading-3" element="h2" bold>Relances de complétude envoyées</twig:Typography>
            <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
                <table class="w-full border-collapse">
                    <thead class="bg-primary-5"><tr class="text-left h-10 border-b border-neutral-200">
                        {% for col in ['Fiche', 'Complétude à l\'envoi', 'Destinataires', 'Quand'] %}<th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ col }}</twig:Typography></th>{% endfor %}
                    </tr></thead>
                    <tbody>
                    {% for relance in relances %}
                        <tr class="h-11 border-t border-neutral-200 first:border-t-0">
                            <td class="px-3"><twig:Typography variant="body-sm" bold>{{ relance.label ?? 'Sans libellé' }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ relance.completude }} %</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ relance.destinataires }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ relance.quand|date('d/m/Y H:i') }}</twig:Typography></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="p-6 text-center"><twig:Typography variant="body-sm" textColor="neutral-500">Aucune relance envoyée.</twig:Typography></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% elseif onglet_actif == 'decisions' %}
        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="Décisions d'arbitrage">
            <twig:Typography variant="heading-3" element="h2" bold>Derniers arbitrages</twig:Typography>
            <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
                <table class="w-full border-collapse">
                    <thead class="bg-primary-5"><tr class="text-left h-10 border-b border-neutral-200">
                        {% for col in ['Quand', 'Fiche', 'Décision', 'Détail', 'Par'] %}<th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ col }}</twig:Typography></th>{% endfor %}
                    </tr></thead>
                    <tbody>
                    {% for decision in decisions %}
                        <tr class="h-11 border-t border-neutral-200 first:border-t-0">
                            <td class="px-3"><twig:Typography variant="body-sm">{{ decision.quand|date('d/m/Y H:i') }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm" bold>{{ decision.label ?? 'Sans libellé' }}</twig:Typography></td>
                            <td class="px-3"><twig:Tag label="{{ decision.genre }}" variant="neutral" size="sm" /></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ decision.detail }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ decision.acteur }}</twig:Typography></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="p-6 text-center"><twig:Typography variant="body-sm" textColor="neutral-500">Aucun arbitrage enregistré.</twig:Typography></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
    </div>
</main>
{% endblock %}
