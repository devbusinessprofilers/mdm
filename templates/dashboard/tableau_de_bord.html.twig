{% extends 'mdm/base.html.twig' %}

{# Tableau de bord MDM — page d'accueil. Gabarit sobre : les files et
   l'activité par période sont comptées en direct ; la santé, le croisement
   pays × typologies, les champs faibles et le stockage viennent du snapshot
   (workflow ComputeDashboardStats, recalcul toutes les 15 minutes ou via
   « Recalculer maintenant » sur les statistiques détaillées). #}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<main class="page">
    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-kicker">MDM</p>
            <h1>Tableau de bord</h1>
            {% if app.user %}<p class="page-description">Bonjour {{ app.user.userIdentifier }}.</p>{% endif %}
            <p class="page-description">
                Les files de travail sont comptées en direct ;
                {% if snapshot %}les indicateurs datent du <time datetime="{{ computedAt|date('c') }}">{{ computedAt|date('d/m/Y H:i') }}</time>.{% else %}aucune statistique n'a encore été calculée.{% endif %}
            </p>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <div class="table-actions">
                <a class="btn btn-secondary btn-small" href="{{ path('app_dashboard_index') }}">Statistiques détaillées</a>
                <a class="btn btn-secondary btn-small" href="{{ path('app_dam_dashboard') }}">Médias (DAM)</a>
            </div>
        {% endif %}
    </header>

    <section class="card" aria-label="À traiter">
        <h2>À traiter</h2>
        <div class="table-shell"><div class="table-scroll"><table class="data-table">
            <thead><tr><th>File</th><th>Détail</th><th>Volume</th><th>Sévérité</th><th></th></tr></thead>
            <tbody>
            {% for file in files %}
                <tr>
                    <td>{{ file.libelle }}</td>
                    <td>{{ file.detail }}</td>
                    <td><strong>{{ file.volume }}</strong></td>
                    <td><span class="badge {{ file.severite == 'critique' ? 'badge-danger' : (file.severite == 'attention' ? 'badge-warning' : 'badge-success') }}">{{ file.severite }}</span></td>
                    <td>{% if is_granted('ROLE_ADMIN') %}<a class="text-link" href="{{ file.url }}">Traiter</a>{% endif %}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table></div></div>
    </section>

    {% if snapshot %}
        <section class="dam-stats" aria-label="Santé du référentiel">
            <div class="card dam-stat"><span>Total de fiches</span><strong>{{ fiches.total }}</strong></div>
            <div class="card dam-stat"><span>Fiches publiées</span><strong>{{ fiches.published }} ({{ fiches.publishedPct }} %)</strong></div>
            <div class="card dam-stat"><span>Complétude moyenne</span><strong>{{ completeness.avgGlobal is null ? '—' : completeness.avgGlobal ~ ' %' }}</strong></div>
            <div class="card dam-stat">
                <span>Temps moyen de validation</span>
                <strong>{{ validation.label ?? '—' }}</strong>
            </div>
            <div class="card dam-stat"><span>Mises à jour cette semaine</span><strong>{{ thisWeek.updates }}</strong></div>
            <div class="card dam-stat"><span>Nouvelles fiches cette semaine</span><strong>{{ thisWeek.created }}</strong></div>
        </section>

        <section class="card" aria-label="Croisement pays et typologies">
            <div class="section-heading">
                <h2>Pays × typologies</h2>
                <nav class="table-actions" aria-label="Mesure du croisement">
                    <a class="btn btn-small {{ croisement == 'completude' ? '' : 'btn-secondary' }}"
                       href="{{ path('app_mdm_tableau_de_bord', {croisement: 'completude', periode: activite.periode}) }}">Complétude</a>
                    <a class="btn btn-small {{ croisement == 'publiees' ? '' : 'btn-secondary' }}"
                       href="{{ path('app_mdm_tableau_de_bord', {croisement: 'publiees', periode: activite.periode}) }}">Fiches publiées</a>
                </nav>
            </div>
            {% if countryRows is empty %}
                <p class="empty-state">Le référentiel est vide.</p>
            {% elseif countryRows[0].completeness is not defined %}
                <p class="empty-state">
                    Le croisement apparaîtra au prochain calcul des statistiques
                    (« Recalculer maintenant » sur les statistiques détaillées, ou au prochain passage automatique).
                </p>
            {% else %}
                <div class="table-shell"><div class="table-scroll"><table class="data-table">
                    <thead><tr>
                        <th>Pays</th>
                        {% for typeValue, label in typeLabels %}<th>{{ label }}</th>{% endfor %}
                        <th>Total</th>
                    </tr></thead>
                    <tbody>
                    {% for row in countryRows|slice(0, 6) %}
                        <tr>
                            <td>{{ row.pays }}</td>
                            {% for typeValue, label in typeLabels %}
                                <td>
                                    {% if croisement == 'completude' %}
                                        {% set comp = row.completeness[typeValue] ?? null %}
                                        {{ comp is null ? '—' : comp ~ ' %' }}
                                    {% else %}
                                        {{ row.published[typeValue] ?? 0 }}
                                    {% endif %}
                                </td>
                            {% endfor %}
                            <td><strong>{{ row.total }}</strong></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table></div></div>
            {% endif %}
        </section>

        {% if fieldFill %}
            <section class="card" aria-label="Champs faibles">
                <h2>Champs les moins renseignés</h2>
                {% for typeValue, data in fieldFill.perType %}
                    {% if data.worstFields is not empty %}
                        <h3>{{ typeLabels[typeValue] ?? typeValue }}</h3>
                        <ul>
                            {% for field in data.worstFields|slice(0, 5) %}
                                <li>{{ field.label }} — {{ field.rate }} % ({{ field.filled }}/{{ field.applicable }})</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endfor %}
            </section>
        {% endif %}

        {% if storage %}
            <section class="dam-stats" aria-label="Médias et stockage">
                <div class="card dam-stat"><span>Stockage total</span><strong>{{ storage.total }}</strong></div>
                <div class="card dam-stat"><span>Images</span><strong>{{ storage.images }}</strong></div>
                <div class="card dam-stat"><span>Documents</span><strong>{{ storage.documents }}</strong></div>
                <div class="card dam-stat"><span>Variantes générées</span><strong>{{ storage.renditions }}</strong></div>
            </section>
        {% endif %}
    {% else %}
        <div class="card empty-state">
            Les indicateurs apparaîtront après le premier calcul des statistiques
            (« Recalculer maintenant » sur les statistiques détaillées).
        </div>
    {% endif %}

    <section class="card" aria-label="Activité des équipes">
        <div class="section-heading">
            <h2>Activité des équipes</h2>
            <nav class="table-actions" aria-label="Période d'analyse">
                {% for cle, definition in periodes %}
                    <a class="btn btn-small {{ activite.periode == cle ? '' : 'btn-secondary' }}"
                       href="{{ path('app_mdm_tableau_de_bord', {periode: cle, croisement: croisement}) }}"
                       {% if activite.periode == cle %}aria-current="true"{% endif %}>{{ definition.libelle }}</a>
                {% endfor %}
            </nav>
        </div>
        <p class="page-description">
            Sur {{ activite.libelle|lower }} : {{ activite.creees }} fiche{{ activite.creees == 1 ? '' : 's' }} créée{{ activite.creees == 1 ? '' : 's' }},
            {{ activite.modifiees }} modification{{ activite.modifiees == 1 ? '' : 's' }}.
        </p>
        <div class="table-shell"><div class="table-scroll"><table class="data-table">
            <thead><tr><th>Contributeur</th><th>Créées</th><th>Modifiées</th><th>Validées</th><th>Publiées</th></tr></thead>
            <tbody>
            {% for row in activite.parActeur %}
                <tr><td>{{ row.actor }}</td><td>{{ row.creees }}</td><td>{{ row.modifiees }}</td><td>{{ row.validees }}</td><td>{{ row.publiees }}</td></tr>
            {% else %}
                <tr><td class="empty-state" colspan="5">Aucune activité sur la période.</td></tr>
            {% endfor %}
            </tbody>
        </table></div></div>

        <h3>Dernières publications</h3>
        <ul>
            {% for publication in publications %}
                <li>
                    {% if publication.url %}
                        <a class="text-link" href="{{ publication.url }}">{{ publication.fiche.label ?? 'Sans libellé' }}</a>
                    {% else %}
                        {{ publication.fiche.label ?? 'Sans libellé' }}
                    {% endif %}
                    <small>
                        {{ publication.fiche.type.value }}
                        · publiée le <time datetime="{{ publication.fiche.publishedAt|date('c') }}">{{ publication.fiche.publishedAt|date('d/m/Y H:i') }}</time>
                    </small>
                </li>
            {% else %}
                <li class="empty-state">Aucune fiche publiée pour l'instant.</li>
            {% endfor %}
        </ul>
    </section>
</main>
{% endblock %}
