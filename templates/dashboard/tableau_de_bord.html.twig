{% extends 'mdm/base.html.twig' %}

{# Tableau de bord MDM — page d'accueil, habillée au langage front. Files et
   activité comptées en direct ; santé, croisement pays × typologies, champs
   faibles et stockage viennent du snapshot. #}

{% block title %}Tableau de bord{% endblock %}

{% macro carte_indic(libelle, valeur) %}
    <div class="flex flex-col gap-1 p-4 rounded-[16px] bg-neutral-100 shadow-(--shadow)">
        <twig:Typography variant="body-xs" textColor="neutral-500" bold class="uppercase tracking-[0.4px]">{{ libelle }}</twig:Typography>
        <twig:Typography variant="heading-3" bold>{{ valeur }}</twig:Typography>
    </div>
{% endmacro %}

{% block contenu %}
<main class="flex flex-col h-full min-h-0 overflow-y-auto scrollbar px-6 py-5 gap-5">

    <div class="shrink-0 flex items-start justify-between gap-4">
        <div class="flex flex-col gap-1">
            <twig:Typography variant="body-xs" textColor="neutral-500" bold class="uppercase tracking-[0.8px]">MDM</twig:Typography>
            <twig:Typography variant="heading-2" element="h1" bold>Tableau de bord</twig:Typography>
            <twig:Typography variant="body-sm" textColor="neutral-500">
                {% if app.user %}Bonjour {{ app.user.userIdentifier }}. {% endif %}
                Files comptées en direct ;
                {% if snapshot %}indicateurs du {{ computedAt|date('d/m/Y H:i') }}.{% else %}aucune statistique calculée pour l'instant.{% endif %}
            </twig:Typography>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <div class="flex flex-wrap items-center gap-2 shrink-0">
                <twig:Button variant="outline" size="sm" asLink href="{{ path('app_dashboard_index') }}">Statistiques détaillées</twig:Button>
                <twig:Button variant="outline" size="sm" asLink href="{{ path('app_dam_dashboard') }}">Médias (DAM)</twig:Button>
            </div>
        {% endif %}
    </div>

    {# À traiter #}
    <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="À traiter">
        <twig:Typography variant="heading-3" element="h2" bold>À traiter</twig:Typography>
        <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
            <table class="w-full border-collapse">
                <thead class="bg-primary-5">
                    <tr class="text-left h-10 border-b border-neutral-200">
                        {% for col in ['File', 'Détail', 'Volume', 'Sévérité', ''] %}
                            <th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ col }}</twig:Typography></th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                {% for file in files %}
                    <tr class="h-12 border-t border-neutral-200 first:border-t-0">
                        <td class="px-3"><twig:Typography variant="body-sm" bold>{{ file.libelle }}</twig:Typography></td>
                        <td class="px-3"><twig:Typography variant="body-sm" textColor="neutral-500">{{ file.detail }}</twig:Typography></td>
                        <td class="px-3"><twig:Typography variant="body" bold>{{ file.volume }}</twig:Typography></td>
                        <td class="px-3"><twig:Tag label="{{ file.severite }}" variant="{{ file.severite == 'critique' ? 'error' : (file.severite == 'attention' ? 'old-gold' : 'success') }}" size="sm" /></td>
                        <td class="px-3">{% if is_granted('ROLE_ADMIN') %}<a href="{{ file.url }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">Traiter</twig:Typography></a>{% endif %}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {% if snapshot %}
        <section class="shrink-0 grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3" aria-label="Santé du référentiel">
            {{ _self.carte_indic('Total de fiches', fiches.total) }}
            {{ _self.carte_indic('Fiches publiées', fiches.published ~ ' (' ~ fiches.publishedPct ~ ' %)') }}
            {{ _self.carte_indic('Complétude moyenne', completeness.avgGlobal is null ? '—' : completeness.avgGlobal ~ ' %') }}
            {{ _self.carte_indic('Temps moyen de validation', validation.label ?? '—') }}
            {{ _self.carte_indic('Mises à jour cette semaine', thisWeek.updates) }}
            {{ _self.carte_indic('Nouvelles fiches cette semaine', thisWeek.created) }}
        </section>

        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="Croisement pays et typologies">
            <div class="flex items-center justify-between gap-3">
                <twig:Typography variant="heading-3" element="h2" bold>Pays × typologies</twig:Typography>
                <nav class="flex items-center gap-2" aria-label="Mesure du croisement">
                    <twig:Button variant="{{ croisement == 'completude' ? 'primary' : 'outline' }}" size="sm" asLink
                                 href="{{ path('app_mdm_tableau_de_bord', {croisement: 'completude', periode: activite.periode}) }}">Complétude</twig:Button>
                    <twig:Button variant="{{ croisement == 'publiees' ? 'primary' : 'outline' }}" size="sm" asLink
                                 href="{{ path('app_mdm_tableau_de_bord', {croisement: 'publiees', periode: activite.periode}) }}">Fiches publiées</twig:Button>
                </nav>
            </div>
            {% if countryRows is empty %}
                <twig:Typography variant="body-sm" textColor="neutral-500">Le référentiel est vide.</twig:Typography>
            {% elseif countryRows[0].completeness is not defined %}
                <twig:Typography variant="body-sm" textColor="neutral-500">
                    Le croisement apparaîtra au prochain calcul des statistiques.
                </twig:Typography>
            {% else %}
                <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
                    <table class="w-full border-collapse">
                        <thead class="bg-primary-5">
                            <tr class="text-left h-10 border-b border-neutral-200">
                                <th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>Pays</twig:Typography></th>
                                {% for typeValue, label in typeLabels %}<th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ label }}</twig:Typography></th>{% endfor %}
                                <th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>Total</twig:Typography></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for row in countryRows|slice(0, 6) %}
                            <tr class="h-11 border-t border-neutral-200 first:border-t-0">
                                <td class="px-3"><twig:Typography variant="body-sm">{{ row.pays }}</twig:Typography></td>
                                {% for typeValue, label in typeLabels %}
                                    <td class="px-3"><twig:Typography variant="body-sm">
                                        {% if croisement == 'completude' %}{% set comp = row.completeness[typeValue] ?? null %}{{ comp is null ? '—' : comp ~ ' %' }}
                                        {% else %}{{ row.published[typeValue] ?? 0 }}{% endif %}
                                    </twig:Typography></td>
                                {% endfor %}
                                <td class="px-3"><twig:Typography variant="body" bold>{{ row.total }}</twig:Typography></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

        {% if fieldFill %}
            <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="Champs faibles">
                <twig:Typography variant="heading-3" element="h2" bold>Champs les moins renseignés</twig:Typography>
                {% for typeValue, data in fieldFill.perType %}
                    {% if data.worstFields is not empty %}
                        <twig:Typography variant="body-sm" bold>{{ typeLabels[typeValue] ?? typeValue }}</twig:Typography>
                        <ul class="flex flex-col gap-1">
                            {% for field in data.worstFields|slice(0, 5) %}
                                <li><twig:Typography variant="body-sm" textColor="neutral-500">{{ field.label }} — {{ field.rate }} % ({{ field.filled }}/{{ field.applicable }})</twig:Typography></li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endfor %}
            </section>
        {% endif %}

        {% if storage %}
            <section class="shrink-0 grid grid-cols-2 xl:grid-cols-4 gap-3" aria-label="Médias et stockage">
                {{ _self.carte_indic('Stockage total', storage.total) }}
                {{ _self.carte_indic('Images', storage.images) }}
                {{ _self.carte_indic('Documents', storage.documents) }}
                {{ _self.carte_indic('Variantes générées', storage.renditions) }}
            </section>
        {% endif %}
    {% else %}
        <div class="shrink-0 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)">
            <twig:Typography variant="body-sm" textColor="neutral-500">Les indicateurs apparaîtront après le premier calcul des statistiques.</twig:Typography>
        </div>
    {% endif %}

    {# Activité des équipes #}
    <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="Activité des équipes">
        <div class="flex items-center justify-between gap-3 flex-wrap">
            <twig:Typography variant="heading-3" element="h2" bold>Activité des équipes</twig:Typography>
            <nav class="flex flex-wrap items-center gap-2" aria-label="Période d'analyse">
                {% for cle, definition in periodes %}
                    <twig:Button variant="{{ activite.periode == cle ? 'primary' : 'outline' }}" size="sm" asLink
                                 href="{{ path('app_mdm_tableau_de_bord', {periode: cle, croisement: croisement}) }}">{{ definition.libelle }}</twig:Button>
                {% endfor %}
            </nav>
        </div>
        <twig:Typography variant="body-sm" textColor="neutral-500">
            Sur {{ activite.libelle|lower }} : {{ activite.creees }} fiche{{ activite.creees == 1 ? '' : 's' }} créée{{ activite.creees == 1 ? '' : 's' }}, {{ activite.modifiees }} modification{{ activite.modifiees == 1 ? '' : 's' }}.
        </twig:Typography>
        <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
            <table class="w-full border-collapse">
                <thead class="bg-primary-5">
                    <tr class="text-left h-10 border-b border-neutral-200">
                        {% for col in ['Contributeur', 'Créées', 'Modifiées', 'Validées', 'Publiées'] %}
                            <th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ col }}</twig:Typography></th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                {% for row in activite.parActeur %}
                    <tr class="h-11 border-t border-neutral-200 first:border-t-0">
                        <td class="px-3"><twig:Typography variant="body-sm">{{ row.actor }}</twig:Typography></td>
                        <td class="px-3"><twig:Typography variant="body-sm">{{ row.creees }}</twig:Typography></td>
                        <td class="px-3"><twig:Typography variant="body-sm">{{ row.modifiees }}</twig:Typography></td>
                        <td class="px-3"><twig:Typography variant="body-sm">{{ row.validees }}</twig:Typography></td>
                        <td class="px-3"><twig:Typography variant="body-sm">{{ row.publiees }}</twig:Typography></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="p-6 text-center"><twig:Typography variant="body-sm" textColor="neutral-500">Aucune activité sur la période.</twig:Typography></td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <twig:Typography variant="heading-3" element="h3" bold>Dernières publications</twig:Typography>
        <ul class="flex flex-col gap-1">
            {% for publication in publications %}
                <li class="flex items-center gap-2 flex-wrap">
                    {% if publication.url %}
                        <a href="{{ publication.url }}" class="hover:underline"><twig:Typography variant="body-sm" textColor="primary-3" bold element="span">{{ publication.fiche.label ?? 'Sans libellé' }}</twig:Typography></a>
                    {% else %}
                        <twig:Typography variant="body-sm">{{ publication.fiche.label ?? 'Sans libellé' }}</twig:Typography>
                    {% endif %}
                    <twig:Typography variant="body-xs" textColor="neutral-500">{{ publication.fiche.type.value }} · publiée le {{ publication.fiche.publishedAt|date('d/m/Y H:i') }}</twig:Typography>
                </li>
            {% else %}
                <li><twig:Typography variant="body-sm" textColor="neutral-500">Aucune fiche publiée pour l'instant.</twig:Typography></li>
            {% endfor %}
        </ul>
    </section>
</main>
{% endblock %}
