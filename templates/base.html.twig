<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}MDM Business Profilers{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.environment == 'dev' ? app.request.server.get('FRANKENPHP_HOT_RELOAD') : null %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}" data-controller="hot-reload">
        {% endif %}
    </head>
    <body>
        {% if app.user %}
            <header class="app-header">
                <nav class="app-nav" aria-label="Navigation principale">
                    <a href="{{ path('app_pim_home') }}" class="brand">MDM Business Profilers</a>
                    {% if is_granted('ROLE_BP_EDITOR') %}
                        <a class="nav-link" href="{{ path('app_pim_admin') }}">Administration</a>
                        <a class="nav-link" href="{{ path('app_pim_lieu_index') }}">Lieux</a>
                        <a class="nav-link" href="{{ path('app_pim_activite_index') }}">Activités</a>
                        <a class="nav-link" href="{{ path('app_pim_restaurant_index') }}">Restaurants</a>
                        <a class="nav-link" href="{{ path('app_pim_service_index') }}">Services</a>
                    {% endif %}
                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                        <a class="nav-link" href="{{ path('app_account_admin_index') }}">Collaborateurs</a>
                        <a class="nav-link" href="{{ path('app_account_user_admin_index') }}">Utilisateurs</a>
                    {% endif %}
                    {% set logout_form_view = logout_form() %}
                    {{ form(logout_form_view) }}
                </nav>
            </header>
        {% endif %}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p role="status" class="flash-{{ type }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </body>
</html>
