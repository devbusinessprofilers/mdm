<!DOCTYPE html>
{# `lang` sert aux lecteurs d'écran et au contrôleur `wysiwyg` (langue de l'éditeur). #}
<html lang="{{ app.request.locale|default('fr') }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}MDM Business Profilers{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.environment == 'dev' ? app.request.server.get('FRANKENPHP_HOT_RELOAD') : null %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}" data-controller="hot-reload">
        {% endif %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        {# Barre de navigation provisoire du back : les écrans repris par le vrai
           front (coquille `mdm/base.html.twig`) neutralisent ce bloc et posent
           leur propre en-tête. #}
        {% block navbar %}
        {% if app.user %}
            <header class="app-header">
                <nav class="app-nav" aria-label="Navigation principale">
                    {% block navigation %}
                    <a href="{{ path('app_pim_home') }}" class="brand">MDM Business Profilers</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="nav-link" href="{{ path('app_dashboard_index') }}">Tableau de bord</a>
                    {% endif %}
                    {% if is_granted('ROLE_BP_EDITOR') %}
                        <a class="nav-link" href="{{ path('app_mdm_referentiel_general') }}">Fiches</a>
                        <a class="nav-link" href="{{ path('app_mdm_lieux') }}">Lieux</a>
                        <a class="nav-link" href="{{ path('app_mdm_referentiel_gamme', {gamme: 'activites'}) }}">Activités</a>
                        <a class="nav-link" href="{{ path('app_mdm_referentiel_gamme', {gamme: 'restaurants'}) }}">Restaurants</a>
                        <a class="nav-link" href="{{ path('app_mdm_referentiel_gamme', {gamme: 'services'}) }}">Services</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="nav-link" href="{{ path('app_pim_admin') }}">Administration</a>
                            <a class="nav-link" href="{{ path('app_dam_dashboard') }}">DAM</a>
                            <a class="nav-link" href="{{ path('app_pim_lov_index') }}">Listes de valeurs</a>
                            <a class="nav-link" href="{{ path('app_etl_import_index') }}">Import de fiches</a>
                        {% endif %}
                        {% set header_search_form_view = global_search_form() %}
                        {{ form(header_search_form_view) }}
                    {% endif %}
                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                        <a class="nav-link" href="{{ path('app_pim_completeness_index') }}">Complétude</a>
                        <a class="nav-link" href="{{ path('app_account_admin_index') }}">Collaborateurs</a>
                        <a class="nav-link" href="{{ path('app_account_user_admin_index') }}">Utilisateurs</a>
                    {% endif %}
                    {% set logout_form_view = logout_form() %}
                    {{ form(logout_form_view) }}
                    {% endblock %}
                </nav>
            </header>
        {% endif %}
        {% endblock %}
        {% block flashes %}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p role="status" class="flash-{{ type }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}
        {% endblock %}
        {% block body %}{% endblock %}
    </body>
</html>
