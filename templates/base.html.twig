<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
<head>
    <meta charset="utf-8">
    <meta name="author" content="Business Profilers" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="{% block meta_description %}{% endblock %}" />
    <meta name="keywords" content="{% block meta_keywords %}{% endblock %}" />
    {% block meta %}{% endblock %}
    <title>Business Profilers - {% block title %}{% endblock %}</title>

    {% block importmap %}{{ importmap() }}{% endblock %}

    <link rel="icon" type="image/png" href="{{ asset('img/favicon.png') }}">

    {% block style %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
</head>
<body class="scrollbar overflow-x-hidden">
    {% block form_themes %}
        {% include 'pim/form/_form-theme.html.twig' %}
    {% endblock %}

    <div class="bg-linear-(--background-gradient) bg-no-repeat grid grid-rows-[auto_1fr_auto] min-h-screen">
        {% include 'pim/layout/_header.html.twig' %}
        <div class="max-w-screen">
            {% block body %}{% endblock %}
        </div>
        {% include 'pim/layout/_footer.html.twig' %}
    </div>

    {% block js %}
        <script src="https://cdn.tiny.cloud/1/{{ tinymce_api_key }}/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
    {% endblock %}
</body>
</html>
