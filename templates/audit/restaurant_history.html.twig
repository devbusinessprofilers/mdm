{% extends 'base.html.twig' %}

{% block title %}Historique de {{ restaurant.label }}{% endblock %}

{% block body %}
<main class="page">
    <a class="back-link" href="{{ path('app_pim_restaurant_show', {id: restaurant.id}) }}">
        ← Retour au restaurant
    </a>

    <header class="page-header">
        <div>
            <p class="page-kicker">Audit append-only</p>
            <h1>Historique de {{ restaurant.label }}</h1>
        </div>
    </header>

    <section class="card">{{ form(filter_form) }}</section>

    {% include 'audit/_revision_table.html.twig' %}

    {% if next_cursor %}
        <nav>
            <a href="{{ path('app_pim_restaurant_history', app.request.query.all|merge({cursor: next_cursor})) }}">
                Historique précédent
            </a>
        </nav>
    {% endif %}
</main>
{% endblock %}
