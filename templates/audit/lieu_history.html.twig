{% extends 'base.html.twig' %}

{% block title %}Historique de {{ lieu.label }}{% endblock %}

{% block body %}
<main class="page">
    <a class="back-link" href="{{ path('app_pim_lieu_show', {id: lieu.id}) }}">← Retour au lieu</a>

    <header class="page-header">
        <div>
            <p class="page-kicker">Audit append-only</p>
            <h1>Historique de {{ lieu.label }}</h1>
        </div>
    </header>

    <section class="card">
        {{ form(filter_form) }}
    </section>

    {% include 'audit/_revision_table.html.twig' %}

    {% if next_cursor %}
        <nav>
            <a href="{{ path('app_pim_lieu_history', app.request.query.all|merge({
                cursor: next_cursor
            })) }}">
                Historique précédent
            </a>
        </nav>
    {% endif %}
</main>
{% endblock %}
