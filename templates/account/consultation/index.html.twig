{% extends 'mdm/simple.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block corps %}
<main class="page">
    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-kicker">Accès prestataires</p>
            <h1>Utilisateurs</h1>
            <p class="page-description">Consultation des utilisateurs prestataires et de leurs fiches.</p>
        </div>
    </header>

    <section class="card form-card">
        <h2 class="card-title">Inviter un utilisateur</h2>
        {{ form(invitation_form) }}
    </section>

    {{ form_start(search_form, {attr: {class: 'card'}}) }}{{ form_row(search_form.q) }}{{ form_row(search_form.search) }}{{ form_end(search_form) }}

    <section class="card">
    <h2 class="card-title">Liste</h2>
    <div class="table-scroll"><table class="data-table">
        <thead><tr><th>Nom</th><th>Email</th><th>Téléphone</th><th>État</th><th>Fiches associées</th></tr></thead>
        <tbody>
        {% for collaborateur in collaborateurs %}
            <tr>
                <td>{{ (collaborateur.firstName ~ ' ' ~ collaborateur.lastName)|trim ?: '—' }}</td>
                <td>{{ collaborateur.email }}</td>
                <td>{{ collaborateur.phone ?: '—' }}</td>
                <td><span class="badge {{ collaborateur.active ? 'badge-success' : 'badge-neutral' }}">{{ collaborateur.active ? 'Actif' : 'Désactivé' }}</span></td>
                <td>
                    {% set liees = affiliations_par_collaborateur[collaborateur.id]|default([]) %}
                    {% if liees is empty %}
                        —
                    {% else %}
                        <ul class="flex flex-col gap-1 m-0 p-0 list-none">
                        {% for affiliation in liees %}
                            {% set fiche = affiliation.fiche %}
                            {% set libelle = (fiche.label ?? 'Sans libellé') ~ ' (' ~ fiche.code ~ ')' %}
                            <li>
                                {% set url_fiche = fiche_url(fiche.type, fiche.idString) %}
                                {% if url_fiche %}
                                    <a class="text-link" href="{{ url_fiche }}">{{ libelle }}</a>
                                {% else %}
                                    {{ libelle }}
                                {% endif %}
                                <span class="badge badge-neutral">{{ affiliation.role.label }}</span>
                            </li>
                        {% endfor %}
                        </ul>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td class="empty-state" colspan="5">Aucun utilisateur.</td></tr>
        {% endfor %}
        </tbody>
    </table></div>
    <nav class="table-actions">
        {% if page > 1 %}<a class="btn btn-secondary" href="{{ path('app_account_collaborateur_consultation_index', {page: page - 1, q: query}) }}">Précédent</a>{% endif %}
        <span class="badge badge-neutral">Page {{ page }} / {{ pages }} — {{ total }} utilisateur{{ total > 1 ? 's' }}</span>
        {% if page < pages %}<a class="btn btn-secondary" href="{{ path('app_account_collaborateur_consultation_index', {page: page + 1, q: query}) }}">Suivant</a>{% endif %}
    </nav>
    </section>
</main>
{% endblock %}
