{#
    Activation de compte sur invitation : gabarit maquette « Création du mot
    de passe » (74:2093) — c'est ici que vit le parcours d'inscription.
#}
{% extends 'auth/base.html.twig' %}
{% form_theme form 'pim/form/_form-theme-auth.html.twig' %}

{% block title %}Activer mon compte{% endblock %}

{% block panneau %}
    <div class="flex flex-col items-center self-stretch shrink-0 gap-6">
        <twig:Badge icon="lock" class="w-16" />

        <div class="flex flex-col items-center self-stretch shrink-0 gap-1">
            <twig:Typography variant="heading-1" element="h1" center
                             class="self-stretch font-[700]!">Création de votre<br>mot de passe</twig:Typography>
            <twig:Typography variant="body-lg" element="p" center
                             class="self-stretch">Remplissez les informations pour finaliser votre inscription.</twig:Typography>
            <twig:Typography variant="body" element="p" bold center class="self-stretch">{{ email }}</twig:Typography>
        </div>
    </div>

    {{ form_start(form, { attr: { class: 'flex flex-col items-stretch self-stretch shrink-0 gap-4' } }) }}
        {{ form_row(form.password.first) }}
        {{ form_row(form.password.second) }}
        {{ form_row(form.submit) }}
    {{ form_end(form) }}
{% endblock %}
