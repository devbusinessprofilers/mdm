{% extends 'mdm/simple.html.twig' %}

{% block title %}Collaborateurs prestataires{% endblock %}

{% block corps %}
<main class="page">
    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-kicker">Accès prestataires</p>
            <h1>Collaborateurs prestataires</h1>
            <p class="page-description">Invitez les contacts et gérez leur accès aux fiches.</p>
        </div>
    </header>
    <section class="card form-card">
        <h2 class="card-title">Inviter un collaborateur</h2>
        {{ form(invitation_form) }}
    </section>

    <section class="card">
    <h2 class="card-title">Liste</h2>
    <div class="table-scroll"><table class="data-table">
        <thead><tr><th>Email</th><th>Nom</th><th>État</th><th>Action</th></tr></thead>
        <tbody>
        {% for collaborateur in collaborateurs %}
            <tr>
                <td>{{ collaborateur.email }}</td>
                <td>{{ (collaborateur.firstName ~ ' ' ~ collaborateur.lastName)|trim ?: '—' }}</td>
                <td><span class="badge {{ collaborateur.active ? 'badge-success' : 'badge-neutral' }}">{{ collaborateur.active ? 'Actif' : 'Désactivé' }}</span></td>
                <td><a class="text-link" href="{{ path('app_account_admin_show', {id: collaborateur.id}) }}">Gérer</a></td>
            </tr>
        {% else %}
            <tr><td class="empty-state" colspan="4">Aucun collaborateur.</td></tr>
        {% endfor %}
        </tbody>
    </table></div>
    <nav class="table-actions">
        {% if page > 1 %}<a class="btn btn-secondary" href="{{ path('app_account_admin_index', {page: page - 1}) }}">Précédent</a>{% endif %}
        <span class="badge badge-neutral">Page {{ page }} / {{ pages }} — {{ total }} collaborateur{{ total > 1 ? 's' }}</span>
        {% if page < pages %}<a class="btn btn-secondary" href="{{ path('app_account_admin_index', {page: page + 1}) }}">Suivant</a>{% endif %}
    </nav>
    </section>
</main>
{% endblock %}
