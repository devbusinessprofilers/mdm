{% extends 'mdm/base.html.twig' %}

{#
    Écran « Médias » — châssis maquette (rail d'onglets + règle de diffusion
    persistante). Les onglets adossés à des données réutilisent le contenu de
    supervision DAM (partial inchangé) ; les autres décrivent ce que le back
    sait faire aujourd'hui.
#}

{% macro indicateur(icone, fond, libelle, valeur, note) %}
    <div class="flex items-center box-border gap-3 px-5 py-4 rounded-md bg-neutral-100 shadow-(--shadow) flex-1 basis-56 min-w-0">
        <span class="shrink-0 w-10 h-10 flex items-center justify-center rounded-full {{ fond }}">
            <twig:Icon name="{{ icone }}" aria-hidden="true" class="w-5 h-5 text-primary-3" />
        </span>
        <div class="flex flex-col gap-px min-w-0">
            <twig:Typography variant="body-sm" textColor="neutral-500" ellipsis>{{ libelle }}</twig:Typography>
            <twig:Typography variant="subtitle" class="font-[700]!">{{ valeur }}</twig:Typography>
            <twig:Typography variant="body-xs" textColor="neutral-400">{{ note }}</twig:Typography>
        </div>
    </div>
{% endmacro %}

{% block title %}Médias · {{ onglets[onglet_actif] }}{% endblock %}

{% set onglet_meta = {
    'biblio': { icone: 'images', sousTitre: 'Le catalogue des images et documents du référentiel.' },
    'import': { icone: 'upload-simple', sousTitre: 'Le dépôt et la retouche se font sur la fiche.' },
    'ia': { icone: 'ai', sousTitre: 'Détection des doublons visuels par empreinte perceptuelle.' },
    'meta': { icone: 'list', sousTitre: 'Nature, usage, légende, mots-clés, droits — saisis sur la fiche.' },
    'formats': { icone: 'desktop', sousTitre: 'Les variantes générées, servies par le CDN public.' },
    'droits': { icone: 'shield-check', sousTitre: 'Les droits d\'usage : manquants, expirants, expirés.' },
    'doublons': { icone: 'cube', sousTitre: 'Les images identiques ou quasi identiques du catalogue.' },
    'sync': { icone: 'arrow-clockwise', sousTitre: 'Les anomalies de synchronisation avec le PIM.' },
} %}

{# ------------------------------------------------- Rail des onglets #}
{% block rail %}
    <nav class="flex flex-col shrink-0 box-border w-[328px] pl-5 pr-3 py-4 gap-4 overflow-y-auto scrollbar"
         aria-label="Onglets du DAM">
        <div class="flex flex-col gap-1">
            <twig:Typography variant="body" bold class="pl-2 pr-4">Médias</twig:Typography>
            <div class="flex flex-col">
                {% for cle, libelle in onglets %}
                    <a href="{{ path('app_mdm_medias', { onglet: cle }) }}"
                       class="group/onglet flex items-center gap-2 box-border px-4 py-2
                              rounded-xs overflow-hidden cursor-pointer
                              hover:bg-primary-4 aria-[current=page]:bg-linear-(--primary-gradient) aria-[current=page]:hover:bg-none"
                       {{ onglet_actif == cle ? 'aria-current="page"' : '' }}>
                        <twig:Icon name="{{ onglet_meta[cle].icone }}" aria-hidden="true"
                                   class="shrink-0 self-center w-4 h-4 mx-1 text-primary
                                          group-aria-[current=page]/onglet:text-neutral-100" />
                        <twig:Typography variant="body" bold ellipsis textColor="primary-3"
                                         class="flex-1 min-w-0
                                                group-aria-[current=page]/onglet:text-neutral-100!">{{ libelle }}</twig:Typography>
                    </a>
                {% endfor %}
            </div>
        </div>

        <span class="flex-1"></span>

        {# La règle de diffusion, sous les yeux sur tous les onglets. #}
        <div class="shrink-0 flex flex-col gap-1.5 mr-1 p-3.5 rounded-[12px] bg-primary-4">
            <twig:Typography variant="body-sm" bold textColor="primary-3">Règle de diffusion</twig:Typography>
            <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">Un média est un actif
                porteur d'un droit d'usage : sans droits déclarés, il ne part sur aucun canal tiers, même si la
                fiche est publiée.</twig:Typography>
        </div>
    </nav>
{% endblock %}

{% block contenu %}
<main class="flex flex-col h-full min-h-0 overflow-y-auto scrollbar">

    <div class="shrink-0 flex items-end justify-between gap-6 px-10 pt-[22px] pb-4">
        <div class="flex flex-col gap-1 min-w-0 max-w-[720px]">
            <twig:Typography variant="heading-2" element="h1"
                             class="sm:text-[1.625rem]! sm:leading-[2.125rem]! font-[700]!">{{ onglets[onglet_actif] }}</twig:Typography>
            <twig:Typography variant="body" element="p" textColor="neutral-500"
                             class="text-pretty">{{ onglet_meta[onglet_actif].sousTitre }}</twig:Typography>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <twig:Button variant="outline" size="sm" asLink href="{{ path('app_dam_dashboard') }}">Supervision classique</twig:Button>
        {% endif %}
    </div>

    <div class="flex-1 min-h-0 flex flex-col gap-4 px-10 pb-8">

        {# ---- Indicateurs maquette : comptes réels quand les stats sont
             chargées ; le stockage vit sur le tableau de bord. ---- #}
        {% if vue and stats is defined %}
            <div class="shrink-0 flex flex-row gap-4 flex-wrap">
                {{ _self.indicateur('images', 'bg-neutral-200', 'Médias', stats.images + stats.documents, 'images et documents') }}
                {{ _self.indicateur('lock', 'bg-error-pastel', 'Sans droits déclarés', stats.rights_missing, 'non diffusables') }}
                {{ _self.indicateur('warning', 'bg-peach-pastel', 'Doublons probables', stats.duplicates, 'à dédoublonner') }}
                {{ _self.indicateur('arrow-clockwise', 'bg-peach-pastel', 'Traitements en échec', stats.failed, 'rejouables') }}
            </div>
        {% endif %}

    {% if onglet_actif == 'sync' and scan_form %}
        <div class="shrink-0">{{ form(scan_form) }}</div>
    {% endif %}

    {% if vue %}
        {% set ecran_route = 'app_mdm_medias' %}
        {% include 'dam/_dashboard_contenu.html.twig' %}
    {% elseif onglet_actif == 'formats' %}
        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)" aria-label="Formats et variantes">
            <twig:Typography variant="heading-3" element="h2" bold>Variantes générées</twig:Typography>
            <twig:Typography variant="body-sm" textColor="neutral-500">Chaque image traitée est déclinée dans ces formats, servis par le CDN public.</twig:Typography>
            <div class="overflow-x-auto rounded-md inset-ring-1 inset-ring-neutral-200">
                <table class="w-full border-collapse">
                    <thead class="bg-primary-5"><tr class="text-left h-10 border-b border-neutral-200">
                        {% for col in ['Variante', 'Dimensions cibles', 'Fichiers générés', 'Volume'] %}<th class="px-3"><twig:Typography variant="body-xs" textColor="neutral-500" bold>{{ col }}</twig:Typography></th>{% endfor %}
                    </tr></thead>
                    <tbody>
                    {% for nom, taille in variantes %}
                        {% set stat = formats|filter(f => f.name == nom)|first %}
                        <tr class="h-11 border-t border-neutral-200 first:border-t-0">
                            <td class="px-3"><twig:Typography variant="body-sm" bold>{{ nom }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ taille.width }} × {{ taille.height }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ stat ? stat.nb : 0 }}</twig:Typography></td>
                            <td class="px-3"><twig:Typography variant="body-sm">{{ stat ? (stat.octets / 1048576)|round(1) ~ ' Mo' : '—' }}</twig:Typography></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% elseif onglet_actif == 'import' %}
        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)">
            <twig:Typography variant="heading-3" element="h2" bold>Import & retouche</twig:Typography>
            <twig:Typography variant="body-sm" textColor="neutral-500">
                Le dépôt des photos et documents se fait sur la fiche (galerie, recadrage, rotation, remplacement) : les variantes sont générées automatiquement au dépôt. L'import en masse passe par l'import de fiches.
            </twig:Typography>
            <div class="flex flex-wrap items-center gap-2">
                <twig:Button variant="outline" size="sm" asLink href="{{ path('app_mdm_referentiel_general') }}">Ouvrir une fiche</twig:Button>
                {% if is_granted('ROLE_ADMIN') %}
                    <twig:Button variant="outline" size="sm" asLink href="{{ path('app_etl_import_index') }}">Import de fiches</twig:Button>
                {% endif %}
            </div>
        </section>
    {% elseif onglet_actif == 'ia' %}
        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)">
            <twig:Typography variant="heading-3" element="h2" bold>Reconnaissance IA</twig:Typography>
            <twig:Typography variant="body-sm" textColor="neutral-500">
                Le back détecte aujourd'hui les doublons visuels par empreinte perceptuelle (onglet Doublons). La reconnaissance du contenu à l'import (sujets, qualité, conformité) n'est pas encore branchée — écran à compléter avec le mécanisme.
            </twig:Typography>
        </section>
    {% elseif onglet_actif == 'meta' %}
        <section class="shrink-0 flex flex-col gap-3 p-6 rounded-[20px] bg-neutral-100 shadow-(--shadow)">
            <twig:Typography variant="heading-3" element="h2" bold>Métadonnées & types</twig:Typography>
            <twig:Typography variant="body-sm" textColor="neutral-500">
                Chaque ressource porte sa nature (photo, document, vidéo), son usage, sa légende, ses mots-clés, son recadrage et ses droits (accordés par qui, jusqu'à quand). Les documents ont en plus un statut de publication vers le stockage public. La saisie se fait sur la fiche, dans la gestion des médias.
            </twig:Typography>
        </section>
    {% endif %}
    </div>
</main>
{% endblock %}
