{% extends 'mdm/base.html.twig' %}

{#
    Écran « Médias » — le DAM au châssis maquette : rail d'onglets à badges,
    en-tête avec actions, indicateurs, santé, cartes, barre de filtres,
    tableau en grille et pied. Chaque onglet garde ses mécanismes back
    (arbitrage des doublons, validation des droits, relance des traitements) ;
    ce que la maquette promet sans couverture back est grisé « À venir ».
#}

{% set a_venir = 'Fonction à venir — en développement' %}
{% set carte = 'flex flex-col box-border gap-3 px-[26px] py-6 rounded-md bg-neutral-100 shadow-(--shadow)' %}
{% set grille = 'grid gap-4 items-center px-4 grid-cols-[repeat(auto-fit,minmax(0,1fr))]' %}
{% set pill_active = 'bg-linear-(--primary-gradient)' %}
{% set pill_repos = 'bg-primary-5 hover:bg-primary-4' %}

{% import 'dam/medias/_macros.html.twig' as m %}

{% block title %}{{ onglets[onglet_actif] }} · Médias{% endblock %}

{% set onglet_meta = {
    'biblio': { icone: 'images', sousTitre: 'Un média appartient à une fiche, porte un droit d\'usage et se décline par canal — les trois conditionnent sa diffusion.' },
    'import': { icone: 'upload-simple', sousTitre: 'L\'amélioration IA propose une version retouchée de chaque photo — validée en avant/après, l\'original est toujours conservé. Le dépôt, lui, se fait sur la fiche.' },
    'ia': { icone: 'rocket', sousTitre: 'Ce que l\'IA déduit d\'une photo — légende, mots-clés, contexte — reste en suggestions : rien n\'est écrit sur la fiche sans validation.' },
    'meta': { icone: 'note', sousTitre: 'Chaque ressource porte sa nature, son usage, sa légende, ses mots-clés et ses droits — saisis sur la fiche.' },
    'formats': { icone: 'layout', sousTitre: 'Les variantes générées à l\'import, servies par le CDN public. Un canal demande un format, pas un fichier.' },
    'droits': { icone: 'lock', sousTitre: 'Un média sans droits déclarés ne part sur aucun canal tiers, même si la fiche est publiée.' },
    'doublons': { icone: 'warning', sousTitre: 'La détection compare les images elles-mêmes, pas les noms de fichier — un visuel réimporté sous un autre nom est repéré.' },
    'sync': { icone: 'spinner', sousTitre: 'Le DAM détient les fichiers, le PIM les rattache aux fiches. Les anomalies entre les deux se traitent ici.' },
} %}

{# Badges réels du rail : seulement là où une donnée back existe. La coquille
   les tient des comptes légers rail_stats ; le fragment de contenu, des stats
   complètes du provider. #}
{% set badges_source = rail_stats|default(stats|default(null)) %}
{% set rail_badges = badges_source ? {
    'biblio': m.nombre(badges_source.images + badges_source.documents),
    'formats': variantes|length,
    'droits': m.nombre(badges_source.rights_missing),
    'doublons': badges_source.duplicates,
    'sync': badges_source.orphans + badges_source.missing_renditions + badges_source.failed,
} : {} %}
{# Onglets IA : ce qui attend une décision humaine. #}
{% set rail_badges = rail_badges|merge(vision_badges|default({})) %}

{# ------------------------------------------------- Rail des onglets #}
{% block rail %}
    <nav class="flex flex-col shrink-0 box-border w-[328px] pl-5 pr-3 py-4 gap-4 overflow-y-auto scrollbar"
         aria-label="Onglets de la bibliothèque de médias">
        {% for groupe, groupe_cles in groupes %}
        <div class="flex flex-col gap-1">
            <twig:Typography variant="body" bold class="pl-2 pr-4">{{ groupe }}</twig:Typography>
            <div class="flex flex-col">
                {% for cle in groupe_cles %}
                    {% set libelle = onglets[cle] %}
                    <a href="{{ path('app_mdm_medias', { onglet: cle }) }}"
                       class="group/onglet flex items-center gap-2 box-border px-4 py-2
                              rounded-xs overflow-hidden cursor-pointer
                              hover:bg-primary-4 aria-[current=page]:bg-linear-(--primary-gradient) aria-[current=page]:hover:bg-none"
                       {{ onglet_actif == cle ? 'aria-current="page"' : '' }}>
                        <twig:Icon name="{{ onglet_meta[cle].icone }}" aria-hidden="true"
                                   class="shrink-0 self-center w-4 h-4 mx-1 text-primary
                                          group-aria-[current=page]/onglet:text-neutral-100" />
                        <twig:Typography variant="body" bold ellipsis textColor="primary-3"
                                         class="flex-1 min-w-0
                                                group-aria-[current=page]/onglet:text-neutral-100!">{{ libelle }}</twig:Typography>
                        {% if rail_badges[cle] is defined %}
                            <twig:Typography variant="body-xs" bold textColor="neutral-500"
                                             class="shrink-0 px-[7px] py-0.5 rounded-lg bg-neutral-200
                                                    group-aria-[current=page]/onglet:bg-neutral-100
                                                    group-aria-[current=page]/onglet:text-primary-3!">{{ rail_badges[cle] }}</twig:Typography>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        </div>
        {% endfor %}

    </nav>
{% endblock %}

{% block contenu %}
<main class="flex flex-col h-full min-h-0">

    {# ------------------------------------------------- En-tête et actions #}
    <div class="shrink-0 flex items-end justify-between gap-6 px-10 pt-[22px] pb-4">
        <div class="flex flex-col gap-1 min-w-0 max-w-[760px]">
            <twig:Typography variant="heading-2" element="h1"
                             class="sm:text-[1.625rem]! sm:leading-[2.125rem]! font-[700]!">{{ onglets[onglet_actif] }}</twig:Typography>
            <twig:Typography variant="body" element="p" textColor="neutral-500"
                             class="text-pretty">{{ onglet_meta[onglet_actif].sousTitre }}</twig:Typography>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 flex-wrap justify-end">
            {% if onglet_actif == 'biblio' %}
                <span title="{{ a_venir }}" class="inline-flex"><twig:Button variant="outline" size="md" disabled icon="upload-simple" class="opacity-60 [&>:first-child]:size-5">Importer des médias</twig:Button></span>
                <span title="{{ a_venir }}" class="inline-flex"><twig:Button variant="primary" size="md" disabled icon="rocket" class="opacity-60 [&>:first-child]:size-5">Classer par lot</twig:Button></span>
            {% elseif onglet_actif == 'droits' %}
                <span title="{{ a_venir }}" class="inline-flex"><twig:Button variant="primary" size="md" disabled icon="lock" class="opacity-60 [&>:first-child]:size-5">Déclarer par lot</twig:Button></span>
            {% elseif onglet_actif == 'doublons' %}
                <span title="{{ a_venir }}" class="inline-flex"><twig:Button variant="primary" size="md" disabled icon="rocket" class="opacity-60 [&>:first-child]:size-5">Dédoublonner</twig:Button></span>
            {% elseif onglet_actif == 'sync' %}
                <twig:Button variant="outline" size="md" asLink href="{{ path('app_mdm_outils') }}">Voir le journal</twig:Button>
                {% if scan_form %}<div class="[&_form]:contents [&_button]:w-auto!">{{ form(scan_form) }}</div>{% endif %}
            {% endif %}
        </div>
    </div>

    {# Le contenu de l'onglet est différé : la coquille s'affiche tout de suite
       avec un squelette, la frame va chercher les agrégats et la page d'items
       sur app_mdm_medias_contenu. target="_top" : les liens et formulaires du
       contenu naviguent en pleine page, comme avant. #}
    <turbo-frame id="medias-contenu" target="_top" class="contents"
                 {% if not contenu_charge %}src="{{ contenu_url }}"{% endif %}>
    {% if not contenu_charge %}
    {# Squelette aux dimensions du réel : barre de files puis tableau. #}
    <div class="flex-1 min-h-0 flex flex-col gap-4 px-10 pb-8 overflow-y-auto scrollbar"
         role="status" aria-label="Chargement des médias en cours">
        <div class="shrink-0 flex items-center gap-3.5 px-5 py-[15px] rounded-sm bg-neutral-100 shadow-(--shadow) animate-pulse">
            <span class="h-4 w-24 rounded-lg bg-neutral-200"></span>
            <span class="w-px h-4 shrink-0 bg-neutral-200"></span>
            <span class="h-6 w-28 rounded-lg bg-neutral-200"></span>
            <span class="h-6 w-36 rounded-lg bg-neutral-200"></span>
        </div>
        <div class="shrink-0 flex flex-col rounded-sm overflow-hidden bg-neutral-100 shadow-(--shadow) animate-pulse">
            <div class="h-9 shrink-0 bg-primary-5 border-b border-neutral-200"></div>
            {% for ligne in 1..8 %}
                <div class="{{ grille }} min-h-[56px] py-2 box-border {{ loop.first ? '' : 'border-t border-neutral-200' }}">
                    {% for colonne in 1..5 %}
                        <span class="h-3.5 rounded-lg bg-neutral-200 {{ colonne is odd ? 'w-3/4' : 'w-1/2' }}"></span>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    </div>
    {% else %}
    <div class="flex-1 min-h-0 flex flex-col gap-4 px-10 pb-8 overflow-y-auto scrollbar">

    {# ------------------------------------------------- Indicateurs (bibliothèque) #}
    {% if onglet_actif == 'biblio' and stats is defined %}
        <div class="shrink-0 flex flex-row gap-3.5 flex-wrap">
            {{ m.indicateur('Médias', m.nombre(stats.images + stats.documents), 'images et documents', 'images', 'bg-neutral-200') }}
            {{ m.indicateur('Stockage', m.poids(stockage.octetsTotal) ~ ' avec variantes', m.nombre(stockage.nb) ~ ' fichiers actifs · ' ~ m.poids(stockage.octets) ~ ' d\'originaux', 'upload-simple', 'bg-peach-pastel') }}
            {{ m.indicateur('Sans droits déclarés', m.nombre(stats.rights_missing), 'non diffusables', 'lock', 'bg-error-pastel') }}
            {{ m.indicateur('Doublons probables', m.nombre(stats.duplicates), 'à dédoublonner', 'warning', 'bg-peach-pastel') }}
        </div>
    {% endif %}

    {# ------------------------------------------------- Santé (droits) : répartition réelle #}
    {% if onglet_actif == 'droits' and regimes is not empty %}
        {% set regimes_total = regimes.not_granted + regimes.unlimited + regimes.valid + regimes.expiring + regimes.expired %}
        {% set diffusables = regimes.unlimited + regimes.valid + regimes.expiring %}
        {% set axes = [
            ['Libres — sans échéance', regimes.unlimited, 'bg-success-pastel'],
            ['Valides', regimes.valid, 'bg-primary-4'],
            ['À échéance sous 30 jours', regimes.expiring, 'bg-peach-pastel'],
            ['Expirés', regimes.expired, 'bg-error-pastel'],
            ['Sans droits déclarés', regimes.not_granted, 'bg-neutral-200'],
        ] %}
        <div class="shrink-0 flex flex-row gap-4 items-stretch">
            <div class="{{ carte }} w-[400px] shrink-0 gap-4!">
                <twig:Typography variant="body" bold>Répartition des droits</twig:Typography>
                <div class="flex items-end gap-3.5">
                    <twig:Typography variant="heading-1" element="p"
                                     class="shrink-0 whitespace-nowrap sm:text-[3.25rem]! sm:leading-[3.625rem]! font-[700]!">
                        {{- regimes_total > 0 ? ((diffusables / regimes_total) * 100)|round : 0 }} %</twig:Typography>
                    <twig:Typography variant="body-sm" textColor="neutral-500" class="pb-1.5 text-pretty">
                        {{- regimes_total|number_format(0, ',', ' ') }} photos · {{ diffusables|number_format(0, ',', ' ') }} diffusables sur canaux tiers</twig:Typography>
                </div>
                <div class="flex flex-col gap-2.5">
                    {% for axe in axes %}
                        {% set part = regimes_total > 0 ? ((axe.1 / regimes_total) * 100)|round : 0 %}
                        <div class="flex flex-col gap-1">
                            <div class="flex items-baseline justify-between gap-3">
                                <twig:Typography variant="body-sm" bold class="min-w-0">{{ axe.0 }}</twig:Typography>
                                <div class="flex items-baseline gap-2 shrink-0">
                                    <twig:Typography variant="body" bold textColor="primary-3">{{ part }} %</twig:Typography>
                                    <twig:Typography variant="body-sm" textColor="neutral-500">{{ axe.1|number_format(0, ',', ' ') }} photos</twig:Typography>
                                </div>
                            </div>
                            <div class="w-full h-1 rounded-lg bg-neutral-200 overflow-hidden">
                                {# Le fond est celui du régime de droits : une répartition, pas un score. #}
                                <div class="h-full rounded-lg {{ axe.2 }}" style="width: {{ part }}%"></div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# Historisation des consentements : pas de back → grisée. #}
            <div title="{{ a_venir }}" class="{{ carte }} flex-1 min-w-0 gap-4! opacity-60">
                <div class="flex items-center gap-3">
                    <twig:Typography variant="body" bold class="flex-1 min-w-0">Consentements historisés</twig:Typography>
                    <span class="inline-flex shrink-0"><twig:Tag label="À venir" variant="neutral" size="sm" /></span>
                </div>
                <twig:Typography variant="body-sm" textColor="neutral-500" class="text-pretty">Chaque cession de
                    droits sera conservée avec sa preuve — cession signée ou accord par email — et sa date,
                    pour un historique opposable.</twig:Typography>
            </div>
        </div>
    {% endif %}

    {# ------------------------------------------------- Cartes par onglet #}
    {% if onglet_actif == 'droits' and stats is defined %}
        <div class="shrink-0 flex flex-row gap-4 flex-wrap">
            <a href="{{ path('app_mdm_medias', { filter: 'rights_missing' }) }}"
               class="{{ carte }} flex-1 basis-80 min-w-0 text-left cursor-pointer hover:bg-primary-5">
                {{ m.carte_contenu('lock', m.nombre(stats.rights_missing) ~ ' médias bloqués', m.nombre(stats.rights_missing), stats.rights_missing > 0,
                    'Sans droits déclarés, ils ne partent sur aucun canal tiers. La validation se fait média par média depuis la file ci-dessous.',
                    'Ouvrir la file') }}
            </a>
            <a href="{{ path('app_mdm_medias', { filter: 'rights_expiring' }) }}"
               class="{{ carte }} flex-1 basis-80 min-w-0 text-left cursor-pointer hover:bg-primary-5">
                {{ m.carte_contenu('calendar', 'Échéances sous 30 jours', m.nombre(stats.rights_expiring), stats.rights_expiring > 0,
                    'Les droits arrivent à terme : revalider ou révoquer avant que la diffusion ne soit suspendue.',
                    'Ouvrir la file') }}
            </a>
        </div>
    {% elseif onglet_actif == 'doublons' %}
        <div title="{{ a_venir }}" class="shrink-0 {{ carte }} opacity-60">
            <div class="flex items-center gap-3">
                <twig:Icon name="rocket" aria-hidden="true" class="shrink-0 w-6 h-6 text-neutral-400" />
                <twig:Typography variant="subtitle" class="flex-1 min-w-0 text-[1.125rem]! leading-[1.625rem]! font-[700]!">Dédoublonnage par lot</twig:Typography>
                <span class="inline-flex shrink-0"><twig:Tag label="À venir" variant="neutral" size="sm" /></span>
            </div>
            <twig:Typography variant="body" textColor="neutral-500" class="text-pretty">Traiter tous les groupes
                en une passe et mesurer le stockage libéré. Aujourd'hui, chaque doublon s'arbitre à la main
                dans la file ci-dessous.</twig:Typography>
        </div>
    {% elseif onglet_actif == 'sync' %}
        <div title="{{ a_venir }}" class="shrink-0 {{ carte }} opacity-60">
            <div class="flex items-center gap-3">
                <twig:Icon name="ok-circle" aria-hidden="true" class="shrink-0 w-6 h-6 text-neutral-400" />
                <twig:Typography variant="subtitle" class="flex-1 min-w-0 text-[1.125rem]! leading-[1.625rem]! font-[700]!">Miroir DAM ↔ PIM</twig:Typography>
                <span class="inline-flex shrink-0"><twig:Tag label="À venir" variant="neutral" size="sm" /></span>
            </div>
            <twig:Typography variant="body" textColor="neutral-500" class="text-pretty">Le tableau des flux
                (volumes, dernier passage, état par canal) arrivera avec la synchronisation planifiée. Le scan
                des anomalies ci-dessous est, lui, opérationnel.</twig:Typography>
        </div>
    {% endif %}

    {# ------------------------------------------------- Tableau maquette « Droits d'usage » : les régimes réels #}
    {% if onglet_actif == 'droits' and regimes is not empty %}
        {% set regimes_lignes = [
            ['Libres — sans échéance', regimes.unlimited, 'bg-success-pastel', 'diffusable partout, sans limite de durée'],
            ['Valides', regimes.valid, 'bg-primary-4', 'diffusable jusqu\'à l\'échéance déclarée'],
            ['À échéance sous 30 jours', regimes.expiring, 'bg-peach-pastel', 'diffusable, revalidation à prévoir'],
            ['Expirés', regimes.expired, 'bg-error-pastel', 'diffusion à suspendre jusqu\'à revalidation'],
            ['Sans droits déclarés', regimes.not_granted, 'bg-neutral-200', 'bloqué à la diffusion jusqu\'à déclaration'],
        ] %}
        <div class="shrink-0 flex flex-col rounded-sm overflow-hidden bg-neutral-100 shadow-(--shadow)">
            {{ m.entete([['Droit d\'usage'], ['Médias', 'text-right'], ['Part du stock'], ['Ce qu\'il autorise']], grille) }}
            <div class="flex flex-col">
                {% for regime in regimes_lignes %}
                    <div role="row" class="{{ grille }} w-full min-h-[56px] py-2 box-border hover:bg-primary-5
                                           {{ loop.first ? '' : 'border-t border-neutral-200' }}">
                        {{ m.jeton(regime.0, regime.2) }}
                        {{ m.txt(regime.1|number_format(0, ',', ' '), gras = true, aligne = 'text-right') }}
                        {{ m.barre_cellule(regimes_total > 0 ? ((regime.1 / regimes_total) * 100)|round : 0) }}
                        {{ m.phrase_cellule(regime.3) }}
                    </div>
                {% endfor %}
            </div>
            <div class="shrink-0 flex items-center h-[50px] px-4 border-t border-neutral-200">
                <twig:Typography variant="body-sm" textColor="neutral-500">5 régimes de droits · {{ regimes.not_granted|number_format(0, ',', ' ') }} média{{ regimes.not_granted > 1 ? 's' : '' }} bloqué{{ regimes.not_granted > 1 ? 's' : '' }}</twig:Typography>
            </div>
        </div>
    {% endif %}

    {# ------------------------------------------------- Files et filtres #}
    {% set files_par_onglet = {
        'biblio': { 'images': 'Images', 'documents': 'Autres médias' },
        'droits': { 'rights_missing': 'Sans droits', 'rights_expiring': 'À J-30', 'rights_expired': 'Expirés', 'published_rights': 'Publiées · droits invalides', 'published_no_photo': 'Publiées sans photo' },
        'doublons': { 'duplicates': 'Doublons détectés' },
        'sync': { 'orphans': 'Ressources orphelines', 'missing_renditions': 'Variantes manquantes', 'failed': 'Traitements en échec' },
    } %}
    {% set files = files_par_onglet[onglet_actif]|default({}) %}

    {% if files is not empty and stats is defined %}
        <div class="shrink-0 flex items-center gap-3.5 flex-wrap px-5 py-3 rounded-sm bg-neutral-100 shadow-(--shadow)">
            <twig:Typography variant="subtitle" class="shrink-0 text-[0.9375rem]! leading-[1.375rem]! font-[700]!">
                {{- total|number_format(0, ',', ' ') }} {{ onglet_actif == 'biblio' ? 'médias' : 'résultat' ~ (total > 1 ? 's' : '') -}}
            </twig:Typography>
            <span class="w-px h-4 shrink-0 bg-neutral-200"></span>
            <div class="flex items-center gap-2 flex-wrap flex-1 min-w-0" aria-label="Files de l'onglet">
                {% for cle, libelle in files %}
                    <a href="{{ path('app_mdm_medias', { filter: cle }) }}"
                       data-file="{{ cle }}"{{ filter == cle ? ' data-file-active' : '' }}
                       class="px-3 py-1 rounded-lg {{ filter == cle ? pill_active : pill_repos }}">
                        <twig:Typography variant="body-sm" bold
                                         textColor="{{ filter == cle ? 'neutral-100' : 'primary-3' }}">{{ libelle }} ({{ attribute(stats, cle)|number_format(0, ',', ' ') }})</twig:Typography>
                    </a>
                {% endfor %}
            </div>
            {% if filter not in ['images', 'documents', 'failed', 'orphans', 'missing_renditions'] %}
                <div class="flex items-center gap-2 flex-wrap shrink-0" aria-label="Filtrer par type de fiche">
                    <a href="{{ path('app_mdm_medias', { filter: filter }) }}"
                       class="px-3 py-1 rounded-lg {{ type is null ? pill_active : pill_repos }}">
                        <twig:Typography variant="body-sm" bold textColor="{{ type is null ? 'neutral-100' : 'primary-3' }}">Tous</twig:Typography>
                    </a>
                    {% for candidate in types %}
                        <a href="{{ path('app_mdm_medias', { filter: filter, type: candidate.value }) }}"
                           class="px-3 py-1 rounded-lg {{ type == candidate.value ? pill_active : pill_repos }}">
                            <twig:Typography variant="body-sm" bold textColor="{{ type == candidate.value ? 'neutral-100' : 'primary-3' }}">{{ candidate.value|replace({'_': ' '})|capitalize }}</twig:Typography>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
            {% if onglet_actif == 'biblio' %}
                <span title="{{ a_venir }}" class="shrink-0 opacity-60">
                    <twig:Typography variant="body-sm" bold textColor="primary-3">Import le plus récent</twig:Typography>
                </span>
            {% endif %}
        </div>
    {% endif %}

    {% include 'dam/medias/_tableau.html.twig' %}

    {% include 'dam/medias/_import.html.twig' %}

    {% include 'dam/medias/_ia.html.twig' %}

    {% include 'dam/medias/_meta_formats.html.twig' %}

    {# ------------------------------------------------- Barre du bas (bibliothèque) #}
    {% if onglet_actif == 'biblio' %}
        <div class="shrink-0 flex items-center gap-4 flex-wrap px-6 py-4 rounded-sm bg-primary-4 inset-ring-1 inset-ring-primary">
            <twig:Icon name="info-circle" aria-hidden="true" class="shrink-0 w-5 h-5 text-primary" />
            <twig:Typography variant="body-sm" textColor="neutral-500" class="flex-1 min-w-[280px] text-pretty">
                Chaque image traitée existe en {{ variantes|length }} déclinaisons, servies par le CDN public.
                Les médias sans droits déclarés sont exclus de toute diffusion.</twig:Typography>
            <div class="flex items-center gap-2 shrink-0">
                <span title="{{ a_venir }}" class="inline-flex"><twig:Button variant="outline" size="sm" disabled class="opacity-60">Choisir la déclinaison</twig:Button></span>
                <span title="{{ a_venir }}" class="inline-flex"><twig:Button variant="primary" size="sm" disabled class="opacity-60">Télécharger</twig:Button></span>
            </div>
        </div>
    {% endif %}
    </div>
    {% endif %}
    </turbo-frame>
</main>
{% endblock %}
