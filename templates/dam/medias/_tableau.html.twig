{%- import 'dam/medias/_macros.html.twig' as m -%}
    {# ------------------------------------------------- Tableau par onglet #}
    {% if onglet_actif in ['biblio', 'droits', 'doublons', 'sync'] and items is defined %}
        {% set statut_jetons = {
            'processed': ['Traité', 'bg-success-pastel'],
            'failed': ['En échec', 'bg-error-pastel'],
            'processing': ['En traitement', 'bg-primary-4'],
            'uploaded': ['Déposé', 'bg-primary-4'],
        } %}
        <div class="shrink-0 flex flex-col rounded-sm overflow-hidden bg-neutral-100 shadow-(--shadow)">

            {% if onglet_actif == 'biblio' %}
                {{ m.entete([['Média'], ['Fiche'], ['Type'], ['Poids', 'text-right'], ['Statut'], ['', 'text-right']], grille) }}
                <div class="flex flex-col">
                    {% for item in items %}
                        <div role="row" class="{{ grille }} w-full min-h-[56px] py-2 box-border hover:bg-primary-5
                                               {{ loop.first ? '' : 'border-t border-neutral-200' }}">
                            {{ m.duo(item.asset.originalFilename, item.asset.kind.value == 'image' ? 'Image' : 'Document') }}
                            {{ m.txt(item.fiche_label ?: 'Aucune fiche', discret = true) }}
                            {{ m.txt(item.asset.mimeType, discret = true) }}
                            {{ m.txt(m.poids(item.asset.sizeBytes), gras = true, aligne = 'text-right') }}
                            {% set jeton = statut_jetons[item.asset.status.value]|default([item.asset.status.value, 'bg-neutral-200']) %}
                            {{ m.jeton(jeton.0, jeton.1) }}
                            {{ m.lien_cellule('Ouvrir la fiche', item.fiche_url) }}
                        </div>
                    {% endfor %}
                </div>

            {% elseif onglet_actif == 'droits' %}
                {% if filter == 'published_no_photo' %}
                    {{ m.entete([['Fiche'], ['Problème'], ['', 'text-right']], grille) }}
                    <div class="flex flex-col">
                        {% for item in items %}
                            <div role="row" class="{{ grille }} w-full min-h-[56px] py-2 box-border hover:bg-primary-5
                                                   {{ loop.first ? '' : 'border-t border-neutral-200' }}">
                                {{ m.duo(item.fiche_label, item.fiche_type ? item.fiche_type|replace({'_': ' '})|capitalize : '') }}
                                {{ m.phrase_cellule('Cette fiche publiée n\'a aucune photo rattachée.', 'error') }}
                                {{ m.lien_cellule('Ouvrir la fiche', item.fiche_url) }}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    {{ m.entete([['Média'], ['Fiche'], ['Source'], ['Échéance', 'text-right'], ['', 'text-right']], grille) }}
                    <div class="flex flex-col">
                        {% for item in items %}
                            <div role="row" class="{{ grille }} w-full min-h-[56px] py-2 box-border hover:bg-primary-5
                                                   {{ loop.first ? '' : 'border-t border-neutral-200' }}">
                                {{ m.duo(item.resource.legende ?: (item.asset ? item.asset.originalFilename : item.resource.usage),
                                    item.resource.keywords ?: '') }}
                                {{ m.txt(item.fiche_label ?: '—', discret = true) }}
                                {{ m.txt(item.resource.source ?: 'Non renseignée', discret = true) }}
                                {{ m.txt(item.resource.rightsExpiresAt ? item.resource.rightsExpiresAt|date('d/m/Y') : 'sans limite',
                                    gras = true, aligne = 'text-right',
                                    teinte = filter == 'rights_expired' or (filter == 'published_rights' and not item.resource.rightsGranted) ? 'error' : '') }}
                                <span class="flex items-center justify-end gap-2 min-w-0 flex-wrap [&_form]:contents [&_button]:w-auto!">
                                    {% if is_granted('ROLE_BP_VALIDATOR') and item.rights_form is defined %}
                                        {{ form(item.rights_form) }}
                                    {% elseif item.fiche_url %}
                                        <a href="{{ item.fiche_url }}" class="flex items-center gap-1.5 hover:underline decoration-primary-3"
                                           title="Corrigez l'échéance dans la fiche avant de valider les droits.">
                                            <twig:Typography variant="body-sm" bold textColor="primary-3">Corriger sur la fiche</twig:Typography>
                                            <twig:Icon name="arrow-right" aria-hidden="true" class="shrink-0 w-3 h-3 text-primary" />
                                        </a>
                                    {% endif %}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

            {% elseif onglet_actif == 'doublons' %}
                {{ m.entete([['Média'], ['Doublon de'], ['Similarité'], ['Décision proposée'], ['Actions', 'text-right']], grille) }}
                <div class="flex flex-col">
                    {% for item in items %}
                        {% set exact = item.alert.kind.value == 'exact' %}
                        <div role="row" class="{{ grille }} w-full min-h-[56px] py-2 box-border hover:bg-primary-5
                                               {{ loop.first ? '' : 'border-t border-neutral-200' }}">
                            <span class="flex flex-col min-w-0">
                                <twig:Typography variant="body-sm" bold ellipsis>{{ item.asset.originalFilename }}</twig:Typography>
                                {% if item.fiche_url %}
                                    <a href="{{ item.fiche_url }}" class="hover:underline decoration-primary-3 min-w-0">
                                        <twig:Typography variant="body-xs" bold textColor="primary-3" ellipsis>{{ item.fiche_label }}</twig:Typography>
                                    </a>
                                {% else %}
                                    <twig:Typography variant="body-xs" textColor="neutral-400" ellipsis>Aucune fiche</twig:Typography>
                                {% endif %}
                            </span>
                            <span class="flex flex-col min-w-0">
                                <twig:Typography variant="body-sm" bold ellipsis>{{ item.reference.originalFilename }}</twig:Typography>
                                {% if item.reference_fiche and item.reference_fiche.fiche_url %}
                                    <a href="{{ item.reference_fiche.fiche_url }}" class="hover:underline decoration-primary-3 min-w-0">
                                        <twig:Typography variant="body-xs" bold textColor="primary-3" ellipsis>{{ item.reference_fiche.fiche_label }}</twig:Typography>
                                    </a>
                                {% else %}
                                    <twig:Typography variant="body-xs" textColor="neutral-400" ellipsis>Fiche d'origine indisponible</twig:Typography>
                                {% endif %}
                            </span>
                            {{ m.duo(exact ? 'Exacte' : 'Visuellement proche',
                                item.alert.distance is not null ? 'distance ' ~ item.alert.distance : 'somme de contrôle identique') }}
                            {{ m.jeton(exact ? 'Supprimer la copie' : 'Vérifier à la main', exact ? 'bg-success-pastel' : 'bg-peach-pastel') }}
                            <span class="flex items-center justify-end gap-2 min-w-0 flex-wrap [&_form]:contents [&_button]:w-auto!">
                                {% if is_granted('ROLE_BP_VALIDATOR') %}
                                    {{ form(item.accept_form) }}
                                    {{ form(item.delete_form) }}
                                {% else %}
                                    <twig:Typography variant="body-sm" textColor="neutral-400">Arbitrage validateur</twig:Typography>
                                {% endif %}
                            </span>
                        </div>
                    {% endfor %}
                </div>

            {% elseif onglet_actif == 'sync' %}
                {% if filter == 'failed' %}
                    {{ m.entete([['Média'], ['Erreur'], ['Déposé le'], ['', 'text-right']], grille) }}
                    <div class="flex flex-col">
                        {% for item in items %}
                            <div role="row" class="{{ grille }} w-full min-h-[56px] py-2 box-border hover:bg-primary-5
                                                   {{ loop.first ? '' : 'border-t border-neutral-200' }}">
                                {{ m.duo(item.asset.originalFilename, item.asset.mimeType) }}
                                {{ m.phrase_cellule(item.asset.errorMessage ?: 'Le traitement DAM a échoué.', 'error') }}
                                {{ m.txt(item.asset.createdAt|date('d/m/Y H:i'), discret = true) }}
                                <span class="flex items-center justify-end min-w-0 [&_form]:contents [&_button]:w-auto!">
                                    {{ form(item.retry_form) }}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    {{ m.entete([['Fiche'], ['Référence média'], ['Anomalie'], ['Détectée le'], ['', 'text-right']], grille) }}
                    <div class="flex flex-col">
                        {% for item in items %}
                            <div role="row" class="{{ grille }} w-full min-h-[56px] py-2 box-border hover:bg-primary-5
                                                   {{ loop.first ? '' : 'border-t border-neutral-200' }}">
                                {{ m.duo(item.fiche_label, item.fiche_type ? item.fiche_type|replace({'_': ' '})|capitalize : '') }}
                                {{ m.txt(item.resource.damAssetId, discret = true) }}
                                {{ m.phrase_cellule(filter == 'orphans'
                                    ? 'Le média associé est introuvable ou supprimé dans le DAM.'
                                    : 'Le média est marqué « traité » mais des variantes d\'image manquent.', 'error') }}
                                {{ m.txt(item.anomaly.detectedAt|date('d/m/Y H:i'), discret = true) }}
                                {{ m.lien_cellule('Ouvrir la fiche', item.fiche_url) }}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}

            {% if items is empty %}
                <div class="flex items-center gap-3 px-4 min-h-[56px]">
                    <twig:Icon name="ok-circle" aria-hidden="true" class="shrink-0 w-5 h-5 text-success" />
                    <twig:Typography variant="body-sm" textColor="neutral-500">
                        {{- onglet_actif == 'biblio' ? 'Aucun média dans cette catégorie.' : 'Aucune anomalie dans cette file.' -}}
                    </twig:Typography>
                </div>
            {% endif %}

            {# Pied : le réel affiché, et la navigation de page. #}
            <div class="shrink-0 flex items-center gap-3 h-[50px] px-4 border-t border-neutral-200">
                <twig:Typography variant="body-sm" textColor="neutral-500">
                    {{- items|length }} affiché{{ items|length > 1 ? 's' : '' }} sur {{ total|number_format(0, ',', ' ') }} · page {{ page }} / {{ max(pages, 1) -}}
                </twig:Typography>
                <span class="flex-1"></span>
                {% if page > 1 %}
                    <twig:Button variant="text" size="sm" asLink class="inset-ring-1 inset-ring-neutral-200 rounded-full!"
                                 href="{{ path('app_mdm_medias', { filter: filter, type: type, page: page - 1 }) }}">Précédent</twig:Button>
                {% endif %}
                {% if page < pages %}
                    <twig:Button variant="text" size="sm" asLink class="inset-ring-1 inset-ring-neutral-200 rounded-full!"
                                 href="{{ path('app_mdm_medias', { filter: filter, type: type, page: page + 1 }) }}">Suivant</twig:Button>
                {% endif %}
            </div>
        </div>
    {% endif %}
