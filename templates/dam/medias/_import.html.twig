{%- import 'dam/medias/_macros.html.twig' as m -%}
    {# ------------------------------------------------- Onglet Import & retouche #}
    {% if onglet_actif == 'import' and retouche is not null %}
        {% if retouche_stats is defined and retouche_stats %}
            <div class="shrink-0 flex flex-row gap-4 flex-wrap">
                <div class="{{ carte }} flex-1 basis-80 min-w-0">
                    <div class="flex items-center gap-3">
                        <twig:Icon name="ok-circle" aria-hidden="true"
                                   class="shrink-0 w-6 h-6 {{ retouche_stats.a_valider > 0 ? 'text-error' : 'text-primary' }}" />
                        <twig:Typography variant="subtitle" ellipsis
                                         class="flex-1 min-w-0 text-[1.125rem]! leading-[1.625rem]! font-[700]!">Retouches à valider</twig:Typography>
                        <span class="inline-flex shrink-0"><twig:Tag label="{{ retouche_stats.a_valider|number_format(0, ',', ' ') }}" size="sm"
                                  variant="{{ retouche_stats.a_valider > 0 ? 'error' : 'success-pastel' }}" class="whitespace-nowrap" /></span>
                    </div>
                    <twig:Typography variant="body" textColor="neutral-500" class="text-pretty">Versions retouchées en
                        attente d'une décision en avant/après, ligne par ligne ci-dessous. L'original est toujours
                        conservé : rien ne change tant qu'une proposition n'est pas acceptée.</twig:Typography>
                </div>
                <div class="{{ carte }} flex-1 basis-80 min-w-0">
                    <div class="flex items-center gap-3">
                        <twig:Icon name="images" aria-hidden="true" class="shrink-0 w-6 h-6 text-primary" />
                        <twig:Typography variant="subtitle" ellipsis
                                         class="flex-1 min-w-0 text-[1.125rem]! leading-[1.625rem]! font-[700]!">Retouches appliquées</twig:Typography>
                        <span class="inline-flex shrink-0"><twig:Tag label="{{ retouche_stats.appliquees|number_format(0, ',', ' ') }}" size="sm"
                                  variant="{{ retouche_stats.appliquees > 0 ? 'success-pastel' : 'neutral' }}" class="whitespace-nowrap" /></span>
                    </div>
                    <twig:Typography variant="body" textColor="neutral-500" class="text-pretty">Photos dont la version
                        retouchée acceptée sert désormais de source aux variantes diffusées{{ retouche_stats.rejetees > 0 ? ' — et ' ~ retouche_stats.rejetees|number_format(0, ',', ' ') ~ ' proposition' ~ (retouche_stats.rejetees > 1 ? 's' : '') ~ ' rejetée' ~ (retouche_stats.rejetees > 1 ? 's' : '') : '' }}.
                        Le retour à l'original reste possible à tout moment.</twig:Typography>
                </div>
                <div class="{{ carte }} flex-1 basis-80 min-w-0">
                    <div class="flex items-center gap-3">
                        <twig:Icon name="spinner" aria-hidden="true"
                                   class="shrink-0 w-6 h-6 {{ retouche_stats.echecs > 0 ? 'text-error' : 'text-primary' }}" />
                        <twig:Typography variant="subtitle" ellipsis
                                         class="flex-1 min-w-0 text-[1.125rem]! leading-[1.625rem]! font-[700]!">File de retouche</twig:Typography>
                        <span class="inline-flex shrink-0"><twig:Tag label="{{ retouche_stats.en_file|number_format(0, ',', ' ') }}" size="sm"
                                  variant="{{ retouche_stats.en_file > 0 ? 'primary-3' : 'neutral' }}" class="whitespace-nowrap" /></span>
                    </div>
                    <twig:Typography variant="body" textColor="neutral-500" class="text-pretty">Photos en file ou en
                        cours de retouche par les workers{{ retouche_stats.echecs > 0 ? ', et ' ~ retouche_stats.echecs|number_format(0, ',', ' ') ~ ' en échec à relancer depuis la liste ci-dessous' : ' — aucun échec à relancer' }}.</twig:Typography>
                </div>
            </div>
        {% endif %}
        {% if ia_active %}
            <div class="shrink-0 {{ carte }}">
                <div class="flex items-center gap-3">
                    <twig:Icon name="rocket" aria-hidden="true" class="shrink-0 w-6 h-6 text-primary" />
                    <twig:Typography variant="subtitle" class="flex-1 min-w-0 text-[1.125rem]! leading-[1.625rem]! font-[700]!">Lancer une retouche IA</twig:Typography>
                </div>
                <twig:Typography variant="body" textColor="neutral-500" class="text-pretty">Chaque photo des fiches
                    sélectionnées part en amélioration — luminosité, contraste, couleurs, netteté. La version proposée
                    s'examine ci-dessous en avant/après : rien ne change tant qu'elle n'est pas acceptée et l'original
                    est toujours conservé. La retouche IA régénère l'image : vérifiez son contenu avant d'accepter.</twig:Typography>
                {% if lancement_retouche_form %}
                    <div class="max-w-[560px] [&_button]:w-auto!">{{ form(lancement_retouche_form) }}</div>
                {% endif %}
            </div>
        {% else %}
            <div class="shrink-0 {{ carte }}">
                <div class="flex items-center gap-3">
                    <twig:Icon name="rocket" aria-hidden="true" class="shrink-0 w-6 h-6 text-neutral-400" />
                    <twig:Typography variant="subtitle" class="flex-1 min-w-0 text-[1.125rem]! leading-[1.625rem]! font-[700]!">Retouche IA désactivée</twig:Typography>
                    <span class="inline-flex shrink-0"><twig:Tag label="Inactive" variant="neutral" size="sm" /></span>
                </div>
                <twig:Typography variant="body" textColor="neutral-500" class="text-pretty">Renseignez la clé API
                    OpenAI puis activez la fonction (OPENAI_ENABLED, surchargeable par le paramètre « openai.actif »
                    dans Administration → Paramètres) pour proposer une version améliorée des photos.</twig:Typography>
            </div>
        {% endif %}

        {{ m.retouche_tableau(retouche, grille, ia_active, 'page') }}

        {# ------------------- Retouche automatique locale (ImageMagick) #}
        {% if retouche_auto is defined and retouche_auto is not null %}
            <div class="shrink-0 {{ carte }}">
                <div class="flex items-center gap-3">
                    <twig:Icon name="images" aria-hidden="true" class="shrink-0 w-6 h-6 text-primary" />
                    <twig:Typography variant="subtitle" class="flex-1 min-w-0 text-[1.125rem]! leading-[1.625rem]! font-[700]!">Lancer une retouche automatique</twig:Typography>
                    <span class="inline-flex shrink-0"><twig:Tag label="Sans IA — gratuite" variant="success-pastel" size="sm" /></span>
                </div>
                <twig:Typography variant="body" textColor="neutral-500" class="text-pretty">Correction locale et
                    déterministe par ImageMagick — exposition, contraste, couleurs, netteté. Contrairement à la
                    retouche IA, aucun pixel n'est inventé : visages, textes et contenus restent strictement ceux de
                    l'original. La proposition s'examine ci-dessous en avant/après, comme une retouche IA.</twig:Typography>
                {% if lancement_retouche_auto_form is defined and lancement_retouche_auto_form %}
                    <div class="max-w-[560px] [&_button]:w-auto!">{{ form(lancement_retouche_auto_form) }}</div>
                {% endif %}
            </div>
            {{ m.retouche_tableau(retouche_auto, grille, true, 'page_auto') }}
        {% endif %}
    {% endif %}
