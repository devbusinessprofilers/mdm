{% set ecran_route = ecran_route|default('app_dam_dashboard') %}
    {% set media_tab = filter == 'images' or filter == 'documents' %}
    <nav class="dam-type-filters dam-tabs" aria-label="Sections du DAM">
        <a class="btn {{ media_tab ? 'btn-secondary' : '' }}" href="{{ path(ecran_route) }}">Anomalies</a>
        <a class="btn {{ filter == 'images' ? '' : 'btn-secondary' }}" href="{{ path(ecran_route, {filter: 'images'}) }}">Images ({{ stats.images }})</a>
        <a class="btn {{ filter == 'documents' ? '' : 'btn-secondary' }}" href="{{ path(ecran_route, {filter: 'documents'}) }}">Autres médias ({{ stats.documents }})</a>
    </nav>

    {% if not media_tab %}
    <section class="dam-stats" aria-label="Anomalies DAM">
        {% set cards = {
            duplicates: ['Doublons', stats.duplicates],
            rights_missing: ['Droits non validés', stats.rights_missing],
            rights_expiring: ['Droits à J-30', stats.rights_expiring],
            rights_expired: ['Droits expirés', stats.rights_expired],
            failed: ['Traitements en échec', stats.failed],
            published_no_photo: ['Publiées sans photo', stats.published_no_photo],
            published_rights: ['Droits invalides (publiées)', stats.published_rights],
            orphans: ['Ressources orphelines', stats.orphans],
            missing_renditions: ['Variantes manquantes', stats.missing_renditions]
        } %}
        {% for key, card in cards %}
            <a class="card dam-stat {{ filter == key ? 'dam-stat-active' : '' }}" href="{{ path(ecran_route, {filter: key, type: type}) }}">
                <span>{{ card[0] }}</span><strong>{{ card[1] }}</strong>
            </a>
        {% endfor %}
    </section>
    {% endif %}

    <section class="card dam-toolbar">
        {% if filter not in ['failed', 'orphans', 'missing_renditions'] and not media_tab %}
            <nav class="dam-type-filters" aria-label="Filtrer par type de fiche">
                <a class="btn {{ type is null ? '' : 'btn-secondary' }}" href="{{ path(ecran_route, {filter: filter}) }}">Tous</a>
                {% for candidate in types %}
                    <a class="btn {{ type == candidate.value ? '' : 'btn-secondary' }}" href="{{ path(ecran_route, {filter: filter, type: candidate.value}) }}">{{ candidate.value|replace({'_': ' '})|capitalize }}</a>
                {% endfor %}
            </nav>
        {% endif %}
        <span>{{ total }} résultat{{ total > 1 ? 's' : '' }}</span>
    </section>

    {% if media_tab %}
    <section class="dam-anomaly-list" aria-label="{{ filter == 'images' ? 'Médias image' : 'Médias hors image' }}">
        {% for item in items %}
            <article class="card dam-anomaly">
                <div class="dam-media-preview">
                    {% if item.thumbnail %}<img src="{{ item.thumbnail }}" alt="{{ item.asset.originalFilename }}" loading="lazy">{% else %}<span>Aucun aperçu</span>{% endif %}
                </div>
                <div class="dam-anomaly-content">
                    <div class="section-heading">
                        <div>
                            <span class="badge badge-neutral">{{ item.asset.kind.value == 'image' ? 'Image' : 'Document' }}</span>
                            <h2>{{ item.asset.originalFilename }}</h2>
                        </div>
                        {% if item.fiche_url %}<a class="btn btn-secondary" href="{{ item.fiche_url }}">Ouvrir {{ item.fiche_label }}</a>{% endif %}
                    </div>
                    <p>
                        {{ item.asset.mimeType }} · {{ (item.asset.sizeBytes / 1024)|round }} Ko
                        · <span class="badge {{ item.asset.status.value == 'failed' ? 'badge-danger' : 'badge-info' }}">{{ item.asset.status.value }}</span>
                        · déposé le <time datetime="{{ item.asset.createdAt|date('c') }}">{{ item.asset.createdAt|date('d/m/Y H:i') }}</time>
                    </p>
                    {% if item.fiche_type %}
                        <p>Rattaché à <span class="badge badge-neutral">{{ item.fiche_type|replace({'_': ' '}) }}</span> {{ item.fiche_label }}</p>
                    {% else %}
                        <p>Rattaché à aucune fiche.</p>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <div class="card empty-state">Aucun média dans cette catégorie.</div>
        {% endfor %}
    </section>
    {% else %}
    <section class="dam-anomaly-list">
        {% for item in items %}
            <article class="card dam-anomaly">
                <div class="dam-media-preview">
                    {% if item.thumbnail %}<img src="{{ item.thumbnail }}" alt="{{ item.resource and item.resource.legende ? item.resource.legende : (item.asset ? item.asset.originalFilename : 'Média') }}" loading="lazy">{% else %}<span>Aucun aperçu</span>{% endif %}
                </div>
                <div class="dam-anomaly-content">
                    <div class="section-heading">
                        <div>
                            <span class="badge badge-neutral">{{ item.fiche_type ? item.fiche_type|replace({'_': ' '}) : '(sans fiche)' }}</span>
                            <h2>{{ item.resource ? (item.resource.legende ?: (item.asset ? item.asset.originalFilename : item.resource.usage)) : (item.asset ? item.asset.originalFilename : item.fiche_label) }}</h2>
                        </div>
                        {% if item.fiche_url %}<a class="btn btn-secondary" href="{{ item.fiche_url }}">Ouvrir {{ item.fiche_label }}</a>{% endif %}
                    </div>

                    {% if filter == 'duplicates' %}
                        <p><strong>{{ item.alert.kind.value == 'exact' ? 'Doublon exact' : 'Image visuellement proche' }}</strong>{% if item.alert.distance is not null %} · distance {{ item.alert.distance }}{% endif %}</p>
                        <div class="dam-duplicate-reference">
                            {% if item.reference_thumbnail %}<img src="{{ item.reference_thumbnail }}" alt="Média de référence" loading="lazy">{% endif %}
                            <div class="dam-duplicate-reference-copy">
                                <span>Média existant : <strong>{{ item.reference.originalFilename }}</strong></span>
                                {% if item.reference_fiche %}
                                    <span class="dam-duplicate-fiche">
                                        Déjà présent sur
                                        <span class="badge badge-neutral">{{ item.reference_fiche.fiche_type|replace({'_': ' '}) }}</span>
                                        {% if item.reference_fiche.fiche_url %}
                                            <a class="text-link" href="{{ item.reference_fiche.fiche_url }}">{{ item.reference_fiche.fiche_label }}</a>
                                        {% else %}
                                            <strong>{{ item.reference_fiche.fiche_label }}</strong>
                                        {% endif %}
                                    </span>
                                {% else %}
                                    <span>La fiche d’origine n’est plus disponible.</span>
                                {% endif %}
                            </div>
                        </div>
                        {% if is_granted('ROLE_BP_VALIDATOR') %}
                            <div class="dam-actions">
                                {{ form_start(item.accept_form) }}{{ form_widget(item.accept_form) }}{{ form_end(item.accept_form) }}
                                {{ form_start(item.delete_form) }}{{ form_widget(item.delete_form) }}{{ form_end(item.delete_form) }}
                            </div>
                        {% endif %}
                    {% elseif filter starts with 'rights_' %}
                        <p>Source : {{ item.resource.source ?: 'Non renseignée' }} · Échéance : <strong>{{ item.resource.rightsExpiresAt ? item.resource.rightsExpiresAt|date('d/m/Y') : 'sans limite' }}</strong></p>
                        {% if item.resource.keywords %}<p>Mots-clés : {{ item.resource.keywords }}</p>{% endif %}
                        {% if is_granted('ROLE_BP_VALIDATOR') and item.rights_form is defined %}
                            {{ form_start(item.rights_form) }}{{ form_widget(item.rights_form) }}{{ form_end(item.rights_form) }}
                        {% elseif not item.resource.rightsGranted and item.resource.rightsExpiresAt %}
                            <p class="text-danger">Corrigez l’échéance dans la fiche avant de valider les droits.</p>
                        {% endif %}
                    {% elseif filter == 'failed' %}
                        <p class="text-danger">{{ item.asset.errorMessage ?: 'Le traitement DAM a échoué.' }}</p>
                        {{ form_start(item.retry_form) }}{{ form_widget(item.retry_form) }}{{ form_end(item.retry_form) }}
                    {% elseif filter == 'published_no_photo' %}
                        <p class="text-danger">Cette fiche publiée n’a aucune photo rattachée.</p>
                    {% elseif filter == 'published_rights' %}
                        <p class="text-danger">
                            {% if not item.resource.rightsGranted %}Les droits d’utilisation de cette photo n’ont pas été validés.{% else %}Les droits d’utilisation de cette photo ont expiré le {{ item.resource.rightsExpiresAt|date('d/m/Y') }}.{% endif %}
                            La fiche est publiée.
                        </p>
                        <p>Source : {{ item.resource.source ?: 'Non renseignée' }} · Échéance : <strong>{{ item.resource.rightsExpiresAt ? item.resource.rightsExpiresAt|date('d/m/Y') : 'sans limite' }}</strong></p>
                    {% elseif filter == 'orphans' %}
                        <p class="text-danger">Le média associé (référence <code>{{ item.resource.damAssetId }}</code>) est introuvable ou supprimé dans le DAM.</p>
                        <p>Détectée le <time datetime="{{ item.anomaly.detectedAt|date('c') }}">{{ item.anomaly.detectedAt|date('d/m/Y H:i') }}</time>.</p>
                    {% elseif filter == 'missing_renditions' %}
                        <p class="text-danger">Le média est marqué « traité » mais certaines variantes d’image manquent.</p>
                        <p>Détectée le <time datetime="{{ item.anomaly.detectedAt|date('c') }}">{{ item.anomaly.detectedAt|date('d/m/Y H:i') }}</time>.</p>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <div class="card empty-state">Aucune anomalie pour ce filtre.</div>
        {% endfor %}
    </section>
    {% endif %}

    {% if pages > 1 %}
        <nav class="pagination" aria-label="Pagination DAM">
            {% if page > 1 %}<a class="btn btn-secondary" href="{{ path(ecran_route, {filter: filter, type: type, page: page - 1}) }}">Précédent</a>{% endif %}
            <span>Page {{ page }} sur {{ pages }}</span>
            {% if page < pages %}<a class="btn btn-secondary" href="{{ path(ecran_route, {filter: filter, type: type, page: page + 1}) }}">Suivant</a>{% endif %}
        </nav>
    {% endif %}
