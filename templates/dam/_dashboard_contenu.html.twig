{#
    Contenu du DAM (écran Médias et supervision admin) — châssis maquette :
    cartes d'anomalies cliquables, barre filtres/résultat, liste des médias en
    cartes à vignette, pied de pagination. Toutes les fonctions du back sont
    conservées : arbitrage des doublons, validation des droits, relance des
    traitements, navigation par type de fiche.

    Variables : celles de DamDashboardProvider::page() (stats, items, filter,
    type, types, total, page, pages) + `ecran_route`.
#}
{% set ecran_route = ecran_route|default('app_dam_dashboard') %}
{% set media_tab = filter == 'images' or filter == 'documents' %}
{% set cartes_anomalies = {
    duplicates: ['Doublons', 'cube', 'Images identiques ou visuellement proches, à arbitrer.'],
    rights_missing: ['Droits non validés', 'lock', 'Sans droits déclarés, le média ne part sur aucun canal.'],
    rights_expiring: ['Droits à J-30', 'calendar', 'Les droits arrivent à échéance sous trente jours.'],
    rights_expired: ['Droits expirés', 'warning', 'L\'échéance est passée : diffusion à suspendre.'],
    failed: ['Traitements en échec', 'arrow-clockwise', 'La chaîne de traitement s\'est arrêtée — relançable.'],
    published_no_photo: ['Publiées sans photo', 'images', 'Des fiches publiées n\'ont aucune photo rattachée.'],
    published_rights: ['Droits invalides (publiées)', 'shield-check', 'Des fiches publiées portent des droits absents ou expirés.'],
    orphans: ['Ressources orphelines', 'magnifying-glass', 'La ressource pointe un média introuvable dans le DAM.'],
    missing_renditions: ['Variantes manquantes', 'desktop', 'Le média est traité mais des déclinaisons manquent.'],
} %}

{# ------------------------------------------------- Cartes d'anomalies #}
{% if not media_tab %}
    <div class="shrink-0 flex flex-row gap-4 flex-wrap" aria-label="Anomalies DAM">
        {% for cle, carte in cartes_anomalies %}
            {% set valeur = attribute(stats, cle) %}
            <a href="{{ path(ecran_route, { filter: cle, type: type }) }}"
               data-carte-anomalie="{{ cle }}"{{ filter == cle ? ' data-carte-active' : '' }}
               class="flex flex-col box-border gap-2 px-5 py-4 rounded-md bg-neutral-100 shadow-(--shadow)
                      flex-1 basis-64 min-w-0 text-left hover:bg-primary-5
                      {{ filter == cle ? 'inset-ring-2 inset-ring-primary' : '' }}">
                <div class="flex items-center gap-3">
                    <twig:Icon name="{{ carte.1 }}" aria-hidden="true"
                               class="shrink-0 w-5 h-5 {{ valeur > 0 ? 'text-error' : 'text-primary' }}" />
                    <twig:Typography variant="body-sm" bold ellipsis class="flex-1 min-w-0">{{ carte.0 }}</twig:Typography>
                    <span class="inline-flex shrink-0"><twig:Tag label="{{ valeur }}" size="sm"
                              variant="{{ valeur > 0 ? 'error' : 'success-pastel' }}" class="whitespace-nowrap" /></span>
                </div>
                <twig:Typography variant="body-xs" textColor="neutral-500" class="text-pretty">{{ carte.2 }}</twig:Typography>
            </a>
        {% endfor %}
    </div>
{% endif %}

{# ------------------------------------------------- Filtres et résultat #}
{% set filtre_libelles = {
    'images': 'Images', 'documents': 'Autres médias',
    'duplicates': 'Doublons', 'rights_missing': 'Droits non validés', 'rights_expiring': 'Droits à J-30',
    'rights_expired': 'Droits expirés', 'failed': 'Traitements en échec', 'published_no_photo': 'Publiées sans photo',
    'published_rights': 'Droits invalides (publiées)', 'orphans': 'Ressources orphelines', 'missing_renditions': 'Variantes manquantes',
} %}
<div class="shrink-0 flex items-center gap-3.5 flex-wrap px-5 py-3 rounded-sm bg-neutral-100 shadow-(--shadow)">
    <twig:Typography variant="subtitle" class="shrink-0 text-[0.9375rem]! leading-[1.375rem]! font-[700]!">
        {{- total }} résultat{{ total > 1 ? 's' : '' -}}
    </twig:Typography>
    <span class="w-px h-4 shrink-0 bg-neutral-200"></span>
    <span class="flex items-center gap-1.5 shrink-0 px-3 py-1 rounded-lg bg-primary-5">
        <twig:Typography variant="body-sm" textColor="neutral-500">File</twig:Typography>
        <twig:Typography variant="body-sm" bold textColor="primary-3">{{ filtre_libelles[filter] ?? filter }}</twig:Typography>
    </span>
    <div class="flex items-center gap-2 flex-wrap flex-1 min-w-0" aria-label="Sections du DAM">
        <a href="{{ path(ecran_route) }}"
           class="px-3 py-1 rounded-lg {{ not media_tab ? 'bg-linear-(--primary-gradient)' : 'bg-primary-5 hover:bg-primary-4' }}">
            <twig:Typography variant="body-sm" bold textColor="{{ not media_tab ? 'neutral-100' : 'primary-3' }}">Anomalies</twig:Typography>
        </a>
        <a href="{{ path(ecran_route, { filter: 'images' }) }}"
           class="px-3 py-1 rounded-lg {{ filter == 'images' ? 'bg-linear-(--primary-gradient)' : 'bg-primary-5 hover:bg-primary-4' }}">
            <twig:Typography variant="body-sm" bold textColor="{{ filter == 'images' ? 'neutral-100' : 'primary-3' }}">Images ({{ stats.images }})</twig:Typography>
        </a>
        <a href="{{ path(ecran_route, { filter: 'documents' }) }}"
           class="px-3 py-1 rounded-lg {{ filter == 'documents' ? 'bg-linear-(--primary-gradient)' : 'bg-primary-5 hover:bg-primary-4' }}">
            <twig:Typography variant="body-sm" bold textColor="{{ filter == 'documents' ? 'neutral-100' : 'primary-3' }}">Autres médias ({{ stats.documents }})</twig:Typography>
        </a>
    </div>
    {% if filter not in ['failed', 'orphans', 'missing_renditions'] and not media_tab %}
        <div class="flex items-center gap-2 flex-wrap shrink-0" aria-label="Filtrer par type de fiche">
            <a href="{{ path(ecran_route, { filter: filter }) }}"
               class="px-3 py-1 rounded-lg {{ type is null ? 'bg-linear-(--primary-gradient)' : 'bg-primary-5 hover:bg-primary-4' }}">
                <twig:Typography variant="body-sm" bold textColor="{{ type is null ? 'neutral-100' : 'primary-3' }}">Tous</twig:Typography>
            </a>
            {% for candidate in types %}
                <a href="{{ path(ecran_route, { filter: filter, type: candidate.value }) }}"
                   class="px-3 py-1 rounded-lg {{ type == candidate.value ? 'bg-linear-(--primary-gradient)' : 'bg-primary-5 hover:bg-primary-4' }}">
                    <twig:Typography variant="body-sm" bold textColor="{{ type == candidate.value ? 'neutral-100' : 'primary-3' }}">{{ candidate.value|replace({'_': ' '})|capitalize }}</twig:Typography>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>

{# ------------------------------------------------- Liste des médias #}
{% macro vignette(url, alt) %}
    <span class="shrink-0 w-[152px] h-[104px] box-border flex items-center justify-center rounded-xs
                 overflow-hidden bg-primary-5 inset-ring-1 inset-ring-neutral-300">
        {% if url %}
            <img src="{{ url }}" alt="{{ alt }}" class="w-full h-full object-cover" loading="lazy">
        {% else %}
            <twig:Icon name="images" class="w-7 h-7 text-neutral-400" />
        {% endif %}
    </span>
{% endmacro %}

<div class="shrink-0 flex flex-col gap-3" aria-label="{{ media_tab ? 'Médias' : 'Anomalies' }}">
    {% for item in items %}
        <article class="flex items-start gap-5 box-border px-[26px] py-5 rounded-md bg-neutral-100 shadow-(--shadow)">
            {{ _self.vignette(item.thumbnail, media_tab
                ? item.asset.originalFilename
                : (item.resource and item.resource.legende ? item.resource.legende : (item.asset ? item.asset.originalFilename : 'Média'))) }}

            <div class="flex flex-col flex-1 min-w-0 gap-2">
                <div class="flex items-center gap-2.5 flex-wrap">
                    {% if media_tab %}
                        <span class="inline-flex"><twig:Tag label="{{ item.asset.kind.value == 'image' ? 'Image' : 'Document' }}" variant="neutral" size="sm" /></span>
                        <twig:Typography variant="body" bold ellipsis class="min-w-0">{{ item.asset.originalFilename }}</twig:Typography>
                        <span class="inline-flex"><twig:Tag label="{{ item.asset.status.value }}"
                                  variant="{{ item.asset.status.value == 'failed' ? 'error' : 'primary-3' }}" size="sm" /></span>
                    {% else %}
                        <span class="inline-flex"><twig:Tag label="{{ item.fiche_type ? item.fiche_type|replace({'_': ' '}) : 'sans fiche' }}" variant="neutral" size="sm" /></span>
                        <twig:Typography variant="body" bold ellipsis class="min-w-0">
                            {{- item.resource ? (item.resource.legende ?: (item.asset ? item.asset.originalFilename : item.resource.usage)) : (item.asset ? item.asset.originalFilename : item.fiche_label) -}}
                        </twig:Typography>
                    {% endif %}
                    <span class="flex-1"></span>
                    {% if item.fiche_url %}
                        <twig:Button variant="outline" size="sm" asLink href="{{ item.fiche_url }}" class="shrink-0">Ouvrir {{ item.fiche_label }}</twig:Button>
                    {% endif %}
                </div>

                {% if media_tab %}
                    <twig:Typography variant="body-sm" textColor="neutral-500">
                        {{ item.asset.mimeType }} · {{ (item.asset.sizeBytes / 1024)|round }} Ko
                        · déposé le {{ item.asset.createdAt|date('d/m/Y H:i') }}
                        · {{ item.fiche_type ? 'rattaché à ' ~ (item.fiche_label ?? item.fiche_type) : 'rattaché à aucune fiche' }}
                    </twig:Typography>
                {% elseif filter == 'duplicates' %}
                    <twig:Typography variant="body-sm" bold>
                        {{- item.alert.kind.value == 'exact' ? 'Doublon exact' : 'Image visuellement proche' -}}
                        {%- if item.alert.distance is not null %} · distance {{ item.alert.distance }}{% endif -%}
                    </twig:Typography>
                    <div class="flex items-center gap-3 px-3 py-2.5 rounded-xs bg-primary-5">
                        {% if item.reference_thumbnail %}
                            <img src="{{ item.reference_thumbnail }}" alt="Média de référence" loading="lazy"
                                 class="shrink-0 w-[76px] h-[52px] rounded-xxs object-cover">
                        {% endif %}
                        <div class="flex flex-col gap-0.5 min-w-0">
                            <twig:Typography variant="body-sm">Média existant : <strong>{{ item.reference.originalFilename }}</strong></twig:Typography>
                            {% if item.reference_fiche %}
                                <twig:Typography variant="body-xs" textColor="neutral-500" element="span">
                                    Déjà présent sur {{ item.reference_fiche.fiche_type|replace({'_': ' '}) }} ·
                                    {% if item.reference_fiche.fiche_url %}
                                        <a href="{{ item.reference_fiche.fiche_url }}" class="font-[900] text-primary-3 hover:underline">{{ item.reference_fiche.fiche_label }}</a>
                                    {% else %}
                                        <strong>{{ item.reference_fiche.fiche_label }}</strong>
                                    {% endif %}
                                </twig:Typography>
                            {% else %}
                                <twig:Typography variant="body-xs" textColor="neutral-500">La fiche d’origine n’est plus disponible.</twig:Typography>
                            {% endif %}
                        </div>
                    </div>
                    {% if is_granted('ROLE_BP_VALIDATOR') %}
                        <div class="flex items-center gap-2 flex-wrap [&_form]:contents [&_button]:w-auto!">
                            {{ form_start(item.accept_form) }}{{ form_widget(item.accept_form) }}{{ form_end(item.accept_form) }}
                            {{ form_start(item.delete_form) }}{{ form_widget(item.delete_form) }}{{ form_end(item.delete_form) }}
                        </div>
                    {% endif %}
                {% elseif filter starts with 'rights_' %}
                    <twig:Typography variant="body-sm" textColor="neutral-500">
                        Source : {{ item.resource.source ?: 'Non renseignée' }} ·
                        Échéance : <strong>{{ item.resource.rightsExpiresAt ? item.resource.rightsExpiresAt|date('d/m/Y') : 'sans limite' }}</strong>
                        {%- if item.resource.keywords %} · Mots-clés : {{ item.resource.keywords }}{% endif %}
                    </twig:Typography>
                    {% if is_granted('ROLE_BP_VALIDATOR') and item.rights_form is defined %}
                        <div class="[&_form]:flex [&_form]:flex-wrap [&_form]:items-end [&_form]:gap-3 [&_button]:w-auto!">
                            {{ form_start(item.rights_form) }}{{ form_widget(item.rights_form) }}{{ form_end(item.rights_form) }}
                        </div>
                    {% elseif not item.resource.rightsGranted and item.resource.rightsExpiresAt %}
                        <twig:Typography variant="body-sm" textColor="error">Corrigez l’échéance dans la fiche avant de valider les droits.</twig:Typography>
                    {% endif %}
                {% elseif filter == 'failed' %}
                    <twig:Typography variant="body-sm" textColor="error">{{ item.asset.errorMessage ?: 'Le traitement DAM a échoué.' }}</twig:Typography>
                    <div class="[&_form]:contents [&_button]:w-auto!">
                        {{ form_start(item.retry_form) }}{{ form_widget(item.retry_form) }}{{ form_end(item.retry_form) }}
                    </div>
                {% elseif filter == 'published_no_photo' %}
                    <twig:Typography variant="body-sm" textColor="error">Cette fiche publiée n’a aucune photo rattachée.</twig:Typography>
                {% elseif filter == 'published_rights' %}
                    <twig:Typography variant="body-sm" textColor="error">
                        {% if not item.resource.rightsGranted %}Les droits d’utilisation de cette photo n’ont pas été validés.{% else %}Les droits d’utilisation de cette photo ont expiré le {{ item.resource.rightsExpiresAt|date('d/m/Y') }}.{% endif %}
                        La fiche est publiée.
                    </twig:Typography>
                    <twig:Typography variant="body-sm" textColor="neutral-500">
                        Source : {{ item.resource.source ?: 'Non renseignée' }} ·
                        Échéance : <strong>{{ item.resource.rightsExpiresAt ? item.resource.rightsExpiresAt|date('d/m/Y') : 'sans limite' }}</strong>
                    </twig:Typography>
                {% elseif filter == 'orphans' %}
                    <twig:Typography variant="body-sm" textColor="error">Le média associé (référence {{ item.resource.damAssetId }}) est introuvable ou supprimé dans le DAM.</twig:Typography>
                    <twig:Typography variant="body-sm" textColor="neutral-500">Détectée le {{ item.anomaly.detectedAt|date('d/m/Y H:i') }}.</twig:Typography>
                {% elseif filter == 'missing_renditions' %}
                    <twig:Typography variant="body-sm" textColor="error">Le média est marqué « traité » mais certaines variantes d’image manquent.</twig:Typography>
                    <twig:Typography variant="body-sm" textColor="neutral-500">Détectée le {{ item.anomaly.detectedAt|date('d/m/Y H:i') }}.</twig:Typography>
                {% endif %}
            </div>
        </article>
    {% else %}
        <div class="flex items-center gap-3 px-[26px] py-6 rounded-md bg-neutral-100 shadow-(--shadow)">
            <twig:Icon name="ok-circle" aria-hidden="true" class="shrink-0 w-6 h-6 text-success" />
            <twig:Typography variant="body-sm" textColor="neutral-500">
                {{- media_tab ? 'Aucun média dans cette catégorie.' : 'Aucune anomalie pour ce filtre.' -}}
            </twig:Typography>
        </div>
    {% endfor %}

    {# ------------------------------------------------- Pied de pagination #}
    <div class="flex items-center gap-3 px-1 pt-1">
        <twig:Typography variant="body-sm" textColor="neutral-500">
            {{- items|length }} élément{{ items|length > 1 ? 's' : '' }} affiché{{ items|length > 1 ? 's' : '' }} · page {{ page }} sur {{ max(pages, 1) -}}
        </twig:Typography>
        <span class="flex-1"></span>
        {% if page > 1 %}
            <twig:Button variant="text" size="sm" asLink class="bg-neutral-100! inset-ring-1 inset-ring-neutral-200 rounded-full!"
                         href="{{ path(ecran_route, { filter: filter, type: type, page: page - 1 }) }}">Précédent</twig:Button>
        {% endif %}
        {% if page < pages %}
            <twig:Button variant="text" size="sm" asLink class="bg-neutral-100! inset-ring-1 inset-ring-neutral-200 rounded-full!"
                         href="{{ path(ecran_route, { filter: filter, type: type, page: page + 1 }) }}">Suivant</twig:Button>
        {% endif %}
    </div>
</div>
