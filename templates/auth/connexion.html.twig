{# Maquette : S1 · Connexion V1 — Desktop (nœud Figma 36:1455) #}
{% extends 'auth/base.html.twig' %}

{% block title %}Identifiez-vous{% endblock %}

{# Seul écran du groupe à espacer ses blocs de 40 px. #}
{% block classe_panneau %}gap-10{% endblock %}

{% block panneau %}
    <div class="flex flex-col items-center self-stretch shrink-0 gap-6">
        <twig:Badge icon="user" class="w-16" />

        <div class="flex flex-col items-center self-stretch shrink-0 gap-1">
            <twig:Typography variant="heading-1" element="h1" center
                             class="self-stretch font-[700]!">Identifiez-vous</twig:Typography>
            <twig:Typography variant="body-lg" element="p" center class="self-stretch">
                Renseignez votre adresse mail professionnel pour vous connecter ou pour vous créer un compte.
            </twig:Typography>
        </div>

        <form class="flex flex-col items-stretch self-stretch shrink-0 gap-4" method="post" action="">
            {{ _self.champ('Email', 'email', 'Votre e-mail professionnel', 'email', 'email') }}
            <twig:Button variant="primary" size="lg" full>Continuer</twig:Button>
        </form>
    </div>

    <hr class="self-stretch w-full h-px border-0 bg-neutral-200">

    <div class="flex flex-col items-start self-stretch shrink-0 gap-8">
        <div class="flex flex-col items-start self-stretch shrink-0 gap-1">
            <twig:Typography variant="heading-3" element="h2" center
                             class="self-stretch font-[700]!">Besoin d’accompagnement ?</twig:Typography>
            <twig:Typography variant="body" element="p" center
                             class="self-stretch">Notre équipe est là pour vous aider !</twig:Typography>
        </div>

        {# Action de contact : la destination reste à définir (page, mailto…). #}
        <twig:Button variant="outline" size="lg" full type="button">Contactez notre support</twig:Button>
    </div>
{% endblock %}

{#
    ÉCART : sur « Connexion » et « Mot de passe » ce libellé est en blanc dans
    la maquette — donc invisible sur la carte blanche. « Mot de passe oublié »
    l'affiche en neutral-900 ; on retient cette valeur, cohérente et lisible.
#}
{% macro champ(libelle, nom, indication, type, autocomplete) %}
    <div class="flex flex-col gap-1 self-stretch">
        <twig:Typography variant="body" element="label" for="champ-{{ nom }}">{{ libelle }}*</twig:Typography>
        <twig:Form:TextInput id="champ-{{ nom }}" name="{{ nom }}" placeholder="{{ indication }}"
                             inputAttributes="{{ { type: type, autocomplete: autocomplete, required: 'required' } }}" />
    </div>
{% endmacro %}
