{# Maquette : S1 · Mot de passe — Desktop (nœud Figma 74:1914) #}
{% extends 'auth/base.html.twig' %}

{% block title %}Connectez-vous{% endblock %}

{# Surchargé par « mot de passe — user défaut », qui affiche l'avatar générique. #}
{% block avatar_compte %}<twig:Badge pictureUrl="{{ asset('images/auth/avatar-user.png') }}"
                                     pictureText="Photo de profil" class="w-18" />{% endblock %}

{% block panneau %}
    <div class="flex flex-col items-center self-stretch shrink-0 gap-6">
        <twig:Typography variant="heading-1" element="h1" center
                         class="self-stretch font-[700]!">Connectez-vous</twig:Typography>

        <div class="flex flex-col items-center shrink-0 gap-2">
            {{ block('avatar_compte') }}

            <twig:Typography variant="body" element="p" bold center
                             class="w-[267px]">contact@businessprofilers.fr</twig:Typography>

            <twig:Button asLink variant="outline" size="lg"
                         href="{{ path('app_auth_connexion') }}">Utiliser un autre compte</twig:Button>
        </div>
    </div>

    <form class="flex flex-col items-stretch self-stretch shrink-0 gap-4" method="post" action="">
        <div class="flex flex-col gap-1 self-stretch">
            <twig:Typography variant="body" element="label"
                             for="champ-password">Saisissez votre mot de passe*</twig:Typography>
            <twig:Form:Password id="champ-password" name="password"
                                placeholder="Saisissez votre mot de passe"
                                autocomplete="current-password" required />
        </div>

        {# ÉCART : rendu comme un lien réel (la maquette l'affiche en texte simple). #}
        <a class="self-stretch text-neutral-900 no-underline hover:text-primary-3 hover:underline
                  focus-visible:text-primary-3 focus-visible:underline"
           href="{{ path('app_auth_mot_de_passe_oublie') }}">
            <twig:Typography variant="body-lg" textColor="controlled">Mot de passe oublié ?</twig:Typography>
        </a>

        <twig:Button variant="primary" size="lg" full>Se connecter</twig:Button>
    </form>
{% endblock %}
