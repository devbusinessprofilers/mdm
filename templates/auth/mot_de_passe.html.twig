{# Maquette : S1 · Mot de passe — Desktop (nœud Figma 74:1914) #}
{% extends 'auth/base.html.twig' %}
{% import 'auth/_composants.html.twig' as ui %}

{% block title %}Connectez-vous{% endblock %}

{% block classe_carte %}auth-card--mot-de-passe{% endblock %}

{# Surchargé par « mot de passe — user défaut », qui affiche l'avatar générique. #}
{% block avatar_compte %}{{ ui.avatar('photo', 72) }}{% endblock %}

{% block panneau %}
    <div class="auth-header">
        <h1 class="auth-title">Connectez-vous</h1>

        <div class="auth-account">
            {{ block('avatar_compte') }}

            <p class="auth-account__mail">contact@businessprofilers.fr</p>

            {{ ui.bouton('Utiliser un autre compte', {
                style: 'outline',
                size: 'lg',
                href: path('app_auth_connexion')
            }) }}
        </div>
    </div>

    <form class="auth-form" method="post" action="">
        {{ ui.champ('Saisissez votre mot de passe', 'password', {
            type: 'password',
            placeholder: 'Saisissez votre mot de passe',
            autocomplete: 'current-password',
            required: true,
            toggle: true
        }) }}

        <a class="auth-link" href="{{ path('app_auth_mot_de_passe_oublie') }}">Mot de passe oublié ?</a>

        {{ ui.bouton('Se connecter', { style: 'primary', size: 'lg', block: true }) }}
    </form>
{% endblock %}
