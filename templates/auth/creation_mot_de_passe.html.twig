{# Maquette : S1 · Création du mot de passe — Desktop (nœud Figma 74:2093) #}
{% extends 'auth/base.html.twig' %}

{% block title %}Création de votre mot de passe{% endblock %}

{% block panneau %}
    <div class="flex flex-col items-center self-stretch shrink-0 gap-6">
        <twig:Badge icon="lock" class="w-16" />

        <div class="flex flex-col items-center self-stretch shrink-0 gap-1">
            <twig:Typography variant="heading-1" element="h1" center
                             class="self-stretch font-[700]!">Création de votre<br>mot de passe</twig:Typography>
            <twig:Typography variant="body-lg" element="p" center
                             class="self-stretch">Remplissez les informations pour finaliser votre inscription.</twig:Typography>
        </div>
    </div>

    <form class="flex flex-col items-stretch self-stretch shrink-0 gap-4" method="post" action="">
        {#
            `withControl` remplace la jauge et les cinq règles de la maquette :
            le composant du portail les calcule à la frappe, là où la maquette
            n'en montrait qu'un état figé.
        #}
        <div class="flex flex-col gap-1 self-stretch">
            <twig:Typography variant="body" element="label"
                             for="champ-password">Nouveau mot de passe*</twig:Typography>
            <twig:Form:Password id="champ-password" name="password" withControl
                                placeholder="Mot de passe" autocomplete="new-password" required />
        </div>

        <div class="flex flex-col gap-1 self-stretch">
            <twig:Typography variant="body" element="label"
                             for="champ-password_confirmation">Confirmation du nouveau mot de passe*</twig:Typography>
            <twig:Form:Password id="champ-password_confirmation" name="password_confirmation"
                                placeholder="Confirmation du nouveau mot de passe"
                                autocomplete="new-password" required />
        </div>

        <twig:Button variant="primary" size="lg" full>Se connecter</twig:Button>
    </form>
{% endblock %}
