{# ----------------------------------------------------------------- Avatars #}

{#  type : 'defaut' | 'photo'   —   taille en px (32 par défaut dans la maquette) #}
{% macro avatar(type = 'defaut', taille = 32) %}
    {% import _self as ui %}
    {% if type == 'photo' %}
        <span class="bp-avatar bp-avatar--photo auth-avatar-photo"
              style="--bp-avatar-size: {{ taille }}px"
              role="img"
              aria-label="Photo de profil"></span>
    {% else %}
        <span class="bp-avatar bp-avatar--defaut" style="--bp-avatar-size: {{ taille }}px" aria-hidden="true">
            <span class="bp-avatar__icon">{{ ui.icone_utilisateur() }}</span>
        </span>
    {% endif %}
{% endmacro %}

{% macro pastille_cadenas() %}
    {% import _self as ui %}
    <span class="bp-iconcircle" aria-hidden="true">{{ ui.icone_cadenas() }}</span>
{% endmacro %}

{# ----------------------------------------------------------------- Boutons #}

{#
    options :
      style    'primary' (défaut) | 'outline' | 'text'
      size     'lg' (défaut) | 'sm'
      block    true pour occuper toute la largeur
      href     rend un <a> au lieu d'un <button>
      type     type du <button> (submit par défaut)
      disabled true
#}
{% macro bouton(libelle, options = {}) %}
    {% set style = options.style|default('primary') %}
    {% set size = options.size|default('lg') %}
    {% set classes = [
        'bp-btn',
        'bp-btn--' ~ style,
        'bp-btn--' ~ size,
        options.block|default(false) ? 'bp-btn--block' : ''
    ]|filter(c => c is not empty)|join(' ') %}

    {% if options.href is defined %}
        <a class="{{ classes }}" href="{{ options.href }}">{{ libelle }}</a>
    {% else %}
        <button class="{{ classes }}"
                type="{{ options.type|default('submit') }}"
                {{ options.disabled|default(false) ? 'disabled' : '' }}>{{ libelle }}</button>
    {% endif %}
{% endmacro %}

{# ------------------------------------------------------------------ Champs #}

{#
    options :
      type        'text' (défaut) | 'email' | 'password'
      placeholder texte indicatif
      required    true → ajoute l'astérisque et l'attribut HTML
      autocomplete
      toggle      true → bouton œil d'affichage du mot de passe
#}
{% macro champ(libelle, nom, options = {}) %}
    {% import _self as ui %}
    {% set id = 'champ-' ~ nom %}
    <div class="bp-field">
        <label class="bp-field__label" for="{{ id }}">{{ libelle }}{{ options.required|default(false) ? '*' : '' }}</label>
        <div class="bp-field__control"{{ options.toggle|default(false) ? ' data-controller=bp-password'|raw : '' }}>
            <input class="bp-field__input"
                   id="{{ id }}"
                   name="{{ nom }}"
                   type="{{ options.type|default('text') }}"
                   {% if options.toggle|default(false) %}data-bp-password-target="input"{% endif %}
                   {% if options.placeholder is defined %}placeholder="{{ options.placeholder }}"{% endif %}
                   {% if options.autocomplete is defined %}autocomplete="{{ options.autocomplete }}"{% endif %}
                   {{ options.required|default(false) ? 'required' : '' }}>
            {% if options.toggle|default(false) %}
                <button class="bp-field__toggle"
                        type="button"
                        data-action="bp-password#toggle"
                        data-bp-password-target="bouton"
                        aria-label="Afficher le mot de passe">{{ ui.icone_oeil() }}</button>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{# -------------------------------------------------------------------- Tags #}

{#  etat : 'valide' (vert pâle) | 'attente' (gris) #}
{% macro regle(libelle, etat = 'attente') %}
    {% import _self as ui %}
    <li class="bp-tag {{ etat == 'valide' ? 'bp-tag--vert-pale' : 'bp-tag--gris' }}">
        <span class="bp-tag__icon">{{ ui.icone_coche() }}</span>
        <span>{{ libelle }}</span>
    </li>
{% endmacro %}

{# ------------------------------------------------------- Jauge de robustesse #}

{#  niveau : pourcentage 0-100   —   force : 'faible' | 'moyen' | 'fort' #}
{% macro jauge(niveau = 0, force = 'moyen') %}
    <div class="bp-strength bp-strength--{{ force }}">
        <div class="bp-strength__track"
             role="progressbar"
             aria-label="Robustesse du mot de passe"
             aria-valuenow="{{ niveau }}"
             aria-valuemin="0"
             aria-valuemax="100">
            <span class="bp-strength__fill" style="--bp-strength-level: {{ niveau }}%"></span>
        </div>
    </div>
{% endmacro %}
