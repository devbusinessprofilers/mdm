{% extends 'base.html.twig' %}

{% block title %}
    {{ 'page.login.title'|trans }}
{% endblock %}

{% block content %}
    <div class="max-w-xs w-full flex flex-col items-center justify-center gap-10">
        <div class="flex flex-col items-center justify-center gap-4 lg:gap-6">
            <twig:Badge class="w-16" />
            <div class="flex flex-col gap-1">
                <h1><twig:Typography variant="heading-1" bold center>{{ 'page.login.title'|trans }}</twig:Typography></h1>
                <p><twig:Typography center>{{ 'page.login.description'|trans }}</twig:Typography></p>
            </div>
            {{ form_start(form, {'attr': {'class': 'w-full flex flex-col gap-2 lg:gap-4'}}) }}
            {{ form_end(form) }}
        </div>

        <div class="pt-10 border-t border-neutral-300 w-full flex flex-col items-center justify-center gap-6 lg:gap-8">
            <div class="flex flex-col gap-1">
                <h2><twig:Typography variant="heading-3" bold center>{{ 'page.login.contact.title'|trans }}</twig:Typography></h2>
                <p><twig:Typography center>{{ 'page.login.contact.description'|trans }}</twig:Typography></p>
            </div>
            <twig:Button asLink href="{{ path('provider_portal_index') }}" variant="outline" icon="phone" full>{{ 'page.login.contact.cta'|trans }}</twig:Button>
        </div>
    </div>
{% endblock %}

