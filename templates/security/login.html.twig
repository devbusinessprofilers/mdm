{% extends 'base.html.twig' %}

{% block title %}Connexion | MDM Business Profilers{% endblock %}

{% block body %}
    <main class="login-page">
        <section class="login-card" aria-labelledby="login-title">
            <p class="eyebrow">Business Profilers</p>
            <h1 id="login-title">Connexion au MDM</h1>
            <p class="login-intro">Accédez au référentiel PIM et DAM.</p>

            {% if authentication_error %}
                <div class="alert" role="alert">Identifiants invalides.</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <label for="email">Adresse email</label>
                <input
                    id="email"
                    name="email"
                    type="email"
                    value="{{ last_username }}"
                    autocomplete="username"
                    required
                    autofocus
                >

                <label for="password">Mot de passe</label>
                <input
                    id="password"
                    name="password"
                    type="password"
                    autocomplete="current-password"
                    required
                >

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit">Se connecter</button>
            </form>
        </section>
    </main>
{% endblock %}
