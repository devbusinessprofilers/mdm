{% extends 'auth/base.html.twig' %}

{% block title %}Connexion | MDM Business Profilers{% endblock %}

{% block classe_panneau %}gap-8{% endblock %}

{% block panneau %}
    <div class="flex flex-col items-center self-stretch shrink-0 gap-6">
        <twig:Badge icon="user" class="w-16" />

        <div class="flex flex-col items-center self-stretch shrink-0 gap-1">
            <twig:Typography variant="heading-1" element="h1" center class="self-stretch font-[700]!">
                Connexion au MDM
            </twig:Typography>
            <twig:Typography variant="body-lg" element="p" center class="self-stretch">
                Accédez au référentiel PIM et à la médiathèque.
            </twig:Typography>
        </div>

        {% if authentication_error %}
            <twig:Alert icon="cross-circle" role="alert" class="self-stretch">Identifiants invalides.</twig:Alert>
        {% endif %}

        <div class="self-stretch">{{ form(login_form) }}</div>

        <a href="{{ path('app_account_password_forgot') }}">
            <twig:Typography variant="body-sm" textColor="primary-3" bold>Mot de passe oublié ?</twig:Typography>
        </a>
    </div>
{% endblock %}
