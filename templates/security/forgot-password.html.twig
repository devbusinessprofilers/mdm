{% extends 'security/_layout.html.twig' %}

{% block title %}
    {{ 'page.forgot_password.title'|trans }}
{% endblock %}

{% block content %}
    <div class="max-w-xs w-full flex flex-col items-center justify-center gap-4 lg:gap-6">
        <twig:Badge icon="lock" class="w-16" />
        <div class="flex flex-col gap-1">
            <h1><twig:Typography variant="heading-1" bold center>{{ 'page.forgot_password.title'|trans }}</twig:Typography></h1>
            <p><twig:Typography center>{{ 'page.forgot_password.description'|trans }}</twig:Typography></p>
        </div>

        {{ form_start(form, {'attr': {'class': 'w-full flex flex-col gap-2 lg:gap-4'}}) }}
        {{ form_end(form) }}
    </div>
{% endblock %}

