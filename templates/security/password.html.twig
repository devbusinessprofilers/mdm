{#
    Maquette : S1 · Mot de passe — user défaut (nœud Figma 392:24354), seconde
    étape du parcours : les comptes n'ont pas de photo, l'avatar générique
    remplace le portrait de l'écran « Mot de passe » (74:1914).

    Le formulaire poste vers /connexion (check_path du form_login) : le champ
    caché `email` porte l'identifiant retenu à l'étape précédente.
#}
{% extends 'auth/base.html.twig' %}
{% form_theme password_form 'pim/form/_form-theme-auth.html.twig' %}

{% block title %}Connectez-vous{% endblock %}

{% block panneau %}
    <div class="flex flex-col items-center self-stretch shrink-0 gap-6">
        <twig:Typography variant="heading-1" element="h1" center
                         class="self-stretch font-[700]!">Connectez-vous</twig:Typography>

        <div class="flex flex-col items-center shrink-0 gap-2">
            <twig:Badge icon="user" class="w-18" />

            <twig:Typography variant="body" element="p" bold center
                             class="w-[267px] break-words">{{ email }}</twig:Typography>

            <twig:Button asLink variant="outline" size="lg"
                         href="{{ path('app_login') }}">Utiliser un autre compte</twig:Button>
        </div>
    </div>

    {% if authentication_error %}
        <twig:Alert icon="cross-circle" role="alert" class="self-stretch">Identifiants invalides.</twig:Alert>
    {% endif %}

    {{ form_start(password_form, { attr: { class: 'flex flex-col items-stretch self-stretch shrink-0 gap-4' } }) }}
        {{ form_row(password_form.password) }}

        {# ÉCART : la maquette l'affiche en texte simple ; rendu comme un vrai lien. #}
        <a class="self-stretch text-neutral-900 no-underline hover:text-primary-3 hover:underline
                  focus-visible:text-primary-3 focus-visible:underline"
           href="{{ path('app_account_password_forgot') }}">
            <twig:Typography variant="body-lg" textColor="controlled">Mot de passe oublié ?</twig:Typography>
        </a>

        {{ form_row(password_form.submit) }}
    {{ form_end(password_form) }}
{% endblock %}
