{% extends 'security/_layout.html.twig' %}

{% block title %}
    {{ 'page.enter_password.title'|trans }}
{% endblock %}

{% block content %}
    <div class="max-w-xs w-full flex flex-col items-center justify-center gap-4 lg:gap-6">
        <h1><twig:Typography variant="heading-1" bold center>{{ 'page.enter_password.title'|trans }}</twig:Typography></h1>
        <div class="flex flex-col items-center justify-center gap-2">
            <twig:Badge icon="user" class="w-18" />
            <twig:Typography variant="body" bold>{{ currentUserEmail }}</twig:Typography>
            <twig:Button variant="outline">{{ 'page.enter_password.other_account'|trans }}</twig:Button>
        </div>
        {{ form_start(form, {'attr': {'class': 'w-full flex flex-col gap-4'}}) }}
        <div class="w-full flex flex-col gap-1">
            {{ form_row(form.password) }}
            <twig:Typography variant="body-xs" underline>
                <a href="{{ path('provider_portal_forgot_password') }}">{{ 'page.enter_password.forgotten_password'|trans }}</a>
            </twig:Typography>
        </div>
            {{ form_row(form.submit) }}
        {{ form_end(form) }}
    </div>
{% endblock %}

