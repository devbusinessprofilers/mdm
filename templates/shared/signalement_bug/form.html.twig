{% extends 'mdm/simple.html.twig' %}
{% block title %}Signaler un bug{% endblock %}
{% block corps %}
{# Écran à but unique : colonne étroite centrée dans la zone de contenu,
   plutôt que le gabarit page/carte calé à gauche des écrans d'admin. #}
<main class="page w-full max-w-[560px] mx-auto my-auto py-6">
    <header class="flex flex-col items-center gap-3 text-center">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-error-pastel">
            <twig:Icon name="warning" aria-hidden="true" class="w-6 h-6 text-error" />
        </div>
        <div class="flex flex-col gap-1">
            <h1>Signaler un bug</h1>
            <p class="page-description">Décrivez le problème rencontré : votre signalement est transmis directement à l'équipe technique.</p>
        </div>
    </header>
    <section class="card">
        {{ form(form, {attr: {class: 'flex flex-col gap-5'}}) }}
    </section>
</main>
{% endblock %}
