# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

###> doctrine/doctrine-bundle ###
# Symfony ne charge pas .env.local en env test : la DSN conteneur vit ici.
# DB_USER/DB_PASSWORD/DB_HOST viennent de l'environnement du conteneur php
# (env_file .env racine + DB_HOST=sql dans docker-compose) et priment sur les
# défauts. Doctrine ajoute le suffixe _test (config/packages/doctrine.yaml)
# => base mdm_test.
DATABASE_URL="mysql://${DB_USER:-mdm}:${DB_PASSWORD:-mdm_dev_change_me}@${DB_HOST:-sql}:3306/mdm?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
