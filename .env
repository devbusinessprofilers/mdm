###> Google Cloud Translation Basic v2 ###
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_ENDPOINT=https://translation.googleapis.com/language/translate/v2
###< Google Cloud Translation Basic v2 ###

###> Observabilité / alertes ###
# Jeton Bearer de /metrics — vide = endpoint désactivé (404).
METRICS_TOKEN=
# Destinataire des alertes applicatives — vide = alertes désactivées.
ALERT_EMAIL_TO=
# Seuil de la queue failed au-delà duquel une alerte est envoyée.
ALERT_FAILED_QUEUE_THRESHOLD=5
###< Observabilité / alertes ###

###> Relances de complétude ###
# Score global en dessous duquel une fiche est relancée (0 = désactivé).
COMPLETENESS_REMINDER_THRESHOLD=60
# Délai minimal entre deux relances d'une même fiche, en jours.
COMPLETENESS_REMINDER_COOLDOWN_DAYS=30
# Envoi automatique du lot préparé (lundi 14h). 0 = envoi manuel uniquement.
COMPLETENESS_REMINDER_ENABLED=1
###< Relances de complétude ###

###> Réglages métier (défauts des paramètres surchargeables dans /admin/parametres) ###
# Obligations photos à la soumission et à la diffusion, par type de fiche.
PHOTOS_MIN_LIEU=4
PHOTOS_MAX_LIEU=25
PHOTOS_MIN_AUTRES=1
PHOTOS_MAX_AUTRES=10
# Contraintes d'upload des images (poids en Mo, dimensions minimales en px).
DAM_IMAGE_MAX_MB=25
DAM_IMAGE_MIN_WIDTH=960
DAM_IMAGE_MIN_HEIGHT=480
# Poids maximum des documents (Mo) : supports commerciaux et autres usages.
DAM_DOCUMENT_MAX_MB=10
DAM_COMMERCIAL_SUPPORT_MAX_MB=100
# Délai d'alerte avant l'échéance des droits d'une ressource, en jours.
DAM_RIGHTS_ALERT_DAYS=30
# Limites des PDF soumis à l'extraction documentaire.
OCR_PDF_MAX_MB=50
OCR_PDF_MAX_PAGES=100
# Seuil de confiance (%) d'application automatique des suggestions OCR ;
# 0 = arbitrage manuel uniquement. Surchargeable dans /admin/parametres.
OCR_AUTO_APPLY_THRESHOLD=0
# Comptes internes : validités des liens, purge des jetons, mot de passe.
ACCOUNT_INVITATION_VALIDITY_HOURS=24
ACCOUNT_RESET_VALIDITY_HOURS=1
ACCOUNT_TOKEN_PURGE_DAYS=30
ACCOUNT_PASSWORD_MIN_LENGTH=12
# Destinataires maximum des demandes d'affiliation d'une fiche.
ACCOUNT_MAX_REQUEST_RECIPIENTS=3
###< Réglages métier ###

###> Rate limiting ###
# Requêtes /api/v1/* par minute et par client JWT (claim sub).
RATE_LIMIT_API_CLIENT=300
# Requêtes /api/v1/* par minute et par IP (repli sans token).
RATE_LIMIT_API_IP=60
# Requêtes par heure et par IP sur les pages publiques (/invitation/*, /mot-de-passe-oublie).
RATE_LIMIT_PUBLIC_IP=30
###< Rate limiting ###

###> Box AI Structured Extract ###
BOX_OCR_ENABLED=0
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_SUBJECT_TYPE=enterprise
BOX_SUBJECT_ID=
BOX_FOLDER_ID=0
BOX_API_URL=https://api.box.com
BOX_UPLOAD_URL=https://upload.box.com/api
BOX_ENHANCED_EXTRACT_AGENT=enhanced_extract_agent
###< Box AI Structured Extract ###

###> Marketplace (création des comptes collaborateurs) ###
# URL vide : l'invitation est journalisée et ignorée (poste de dev).
MARKETPLACE_API_URL=
MARKETPLACE_API_TOKEN=
###< Marketplace ###

###> Marketplace (synchronisation des fiches) ###
# Compte machine ROLE_PIM de la marketplace (JWT Lexik via /api/login_check).
# URL vide : la diffusion est désactivée pour l'environnement. Valeurs par
# environnement (local via docker marketplace / test / preprod / prod) dans
# .env.local ou les variables Upsun.
# En local : MARKETPLACE_SYNC_API_URL=http://host.docker.internal:7080
MARKETPLACE_SYNC_API_URL=
MARKETPLACE_SYNC_API_LOGIN=
MARKETPLACE_SYNC_API_PASSWORD=
###< Marketplace (synchronisation des fiches) ###

###> Salesforce (refresh des données fiche) ###
# Connected App Salesforce, OAuth JWT Bearer (RS256). Vide = refresh désactivé.
# LOGIN_URL : https://login.salesforce.com (prod) ou https://test.salesforce.com.
# PRIVATE_KEY : clé privée PEM de la Connected App, « \n » littéraux acceptés.
# Secrets dans .env.local / variables Upsun — voir docs/SECRETS.md.
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_USERNAME=
SALESFORCE_PRIVATE_KEY=
# Jeton Bearer du webhook entrant POST /api/salesforce/produits (notification
# des produits modifiés, refresh ciblé asynchrone). Vide = webhook désactivé (404).
SALESFORCE_WEBHOOK_TOKEN=
###< Salesforce (refresh des données fiche) ###
