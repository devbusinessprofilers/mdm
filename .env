# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
AUDIT_ENABLED=1
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:6080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://mdm:mdm_dev_change_me@127.0.0.1:3306/mdm?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=noreply@businessprofilers.fr
INVITATION_SIGNING_KEY=
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> external site JWT ###
EXTERNAL_SITE_JWT_ISSUER=external-site
EXTERNAL_SITE_JWT_AUDIENCE=mdm
EXTERNAL_SITE_JWT_SUBJECT=external-site
EXTERNAL_SITE_JWT_PUBLIC_KEY=
###< external site JWT ###

###> OVH Object Storage ###
S3_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net
S3_REGION=eu-west-par
S3_PRIVATE_BUCKET=bp-dam-originals
S3_PUBLIC_BUCKET=bp-dam-public
S3_PUBLIC_BASE_URL=https://bp-dam-public.s3.eu-west-par.io.cloud.ovh.net
S3_PREFIX=dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
###< OVH Object Storage ###

###> Google Cloud Translation Basic v2 ###
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_ENDPOINT=https://translation.googleapis.com/language/translate/v2
###< Google Cloud Translation Basic v2 ###

###> Observabilité / alertes ###
# Jeton Bearer de /metrics — vide = endpoint désactivé (404).
METRICS_TOKEN=
# Destinataire des alertes applicatives — vide = alertes désactivées.
ALERT_EMAIL_TO=
# Seuil de la queue failed au-delà duquel une alerte est envoyée.
ALERT_FAILED_QUEUE_THRESHOLD=5
###< Observabilité / alertes ###

###> Relances de complétude ###
# Score global en dessous duquel une fiche est relancée (0 = désactivé).
COMPLETENESS_REMINDER_THRESHOLD=60
# Délai minimal entre deux relances d'une même fiche, en jours.
COMPLETENESS_REMINDER_COOLDOWN_DAYS=30
###< Relances de complétude ###

###> Rate limiting ###
# Requêtes /api/v1/* par minute et par client JWT (claim sub).
RATE_LIMIT_API_CLIENT=300
# Requêtes /api/v1/* par minute et par IP (repli sans token).
RATE_LIMIT_API_IP=60
# Requêtes par heure et par IP sur les pages publiques (/invitation/*, /mot-de-passe-oublie).
RATE_LIMIT_PUBLIC_IP=30
###< Rate limiting ###

###> Box AI Structured Extract ###
BOX_OCR_ENABLED=0
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_SUBJECT_TYPE=enterprise
BOX_SUBJECT_ID=
BOX_FOLDER_ID=0
BOX_API_URL=https://api.box.com
BOX_UPLOAD_URL=https://upload.box.com/api
BOX_ENHANCED_EXTRACT_AGENT=enhanced_extract_agent
###< Box AI Structured Extract ###

###> Marketplace (création des comptes collaborateurs) ###
# URL vide : l'invitation est journalisée et ignorée (poste de dev).
MARKETPLACE_API_URL=
MARKETPLACE_API_TOKEN=
###< Marketplace ###
