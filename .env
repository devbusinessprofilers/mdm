###> Observabilité / alertes ###
# Jeton Bearer de /metrics — vide = endpoint désactivé (404).
METRICS_TOKEN=
# Destinataire des alertes applicatives — vide = alertes désactivées.
ALERT_EMAIL_TO=
# Seuil de la queue failed au-delà duquel une alerte est envoyée.
ALERT_FAILED_QUEUE_THRESHOLD=5
###< Observabilité / alertes ###

###> Relances de complétude ###
# Score global en dessous duquel une fiche est relancée (0 = désactivé).
COMPLETENESS_REMINDER_THRESHOLD=60
# Délai minimal entre deux relances d'une même fiche, en jours.
COMPLETENESS_REMINDER_COOLDOWN_DAYS=30
# Envoi automatique du lot préparé (lundi 14h). 0 = envoi manuel uniquement.
COMPLETENESS_REMINDER_ENABLED=1
###< Relances de complétude ###

###> Réglages métier (défauts des paramètres surchargeables dans /admin/parametres) ###
# Obligations photos à la soumission et à la diffusion, par type de fiche.
PHOTOS_MIN_LIEU=4
PHOTOS_MAX_LIEU=25
PHOTOS_MIN_AUTRES=1
PHOTOS_MAX_AUTRES=10
# Contraintes d'upload des images (poids en Mo, dimensions minimales en px).
DAM_IMAGE_MAX_MB=25
DAM_IMAGE_MIN_WIDTH=960
DAM_IMAGE_MIN_HEIGHT=480
# Poids maximum des documents (Mo) : supports commerciaux et autres usages.
DAM_DOCUMENT_MAX_MB=10
DAM_COMMERCIAL_SUPPORT_MAX_MB=100
# Délai d'alerte avant l'échéance des droits d'une ressource, en jours.
DAM_RIGHTS_ALERT_DAYS=30
# Limites des PDF soumis à l'extraction documentaire.
OCR_PDF_MAX_MB=50
OCR_PDF_MAX_PAGES=100
# Seuil de confiance (%) d'application automatique des suggestions OCR ;
# 0 = arbitrage manuel uniquement. Surchargeable dans /admin/parametres.
OCR_AUTO_APPLY_THRESHOLD=0
# Détection de doublons de textes entre fiches. Longueur minimale (caractères
# normalisés) d'un champ pour être analysé, et distance SimHash maximale (bits)
# pour signaler un quasi-doublon. Surchargeables dans /admin/parametres.
PIM_TEXT_MIN_LENGTH=60
PIM_TEXT_SIMHASH_DISTANCE_THRESHOLD=10
# Comptes internes : validités des liens, purge des jetons, mot de passe.
ACCOUNT_INVITATION_VALIDITY_HOURS=24
ACCOUNT_RESET_VALIDITY_HOURS=1
ACCOUNT_TOKEN_PURGE_DAYS=30
ACCOUNT_PASSWORD_MIN_LENGTH=12
# Destinataires maximum des demandes d'affiliation d'une fiche.
ACCOUNT_MAX_REQUEST_RECIPIENTS=3
###< Réglages métier ###

###> Rate limiting ###
# Requêtes /api/v1/* par minute et par client JWT (claim sub).
RATE_LIMIT_API_CLIENT=300
# Requêtes /api/v1/* par minute et par IP (repli sans token).
RATE_LIMIT_API_IP=60
# Requêtes par heure et par IP sur les pages publiques (/invitation/*, /mot-de-passe-oublie).
RATE_LIMIT_PUBLIC_IP=30
###< Rate limiting ###

###> Box AI Structured Extract ###
BOX_OCR_ENABLED=0
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_SUBJECT_TYPE=enterprise
BOX_SUBJECT_ID=
BOX_FOLDER_ID=0
BOX_API_URL=https://api.box.com
BOX_UPLOAD_URL=https://upload.box.com/api
BOX_ENHANCED_EXTRACT_AGENT=enhanced_extract_agent
###< Box AI Structured Extract ###

###> OpenAI (retouche & reconnaissance d'images, suggestion de champs) ###
# 0 : les onglets IA de /medias et la pilule « Suggérer » des champs sont
# visibles mais inactifs, aucun appel sortant.
OPENAI_ENABLED=0
# Secret : uniquement en variable d'environnement, jamais en paramètre BDD.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com
OPENAI_IMAGE_EDIT_MODEL=gpt-image-1
OPENAI_VISION_MODEL=gpt-4o
OPENAI_RETOUCHE_PROMPT="Améliore la luminosité, le contraste, les couleurs et la netteté de cette photo sans modifier son contenu, son cadrage ni les éléments présents."
OPENAI_RECO_PROMPT="Décris cette photo d'un établissement événementiel en français : une légende d'une phrase, des mots-clés, le type de vue, intérieur ou extérieur. Les mots-clés décrivent uniquement ce qui est visible sur l'image : le type d'espace (restaurant, salle de réunion, salle de réception, chambre, terrasse, bar…), les éléments présents (boissons, nourriture, mobilier, équipement audiovisuel, décoration…) et l'ambiance. Donne 5 à 10 mots-clés courts, en minuscules, sans doublon."
# La reconnaissance se lance aussi automatiquement à l'import d'une photo.
OPENAI_RECO_AUTO_ENABLED=1
# Suggestion IA d'un champ de description (pilule « Suggérer » de la fiche).
# Placeholders du gabarit : {contexte}, {champ}, {valeur}.
OPENAI_SUGGESTION_MODEL=gpt-4o
OPENAI_SUGGESTION_PROMPT="Tu es un rédacteur pour un référentiel d'établissements événementiels.
Améliore ou propose le champ « {champ} » de la fiche décrite ci-dessous.
Réponds uniquement par le texte du champ, en français, sans commentaire ni guillemets.

Contexte de la fiche :
{contexte}

Contenu actuel du champ :
{valeur}"
# Suggestion des atouts (bouton « Enrichir ce qui manque ») : générés depuis la
# description déjà présente sur la fiche, jamais sans matière première.
# Placeholders du gabarit : {contexte}, {description}, {max}, {longueur_max}.
OPENAI_ATOUTS_PROMPT="Tu es un rédacteur pour un référentiel d'établissements événementiels.
À partir de la description ci-dessous, liste les {max} meilleurs atouts de l'établissement pour un organisateur d'événement d'entreprise.
Réponds uniquement avec un atout par ligne, sans numérotation ni puces, chacun de {longueur_max} caractères maximum, sans point final.

Contexte de la fiche :
{contexte}

Description :
{description}"
###< OpenAI (retouche & reconnaissance d'images, suggestion de champs) ###

###> Marketplace (création des comptes collaborateurs) ###
# URL vide : l'invitation est journalisée et ignorée (poste de dev).
MARKETPLACE_API_URL=
MARKETPLACE_API_TOKEN=
###< Marketplace ###

###> Marketplace (synchronisation des fiches) ###
# Compte machine ROLE_PIM de la marketplace (JWT Lexik via /api/login_check).
# URL vide : la diffusion est désactivée pour l'environnement. Valeurs par
# environnement (local via docker marketplace / test / preprod / prod) dans
# .env.local ou les variables Upsun.
# En local : MARKETPLACE_SYNC_API_URL=http://host.docker.internal:7080
MARKETPLACE_SYNC_API_URL=
MARKETPLACE_SYNC_API_LOGIN=
MARKETPLACE_SYNC_API_PASSWORD=
###< Marketplace (synchronisation des fiches) ###

###> Salesforce (refresh des données fiche) ###
# Connected App Salesforce, OAuth JWT Bearer (RS256). Vide = refresh désactivé.
# LOGIN_URL : https://login.salesforce.com (prod) ou https://test.salesforce.com.
# PRIVATE_KEY : clé privée PEM de la Connected App, « \n » littéraux acceptés.
# Secrets dans .env.local / variables Upsun — voir docs/SECRETS.md.
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_USERNAME=
SALESFORCE_PRIVATE_KEY=
# Jeton Bearer du webhook entrant POST /api/salesforce/produits (notification
# des produits modifiés, refresh ciblé asynchrone). Vide = webhook désactivé (404).
SALESFORCE_WEBHOOK_TOKEN=
###< Salesforce (refresh des données fiche) ###

###> Salesforce (synchro sortante CSV e-mail, système de transition) ###
# Envoi des CSV Produits/Salles vers l'intégration Salesforce par e-mail, en
# attendant l'API. Désactivé par défaut : rien ne part tant que ENABLED=0 ou
# que le destinataire est vide (dev, test, avant le « go » migration prod).
# L'activation, le destinataire et le jeton se règlent aussi dans /admin/parametres.
# TO : adresse d'intégration Salesforce (email → intégration), spécifique à l'org.
# INTEGRATION_TOKEN : valeur de « integration=… » dans l'objet des e-mails.
# C'est un secret (il autorise l'injection de CSV dans Salesforce) : à poser
# hors dépôt (.env.local en local, variable Upsun en prod), jamais ici.
SALESFORCE_CSV_ENABLED=0
SALESFORCE_CSV_TO=
SALESFORCE_CSV_INTEGRATION_TOKEN=
# Expéditeur (doit être autorisé par Salesforce). Vide = MAILER_FROM.
SALESFORCE_CSV_FROM=
###< Salesforce (synchro sortante CSV e-mail, système de transition) ###

###> Sirene (contrôle d'état d'activité des lieux) ###
# Vérifie les lieux (France) contre l'annuaire des entreprises : établissement
# cessé → suggestion d'archivage, SIRET/TVA manquant → backfill. Désactivé par
# défaut (run planifié = no-op tant que 0). Réglable dans /admin/parametres.
SIRENE_STATUS_CHECK_ENABLED=0
# Suggestions d'étoiles (typologie) et de chambres depuis le classement
# officiel Atout France (référentiel local, open data data.gouv.fr).
ATOUT_FRANCE_ENABLED=0
# Re-scan d'un lieu déjà scanné après ce nombre de jours (rafraîchissement
# périodique). Une modification de la fiche force aussi un re-scan avant ce délai.
SIRENE_RESCAN_AFTER_DAYS=180
###< Sirene (contrôle d'état d'activité des lieux) ###

###> Geoapify (enrichissement attributs restaurants) ###
# Propose cuisine, spécificités, équipements, PMR et site des restaurants depuis
# Geoapify Place Details (OpenStreetMap). Nécessite GEOAPIFY_API_KEY. Désactivé
# par défaut. Réglable dans /admin/parametres.
GEOAPIFY_PLACES_ENABLED=0
GEOAPIFY_RESCAN_AFTER_DAYS=180
###< Geoapify (enrichissement attributs restaurants) ###

###> DATAtourisme (enrichissement descriptions/équipements lieux & activités) ###
# Enrichit lieux et activités depuis le flux open data des offices de tourisme.
# FLUX_DIR = répertoire où le flux JSON-LD (configuré sur datatourisme.fr) est
# synchronisé et décompressé. Désactivé par défaut. Réglable dans /admin/parametres.
DATATOURISME_ENABLED=0
DATATOURISME_FLUX_DIR=
DATATOURISME_RESCAN_AFTER_DAYS=180
###< DATAtourisme (enrichissement descriptions/équipements lieux & activités) ###

###> Wikidata (détection de chaîne/marque hôtelière) ###
# Détecte l'affiliation d'un lieu à un groupe hôtelier depuis son nom. Le
# référentiel interne fonctionne seul ; Wikidata (SPARQL) l'enrichit. Désactivé
# par défaut. Réglable dans /admin/parametres.
WIKIDATA_CHAINE_ENABLED=0
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_RESCAN_AFTER_DAYS=180
###< Wikidata (détection de chaîne/marque hôtelière) ###
