# Copier ce fichier vers .env.local (ignoré par git) et renseigner les valeurs.
# NE JAMAIS committer .env.local : il contient les secrets réels.
# Procédures de rotation : voir docs/SECRETS.md

###> symfony/framework-bundle ###
# Générer via : php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_SECRET=
APP_DEBUG=1
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# En conteneur Docker : hôte "sql" (cf. docker-compose), credentials du .env racine du dépôt parent.
DATABASE_URL="mysql://mdm:CHANGE_ME@sql:3306/mdm?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Dev : maildev fourni par docker-compose (interface web sur le port 6082).
MAILER_DSN=smtp://maildev:1025
# Clé HMAC des liens d'invitation — générer comme APP_SECRET.
INVITATION_SIGNING_KEY=
###< symfony/mailer ###

###> external site JWT ###
# Chemin vers la clé publique RS256 (PEM) du site externe consommateur de l'API.
EXTERNAL_SITE_JWT_PUBLIC_KEY=
###< external site JWT ###

###> OVH Object Storage ###
S3_ACCESS_KEY=
S3_SECRET_KEY=
###< OVH Object Storage ###

###> Google Cloud Translation Basic v2 ###
GOOGLE_TRANSLATE_API_KEY=
###< Google Cloud Translation Basic v2 ###

###> Box AI Structured Extract ###
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_SUBJECT_ID=
BOX_FOLDER_ID=
###< Box AI Structured Extract ###

###> Observabilité / alertes ###
# Jeton Bearer de l'endpoint /metrics — générer comme APP_SECRET.
METRICS_TOKEN=
# Destinataire des alertes applicatives (échecs workers, queue failed, 5xx répétées).
ALERT_EMAIL_TO=
###< Observabilité / alertes ###

###> Rate limiting (optionnel — surcharge des défauts du .env) ###
#RATE_LIMIT_API_CLIENT=300
#RATE_LIMIT_API_IP=60
#RATE_LIMIT_PUBLIC_IP=30
###< Rate limiting ###
